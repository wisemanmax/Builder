{
  "env": {
    "browser": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-undef": "error",
    "no-redeclare": "error",
    "eqeqeq": ["warn", "smart"],
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-constant-condition": "warn",
    "no-debugger": "warn"
  },
  "globals": {
    "openBuilder": "readonly",
    "openApp": "readonly",
    "openThink": "readonly",
    "openSettings": "readonly",
    "openTemplates": "readonly",
    "openCustomizeBuilder": "readonly",
    "showProfilePicker": "readonly",
    "pickEmoji": "readonly",
    "finishThink": "readonly",
    "confirmThinkBrief": "readonly",
    "finishOrgThink": "readonly",
    "showThoughtPicker": "readonly",
    "closeTplSheetPreview": "readonly",
    "toggleTplSheetPreviewFullscreen": "readonly",
    "openCurrentInViewer": "readonly",
    "editCurrentApp": "readonly",
    "closeProject": "readonly",
    "copyUrl": "readonly",
    "copyViewerUrl": "readonly",
    "chipSend": "readonly",
    "templateSend": "readonly",
    "sendMsg": "readonly",
    "closeBuilder": "readonly",
    "closeThink": "readonly",
    "delApp": "readonly",
    "handleTap": "readonly",
    "showCtx": "readonly",
    "showCtxAt": "readonly",
    "closeCtx": "readonly",
    "detachThought": "readonly",
    "pickThought": "readonly",
    "thinkOptionSelect": "readonly",
    "refineThink": "readonly",
    "editThinkBrief": "readonly",
    "sendThinkMsg": "readonly",
    "studioSend": "readonly",
    "studioSetFullscreen": "readonly",
    "openPreview": "readonly",
    "renderGrid": "readonly",
    "openOrgThink": "readonly",
    "closeOrgThink": "readonly",
    "sendOrgMsg": "readonly",
    "orgOptionSelect": "readonly",
    "refineOrgThink": "readonly",
    "cycleProfile": "readonly",
    "selfUpdateBuilder": "readonly",
    "pullFromGitHub": "readonly",
    "pullFromSupabase": "readonly",
    "copyToClipboard": "readonly",
    "toast": "readonly",
    "dismissRecovery": "readonly",
    "stopPipeline": "readonly",
    "openBuildHistory": "readonly",
    "closeBuildHistory": "readonly",
    "openThoughtsFolder": "readonly",
    "closeThoughtsFolder": "readonly",
    "openThoughtDetail": "readonly",
    "openShareCard": "readonly",
    "openProjectSheet": "readonly",
    "selectTemplate": "readonly",
    "openTplSheetPreview": "readonly",
    "filterTemplates": "readonly"
  }
}
