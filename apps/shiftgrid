/* ─── WEEKLY EVENT TAB ───────────────────────────────────────────── */
function WeeklyTab(props) {
  var meta = props.meta, setMeta = props.setMeta, onPlay = props.onPlay;
  var event = getWeeklyEvent();
  var weeklyData = loadWeekly();
  var _timer = React.useState(msToEventEnd());
  var timer = _timer[0]; var setTimer = _timer[1];

  React.useEffect(function() {
    var t = setInterval(function() { setTimer(msToEventEnd()); }, 1000);
    return function() { clearInterval(t); };
  }, []);

  function fmtEventTimer(ms) {
    var d = Math.floor(ms / 86400000);
    var h = Math.floor((ms % 86400000) / 3600000);
    var m = Math.floor((ms % 3600000) / 60000);
    var s = Math.floor((ms % 60000) / 1000);
    if (d > 0) return d + "d " + h + "h " + m + "m";
    return h + ":" + String(m).padStart(2,"0") + ":" + String(s).padStart(2,"0");
  }

  var eventDef = {
    id: "event_" + event.id, name: "EVENT: " + event.name,
    moves: 15, bids: ["apt","factory","lab","power"],
    hazards: event.id === "void_wave" ? 12 : event.id === "neon_storm" ? 4 : 0,
    hint: event.desc, isDaily: true,
    comboMult: event.id === "neon_storm" ? 3 : event.id === "blitz_mode" ? 5 : 1,
  };

  var lb = MOCK_LEADERBOARD.map(function(r) {
    if (r.you) return Object.assign({}, r, {score: weeklyData.score || 0});
    return r;
  }).sort(function(a,b) { return b.score - a.score; });

  return (
    <div style={{paddingBottom:16}}>
      <div className="sg-event-hero" style={{borderColor: event.color + "44", background: "linear-gradient(180deg, " + event.glow + " 0%, rgba(7,7,15,0.95) 100%)"}}>
        <div className="sg-event-banner">
          <span className="sg-event-icon">{event.icon}</span>
          <div className="sg-event-title" style={{color: event.color, textShadow: "0 0 16px " + event.color + "66"}}>{event.name}</div>
          <div className="sg-event-timer-label">ENDS IN</div>
          <div className="sg-event-timer" style={{color: event.color}}>{fmtEventTimer(timer)}</div>
          <div className="sg-event-desc">{event.desc}</div>
          <div className="sg-event-modifiers">
            {event.modifiers.map(function(m, i) {
              return <span key={i} className="sg-event-mod" style={{borderColor: event.color + "44", color: event.color}}>{m}</span>;
            })}
          </div>
          <button onClick={function() { onPlay(eventDef, function(){}); }}
            style={{background:"linear-gradient(135deg,"+event.color+","+event.color+"99)",border:"none",borderRadius:14,padding:"14px 32px",color:"#06060f",fontFamily:"'Orbitron',monospace",fontSize:11,fontWeight:700,cursor:"pointer",letterSpacing:"0.1em"}}>
            ENTER EVENT
          </button>
        </div>
        <div className="sg-leaderboard">
          <div style={{fontSize:9,letterSpacing:"0.2em",color:"rgba(255,255,255,0.25)",marginBottom:8}}>LEADERBOARD — THIS WEEK</div>
          {lb.slice(0,7).map(function(row, i) {
            var rankColor = i===0?"#ffaa00":i===1?"rgba(255,255,255,0.6)":i===2?"#ff7700":"rgba(255,255,255,0.3)";
            var medal = i===0?"🥇":i===1?"🥈":i===2?"🥉":"";
            return (
              <div key={i} className={"sg-lb-row" + (row.you ? " you" : "")}>
                <div className="sg-lb-rank" style={{color:rankColor}}>{medal||("#"+(i+1))}</div>
