/* ─── PATROLLING CORRUPTION ────────────────────────────────────── */
function movePatrollers(grid){
  /* Find tiles marked as patrollers and move them one step */
  const g=grid.map(function(row){ return row.map(function(t){ return Object.assign({},t); }); });
  for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
    if(g[r][c]&&g[r][c].patrol&&g[r][c].corrupted){
      var dir=g[r][c].patrolDir||0;
      var dirs=[[0,1],[1,0],[0,-1],[-1,0]];
      var tried=0;
      while(tried<4){
        var nr=r+dirs[dir][0], nc=c+dirs[dir][1];
        if(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&g[nr][nc]&&!g[nr][nc].corrupted&&!g[nr][nc].patrol){
          /* Move patroller */
          g[nr][nc]=Object.assign({},g[nr][nc],{corrupted:true,patrol:true,patrolDir:dir});
          g[r][c]=Object.assign({},g[r][c],{corrupted:false,patrol:false,patrolDir:undefined});
          break;
        }
        dir=(dir+1)%4; tried++;
      }
      if(tried>=4) g[r][c]=Object.assign({},g[r][c],{patrolDir:(dir+1)%4});
    }
  }
  return g;
}

function spreadCorruption(grid,slow){
  if(slow&&Math.random()<slow*0.25) return grid;
  const g=grid.map(function(row){ return row.map(function(t){ return Object.assign({},t); }); });
  const sources=[]; for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) if(g[r][c]&&g[r][c].corrupted) sources.push([r,c]);
  if(!sources.length) return g;
  const src=sources[Math.floor(Math.random()*sources.length)]; const sr=src[0],sc=src[1];
  const nbrs=[[-1,0],[1,0],[0,-1],[0,1]].map(function(d){ return [sr+d[0],sc+d[1]]; }).filter(function(pos){ return pos[0]>=0&&pos[0]<ROWS&&pos[1]>=0&&pos[1]<COLS&&g[pos[0]][pos[1]]&&!g[pos[0]][pos[1]].corrupted; });
  if(nbrs.length){ const pick=nbrs[Math.floor(Math.random()*nbrs.length)]; g[pick[0]][pick[1]]=Object.assign({},g[pick[0]][pick[1]],{corrupted:true}); }
  return g;
}
