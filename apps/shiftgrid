      <ChestInventory meta={meta} setMeta={setMeta} lives={lives} setLives={setLives}/>

      <div className="sg-label" style={{marginTop:14}}>ABILITIES SHOP</div>
      <AbilityShop meta={meta} setMeta={setMeta}/>

      <div className="sg-label" style={{marginTop:14}}>GRID SKINS</div>
