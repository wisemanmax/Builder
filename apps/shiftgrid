                          <div className="sg-boss-stat-val" style={{color:"#00ff88",fontSize:13}}>{proof.clearRate+"%"}</div>
                          <div className="sg-boss-stat-lbl">CLEAR RATE</div>
                        </div>
                      )}
                    </div>
                    <button className="sg-boss-enter-btn"
                      style={{
                        background:bossDone?"rgba(255,170,0,0.12)":"linear-gradient(135deg,#ffaa00,#ff2d95)",
                        color:bossDone?"#ffaa00":"#06060f",
                        border:bossDone?"1px solid rgba(255,170,0,0.3)":"none",
                        boxShadow:bossDone?"none":"0 0 16px rgba(255,100,0,0.4)",
                      }}
                      onClick={function(e){ e.stopPropagation(); if(bossUnlocked) onPlay(bossLvl,null); }}>
                      {bossDone?"⟳ REPLAY BOSS":"⚔ ENTER BOSS — CLEAR ALL "+bossLvl.bids.length+" BUILDINGS"}
                    </button>
                  </>
                )}
              </div>
            );
          })()}
        </>
      )}
    </div>
  );
}


/* ─── ROOT APP ──────────────────────────────────────────────────── */
function Shiftgrid() {
  var _m=React.useState(loadMeta); var meta=_m[0]; var setMeta=_m[1];
  var _t=React.useState("campaign"); var tab=_t[0]; var setTab=_t[1];
  var _p=React.useState(null); var playing=_p[0]; var setPlaying=_p[1];
  var _l=React.useState(loadLives); var lives=_l[0]; var setLives=_l[1];
  var _st=React.useState(false); var showTuto=_st[0]; var setShowTuto=_st[1];
  var _ts=React.useState(0); var tutoStep=_ts[0]; var setTutoStep=_ts[1];
  var _pl=React.useState(null); var pendingLevel=_pl[0]; var setPendingLevel=_pl[1];
  var _sp=React.useState(false); var showStarterPack=_sp[0]; var setShowStarterPack=_sp[1];
  var _lg=React.useState(false); var livesGate=_lg[0]; var setLivesGate=_lg[1];
  var _xp=React.useState(loadXP); var xpData=_xp[0]; var setXpData=_xp[1];
  var _sk=React.useState(function(){ return checkAndUpdateStreak(loadStreak()); });
  var streak=_sk[0]; var setStreak=_sk[1];
  var _cd=React.useState(function(){ return loadChallenges()||initChallenges(); });
  var challengeData=_cd[0]; var setChallengeData=_cd[1];
  var _su=React.useState(false); var showXPUp=_su[0]; var setShowXPUp=_su[1];
  var _sg=React.useState(loadSessionGoals); var sessionGoals=_sg[0]; var setSessionGoals=_sg[1];
  var _lc=React.useState(shouldShowLoginChest); var showLoginChest=_lc[0]; var setShowLoginChest=_lc[1];
  var _ss=React.useState(false); var showSettings=_ss[0]; var setShowSettings=_ss[1];
  var _du=React.useState(null); var distUnlock=_du[0]; var setDistUnlock=_du[1];
  var _eg=React.useState(false); var showEndGame=_eg[0]; var setShowEndGame=_eg[1];
  var _scrollPos=React.useRef({}); /* level scroll memory */
  var _pre=React.useState(null); var preLevelDef=_pre[0]; var setPreLevelDef=_pre[1];
  var _scb=React.useState(null); var starChainBurst=_scb[0]; var setStarChainBurst=_scb[1];
  var _starChain=React.useState(loadStarChain); var starChainData=_starChain[0]; var setStarChainData=_starChain[1];

  React.useEffect(function(){
    var t=setInterval(function(){ setLives(loadLives()); },30000);
    return function(){ clearInterval(t); };
  },[]);

  function handlePlay(levelDef,cb){
    /* Skip lives/tutorial for non-campaign levels */
    var isNonCampaign=levelDef.isDaily||levelDef.isCustom||levelDef.isSandbox||(levelDef.id!=null&&(typeof levelDef.id==="string")&&(levelDef.id.startsWith("event")||levelDef.id.startsWith("wars")||levelDef.id==="sandbox"||levelDef.id.startsWith("custom")));

    /* Campaign levels show pre-level screen first */
    if(!isNonCampaign&&!levelDef.isMaster&&typeof levelDef.id==="number"){
      setPreLevelDef({levelDef:applyComeback(levelDef),cb:cb||function(){}});
      return;
    }
    if(!isNonCampaign&&levelDef.isMaster){
      setPreLevelDef({levelDef:levelDef,cb:cb||function(){}});
      return;
    }
    if(isNonCampaign){
      setPlaying({levelDef:levelDef,cb:cb||function(){}}); return;
    }
    var fresh=loadLives();
    if(fresh.count<=0){ setLivesGate(true); setPendingLevel({levelDef:levelDef,cb:cb}); return; }
    if(!isTutoDone()&&levelDef.id===0){
      setPendingLevel({levelDef:levelDef,cb:cb||function(){}});
      setShowTuto(true); setTutoStep(0); return;
    }
    setPlaying({levelDef:levelDef,cb:cb||function(){}});
  }

  function handlePreLaunch(selectedBoosters, isMasterMode){
    if(!preLevelDef) return;
    var lvl=preLevelDef.levelDef;
    var cb=preLevelDef.cb;
    /* For master mode, strip comeback flags first to avoid double modification */
    var baseLvl = isMasterMode ? Object.assign({},lvl,{_comeback:false,_comebackFails:undefined,hazards:CAMPAIGN_LEVELS[lvl.id]?CAMPAIGN_LEVELS[lvl.id].hazards:lvl.hazards}) : lvl;
    var finalDef = isMasterMode ? getMasterDef(baseLvl) : lvl;
    setPreLevelDef(null);
    /* Apply comeback pity (already applied in levelDef if _comeback flag set) */
    /* Check lives for campaign */
    var fresh=loadLives();
    if(fresh.count<=0){ setLivesGate(true); setPendingLevel({levelDef:finalDef,cb:cb}); return; }
    if(!isTutoDone()&&finalDef.id===0){
      setPendingLevel({levelDef:finalDef,cb:cb});
      setShowTuto(true); setTutoStep(0); return;
    }
    /* Store pre-selected boosters for GameBoard to pre-load */
    setPlaying({levelDef:finalDef, cb:cb, preloadedAbilities:selectedBoosters||[]});
  }

  function startPending(){ if(pendingLevel){ setPlaying(pendingLevel); setPendingLevel(null); } }
  function handleTutoNext(){ Audio.tap(); if(tutoStep>=3){ markTutoDone(); setShowTuto(false); startPending(); } else setTutoStep(tutoStep+1); }
  function handleTutoSkip(){ markTutoDone(); setShowTuto(false); startPending(); }

  function handleComplete(rewards){
    var lvl=playing.levelDef;
    if(playing.cb) playing.cb(rewards);
    var movesUsed=lvl.moves-(rewards.movesLeft||0);
    var stars=calcStars(movesUsed,lvl.moves);

    /* XP */
    var gained=calcXP(rewards.score||0, stars, lvl.boss);
    var newXP=addXP(xpData, gained);
    var leveledUp=newXP.level>xpData.level;
    saveXP(newXP); setXpData(newXP);
    if(leveledUp){ setShowXPUp(true); setTimeout(function(){ setShowXPUp(false); },2500); }

    /* Streak — only update for campaign levels (not sandbox/editor) */
    var newStreak=isCampaignLevel?checkAndUpdateStreak(streak):streak;
    setStreak(newStreak);

    /* Challenges — only update for campaign levels */
    if(isCampaignLevel && challengeData){
      var today=todayStr();
      var seed=parseInt(today.replace(/-/g,""));
      var defs=getDailyChallenges(seed);
      var updated=challengeData.challenges.map(function(c,i){
        var def=defs[i]; if(c.done) return c;
        var prog=c.progress;
        if(def.type==="complete") prog=Math.min(def.goal,prog+1);
        if(def.type==="stars3"&&stars===3) prog=Math.min(def.goal,prog+1);
        if(def.type==="session") prog=Math.min(def.goal,prog+1);
        if(def.type==="cascade"&&(rewards.maxCascade||0)>=3) prog=Math.min(def.goal,prog+1);
        if(def.type==="corrupt"&&(rewards.corruptCleared||0)>0) prog=Math.min(def.goal,prog+(rewards.corruptCleared||0));
        if(def.type==="battery"&&(rewards.batteries||0)>0) prog=Math.min(def.goal,prog+1);
        if(def.type==="pulse"&&(rewards.pulses||0)>0) prog=Math.min(def.goal,prog+1);
        if(def.type==="moves5"&&(lvl.moves-(rewards.movesLeft||0))<=5&&stars>0) prog=Math.min(def.goal,prog+1);
        return Object.assign({},c,{progress:prog,done:prog>=def.goal});
      });
      var newCD=Object.assign({},challengeData,{challenges:updated});
      saveChallenges(newCD); setChallengeData(newCD);
    }

    /* Meta + Chest rewards — only track numeric campaign level ids */
    var isCampaignLevel = typeof lvl.id === "number" && lvl.id >= 0 && lvl.id <= 49;
    setMeta(function(m){
      var cleared=isCampaignLevel?Array.from(new Set((m.levelsCleared||[]).concat([lvl.id]))):(m.levelsCleared||[]);
      var newStars=Object.assign({},m.stars||{});
      if(isCampaignLevel&&(newStars[lvl.id]||0)<stars) newStars[lvl.id]=stars;
      /* Chest drop logic — only for campaign levels */
      var newChests=Object.assign({bronze:0,silver:0,gold:0,royal:0},m.chests||{});
      if(!isCampaignLevel){ var n2=Object.assign({},m,{levelsCleared:cleared,stars:newStars,chests:newChests}); saveMeta(n2); return n2; }
      if(lvl.boss)                        newChests.gold   = (newChests.gold||0)+1;
      else if(stars===3)                  newChests.silver = (newChests.silver||0)+1;
      else if(Math.random()<0.4)          newChests.bronze = (newChests.bronze||0)+1;
      var n=Object.assign({},m,{coins:m.coins+(rewards.coins||0),parts:m.parts+(rewards.parts||0),levelsCleared:cleared,stars:newStars,chests:newChests});
      saveMeta(n); return n;
    });

    /* Session Goals — only for campaign levels */
    if(isCampaignLevel) setSessionGoals(function(sg) {
      if (!sg) return sg;
      var defs = getSessionGoalDefs(sg.pickedIds);
      var wasNearWin = rewards.wasNearWin || false;
      var newGoals = sg.goals.map(function(g, i) {
        var def = defs[i]; if (!def || g.claimed) return g;
        if (g.progress >= def.goal) return g;
        var prog = g.progress;
        if (def.type === "win")       prog = Math.min(def.goal, prog + 1);
        if (def.type === "stars3" && stars === 3) prog = Math.min(def.goal, prog + 1);
        if (def.type === "battery" && (rewards.batteries||0) > 0)  prog = Math.min(def.goal, prog + (rewards.batteries||0));
        if (def.type === "pulse"   && (rewards.pulses||0) > 0)     prog = Math.min(def.goal, prog + 1);
        if (def.type === "cascade4" && (rewards.maxCascade||0)>=4) prog = Math.min(def.goal, prog + 1);
        if (def.type === "corrupt"  && (rewards.corruptCleared||0)>0) prog = Math.min(def.goal, prog + (rewards.corruptCleared||0));
        if (def.type === "clean_win" && !wasNearWin) prog = Math.min(def.goal, prog + 1);
        if (def.type === "streak2" && (rewards.consecutiveWins||0) >= 2) prog = Math.min(def.goal, prog + 1);
        return Object.assign({}, g, {progress: prog});
      });
      var updated = Object.assign({}, sg, {goals: newGoals});
      saveSessionGoals(updated);
      return updated;
    });
    /* District unlock ceremony */
    var bossIds=[9,19,29,39,49];
    if(isCampaignLevel&&bossIds.includes(lvl.id)){
      var distIdx=Math.floor(lvl.id/10);
      var dist=DISTRICTS[distIdx];
      if(dist){
        /* Give district clear rewards */
        setMeta(function(m){
          var newChests=Object.assign({},m.chests||{});
          newChests.silver=(newChests.silver||0)+1;
          var n=Object.assign({},m,{coins:m.coins+150,parts:m.parts+8,chests:newChests});
          saveMeta(n); return n;
        });
        if(lvl.id===49){ setTimeout(function(){ setShowEndGame(true); },400); }
        else { setTimeout(function(){ setDistUnlock(Object.assign({},dist,{icon:distIdx===0?"🏙️":distIdx===1?"🏭":distIdx===2?"🌆":distIdx===3?"🌑":"🏆"})); },400); }
      }
    }
    /* ── SQUAD CONTRIBUTION ── */
    if(isCampaignLevel){
      var sqd=loadSquad();
      if(sqd){
        /* Increment player contribution in local squad data */
        if(!sqd.playerWeekly) sqd.playerWeekly={};
        sqd.playerWeekly.levels=(sqd.playerWeekly.levels||0)+1;
        if(stars===3) sqd.playerWeekly.stars3=(sqd.playerWeekly.stars3||0)+1;
        saveSquad(sqd);
      }
    }

    /* ── SEASON XP ── */
    if(isCampaignLevel){
      var sxp = 20 + stars*15 + (lvl.boss?50:0);
      addSeasonXP(sxp);
    }

    /* ── STAR CHAIN UPDATE ── */
    if(isCampaignLevel && stars===3){
      var sc=loadStarChain();
      sc.stars=(sc.stars||0)+1;
      var newClaimed=sc.claimed||[];
      /* Check if we hit a milestone */
      var milestone=STAR_CHAIN_REWARDS.find(function(r){
        return !newClaimed.includes(r.at) && sc.stars%STAR_CHAIN_GOAL>=r.at;
      });
      if(milestone){
        newClaimed=newClaimed.concat([sc.stars]);
        /* Award chest */
        setMeta(function(m){
          var nc=Object.assign({},m.chests||{});
          nc[milestone.chest]=(nc[milestone.chest]||0)+1;
          var n=Object.assign({},m,{coins:m.coins+milestone.coins,chests:nc});
          saveMeta(n); return n;
        });
        /* Show burst */
        setStarChainBurst(milestone);
        setTimeout(function(){ setStarChainBurst(null); },2500);
      }
      sc.claimed=newClaimed;
      saveStarChain(sc);
      setStarChainData(sc);
    }

    /* ── FAIL COUNT RESET ON WIN ── */
    if(isCampaignLevel) resetFailCount(lvl.id);

    /* ── MASTER CLEAR RECORD ── */
    if(isCampaignLevel&&lvl.isMaster) addMasterClear(lvl.id);

    setPlaying(null);
    if(lvl.id>=4&&!meta.starterPackShown&&Math.random()<0.25){
      setMeta(function(m){ var n=Object.assign({},m,{starterPackShown:true}); saveMeta(n); return n; });
      setTimeout(function(){ setShowStarterPack(true); },700);
    }
  }

  function handleLose(){
    var fresh=loadLives();
    var updated={count:Math.max(0,fresh.count-1),lastRegen:fresh.count===MAX_LIVES?Date.now():fresh.lastRegen};
    saveLives(updated); setLives(updated);
    /* Track fail count for comeback system */
    if(playing&&playing.levelDef&&typeof playing.levelDef.id==="number"){
      bumpFailCount(playing.levelDef.id);
    }
  }

  function watchAdForLife(){
    var fresh=loadLives();
    var updated={count:Math.min(MAX_LIVES,fresh.count+1),lastRegen:fresh.lastRegen};
    saveLives(updated); setLives(updated); setLivesGate(false);
    if(pendingLevel){ setPlaying(pendingLevel); setPendingLevel(null); }
  }

  function handleLoginClaim(rewards) {
    saveLoginData({ lastLogin: todayStr(), claimed: true });
    setShowLoginChest(false);
    setMeta(function(m) {
      var n = Object.assign({}, m, {
        coins: m.coins + (rewards.coins||0),
        parts: m.parts + (rewards.parts||0),
      });
      saveMeta(n); return n;
    });
    if ((rewards.lives||0) > 0) {
      var fresh = loadLives();
      var updated = { count: Math.min(MAX_LIVES, fresh.count + rewards.lives), lastRegen: fresh.lastRegen };
      saveLives(updated); setLives(updated);
    }
    Audio.win();
  }

  var rank = getKingdomRank(meta.levelsCleared);

  var TABS=[
    {id:"campaign",  icon:"🗺", label:"PLAY"},
    {id:"challenges",icon:"🎯", label:"QUESTS"},
    {id:"social",    icon:"🛡", label:"SOCIAL"},
    {id:"city",      icon:"🌆", label:"CITY"},
    {id:"season",    icon:"🌟", label:"SEASON"},
    {id:"event",     icon:"⚡", label:"MORE"},
    {id:"editor",    icon:"🛠", label:"BUILD"},
  ];

  if(playing){
    return (
      <div className="sg-app">
        <Particles/>
        {showTuto&&<TutorialOverlay step={tutoStep} onNext={handleTutoNext} onSkip={handleTutoSkip}/>}
        <GameBoard key={playing.levelDef.id+"_"+Date.now()} levelDef={playing.levelDef} meta={meta} lives={lives}
          preloadedAbilities={playing.preloadedAbilities||[]}
          onComplete={handleComplete} onLose={handleLose}
          onBack={function(){ setPlaying(null); }}/>
      </div>
    );
  }

  var allChallengesDone = challengeData && challengeData.challenges.every(function(c){ return c.done; });
  var chestUnclaimed = allChallengesDone && !challengeData.chestClaimed;
  var streakAtRisk = (function(){
    var d = new Date(), prev = new Date(d); prev.setDate(prev.getDate()-1);
    var prevStr = prev.getFullYear()+"-"+String(prev.getMonth()+1).padStart(2,"0")+"-"+String(prev.getDate()).padStart(2,"0");
    return streak.count >= 2 && streak.lastDay !== todayStr() && streak.lastDay !== prevStr && !isStreakProtected(streak);
  })();
  var seasonClaimable=(function(){
    var sd=loadSeason(); var ct=Math.min(SEASON_TIERS.length,Math.floor((sd.xp||0)/SEASON_XP_PER_TIER));
    var cl=sd.claimed||[];
    return SEASON_TIERS.some(function(t){
      return (ct>=t.tier&&!cl.includes(t.tier+"f")&&t.reward)||(ct>=t.tier&&!cl.includes(t.tier+"p")&&t.premReward&&sd.premium);
    });
  })();
  var hasClaimableGoal = sessionGoals && sessionGoals.goals && getSessionGoalDefs(sessionGoals.pickedIds).some(function(def, i) {
    var g = sessionGoals.goals[i];
    return def && g && !g.claimed && g.progress >= def.goal;
  });

  return (
    <div className="sg-app">
      <Particles/>
      {showTuto&&<TutorialOverlay step={tutoStep} onNext={handleTutoNext} onSkip={handleTutoSkip}/>}
      {livesGate&&<LivesGate lives={lives} onBack={function(){ setLivesGate(false); setPendingLevel(null); }} onWatchAd={watchAdForLife}/>}
      {showStarterPack&&<StarterPack onClose={function(){ setShowStarterPack(false); }} onBuy={function(){ setShowStarterPack(false); }}/>}
      {showLoginChest&&<LoginChestPopup streak={streak} onClaim={handleLoginClaim}/>}
      {preLevelDef&&<PreLevelScreen
        levelDef={preLevelDef.levelDef}
        meta={meta}
        onLaunch={handlePreLaunch}
        onBack={function(){ setPreLevelDef(null); }}/>}
      {starChainBurst&&(
        <div className="sg-star-chain-burst" onClick={function(){ setStarChainBurst(null); }}>
          <div style={{position:"absolute",inset:0,background:"rgba(255,170,0,0.15)"}}/>
          <div className="sg-scb-inner">
            <span className="sg-scb-icon">{starChainBurst.icon}</span>
            <div className="sg-scb-title">STAR CHAIN COMPLETE!</div>
            <div className="sg-scb-sub">{starChainBurst.label+" earned — check your CITY tab"}</div>
          </div>
        </div>
      )}
      {showSettings&&<SettingsSheet onClose={function(){ setShowSettings(false); }} meta={meta} setMeta={setMeta} lives={lives} setLives={setLives}/>}
      {distUnlock&&<DistrictUnlock dist={distUnlock} onContinue={function(){ setDistUnlock(null); }}/>}
      {showEndGame&&<EndGame meta={meta} xpData={xpData} onNewGame={function(){ setShowEndGame(false); }} onClose={function(){ setShowEndGame(false); }}/>}

      {/* XP Level Up toast */}
      {showXPUp&&(
        <div style={{position:"fixed",top:80,left:"50%",transform:"translateX(-50%)",zIndex:800,background:"linear-gradient(135deg,#a855f7,#00e5ff)",borderRadius:12,padding:"10px 20px",fontFamily:"'Orbitron',monospace",fontSize:11,fontWeight:700,color:"#fff",letterSpacing:"0.1em",boxShadow:"0 0 24px rgba(168,85,247,0.5)",animation:"toast-in 0.3s ease",whiteSpace:"nowrap"}}>
          ⬆ LEVEL UP! LVL {xpData.level}
        </div>
      )}

      <div className="sg-header">
        <div>
          <div className="sg-logo">SHIFTGRID</div>
          <div className="sg-kingdom-rank" style={{color:rank.color,borderColor:rank.border,background:rank.bg,marginTop:3}}>
            {rank.label}
          </div>
        </div>
        <div style={{display:"flex",gap:8,alignItems:"center"}}>
          <div className="sg-lives">
            {[0,1,2,3,4].map(function(i){ return <span key={i} className={"sg-heart"+(i<lives.count?"":" empty")}>❤️</span>; })}
          </div>
          <div className="sg-coin">
            <div className="sg-coin-dot" style={{background:"#ffaa00",boxShadow:"0 0 5px #ffaa00"}}></div>
            <span style={{fontFamily:"'Share Tech Mono',monospace",fontSize:12,color:"rgba(255,255,255,0.6)"}}>{meta.coins}</span>
          </div>
          <div style={{fontFamily:"'Share Tech Mono',monospace",fontSize:10,color:"rgba(168,85,247,0.8)",letterSpacing:"0.06em"}}>{"LV"+xpData.level}</div>
          <button onClick={function(){ Audio.tap(); setShowSettings(true); }}
            style={{background:"none",border:"none",color:"rgba(255,255,255,0.4)",fontSize:18,cursor:"pointer",padding:"2px 4px",lineHeight:1}}>⚙️</button>
        </div>
      </div>
      <XPBar xpData={xpData}/>
      <div className="sg-content" ref={function(el){
        if(el){
          el.scrollTop=_scrollPos.current[tab]||0;
          el._tab=tab;
          el.onscroll=function(){ _scrollPos.current[el._tab]=el.scrollTop; };
        }
      }}>
        {tab==="campaign"   &&<CampaignTab meta={meta} onPlay={handlePlay} setMeta={setMeta} sessionGoals={sessionGoals} setSessionGoals={setSessionGoals}/>}
        {tab==="challenges" &&<ChallengesTab meta={meta} setMeta={setMeta} challengeData={challengeData} setChallengeData={setChallengeData} streak={streak} onStreakUpdate={setStreak} onPlay={handlePlay}/>}
        {tab==="social"     &&<SocialTab meta={meta} setMeta={setMeta} xpData={xpData} lives={lives} setLives={setLives} onPlay={handlePlay}/>}
        {tab==="city"       &&<CityTab meta={meta} setMeta={setMeta} xpData={xpData} lives={lives} setLives={setLives}/>}
        {tab==="season"     &&<SeasonPassTab meta={meta} setMeta={setMeta}/>}
        {tab==="event"      &&<MoreTab meta={meta} setMeta={setMeta} xpData={xpData} onPlay={handlePlay}/>}
        {tab==="editor"     &&<EditorTab meta={meta} setMeta={setMeta} onPlay={handlePlay}/>}
      </div>
      <nav className="sg-nav">
        {TABS.map(function(t){
          var socialHasDot=(function(){
            var sqd=loadSquad(); if(!sqd) return false;
            /* pending gifts */
            var today=todayStr(); var g=loadGifts();
            var giftsNew=g.lastReset!==today;
            /* bracket ready */
            var b=loadBracket(); var w=Math.floor(Date.now()/(7*24*60*60*1000));
            var bReady=!b||b.weekSeed!==w||(b.round<3&&(b.losses||0)<1);
            return giftsNew||bReady;
          })();
          var hasDot = (t.id==="campaign"&&hasClaimableGoal) || (t.id==="challenges"&&(chestUnclaimed||streakAtRisk)) || (t.id==="social"&&socialHasDot) || (t.id==="season"&&seasonClaimable);
          var dotColor = t.id==="challenges"&&streakAtRisk ? "#ff2d95" : t.id==="challenges"&&chestUnclaimed ? "#00ff88" : "#ffaa00";
          return (
            <button key={t.id} className={"sg-nav-btn"+(tab===t.id?" active":"")} onClick={function(){ Audio.tap(); setTab(t.id); }} style={{position:"relative"}}>
              <span className="nav-icon">{t.icon}</span>
              <span>{t.label}</span>
              {hasDot&&tab!==t.id&&<div style={{position:"absolute",top:5,right:"50%",marginRight:-16,width:7,height:7,borderRadius:"50%",background:dotColor,boxShadow:"0 0 6px "+dotColor}}/>}
            </button>
          );
        })}
      </nav>
    </div>
  );
}

class ErrorBoundary extends React.Component {
  constructor(props){ super(props); this.state={hasError:false,error:null}; }
  static getDerivedStateFromError(e){ return {hasError:true,error:e}; }
  componentDidCatch(e,info){ console.error("SHIFTGRID ERROR:",e,info); }
  render(){
    if(this.state.hasError){
      return (
        <div style={{position:"fixed",inset:0,background:"#07070f",display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",padding:24,textAlign:"center"}}>
          <div style={{fontSize:48,marginBottom:16}}>⚡</div>
          <div style={{fontFamily:"'Orbitron',monospace",fontSize:16,fontWeight:900,color:"#ff2d95",marginBottom:8,letterSpacing:"0.1em"}}>GRID ERROR</div>
          <div style={{fontSize:12,color:"rgba(255,255,255,0.4)",marginBottom:24,lineHeight:1.6}}>Something went wrong.<br/>Your progress is safe.</div>
          <button onClick={function(){ window.location.reload(); }}
            style={{background:"linear-gradient(135deg,#00e5ff,#00ff88)",border:"none",borderRadius:12,padding:"14px 28px",color:"#06060f",fontFamily:"'Orbitron',monospace",fontSize:10,fontWeight:700,cursor:"pointer",letterSpacing:"0.1em"}}>
            RELOAD GAME
          </button>
          <div style={{fontSize:9,color:"rgba(255,255,255,0.2)",marginTop:16}}>Error: {this.state.error&&this.state.error.message}</div>
        </div>
      );
    }
    return this.props.children;
  }
}

const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<ErrorBoundary><Shiftgrid/></ErrorBoundary>);
</script>

</body>
</html>