/* ─── SEASON PASS ────────────────────────────────────────────────── */
function SeasonPassTab(props){
  var meta=props.meta, setMeta=props.setMeta;
  var _sd=React.useState(loadSeason); var sd=_sd[0]; var setSd=_sd[1];
  /* Re-sync season data when tab mounts (picks up XP earned mid-session) */
  React.useEffect(function(){ setSd(loadSeason()); },[]);

  var tierProgress=sd.xp||0;
  var currentTier=Math.min(SEASON_TIERS.length, Math.floor(tierProgress/SEASON_XP_PER_TIER));
  var tierPct=Math.min(100,((tierProgress%SEASON_XP_PER_TIER)/SEASON_XP_PER_TIER)*100);
  var isPremium=sd.premium||false;
  var claimed=sd.claimed||[];

  function claimTier(tier,isPrem){
    var key=tier.tier+(isPrem?"p":"f");
    if(claimed.includes(key)) return;
    var reward=isPrem?tier.premReward:tier.reward;
    if(!reward) return;
    if(isPrem&&!isPremium) return;
    var newClaimed=claimed.concat([key]);
    /* Apply reward */
    var newAbils=loadAbilities();
    if(reward.abilities) Object.keys(reward.abilities).forEach(function(k){ newAbils[k]=(newAbils[k]||0)+reward.abilities[k]; });
    saveAbilities(newAbils);
    setMeta(function(m){
      var nc=Object.assign({},m.chests||{});
      if(reward.chest) nc[reward.chest]=(nc[reward.chest]||0)+1;
      var n=Object.assign({},m,{
        coins:m.coins+(reward.coins||0),
        parts:m.parts+(reward.parts||0),
        chests:nc,
      });
      saveMeta(n); return n;
    });
    var newSd=Object.assign({},sd,{claimed:newClaimed});
    saveSeason(newSd); setSd(newSd);
    Audio.win(); Haptics.medium();
