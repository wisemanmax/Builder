/* ─── STAR CHAIN METER ─────────────────────────────────────────── */
function StarChainMeter(props){
  var meta=props.meta, setMeta=props.setMeta, onBurst=props.onBurst;
  var chain=loadStarChain();
  var stars=chain.stars||0;
  var pct=Math.min(100,(stars%STAR_CHAIN_GOAL)/STAR_CHAIN_GOAL*100);
  var nextReward=STAR_CHAIN_REWARDS.find(function(r){ return !(chain.claimed||[]).includes(r.at)&&r.at>stars; });
  if(!nextReward) nextReward=STAR_CHAIN_REWARDS[STAR_CHAIN_REWARDS.length-1];

  return (
    <div className="sg-star-chain-bar">
      <div className="sg-star-chain-label">
        <span className="sg-star-chain-lbl">⭐ STAR CHAIN — {nextReward?nextReward.label:"MAX"}</span>
        <span className="sg-star-chain-count">{stars%STAR_CHAIN_GOAL}/{STAR_CHAIN_GOAL}</span>
      </div>
      <div className="sg-star-chain-track">
        <div className="sg-star-chain-fill" style={{width:pct+"%"}}/>
      </div>
      <div className="sg-star-chain-pips">
        {[1,2,3,4,5,6,7,8,9].map(function(n){
          var r=STAR_CHAIN_REWARDS.find(function(x){ return x.at===n; });
          return (
            <span key={n} className={"sg-star-pip"+(stars%STAR_CHAIN_GOAL>=n||Math.floor(stars/STAR_CHAIN_GOAL)>0?" lit":"")}>
