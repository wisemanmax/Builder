                  onClick={function(){ if(canClaimFree) claimTier(tier,false); }}>
                  {fClaimed?"✓":tier.icon}
                </div>
                <div className="sg-pass-lbl">T{tier.tier}</div>
                {/* Premium row */}
                {tier.premReward&&(
                  <div className={"sg-pass-gem"+(pClaimed?" earned":earned&&isPremium?" current":" locked")}
