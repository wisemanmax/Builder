  for (var i = 0; i < 18; i++) {
    var col = cols[i % cols.length];
    var left = (i * 17 + 3) % 97;
    var dur = 8 + (i * 3.7) % 14;
    var delay = -(i * 2.1) % dur;
    var size = 1.5 + (i % 3);
    particles.push(
      <div key={i} className="sg-particle" style={{left: left+"%", bottom: "-4px", width: size+"px", height: size+"px", background: col, boxShadow: "0 0 6px "+col, animationDuration: dur+"s", animationDelay: delay+"s"}}/>
    );
  }
  return <div className="sg-particles">{particles}</div>;
}

