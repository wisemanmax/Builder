/* ─── COMEBACK / PITY SYSTEM ────────────────────────────────────── */
const FAIL_COUNTS_KEY = "sg_fails_v1";
function getFailCount(levelId){ try{ var s=localStorage.getItem(FAIL_COUNTS_KEY); var d=s?JSON.parse(s):{}; return d[levelId]||0; }catch{ return 0; } }
function bumpFailCount(levelId){ try{ var s=localStorage.getItem(FAIL_COUNTS_KEY); var d=s?JSON.parse(s):{}; d[levelId]=(d[levelId]||0)+1; localStorage.setItem(FAIL_COUNTS_KEY,JSON.stringify(d)); }catch{} }
function resetFailCount(levelId){ try{ var s=localStorage.getItem(FAIL_COUNTS_KEY); var d=s?JSON.parse(s):{}; delete d[levelId]; localStorage.setItem(FAIL_COUNTS_KEY,JSON.stringify(d)); }catch{} }
/* Apply pity: reduce hazards and improve tiles subtly after 3+ fails */
function applyComeback(levelDef){
  var fails=getFailCount(levelDef.id);
  if(fails<3||typeof levelDef.id!=="number") return levelDef;
  var reduction = fails>=6 ? 3 : fails>=4 ? 2 : 1;
  return Object.assign({},levelDef,{
    hazards:Math.max(0,(levelDef.hazards||0)-reduction),
    _comeback:true,
    _comebackFails:fails,
  });
}

