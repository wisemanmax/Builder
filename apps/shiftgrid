const ABILITIES_KEY = "sg_abilities_v1";
function loadAbilities(){
  try{
    var s=localStorage.getItem(ABILITIES_KEY);
    var base={surge:0,cleanse:0,shift_plus:0,freeze:0,wildfire:0,detector:0};
    if(!s){
      /* New player starter pack — 1 free of each basic ability */
      var starter=Object.assign({},base,{detector:2,shift_plus:1,surge:1});
      localStorage.setItem(ABILITIES_KEY,JSON.stringify(starter));
      return starter;
    }
    return Object.assign({},base,JSON.parse(s));
  }catch{ return {surge:0,cleanse:0,shift_plus:0,freeze:0,wildfire:0,detector:0}; }
}
function saveAbilities(a){ try{ localStorage.setItem(ABILITIES_KEY,JSON.stringify(a)); }catch{} }

