                {def.label}
              </div>
              <div className="sg-chest-inv-count" style={{color:isEmpty?"rgba(255,255,255,0.15)":def.color}}>
                {count}
              </div>
              {!isEmpty && <div className="sg-chest-inv-tap">TAP TO OPEN</div>}
            </div>
          );
        })}
      </div>

      {/* Last opened reward display */}
      {lastReward && (
        <div style={{background:"rgba(255,255,255,0.03)",border:"1px solid rgba(255,255,255,0.08)",
          borderRadius:12,padding:"10px 14px",display:"flex",alignItems:"center",gap:10,marginBottom:8}}>
          <span style={{fontSize:20}}>{CHEST_DEFS[lastReward.type].icon}</span>
