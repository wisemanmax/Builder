            {lastReward.rewards.coins>0&&<span style={{color:"#ffaa00"}}>+{lastReward.rewards.coins}⬡</span>}
            {lastReward.rewards.parts>0&&<span style={{color:"#00e5ff"}}>+{lastReward.rewards.parts}◈</span>}
            {lastReward.rewards.lives>0&&<span style={{color:"#ff2d95"}}>+{lastReward.rewards.lives}❤</span>}
          </div>
