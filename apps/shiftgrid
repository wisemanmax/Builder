                <div className="sg-bldg-sub">
                  {colorblind && <span style={{marginRight:4,fontSize:12}}>{CB_SHAPE[b.color]}</span>}
                  <span style={{color:"rgba(255,255,255,0.45)",fontWeight:700}}>{NODENAME[b.color]}</span>
                  <span style={{color:"rgba(255,255,255,0.2)"}}>{" ("+LABEL[b.color]+")"}</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div className="sg-hint">{levelDef.hint}</div>

      {/* WIN — upgraded with animated stars, efficiency bar, best badge */}
      {phase==="win"&&(function(){
        var prevBest=0;
        try{ var gr=JSON.parse(localStorage.getItem("sg_ghost_"+levelDef.id)||"{}"); prevBest=gr.moves?gr.moves.length:0; }catch{}
        var isNewBest = prevBest>0 && moveHistoryRef.current.length < prevBest;
        var effPct = Math.round((moves/levelDef.moves)*100);
        return (
          <div className="sg-overlay">
            <div className="sg-modal">
              <span className="sg-modal-icon">⚡</span>
              <div className="sg-modal-title" style={{background:"linear-gradient(135deg,#ffaa00,#00ff88)",WebkitBackgroundClip:"text",WebkitTextFillColor:"transparent"}}>DISTRICT POWERED!</div>
              <div className="sg-modal-sub">{displayName}</div>
              {isNewBest && <div className="sg-best-badge">🏅 NEW BEST — {moveHistoryRef.current.length} MOVES</div>}
              <div className="sg-win-stars">
                {[1,2,3].map(function(i){
                  return <span key={i} className={"sg-win-star"+(i<=stars?" lit":"")} style={{animationDelay:(i*0.12)+"s"}}>★</span>;
                })}
              </div>
              <div style={{fontSize:9,color:"rgba(255,255,255,0.3)",letterSpacing:"0.1em",marginBottom:3,textAlign:"left"}}>
                {objectiveType==="minmoves"
                  ? "EFFICIENCY — PAR "+minMovesPar+" · YOU USED "+movesUsed
