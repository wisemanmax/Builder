    .sg-daily-lb-row.you-row { background: rgba(0,229,255,0.05); }
    .sg-daily-lb-rank { font-family: 'Orbitron', monospace; font-size: 11px; min-width: 24px; }
    .sg-daily-lb-name { flex: 1; font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.65); }
    .sg-daily-lb-score { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.45); }
    .sg-daily-lb-moves { font-size: 9px; color: rgba(255,255,255,0.25); margin-left: 4px; }

    /* ── STREAK PROTECTION ── */
    .sg-streak-protect {
      background: linear-gradient(90deg,rgba(168,85,247,0.12),rgba(0,229,255,0.06));
      border: 1px solid rgba(168,85,247,0.3); border-radius: 14px;
      padding: 14px 16px; margin-bottom: 10px;
      display: flex; align-items: center; gap: 12px;
    }
    .sg-protect-icon { font-size: 28px; flex-shrink: 0; }
    .sg-protect-info { flex: 1; }
    .sg-protect-title { font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 2px; }
    .sg-protect-sub { font-size: 10px; color: rgba(255,255,255,0.35); line-height: 1.4; }
    .sg-protect-btns { display: flex; flex-direction: column; gap: 5px; flex-shrink: 0; }
    .sg-protect-ad {
      background: linear-gradient(135deg,#a855f7,#6366f1);
      border: none; border-radius: 8px; padding: 7px 12px;
      font-family: 'Orbitron', monospace; font-size: 8px; font-weight: 700;
      color: #fff; cursor: pointer; letter-spacing: 0.08em; white-space: nowrap;
      transition: opacity 0.15s;
    }
    .sg-protect-ad:hover { opacity: 0.88; }
    .sg-protect-coins {
      background: rgba(255,170,0,0.12); border: 1px solid rgba(255,170,0,0.3);
      border-radius: 8px; padding: 6px 12px;
      font-family: 'Orbitron', monospace; font-size: 8px; font-weight: 700;
      color: #ffaa00; cursor: pointer; letter-spacing: 0.08em; white-space: nowrap;
      transition: all 0.15s;
    }
    .sg-protect-coins:hover { background: rgba(255,170,0,0.2); }
    .sg-protect-coins:disabled { opacity: 0.3; cursor: default; }
    .sg-streak-shield {
      display: inline-block; font-size: 11px; margin-left: 6px;
      animation: shield-pulse 1.5s ease infinite;
    }
    @keyframes shield-pulse {
      0%,100% { filter: drop-shadow(0 0 2px #a855f7); }
      50%      { filter: drop-shadow(0 0 8px #a855f7); }
    }
    .sg-streak-protected-badge {
      font-size: 9px; color: #a855f7; letter-spacing: 0.12em;
      font-weight: 700; margin-top: 3px;
    }

    /* ── DAILY TAB ── */
    .sg-daily-hero {
      background: rgba(255,170,0,0.04); border: 1px solid rgba(255,170,0,0.14);
      border-radius: 18px; padding: 24px 20px; text-align: center; margin-bottom: 12px;
      position: relative; overflow: hidden;
    }
    .sg-daily-hero::before {
      content: ''; position: absolute; top: -30px; left: 50%; transform: translateX(-50%);
      width: 200px; height: 200px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,170,0,0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .sg-daily-city { font-size: 52px; margin-bottom: 8px; display: block; }
    .sg-daily-num { font-family: 'Orbitron', monospace; font-size: 14px; font-weight: 700; letter-spacing: 0.12em; margin-bottom: 6px; }
    .sg-daily-desc { font-size: 11px; color: rgba(255,255,255,0.35); line-height: 1.5; margin-bottom: 16px; }
    .sg-daily-specs { display: flex; gap: 8px; justify-content: center; margin-bottom: 16px; }
    .sg-spec {
      background: rgba(255,255,255,0.05); border: 1px solid var(--border);
      border-radius: 10px; padding: 8px 14px; text-align: center;
    }
