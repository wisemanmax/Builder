    .sg-boss-stats { display: flex; gap: 6px; margin-bottom: 12px; }
    .sg-boss-stat {
      flex: 1; background: rgba(0,0,0,0.25); border-radius: 8px; padding: 7px 4px; text-align: center;
    }
    .sg-boss-stat-val { font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 700; }
    .sg-boss-stat-lbl { font-size: 7px; letter-spacing: 0.12em; margin-top: 2px; opacity: 0.55; }
    .sg-boss-enter-btn {
      width: 100%; border: none; border-radius: 11px; padding: 13px;
      font-family: 'Orbitron', monospace; font-size: 11px; font-weight: 700;
      cursor: pointer; letter-spacing: 0.1em; transition: all 0.15s;
    }
    .sg-boss-enter-btn:hover { opacity: 0.88; transform: scale(1.02); }

    /* ── CAMPAIGN ── */
    .sg-campaign-card {
      border: 1px solid; border-radius: 14px; padding: 13px 14px;
      margin-bottom: 8px; transition: all 0.3s; cursor: default;
    }
    .sg-campaign-card.playable { cursor: pointer; }
    .sg-campaign-card.playable:active { transform: scale(0.98); }
    .sg-camp-row { display: flex; align-items: center; gap: 12px; }
    .sg-camp-emoji { font-size: 30px; flex-shrink: 0; }
    .sg-camp-info { flex: 1; }
    .sg-camp-num { font-size: 9px; letter-spacing: 0.2em; color: rgba(255,255,255,0.25); margin-bottom: 2px; }
    .sg-camp-name { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
    .sg-camp-meta { display: flex; gap: 10px; }
    .sg-camp-tag { font-size: 10px; color: rgba(255,255,255,0.32); }
    .sg-play-btn {
      border: none; border-radius: 11px; padding: 9px 16px;
      font-family: 'Orbitron', monospace; font-size: 9px; font-weight: 700;
      cursor: pointer; letter-spacing: 0.08em; transition: transform 0.12s, opacity 0.12s;
      flex-shrink: 0;
    }
    .sg-play-btn:hover { opacity: 0.85; transform: scale(1.06); }
    .sg-camp-bids { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 8px; }
    .sg-bid-chip { font-size: 9px; padding: 2px 8px; border-radius: 5px; border: 1px solid; }

    /* ── OFFLINE BANNER ── */
    #sg-offline-banner {
      display: none;
      position: fixed; top: 0; left: 0; right: 0; z-index: 99998;
      background: rgba(255,45,149,0.95);
      padding: 8px 16px;
      text-align: center;
      font-family: 'Share Tech Mono', monospace;
      font-size: 11px; font-weight: 700;
      color: #fff; letter-spacing: 0.1em;
      animation: slide-down 0.3s ease;
    }
    @keyframes slide-down {
      from { transform: translateY(-100%); }
      to   { transform: translateY(0); }
    }

    /* ── COIN FLY ANIMATION ── */
    .sg-coin-fly {
      position: fixed; z-index: 8000; pointer-events: none;
      font-family: 'Share Tech Mono', monospace; font-size: 13px;
      font-weight: 700; color: #ffaa00;
      text-shadow: 0 0 8px rgba(255,170,0,0.7);
      animation: coin-fly 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
    }
    @keyframes coin-fly {
      0%   { opacity: 1; transform: translate(0, 0) scale(1); }
      30%  { opacity: 1; transform: translate(var(--fly-x), calc(var(--fly-y) * 0.3)) scale(1.2); }
      100% { opacity: 0; transform: translate(var(--fly-x), var(--fly-y)) scale(0.5); }
    }

    /* ── SESSION GOALS STRIP ── */
    .sg-goals-strip {
      margin-bottom: 12px;
    }
    .sg-goals-row {
      display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px;
    }
    .sg-goals-row::-webkit-scrollbar { display: none; }
    .sg-goal-card {
      flex-shrink: 0; width: 148px;
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 13px; padding: 11px 12px;
      display: flex; flex-direction: column; gap: 6px;
      transition: border-color 0.3s, background 0.3s;
      position: relative; overflow: hidden;
    }
    .sg-goal-card.complete {
      border-color: rgba(0,255,136,0.4); background: rgba(0,255,136,0.06);
    }
    .sg-goal-card.claimable {
      border-color: rgba(255,170,0,0.5); background: rgba(255,170,0,0.07);
      animation: goal-ready 1.4s ease infinite;
    }
    @keyframes goal-ready {
      0%,100% { box-shadow: 0 0 0 0 rgba(255,170,0,0); }
      50%      { box-shadow: 0 0 12px 2px rgba(255,170,0,0.25); }
    }
    .sg-goal-icon  { font-size: 20px; line-height: 1; }
    .sg-goal-name  { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.85); line-height: 1.3; }
    .sg-goal-prog  { font-size: 9px; color: rgba(255,255,255,0.35); letter-spacing: 0.06em; }
    .sg-goal-bar-track { height: 3px; background: rgba(255,255,255,0.08); border-radius: 2px; overflow: hidden; }
    .sg-goal-bar-fill  { height: 100%; border-radius: 2px; transition: width 0.5s ease; }
    .sg-goal-claim {
      background: linear-gradient(135deg,#ffaa00,#ff7700);
      border: none; border-radius: 7px; padding: 5px 10px;
      font-family: 'Orbitron', monospace; font-size: 8px; font-weight: 700;
      color: #06060f; cursor: pointer; letter-spacing: 0.08em;
      transition: transform 0.12s; width: 100%;
    }
    .sg-goal-claim:hover { transform: scale(1.04); }
    .sg-goal-done-badge {
      font-size: 9px; color: var(--green); letter-spacing: 0.1em; font-weight: 700; text-align: center;
    }

    /* ── SOCIAL PROOF on level cards ── */
    .sg-social-row {
      display: flex; gap: 10px; margin-top: 4px; flex-wrap: wrap;
    }
    .sg-social-chip {
      font-size: 9px; color: rgba(255,255,255,0.28); letter-spacing: 0.04em;
      display: flex; align-items: center; gap: 3px;
    }
    .sg-social-chip b { color: rgba(255,255,255,0.5); }
    .sg-social-chip.you b { color: var(--cyan); }

    /* ── STREAK PROTECTION UI ── */
    .sg-streak-shield { font-size: 12px; margin-left: 4px; vertical-align: middle; }
    .sg-streak-protected-badge {
      font-size: 8px; letter-spacing: 0.14em; color: #00ff88;
      margin-top: 2px; font-weight: 700;
    }
    .sg-streak-protect {
      display: flex; align-items: flex-start; gap: 10px;
      background: linear-gradient(135deg, rgba(255,45,149,0.1), rgba(255,170,0,0.06));
      border: 1px solid rgba(255,45,149,0.35);
      border-radius: 14px; padding: 14px; margin-bottom: 10px;
      animation: nw-border-pulse 1.2s ease infinite alternate;
    }
    .sg-protect-icon { font-size: 26px; flex-shrink: 0; margin-top: 2px; }
    .sg-protect-info { flex: 1; }
    .sg-protect-title { font-size: 13px; font-weight: 700; color: #ff2d95; margin-bottom: 3px; }
    .sg-protect-sub { font-size: 10px; color: rgba(255,255,255,0.38); line-height: 1.5; }
    .sg-protect-btns { display: flex; flex-direction: column; gap: 6px; flex-shrink: 0; }
    .sg-protect-ad {
      background: linear-gradient(135deg,#ff2d95,#ffaa00);
      border: none; border-radius: 9px; padding: 8px 12px;
      font-family: 'Orbitron', monospace; font-size: 8px; font-weight: 700;
      color: #06060f; cursor: pointer; letter-spacing: 0.08em; white-space: nowrap;
    }
    .sg-protect-coins {
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15);
      border-radius: 9px; padding: 7px 12px;
      font-family: 'Share Tech Mono', monospace; font-size: 9px;
      color: rgba(255,255,255,0.55); cursor: pointer; white-space: nowrap;
      transition: all 0.12s;
    }
    .sg-protect-coins:hover:not(:disabled) { background: rgba(255,255,255,0.12); color: #fff; }
    .sg-protect-coins:disabled { opacity: 0.28; cursor: default; }

    /* ── DAILY RANK CARD ── */
    .sg-daily-rank-card {
      border-radius: 18px; padding: 20px 16px; margin-bottom: 12px;
      text-align: center; position: relative; overflow: hidden;
    }
    .sg-daily-rank-badge {
      display: inline-block; border-radius: 8px; padding: 4px 12px;
      font-family: 'Orbitron', monospace; font-size: 9px; font-weight: 900;
      letter-spacing: 0.18em; margin-bottom: 10px;
    }
    .sg-perfect-badge {
      font-size: 10px; color: #ffaa00; letter-spacing: 0.12em;
      font-weight: 700; margin-bottom: 8px;
      text-shadow: 0 0 10px rgba(255,170,0,0.4);
    }
    .sg-daily-rank-pos {
      font-family: 'Orbitron', monospace; font-size: 48px; font-weight: 900;
      line-height: 1; margin-bottom: 4px;
      text-shadow: 0 0 24px currentColor;
    }
    .sg-daily-rank-lbl {
      font-size: 9px; letter-spacing: 0.16em; color: rgba(255,255,255,0.3);
      margin-bottom: 16px;
    }
    .sg-daily-score-row {
      display: flex; gap: 8px; margin-bottom: 16px; justify-content: center;
    }
    .sg-daily-score-chip {
      flex: 1; max-width: 100px;
      background: rgba(7,7,15,0.5); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px; padding: 10px 6px; text-align: center;
    }
    .sg-daily-score-val {
      font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 700;
      margin-bottom: 3px;
    }
    .sg-daily-score-lbl {
      font-size: 8px; letter-spacing: 0.12em; color: rgba(255,255,255,0.3);
    }
    .sg-share-btn {
      background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
      border-radius: 11px; padding: 11px 24px;
      font-family: 'Rajdhani', monospace; font-size: 12px; font-weight: 700;
      color: rgba(255,255,255,0.7); cursor: pointer; letter-spacing: 0.08em;
      transition: all 0.2s; width: 100%;
    }
    .sg-share-btn:hover { background: rgba(255,255,255,0.14); color: #fff; }
    .sg-share-btn.copied { background: rgba(0,255,136,0.15); border-color: rgba(0,255,136,0.4); color: #00ff88; }

    /* ── DAILY LEADERBOARD ── */
    .sg-daily-lb {
      background: rgba(13,13,26,0.9); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px; overflow: hidden; margin-bottom: 8px;
    }
    .sg-daily-lb-hdr {
      font-size: 9px; letter-spacing: 0.2em; color: rgba(255,255,255,0.25);
      padding: 12px 14px 8px; border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .sg-daily-lb-row {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 14px; border-bottom: 1px solid rgba(255,255,255,0.04);
      transition: background 0.15s;
    }
    .sg-daily-lb-row:last-child { border-bottom: none; }
    .sg-daily-lb-row.you-row { background: rgba(0,229,255,0.06); }
    .sg-daily-lb-rank { font-family:'Orbitron',monospace; font-size:11px; font-weight:700; min-width:26px; }
    .sg-daily-lb-name { flex:1; font-size:12px; font-weight:600; color:rgba(255,255,255,0.65); }
    .sg-daily-lb-score { font-family:'Share Tech Mono',monospace; font-size:11px; color:rgba(255,255,255,0.45); }
    .sg-daily-lb-moves { font-size:9px; color:rgba(255,255,255,0.22); margin-left:4px; }

    /* ── PILL BTN ── */
    .sg-pill {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12);
      border-radius: 9px; color: rgba(255,255,255,0.55); padding: 7px 13px;
      font-family: 'Rajdhani', sans-serif; font-size: 11px; font-weight: 700;
      cursor: pointer; transition: all 0.12s; letter-spacing: 0.06em;
    }
    .sg-pill:hover { background: rgba(255,255,255,0.1); color: #fff; }

    /* ── ADJACENT CORRUPTION PREVIEW ── */
    .sg-tile.adj-corrupt {
      box-shadow: 0 0 0 2px rgba(255,45,149,0.28) !important;
      animation: adj-pulse 1.5s ease infinite;
    }
    @keyframes adj-pulse {
      0%,100% { box-shadow: 0 0 0 1px rgba(255,45,149,0.15); }
      50%      { box-shadow: 0 0 0 2px rgba(255,45,149,0.5), 0 0 10px rgba(255,45,149,0.2); }
    }
    /* ── BUILDING ONLINE FLASH ── */
    @keyframes bldg-flash {
      0%   { transform:scale(1); }
      25%  { transform:scale(1.03); }
      50%  { transform:scale(0.99); }
      100% { transform:scale(1); }
    }
    .sg-bldg.online { animation: bldg-flash 0.55s ease; }
    /* ── LIVES ── */
    .sg-lives { display:flex; gap:2px; align-items:center; }
    .sg-heart { font-size:12px; transition: opacity 0.3s, filter 0.3s; line-height:1; }
    .sg-heart.empty { opacity:0.18; filter:grayscale(1) brightness(0.5); }
    /* ── BOSS BADGE ── */
    .sg-boss-badge { display:inline-block; background:linear-gradient(135deg,#ffaa00,#ff7700); color:#06060f; font-family:'Orbitron',monospace; font-size:7px; font-weight:900; letter-spacing:0.12em; padding:2px 5px; border-radius:4px; margin-left:5px; vertical-align:middle; }
    /* ── STARS ── */
    .sg-stars { font-size:10px; letter-spacing:0.05em; color:#ffaa00; }
    /* ── DISTRICT PROGRESS BAR ── */
    .dist-bar { height:3px; background:rgba(255,255,255,0.06); border-radius:2px; margin-bottom:8px; overflow:hidden; }
    .dist-bar-fill { height:100%; border-radius:2px; transition:width 0.5s ease; }

    /* ── XP BAR ── */
    .sg-xp-bar-wrap {
      width: 100%; max-width: 460px; padding: 0 16px 8px;
      flex-shrink: 0; position: relative; z-index: 10;
    }
    .sg-xp-row {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 4px;
    }
    .sg-xp-lbl {
      font-family: 'Share Tech Mono', monospace; font-size: 10px;
      color: rgba(255,255,255,0.4); letter-spacing: 0.1em;
    }
    .sg-xp-track {
      height: 4px; background: rgba(255,255,255,0.07);
      border-radius: 2px; overflow: hidden;
    }
    .sg-xp-fill {
      height: 100%; border-radius: 2px;
      background: linear-gradient(90deg, #a855f7, #00e5ff);
      box-shadow: 0 0 6px rgba(168,85,247,0.5);
      transition: width 0.6s ease;
    }
    .sg-xp-levelup {
      animation: xp-flash 0.5s ease;
    }
    @keyframes xp-flash {
      0%   { transform: scale(1); }
      40%  { transform: scale(1.06); box-shadow: 0 0 20px rgba(168,85,247,0.7); }
      100% { transform: scale(1); }
    }

    /* ── STREAK ── */
    .sg-streak-banner {
      background: linear-gradient(90deg, rgba(255,170,0,0.12), rgba(255,120,0,0.08));
      border: 1px solid rgba(255,170,0,0.25); border-radius: 14px;
      padding: 12px 14px; margin-bottom: 10px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .sg-streak-fire { font-size: 28px; }
    .sg-streak-val {
      font-family: 'Orbitron', monospace; font-size: 26px; font-weight: 900;
      color: #ffaa00; text-shadow: 0 0 14px rgba(255,170,0,0.5);
    }
    .sg-streak-lbl { font-size: 9px; color: rgba(255,255,255,0.3); letter-spacing: 0.12em; margin-top: 1px; }
    .sg-streak-days { display: flex; gap: 4px; }
    .sg-streak-day {
      width: 28px; height: 28px; border-radius: 8px; border: 1px solid;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; transition: all 0.3s;
    }
    .sg-streak-day.done {
      background: rgba(255,170,0,0.2); border-color: #ffaa00;
      box-shadow: 0 0 8px rgba(255,170,0,0.3);
    }
    .sg-streak-day.today {
      background: rgba(255,170,0,0.35); border-color: #ffaa00;
      animation: today-pulse 1.2s ease infinite;
    }
    .sg-streak-day.pending {
      background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08);
    }
    @keyframes today-pulse {
      0%,100% { box-shadow: 0 0 6px rgba(255,170,0,0.3); }
      50%      { box-shadow: 0 0 14px rgba(255,170,0,0.6); }
    }

    /* ── REWARD CALENDAR ── */
    .sg-calendar {
      display: grid; grid-template-columns: repeat(7,1fr); gap: 5px;
      margin-bottom: 8px;
    }
    .sg-cal-day {
      border: 1px solid; border-radius: 10px; padding: 8px 4px;
      text-align: center; transition: all 0.3s;
    }
    .sg-cal-day.claimed  { background: rgba(0,255,136,0.1);  border-color: rgba(0,255,136,0.4); }
    .sg-cal-day.today    { background: rgba(255,170,0,0.12); border-color: rgba(255,170,0,0.5); animation: today-pulse 1.2s ease infinite; }
    .sg-cal-day.future   { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.06); }
    .sg-cal-day .day-num { font-size: 8px; color: rgba(255,255,255,0.3); margin-bottom: 4px; }
    .sg-cal-day .day-ico { font-size: 16px; }
    .sg-cal-day .day-val { font-size: 8px; color: rgba(255,255,255,0.4); margin-top: 2px; }
    .sg-cal-day.milestone { border-color: rgba(255,170,0,0.5); background: rgba(255,170,0,0.06); }
    .sg-cal-day.milestone .day-ico { filter: drop-shadow(0 0 4px #ffaa00); }

    /* ── DAILY CHALLENGES ── */
    .sg-challenge-card {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 13px; padding: 11px 13px; margin-bottom: 7px;
      display: flex; align-items: center; gap: 11px;
      transition: all 0.3s;
    }
    .sg-challenge-card.complete {
      border-color: rgba(0,255,136,0.35); background: rgba(0,255,136,0.05);
    }
    .sg-challenge-icon { font-size: 22px; flex-shrink: 0; }
    .sg-challenge-info { flex: 1; }
    .sg-challenge-name { font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 3px; }
    .sg-challenge-prog { font-size: 10px; color: rgba(255,255,255,0.35); margin-bottom: 5px; }
    .sg-challenge-bar-track { height: 4px; background: rgba(255,255,255,0.07); border-radius: 2px; overflow: hidden; }
    .sg-challenge-bar-fill  { height: 100%; border-radius: 2px; transition: width 0.5s ease; }
    .sg-challenge-check { font-size: 20px; flex-shrink: 0; }
    .sg-chest-card {
      background: linear-gradient(135deg, rgba(255,170,0,0.12), rgba(255,100,0,0.06));
      border: 1px solid rgba(255,170,0,0.3); border-radius: 16px;
      padding: 18px; text-align: center; margin-bottom: 10px;
      position: relative; overflow: hidden;
    }
    .sg-chest-card.unlocked {
      border-color: rgba(0,255,136,0.5); background: linear-gradient(135deg, rgba(0,255,136,0.1), rgba(0,229,255,0.06));
      animation: chest-glow 1.5s ease infinite;
    }
    @keyframes chest-glow {
      0%,100% { box-shadow: 0 0 12px rgba(0,255,136,0.2); }
      50%      { box-shadow: 0 0 24px rgba(0,255,136,0.4); }
    }
    .sg-chest-icon { font-size: 44px; margin-bottom: 6px; display: block; }
    .sg-chest-title { font-family: 'Orbitron', monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 4px; }
    .sg-chest-sub { font-size: 11px; color: rgba(255,255,255,0.35); }

    /* ── CITY OVERVIEW ── */
    .sg-city-overview {
      border-radius: 16px; overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
      margin-bottom: 12px; position: relative;
      background: rgba(13,13,26,0.9);
      min-height: 180px;
    }
    .sg-city-skyline {
      display: flex; align-items: flex-end; justify-content: center;
      gap: 6px; padding: 16px 12px 0; height: 140px;
    }
    .sg-city-building {
      border-radius: 4px 4px 0 0; transition: all 0.6s ease;
      position: relative; overflow: hidden;
      display: flex; flex-direction: column; justify-content: flex-start;
      align-items: center; padding-top: 6px;
    }
    .sg-city-building::after {
      content: ''; position: absolute; inset: 0;
      background: repeating-linear-gradient(0deg, transparent, transparent 8px, rgba(255,255,255,0.04) 8px, rgba(255,255,255,0.04) 9px);
    }
    .sg-city-building.lit .window {
      animation: window-flicker 3s ease infinite;
    }
    @keyframes window-flicker {
      0%,95%,100% { opacity: 1; }
      96%          { opacity: 0.3; }
    }
    .sg-building-windows {
      display: grid; gap: 2px; position: relative; z-index: 2;
    }
    .sg-window {
      width: 6px; height: 4px; border-radius: 1px;
      transition: background 0.8s ease, box-shadow 0.8s;
    }
    .sg-city-label {
      text-align: center; padding: 8px 0 10px;
      font-size: 9px; letter-spacing: 0.14em;
      color: rgba(255,255,255,0.3);
    }
    .sg-city-stats {
      display: flex; gap: 8px; padding: 0 12px 12px;
    }
    .sg-city-stat {
      flex: 1; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px; padding: 8px; text-align: center;
    }
    .sg-city-stat-val { font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 700; }
    .sg-city-stat-lbl { font-size: 8px; color: rgba(255,255,255,0.28); letter-spacing: 0.1em; margin-top: 2px; }

    /* ── WEEKLY EVENT ── */
    .sg-event-hero {
      border-radius: 18px; padding: 0; margin-bottom: 12px;
      overflow: hidden; position: relative; border: 1px solid;
    }
    .sg-event-banner {
      padding: 20px 18px 16px; text-align: center; position: relative; z-index: 2;
