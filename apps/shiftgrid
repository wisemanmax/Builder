}

/* ─── TROPHY ROAD ────────────────────────────────────────────────── */
function TrophyRoad(props) {
  var meta = props.meta, setMeta = props.setMeta, setLives = props.setLives;
  var cleared = (meta.levelsCleared||[]).length;
  var trophyClaimed = meta.trophyClaimed || [];
  var maxMilestone = TROPHY_MILESTONES[TROPHY_MILESTONES.length-1].levels;
  var fillPct = Math.min(100, (cleared / maxMilestone) * 100);

  function claimTrophy(m) {
    if (trophyClaimed.includes(m.levels)) return;
    var newClaimed = trophyClaimed.concat([m.levels]);
    var newChests = Object.assign({}, meta.chests||{});
    if (m.reward.chest) newChests[m.reward.chest] = (newChests[m.reward.chest]||0) + 1;
    setMeta(function(prev) {
      var n = Object.assign({}, prev, {
        coins: prev.coins + m.reward.coins,
        parts: prev.parts + m.reward.parts,
        chests: newChests,
        trophyClaimed: newClaimed,
      });
      saveMeta(n); return n;
    });
    Audio.win();
  }

  return (
    <div className="sg-trophy-road">
      <div className="sg-trophy-track">
        <div className="sg-trophy-track-fill" style={{width:fillPct+"%"}}/>
      </div>
      <div className="sg-trophy-nodes">
        {TROPHY_MILESTONES.map(function(m) {
          var done   = cleared >= m.levels;
          var claimed= trophyClaimed.includes(m.levels);
          var canClaim = done && !claimed;
          return (
            <div key={m.levels} className="sg-trophy-node">
              <div className={"sg-trophy-gem"+(claimed?" unlocked":(canClaim?" claimable":""))}
                style={{
                  borderColor: claimed?"#ffaa00":(canClaim?"#ffaa00":"rgba(255,255,255,0.1)"),
                  background:  claimed?"rgba(255,170,0,0.18)":(canClaim?"rgba(255,170,0,0.12)":"rgba(255,255,255,0.03)"),
                  color:       canClaim?"#ffaa00":"rgba(255,255,255,0.3)",
                  cursor:      canClaim?"pointer":"default",
                }}
                onClick={function(){ if(canClaim) claimTrophy(m); }}>
                {claimed ? "✓" : m.icon}
              </div>
              <div className={"sg-trophy-label"+(claimed?" done":"")}>
                {m.label}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

