/* ─── ROOT APP ──────────────────────────────────────────────────── */
function Shiftgrid() {
  var _m=React.useState(loadMeta); var meta=_m[0]; var setMeta=_m[1];
  var _t=React.useState("campaign"); var tab=_t[0]; var setTab=_t[1];
  var _p=React.useState(null); var playing=_p[0]; var setPlaying=_p[1];
  var _l=React.useState(loadLives); var lives=_l[0]; var setLives=_l[1];
  var _st=React.useState(false); var showTuto=_st[0]; var setShowTuto=_st[1];
  var _ts=React.useState(0); var tutoStep=_ts[0]; var setTutoStep=_ts[1];
  var _pl=React.useState(null); var pendingLevel=_pl[0]; var setPendingLevel=_pl[1];
  var _sp=React.useState(false); var showStarterPack=_sp[0]; var setShowStarterPack=_sp[1];
  var _lg=React.useState(false); var livesGate=_lg[0]; var setLivesGate=_lg[1];
  var _xp=React.useState(loadXP); var xpData=_xp[0]; var setXpData=_xp[1];
  var _sk=React.useState(function(){ return checkAndUpdateStreak(loadStreak()); });
  var streak=_sk[0]; var setStreak=_sk[1];
  var _cd=React.useState(function(){ return loadChallenges()||initChallenges(); });
  var challengeData=_cd[0]; var setChallengeData=_cd[1];
  var _su=React.useState(false); var showXPUp=_su[0]; var setShowXPUp=_su[1];
  var _sg=React.useState(loadSessionGoals); var sessionGoals=_sg[0]; var setSessionGoals=_sg[1];

  React.useEffect(function(){
    var t=setInterval(function(){ setLives(loadLives()); },30000);
    return function(){ clearInterval(t); };
  },[]);

  function handlePlay(levelDef,cb){
    if(levelDef.isDaily||levelDef.id&&levelDef.id.toString().startsWith("event")){
      setPlaying({levelDef:levelDef,cb:cb||function(){}}); return;
    }
    var fresh=loadLives();
    if(fresh.count<=0){ setLivesGate(true); setPendingLevel({levelDef:levelDef,cb:cb}); return; }
    if(!isTutoDone()&&levelDef.id===0){
      setPendingLevel({levelDef:levelDef,cb:cb||function(){}});
      setShowTuto(true); setTutoStep(0); return;
    }
    setPlaying({levelDef:levelDef,cb:cb||function(){}});
  }

  function startPending(){ if(pendingLevel){ setPlaying(pendingLevel); setPendingLevel(null); } }
  function handleTutoNext(){ Audio.tap(); if(tutoStep>=2){ markTutoDone(); setShowTuto(false); startPending(); } else setTutoStep(tutoStep+1); }
  function handleTutoSkip(){ markTutoDone(); setShowTuto(false); startPending(); }

  function handleComplete(rewards){
    var lvl=playing.levelDef;
    if(playing.cb) playing.cb(rewards);
    var movesUsed=lvl.moves-(rewards.movesLeft||0);
    var stars=calcStars(movesUsed,lvl.moves);

    /* XP */
    var gained=calcXP(rewards.score||0, stars, lvl.boss);
    var newXP=addXP(xpData, gained);
    var leveledUp=newXP.level>xpData.level;
    saveXP(newXP); setXpData(newXP);
    if(leveledUp){ setShowXPUp(true); setTimeout(function(){ setShowXPUp(false); },2500); }

    /* Streak */
    var newStreak=checkAndUpdateStreak(streak);
    setStreak(newStreak);

    /* Challenges */
    if(challengeData){
      var today=todayStr();
      var seed=parseInt(today.replace(/-/g,""));
      var defs=getDailyChallenges(seed);
      var updated=challengeData.challenges.map(function(c,i){
        var def=defs[i]; if(c.done) return c;
        var prog=c.progress;
        if(def.type==="complete") prog=Math.min(def.goal,prog+1);
        if(def.type==="stars3"&&stars===3) prog=Math.min(def.goal,prog+1);
        if(def.type==="session") prog=Math.min(def.goal,prog+1);
        return Object.assign({},c,{progress:prog,done:prog>=def.goal});
      });
      var newCD=Object.assign({},challengeData,{challenges:updated});
      saveChallenges(newCD); setChallengeData(newCD);
    }

    /* Meta */
    setMeta(function(m){
      var cleared=Array.from(new Set((m.levelsCleared||[]).concat([lvl.id])));
      var newStars=Object.assign({},m.stars||{});
      if((newStars[lvl.id]||0)<stars) newStars[lvl.id]=stars;
      var n=Object.assign({},m,{coins:m.coins+(rewards.coins||0),parts:m.parts+(rewards.parts||0),levelsCleared:cleared,stars:newStars});
      saveMeta(n); return n;
    });

    /* Session Goals */
    setSessionGoals(function(sg) {
      if (!sg) return sg;
      var defs = getSessionGoalDefs(sg.pickedIds);
      var wasNearWin = rewards.wasNearWin || false;
      var newGoals = sg.goals.map(function(g, i) {
        var def = defs[i]; if (!def || g.claimed) return g;
        if (g.progress >= def.goal) return g;
        var prog = g.progress;
        if (def.type === "win")       prog = Math.min(def.goal, prog + 1);
        if (def.type === "stars3" && stars === 3) prog = Math.min(def.goal, prog + 1);
        if (def.type === "battery" && (rewards.batteries||0) > 0)  prog = Math.min(def.goal, prog + (rewards.batteries||0));
        if (def.type === "pulse"   && (rewards.pulses||0) > 0)     prog = Math.min(def.goal, prog + 1);
        if (def.type === "cascade4" && (rewards.maxCascade||0)>=4) prog = Math.min(def.goal, prog + 1);
        if (def.type === "corrupt"  && (rewards.corruptCleared||0)>0) prog = Math.min(def.goal, prog + (rewards.corruptCleared||0));
        if (def.type === "clean_win" && !wasNearWin) prog = Math.min(def.goal, prog + 1);
        if (def.type === "streak2") prog = Math.min(def.goal, prog + 1);
        return Object.assign({}, g, {progress: prog});
      });
      var updated = Object.assign({}, sg, {goals: newGoals});
      saveSessionGoals(updated);
      return updated;
    });
    setPlaying(null);
    if(lvl.id>=4&&!meta.starterPackShown&&Math.random()<0.25){
      setMeta(function(m){ var n=Object.assign({},m,{starterPackShown:true}); saveMeta(n); return n; });
      setTimeout(function(){ setShowStarterPack(true); },700);
    }
  }

  function handleLose(){
    var fresh=loadLives();
    var updated={count:Math.max(0,fresh.count-1),lastRegen:fresh.count===MAX_LIVES?Date.now():fresh.lastRegen};
    saveLives(updated); setLives(updated);
  }

  function watchAdForLife(){
    var fresh=loadLives();
    var updated={count:Math.min(MAX_LIVES,fresh.count+1),lastRegen:fresh.lastRegen};
    saveLives(updated); setLives(updated); setLivesGate(false);
    if(pendingLevel){ setPlaying(pendingLevel); setPendingLevel(null); }
  }

  var TABS=[
    {id:"campaign",  icon:"🗺", label:"PLAY"},
    {id:"challenges",icon:"🎯", label:"QUESTS"},
    {id:"event",     icon:"⚡", label:"EVENT"},
    {id:"city",      icon:"🌆", label:"CITY"},
    {id:"editor",    icon:"🛠", label:"BUILD"},
  ];

  if(playing){
    return (
      <div className="sg-app">
        <Particles/>
        {showTuto&&<TutorialOverlay step={tutoStep} onNext={handleTutoNext} onSkip={handleTutoSkip}/>}
        <GameBoard levelDef={playing.levelDef} meta={meta} lives={lives}
          onComplete={handleComplete} onLose={handleLose}
          onBack={function(){ setPlaying(null); }}/>
      </div>
    );
  }

  var allChallengesDone = challengeData && challengeData.challenges.every(function(c){ return c.done; });
  var chestUnclaimed = allChallengesDone && !challengeData.chestClaimed;
  var streakAtRisk = (function(){
    var d = new Date(), prev = new Date(d); prev.setDate(prev.getDate()-1);
    var prevStr = prev.getFullYear()+"-"+String(prev.getMonth()+1).padStart(2,"0")+"-"+String(prev.getDate()).padStart(2,"0");
    return streak.count >= 2 && streak.lastDay !== todayStr() && streak.lastDay !== prevStr && !isStreakProtected(streak);
  })();
  var hasClaimableGoal = sessionGoals && sessionGoals.goals && getSessionGoalDefs(sessionGoals.pickedIds).some(function(def, i) {
    var g = sessionGoals.goals[i];
    return def && g && !g.claimed && g.progress >= def.goal;
  });

  return (
    <div className="sg-app">
      <Particles/>
      {showTuto&&<TutorialOverlay step={tutoStep} onNext={handleTutoNext} onSkip={handleTutoSkip}/>}
      {livesGate&&<LivesGate lives={lives} onBack={function(){ setLivesGate(false); setPendingLevel(null); }} onWatchAd={watchAdForLife}/>}
      {showStarterPack&&<StarterPack onClose={function(){ setShowStarterPack(false); }} onBuy={function(){ setShowStarterPack(false); }}/>}

      {/* XP Level Up toast */}
      {showXPUp&&(
        <div style={{position:"fixed",top:80,left:"50%",transform:"translateX(-50%)",zIndex:800,background:"linear-gradient(135deg,#a855f7,#00e5ff)",borderRadius:12,padding:"10px 20px",fontFamily:"'Orbitron',monospace",fontSize:11,fontWeight:700,color:"#fff",letterSpacing:"0.1em",boxShadow:"0 0 24px rgba(168,85,247,0.5)",animation:"toast-in 0.3s ease",whiteSpace:"nowrap"}}>
          ⬆ LEVEL UP! LVL {xpData.level}
        </div>
      )}

      <div className="sg-header">
        <div className="sg-logo">SHIFTGRID</div>
        <div style={{display:"flex",gap:8,alignItems:"center"}}>
          <div className="sg-lives">
            {[0,1,2,3,4].map(function(i){ return <span key={i} className={"sg-heart"+(i<lives.count?"":" empty")}>❤️</span>; })}
          </div>
          <div className="sg-coin">
            <div className="sg-coin-dot" style={{background:"#ffaa00",boxShadow:"0 0 5px #ffaa00"}}></div>
            <span style={{fontFamily:"'Share Tech Mono',monospace",fontSize:12,color:"rgba(255,255,255,0.6)"}}>{meta.coins}</span>
          </div>
          <div style={{fontFamily:"'Share Tech Mono',monospace",fontSize:10,color:"rgba(168,85,247,0.8)",letterSpacing:"0.06em"}}>{"LV"+xpData.level}</div>
        </div>
      </div>
      <XPBar xpData={xpData}/>
      <div className="sg-content">
        {tab==="campaign"   &&<CampaignTab meta={meta} onPlay={handlePlay} setMeta={setMeta} sessionGoals={sessionGoals} setSessionGoals={setSessionGoals}/>}
        {tab==="challenges" &&<ChallengesTab meta={meta} setMeta={setMeta} challengeData={challengeData} setChallengeData={setChallengeData} streak={streak} onStreakUpdate={setStreak} onPlay={handlePlay}/>}
        {tab==="event"      &&<WeeklyTab meta={meta} setMeta={setMeta} onPlay={handlePlay}/>}
        {tab==="city"       &&<CityTab meta={meta} setMeta={setMeta} xpData={xpData}/>}
        {tab==="editor"     &&<EditorTab meta={meta} setMeta={setMeta} onPlay={handlePlay}/>}
      </div>
      <nav className="sg-nav">
        {TABS.map(function(t){
          var hasDot = (t.id==="campaign"&&hasClaimableGoal) || (t.id==="challenges"&&(chestUnclaimed||streakAtRisk)) || (t.id==="event"&&true);
          var dotColor = t.id==="challenges"&&streakAtRisk ? "#ff2d95" : t.id==="challenges"&&chestUnclaimed ? "#00ff88" : "#ffaa00";
          return (
            <button key={t.id} className={"sg-nav-btn"+(tab===t.id?" active":"")} onClick={function(){ Audio.tap(); setTab(t.id); }} style={{position:"relative"}}>
              <span className="nav-icon">{t.icon}</span>
              <span>{t.label}</span>
              {hasDot&&tab!==t.id&&<div style={{position:"absolute",top:5,right:"50%",marginRight:-16,width:7,height:7,borderRadius:"50%",background:t.id==="challenges"?"#00ff88":"#ffaa00",boxShadow:"0 0 6px currentColor"}}/>}
            </button>
          );
        })}
      </nav>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<Shiftgrid/>);
</script>
</body>
</html>
