          {/* Aurora glow for completed districts */}
          {cleared>=10&&<div style={{position:"absolute",bottom:0,left:"5%",width:"30%",height:"80px",background:"radial-gradient(ellipse,rgba(0,229,255,0.08) 0%,transparent 70%)",pointerEvents:"none"}}/>}
          {cleared>=30&&<div style={{position:"absolute",bottom:0,left:"40%",width:"30%",height:"80px",background:"radial-gradient(ellipse,rgba(255,45,149,0.07) 0%,transparent 70%)",pointerEvents:"none"}}/>}
          {cleared>=50&&<div style={{position:"absolute",bottom:0,left:"70%",width:"30%",height:"80px",background:"radial-gradient(ellipse,rgba(0,255,136,0.1) 0%,transparent 70%)",pointerEvents:"none"}}/>}
        </div>

        {/* District buildings */}
        {DIST_CONFIGS.map(function(dc,di){
          var state=distStates[di];
          return (
            <div key={di} style={{position:"absolute",bottom:18,left:dc.x,display:"flex",gap:4,alignItems:"flex-end"}}>
