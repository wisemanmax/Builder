/* ─── STREAK PROTECTION ─────────────────────────────────────────── */
const PROTECT_COST = 30;

function isStreakProtected(streak) {
  return streak.protectedUntil && Date.now() < streak.protectedUntil;
}

function applyStreakProtection(streak) {
  var tomorrow = new Date();
  tomorrow.setDate(tomorrow.getDate() + 1);
  tomorrow.setHours(4, 0, 0, 0);
  var updated = Object.assign({}, streak, { protectedUntil: tomorrow.getTime() });
  saveStreak(updated);
  return updated;
}

function checkAndUpdateStreak(st) {
  var today = todayStr();
  if (st.lastDay === today) return st;
  var d = new Date(), prev = new Date(d); prev.setDate(prev.getDate()-1);
  var prevStr = prev.getFullYear() + "-" + String(prev.getMonth()+1).padStart(2,"0") + "-" + String(prev.getDate()).padStart(2,"0");
  var consecutive = st.lastDay === prevStr;
  /* If not consecutive but protected, preserve streak and consume protection */
  if (!consecutive && isStreakProtected(st)) {
    var protStreak = Object.assign({}, st, { lastDay: today, protectedUntil: null });
    saveStreak(protStreak);
    return protStreak;
  }
  var newCount = consecutive ? st.count + 1 : 1;
  var newSt = { count: newCount, lastDay: today, claimed: st.claimed || [], protectedUntil: st.protectedUntil || null };
  saveStreak(newSt);
  return newSt;
}
function getStreakReward(day) {
  if (day === 7)  return { icon: "🎨", label: "Skin Unlock",  coins: 150, parts: 10, special: "skin",  abilities: null };
  if (day === 14) return { icon: "⚡", label: "Ability Pack", coins: 50,  parts: 5,  special: "boost", abilities: {surge:2,cleanse:1,wildfire:1} };
  if (day === 30) return { icon: "👑", label: "Legend Drop",  coins: 500, parts: 20, special: "title", abilities: {surge:3,cleanse:2,wildfire:2,freeze:3} };
  if (day % 7 === 0) return { icon: "💎", label: "Gem Pack",  coins: 100, parts: 8,  special: null, abilities: null };
  return { icon: "⬡",  label: "Coins", coins: 10 + day * 3, parts: day, special: null, abilities: null };
}


