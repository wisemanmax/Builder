/* ─── DAILY CHALLENGE SCORING ───────────────────────────────────── */
const DAILY_NAMES = [
  "GridKing","NeonRider","VoltMaster","ByteHunter","CipherX",
  "StackZero","PulseCore","DarkNode","ChainLink","StaticWave",
  "LoopBreak","HexDrift","ArcLight","VoidPulse","NullShift",
  "CoreSlam","WireGhost","BitFlux","CellRush","OhmBreaker"
];

function calcDailyScore(rawScore, movesLeft, totalMoves, stars) {
  /* Formula: raw score + moves efficiency bonus + star bonus */
  var effBonus = Math.floor((movesLeft / totalMoves) * 500);
  var starBonus = stars * 200;
  return rawScore + effBonus + starBonus;
}

function genDailyLeaderboard(seed, playerScore) {
  var rng = mkSeededRng(seed + 9999);
  var entries = [];
  /* Generate 19 fake players with scores spread around player score */
  for (var i = 0; i < 19; i++) {
    var name = DAILY_NAMES[i % DAILY_NAMES.length];
    /* Score range: 400 – 3200, normally distributed around 1400 */
    var s = Math.max(400, Math.round(1400 + (rng() - 0.5) * 2800));
    var moves = Math.floor(rng() * 12) + 3;
    entries.push({ name: name, score: s, moves: moves, you: false });
  }
  /* Insert player */
  entries.push({ name: "You", score: playerScore, moves: 0, you: true });
  /* Sort descending */
  entries.sort(function(a,b){ return b.score - a.score; });
  return entries;
}

function getDailyRank(lb) {
  for (var i = 0; i < lb.length; i++) {
    if (lb[i].you) return i + 1;
  }
  return lb.length;
}

function getDailyTier(rank, total) {
  var pct = rank / total;
  if (pct <= 0.10) return { label:"TOP 10%", color:"#ffaa00", bg:"rgba(255,170,0,0.12)", border:"rgba(255,170,0,0.4)" };
  if (pct <= 0.50) return { label:"TOP 50%", color:"#00e5ff", bg:"rgba(0,229,255,0.08)", border:"rgba(0,229,255,0.3)" };
  return { label:"PARTICIPANT", color:"rgba(255,255,255,0.5)", bg:"rgba(255,255,255,0.04)", border:"rgba(255,255,255,0.12)" };
}

function getDailyTierReward(tier) {
  if (tier.label === "TOP 10%")     return { coins: 80, parts: 5 };
  if (tier.label === "TOP 50%")     return { coins: 40, parts: 2 };
  return { coins: 20, parts: 1 };
}


