/* ─── GAME BOARD ────────────────────────────────────────────────── */
function GameBoard(props) {
  const levelDef=props.levelDef, meta=props.meta, onComplete=props.onComplete, onBack=props.onBack, onLose=props.onLose||function(){};
  const upg=(meta&&meta.upgrades)?meta.upgrades:DEF_META.upgrades;
  const capBonus=(upg.capReduce||0)*2, hazardSlow=upg.hazardSlow||0;
  const comboAmp=1+(upg.comboBoost||0)*0.3, freeChance=(upg.extraMoves||0)*0.15;
  const spreadEvery=3+hazardSlow;

  const activeSkin   = React.useMemo(function(){ return loadSkin(); },[]);
  /* Preloaded boosters from pre-level screen — merge into ability state on mount */
  const initialAbilities = React.useMemo(function(){
    var base=loadAbilities();
    var preload=props.preloadedAbilities||[];
    /* Boosters already deducted in handlePreLaunch — add +1 charge in-game for each preloaded */
    if(preload.length > 0){
      var boosted = Object.assign({}, base);
      preload.forEach(function(id){ boosted[id] = (boosted[id]||0) + 1; });
      return boosted;
    }
    return base;
  },[]);
  const colorblind   = React.useMemo(function(){ return loadSettings().colorblind||false; },[]);
  const skinColors  = React.useMemo(function(){
    var s=SKIN_DEFS.find(function(s){ return s.id===activeSkin; });
    return s ? s.colors : SKIN_DEFS[0].colors;
  },[activeSkin]);

  const buildInitGrid=useCallback(function(){
    if(levelDef.boardData) return levelDef.boardData.map(function(row){ return row.map(function(t){ return Object.assign({},t,{id:nextId()}); }); });
    const rng=levelDef.rngSeed?mkSeededRng(levelDef.rngSeed):null;
    var g=makeGrid(rng);
    if((levelDef.hazards||0)>0) g=addCorruption(g,levelDef.hazards,rng,(levelDef.id||0)>=30);
    /* Inject special node types starting district 2 (level 10+) */
    if((levelDef.id||0)>=10) g=injectSpecialNodes(g,levelDef.id,rng);
    if((levelDef.blockers||0)>0) g=injectBlockers(g,levelDef.id,levelDef.blockers,rng);
    return g;
  },[levelDef]);

  const [grid,setGrid]=useState(buildInitGrid);
  const [moves,setMoves]=useState(levelDef.moves);
  const [bldgs,setBldgs]=useState(function(){
    return BLDG_DEFS.filter(function(b){ return levelDef.bids.includes(b.id); }).map(function(b){
      return Object.assign({},b,{max:Math.max(4,b.cap-capBonus),ch:0,on:false});
    });
  });
  const [score,setScore]=useState(0);
  const [hi,setHi]=useState(new Set());
  const [phase,setPhase]=useState("idle");
  const [toasts,setToasts]=useState([]);
  const [slideAnim,setSlideAnim]=useState(null);
  const [moveCount,setMoveCount]=useState(0);
  const lastChanceRef=useRef(false);
  const [nearWinData,setNearWinData]=useState(null);
  const [chargedBldgs,setChargedBldgs]=useState(new Set()); /* buildings that just received charge */
  const [abilities,setAbilities]=useState(function(){ return loadAbilities(); });
  const [surgeActive,setSurgeActive]=useState(false);      /* next match charges all */
  const [freezeActive,setFreezeActive]=useState(0);        /* moves remaining frozen */
  const [wildfireActive,setWildfireActive]=useState(false); /* next shift = full row/col match */
  const [hintTile,setHintTile]=useState(null);             /* {row,col} highlight for detector */
  /* abilityFlash removed — replaced by cinematic system */
  const [usedAbilities,setUsedAbilities]=useState(new Set()); /* track single-use per level */
  /* ── PHASE 2: OBJECTIVE + COMBO ── */
  const objectiveType = React.useMemo(function(){ return getLevelObjective(levelDef); },[levelDef]);
  const [timeLeft,setTimeLeft]  = useState(function(){ return objectiveType==="timed"?getTimerSeconds(levelDef):0; });
  const [timerRunning,setTimerRunning] = useState(false);
  const timerRef = useRef(null);
  const collectTarget = React.useMemo(function(){ return objectiveType==="collect"?getCollectTarget(levelDef):0; },[levelDef,objectiveType]);
  const [collectTiles,setCollectTiles] = useState(function(){
    /* Randomly mark N tiles as collect targets on init */
    if(objectiveType!=="collect") return new Set();
    /* Use seeded RNG so same level always starts same collect positions */
    var rng=mkSeededRng((levelDef.id||0)*999+collectTarget*77);
    var targets=new Set(), tries=0;
    while(targets.size<collectTarget&&tries<50){ tries++; targets.add(Math.floor(rng()*ROWS)+","+(Math.floor(rng()*COLS))); }
    return targets;
  });
  const [collectDone,setCollectDone] = useState(0);
  const [comboPower,setComboPower]   = useState(0);
  const [rankUpText,setRankUpText]   = useState(null);
  const prevRankRef = useRef(COMBO_RANKS[0].name);
  const minMovesPar = React.useMemo(function(){ return objectiveType==="minmoves"?getMinMovesPar(levelDef):0; },[levelDef,objectiveType]);
  const [containBreach,setContainBreach] = useState(false);
  /* ── STORY STATE ── */
  const [storyBeat,setStoryBeat]         = useState(null);  /* {char,name,color,icon,role,line} shown in HUD */
  const [ariaTransmission,setAriaTx]     = useState(null);  /* ARIA broadcast mid-play */
  const storyShownRef                    = useRef({});       /* track what's already shown */
  const levelId = typeof levelDef.id === "number" ? levelDef.id : -1;
  const [abilityAnim,setAbilityAnim]=useState(null); /* {id,icon,name,effect,color,bg,glow,border} */
  const [movesBump,setMovesBump]=useState(false); /* bounce anim on +3 moves */
  const [cleansingTiles,setCleansingTiles]=useState(new Set()); /* set of "r,c" being cleansed */
  const sessionStatsRef=useRef({batteries:0,pulses:0,maxCascade:0,corruptCleared:0,consecutiveWins:0});
  const moveHistoryRef=useRef([]); /* Grid Memory — record every shift */
  const [showGhostReplay,setShowGhostReplay]=useState(false);
  const [shiftNudge,setShiftNudge]=useState(null); /* {dir} for screen nudge */
  const [cascadeFlash,setCascadeFlash]=useState(false); /* big cascade screen flash */
  const [wrapChain,setWrapChain]=useState(false); /* wrap-chain bonus flag */
  const [perfectClear,setPerfectClear]=useState(false);
  const timers=useRef([]);
  const gridRef=useRef(null);
  const touchRef=useRef({startX:0,startY:0,startRow:-1,startCol:-1,moved:false});
  const SZ=44,GAP=3;

  useEffect(function(){ return function(){ timers.current.forEach(clearTimeout); }; },[]);

  /* ── TIMED OBJECTIVE: countdown ── */
  useEffect(function(){
    if(objectiveType!=="timed") return;
    if(phase==="win"||phase==="lose"||phase==="nearwin") return;
    if(timeLeft<=0){ setPhase("lose"); Haptics.lose(); bumpStats({totalLosses:1}); setTimeout(Audio.lose.bind(Audio),100); setTimeout(onLose,300); return; }
    var t=setTimeout(function(){ setTimeLeft(function(s){ return s-1; }); },1000);
    return function(){ clearTimeout(t); };
  },[timeLeft,phase,objectiveType]);

  /* ── COMBO POWER: decay when not playing ── */
  useEffect(function(){
    if(phase!=="idle" || comboPower<=0) return;
    var t=setTimeout(function(){
      setComboPower(function(p){ return p>0?Math.max(0,p-1):0; });
    },2000);
    return function(){ clearTimeout(t); };
  },[comboPower,phase]);

  function later(fn,ms){ const t=setTimeout(fn,ms); timers.current.push(t); }
  function addToast(text,color){
    const id=nextId();
    setToasts(function(prev){ return prev.filter(function(x){ return x.text!==text; }).concat([{id:id,text:text,color:color||"#ffaa00"}]); });
    setTimeout(function(){ setToasts(function(prev){ return prev.filter(function(x){ return x.id!==id; }); }); },2200);
  }

  const handleShift=useCallback(function(type,idx,dir){
    if(phase!=="idle") return;
    timers.current.forEach(clearTimeout); timers.current=[];

    /* Read wildfire state NOW (top of function, not inside later()) */
    var wasWildfire=wildfireActive;

    /* ── ANCHOR: check if this row/col is locked ── */
    if(!wasWildfire && isShiftBlocked(grid, type, idx)){
      addToast("🔒 ANCHOR LOCK — clear an adjacent tile first!", "#64a0ff");
      Audio.tap(); Haptics.medium();
      return;
    }

    if(wasWildfire) setWildfireActive(false);

    setSlideAnim({type:type,idx:idx,dir:dir});
    setPhase("busy");
    Audio.shift(); Haptics.light();
    /* Screen nudge in shift direction */
    setShiftNudge(dir); setTimeout(function(){ setShiftNudge(null); }, 160);
    /* Record move for Grid Memory */
    moveHistoryRef.current.push({type:type,idx:idx,dir:dir});

    later(function(){
      setSlideAnim(null);

      /* ── WILDFIRE: match entire shifted row/col ── */
      /* (wasWildfire already captured at top of handleShift) */

      let g=doShift(grid,type,idx,dir);
      /* Wildfire: force-clear all non-corrupted tiles in the shifted row/col */
      var wildfireCleared={};
      if(wasWildfire){
        var wildcells=[];
        if(type==="row"){ for(var wc=0;wc<COLS;wc++) if(!g[idx][wc].corrupted&&!g[idx][wc].blocker) wildcells.push(idx+","+wc); }
        else { for(var wr=0;wr<ROWS;wr++) if(!g[wr][idx].corrupted&&!g[wr][idx].blocker) wildcells.push(wr+","+idx); }
        if(wildcells.length>=3){
          var wm=new Set(wildcells);
          var wres=applyGravity(g,wm);
          /* Credit cleared colors directly */
          Object.keys(wres.cleared).forEach(function(col){ wildfireCleared[col]=(wildfireCleared[col]||0)+wres.cleared[col]; });
          g=wres.g;
          addToast("🔥 WILDFIRE — FULL LINE CLEARED!","#ff7700");
        }
      }
      let frames=[],totCleared=Object.assign({},wildfireCleared);
      let pts=0,cascades=0,chargeBoost=1;
      if(wasWildfire&&Object.keys(wildfireCleared).length>0) pts+=25*comboAmp; /* base wildfire score */
      const toastQueue=[];

      while(true){
        let m=findMatches(g);
        if(!m.size) break;
        const shapes=detectShapes(g,m);
        shapes.forEach(function(sh){
          if(!toastQueue.find(function(x){ return x.text===sh.label; })) toastQueue.push({text:sh.label,color:"#ffaa00"});
          if(sh.type==="battery"){ chargeBoost=2; sessionStatsRef.current.batteries++; }
          if(sh.type==="pulse"&&sh.pos){ m=expandPulse(m,sh.pos); sessionStatsRef.current.pulses++; }
        });
        var nearCorrupt=clearNearCorruption(g,m);
        nearCorrupt.forEach(function(k){ m.add(k); });
        /* Count corrupted tiles IN the match set too (wildfire, pulse, etc) */
        var inMatchCorrupt=0;
        m.forEach(function(k){ var p=k.split(","); var t=g[+p[0]][+p[1]]; if(t&&t.corrupted) inMatchCorrupt++; });
        sessionStatsRef.current.corruptCleared+=nearCorrupt.size+inMatchCorrupt;
        /* ── BLOCKER PROCESSING (runs per cascade, in scope of m and g) ── */
        /* 1. Chain validation — both partners must match or neither clears */
        var chainBlocked=filterChainMatches(g, m);
        if(chainBlocked.size>0){
          chainBlocked.forEach(function(k){ m.delete(k); });
        }
        /* 2. Overcharge explosion — blast 3×3 around matched overcharge tiles */
        var overchargeExtra=processOvercharge(g, m);
        overchargeExtra.forEach(function(k){ m.add(k); });
        /* 3. Adjacent blocker clears (anchor unlock + fog reveal) */
        var adjacentBlockerClears=clearAdjacentBlockers(g, m);
        adjacentBlockerClears.forEach(function(bk){
          if(bk.startsWith("fog:")) {
            var bpos=bk.slice(4).split(","); var bfr=+bpos[0],bfc=+bpos[1];
            if(g[bfr]&&g[bfr][bfc]) g[bfr][bfc]=Object.assign({},g[bfr][bfc],{fogRevealed:true});
          } else {
            var bpos=bk.split(","); var bbr=+bpos[0],bbc=+bpos[1];
            if(g[bbr]&&g[bbr][bbc]&&g[bbr][bbc].blocker==="anchor"){
              g[bbr][bbc]=Object.assign({},g[bbr][bbc],{blocker:null});
              addToast("🔓 ANCHOR BROKEN!","#64a0ff");
            }
          }
        });
        /* 4. Log blocker type for toast (overcharge/chain toasts) */
        m.forEach(function(bk){
          var bp=bk.split(","); var bbt=g[+bp[0]]&&g[+bp[0]][+bp[1]]&&g[+bp[0]][+bp[1]].blocker;
          if(bbt==="overcharge") addToast("💥 OVERCHARGE DETONATED!","#ffdc00");
          else if(bbt==="chain") addToast("🔗 CHAIN BROKEN!","#ff8c00");
        });

        /* Remove locked nodes from match set (they require adjacent clearing) */
        var lockedCleared=new Set();
        m.forEach(function(k){
          var p=k.split(","); var t=g[+p[0]][+p[1]];
          if(t&&t.nodeType==="locked"){ m.delete(k); lockedCleared.add(k); }
        });
        /* Clear locked nodes adjacent to any match */
        m.forEach(function(k){ var p=k.split(","); var r=+p[0],c=+p[1];
          [[-1,0],[1,0],[0,-1],[0,1]].forEach(function(d){
            var nr=r+d[0],nc=c+d[1];
            if(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS){
              var t=g[nr][nc]; if(t&&t.nodeType==="locked") m.add(nr+","+nc);
            }
          });
        });
        frames.push({g:g,m:new Set(m)});
        const res=applyGravity(g,m);
        Object.keys(res.cleared).forEach(function(col){ totCleared[col]=(totCleared[col]||0)+res.cleared[col]; });
        /* Charged node: double the charge for its color */
        m.forEach(function(k){ var p=k.split(","); var t=g[+p[0]][+p[1]];
          if(t&&t.nodeType==="charged"&&t.color) totCleared[t.color]=(totCleared[t.color]||0)+1; /* +1 extra */
        });
        /* Mirror node: also credit the opposite-color building */
        m.forEach(function(k){ var p=k.split(","); var t=g[+p[0]][+p[1]];
          if(t&&t.nodeType==="mirror"&&t.color){
            var opp={cyan:"magenta",magenta:"cyan",amber:"green",green:"amber"}[t.color];
            if(opp) totCleared[opp]=(totCleared[opp]||0)+1;
          }
        });
        pts+=m.size*10*(1+cascades*0.5)*comboAmp;
        cascades++;
        if(cascades>sessionStatsRef.current.maxCascade) sessionStatsRef.current.maxCascade=cascades;
        frames.push({g:res.g,m:new Set()});
        g=res.g;
      }

      const newMC=moveCount+1;
      /* ── STORY: ARIA transmission at move 3, dialogue at move 4 ── */
      if(newMC===3 && !storyShownRef.current["tx_"+levelId]){
        var tx=getAriaTransmission(levelId);
        if(tx){ setAriaTx(tx); storyShownRef.current["tx_"+levelId]=true; setTimeout(function(){ setAriaTx(null); },5000); }
      }
      if(newMC===4 && !storyShownRef.current["mid_"+levelId]){
        var midBeat=getLevelStory(levelId,"mid");
        if(midBeat){ var midCh=CHARS[midBeat.char]||CHARS.RYKER; setStoryBeat({name:midCh.name,color:midCh.color,icon:midCh.icon,role:midCh.role,line:midBeat.line}); storyShownRef.current["mid_"+levelId]=true; setTimeout(function(){ setStoryBeat(null); },8000); }
      }
      let finalG=g;
      /* ── FREEZE: skip corruption spread when active ── */
      if(freezeActive>0){
        setFreezeActive(function(f){ return Math.max(0,f-1); });
      } else if((levelDef.hazards||0)>0&&newMC%spreadEvery===0){
        finalG=spreadCorruption(g,hazardSlow);
      }
      /* Move patrollers on district 4+ levels */
      if((levelDef.id||0)>=30&&newMC%2===0) finalG=movePatrollers(finalG);
      const free=Math.random()<freeChance;
      const newMoves=free?moves:moves-1;
      if(free) addToast("FREE MOVE!","#00ff88");

      /* ── SURGE: if any match happened, credit all building colors ── */
      var totalCleared=Object.values(totCleared).reduce(function(a,b){return a+(b||0);},0);
      if(surgeActive && (totalCleared>0||wasWildfire)){
        setSurgeActive(false);
        BLDG_DEFS.forEach(function(bd){
          totCleared[bd.color]=(totCleared[bd.color]||0)+3; /* +3 guaranteed charge to every color */
        });
        addToast("⚡ SURGE — ALL BUILDINGS CHARGED!","#ffaa00");
      }
      const newBldgs=bldgs.map(function(b){
        const add=(totCleared[b.color]||0)*chargeBoost;
        const ch=Math.min(b.max,b.ch+add);
        return Object.assign({},b,{ch:ch,on:ch>=b.max,justCharged:add>0});
      });
      /* Track which buildings just got charge for pulse animation */
      var newlyCharged=new Set(newBldgs.filter(function(b){ return b.justCharged; }).map(function(b){ return b.id; }));
      if(newlyCharged.size>0){
        setChargedBldgs(newlyCharged);
        setTimeout(function(){ setChargedBldgs(new Set()); },500);
      }

      setMoveCount(newMC); setMoves(newMoves);

      /* ── LAST MOVE WARNING ── */
      if(newMoves===1 && !newBldgs.every(function(b){ return b.on; })){
        addToast("⚠ LAST MOVE","#ff2d95");
        Audio.lastMove();
      }

      function finish(){
        setGrid(finalG); setHi(new Set()); setBldgs(newBldgs); setScore(function(s){ return s+Math.round(pts); });
        toastQueue.forEach(function(t,i){ setTimeout(function(){ addToast(t.text,t.color); },i*320); });
        /* Bump lifetime stats */
        bumpStats({totalShifts:1, totalMatches:pts>0?1:0, totalCascades:Math.max(0,cascades-1), longestCascade:cascades>1?cascades-1:0, totalBatteries:sessionStatsRef.current.batteries, totalCorruptCleared:sessionStatsRef.current.corruptCleared, totalCoinsEarned:Math.round(pts/10)+25});
        sessionStatsRef.current.batteries=0; sessionStatsRef.current.corruptCleared=0;
        if(cascades>1){ setTimeout(function(){ addToast("CHAIN x"+cascades,"#ffaa00"); },toastQueue.length*320); Audio.chain(cascades); }
        if(cascades>=1) Audio.cascade(cascades-1);
        /* Play node-color sound for dominant matched color */
        if(Object.keys(totCleared).length>0){
          var dominantColor=Object.keys(totCleared).reduce(function(a,b){ return totCleared[a]>totCleared[b]?a:b; });
          Audio.nodeMatch(dominantColor);
        }
        /* Big cascade flash at 3+ */
        if(cascades>=3){ setCascadeFlash(true); setTimeout(function(){ setCascadeFlash(false); },400); }

        /* ── COMBO POWER METER update ── */
        var powerGain = pts>0 ? Math.min(25, Math.round(pts/8)) + (cascades>1?cascades*3:0) : 0;
        setComboPower(function(p){
          var np=Math.min(COMBO_MAX, p+powerGain);
          var newRank=getComboRank(np);
          if(newRank.name!==prevRankRef.current&&newRank.name!=="OFFLINE"){
            setRankUpText(newRank.name);
            setTimeout(function(){ setRankUpText(null); },1200);
            Haptics.medium();
          }
          prevRankRef.current=newRank.name;
          return np;
        });

        /* ── COLLECT: remove matched collect targets ── */
        if(objectiveType==="collect"&&collectTiles.size>0){
          var newCollect=new Set(collectTiles);
          var cleared=0;
          frames.forEach(function(fr){
            fr.m&&fr.m.forEach(function(k){ if(newCollect.has(k)){ newCollect.delete(k); cleared++; } });
          });
          if(cleared>0){
            setCollectTiles(newCollect);
            setCollectDone(function(d){ return d+cleared; });
            if(newCollect.size===0){
              /* All collect tiles cleared — WIN */
              eagerSaveProgress(levelDef.id, stars);
              setPhase("win"); Haptics.win(); bumpStats({totalWins:1});
              if(newMoves>0&&!lastChanceRef.current) setPerfectClear(true);
              saveRun();
              setTimeout(function(){ Audio.win(); },100);
              return;
            }
          }
        }

        /* ── CONTAINMENT: check if corruption crossed the boundary (row 3) ── */
        if(objectiveType==="containment"){
          var breached=false;
          for(var cr=3;cr<ROWS;cr++){ for(var cc=0;cc<COLS;cc++){
            if(finalG[cr]&&finalG[cr][cc]&&finalG[cr][cc].corrupted){ breached=true; break; }
          } if(breached) break; }
          if(breached){
            setContainBreach(true);
            setTimeout(function(){ setContainBreach(false); },400);
            /* Containment fail = lose */
            setPhase("lose"); Haptics.lose(); bumpStats({totalLosses:1}); setTimeout(Audio.lose.bind(Audio),100); setTimeout(onLose,300); return;
          }
        }
        /* Wrap-chain detection: check if any cleared tile is at edge col/row */
        var wrapDetected=false;
        (Array.from ? Array.from(new Set()) : []);
        /* Simple heuristic: if shift moved a tile off an edge and it matched */
        if(frames.length>0){
          frames[0].m && frames[0].m.forEach(function(k){
            var p=k.split(","); var r=+p[0],c=+p[1];
            if((type==="row"&&(c===0||c===COLS-1))||(type==="col"&&(r===0||r===ROWS-1))) wrapDetected=true;
          });
        }
        if(wrapDetected&&cascades>=1){ addToast("⚡ WRAP CHAIN!","#a855f7"); setWrapChain(true); setTimeout(function(){ setWrapChain(false); },1200); }
        if(newBldgs.every(function(b){ return b.on; })){
          eagerSaveProgress(levelDef.id, stars);
          setPhase("win");
          if(newMoves>0 && !lastChanceRef.current){ setPerfectClear(true); }
          setTimeout(function(){ if(levelDef.boss) Audio.bossWin(); else Audio.win(); },100);
          return;
        }

        if(newMoves<=0){
          /* ── NEAR-WIN CHECK ── */
          var offlineBldgs=newBldgs.filter(function(b){ return !b.on; });
          var anyClose=offlineBldgs.some(function(b){ return b.ch/b.max>=0.4; });
          if(!lastChanceRef.current && anyClose){
            /* Build the breakdown for the modal */
            var breakdown=offlineBldgs.map(function(b){
              var need=b.max-b.ch;
              return {label:b.label,icon:b.icon,color:b.color,ch:b.ch,max:b.max,need:Math.ceil(need)};
            });
            setNearWinData(breakdown);
            setPhase("nearwin");
            Audio.nearWin();
            setTimeout(onLose,300);
            return;
          }
          /* Normal lose */
          var failBreakdown=offlineBldgs.map(function(b){
            return {label:b.label,icon:b.icon,color:b.color,ch:b.ch,max:b.max,need:Math.ceil(b.max-b.ch)};
          });
          setNearWinData(failBreakdown);
          setPhase("lose"); Haptics.lose(); bumpStats({totalLosses:1}); sessionStatsRef.current.consecutiveWins=0; setTimeout(Audio.lose.bind(Audio),100); setTimeout(onLose,300); return;
        }
        setPhase("idle");
      }

      if(!frames.length){ setGrid(finalG); if(newMoves<=0) setPhase("lose"); else setPhase("idle"); return; }
      let fi=0;
      function step(){
        if(fi>=frames.length){ finish(); return; }
        const fr=frames[fi++]; setGrid(fr.g); setHi(fr.m);
        later(step,fr.m.size>0?400:170);
      }
      setGrid(frames[0].g); setHi(frames[0].m); fi=1; later(step,400);

    }, SLIDE_MS);

  },[grid,phase,moves,bldgs,moveCount,hazardSlow,comboAmp,freeChance,spreadEvery,levelDef,wildfireActive]);

  /* ── SWIPE HANDLING ── */
  function onTouchStart(e){
    if(phase!=="idle") return;
    const touch=e.touches[0];
    const rect=gridRef.current.getBoundingClientRect();
    const relX=touch.clientX-rect.left-(SZ+GAP);
    const relY=touch.clientY-rect.top-(SZ+GAP);
    touchRef.current={
      startX:touch.clientX, startY:touch.clientY,
      startRow:Math.floor(relY/(SZ+GAP)),
      startCol:Math.floor(relX/(SZ+GAP)),
      moved:false
    };
  }
  function onTouchMove(e){
    const t=touchRef.current;
    const dx=Math.abs(e.touches[0].clientX-t.startX);
    const dy=Math.abs(e.touches[0].clientY-t.startY);
    if(dx>8||dy>8){ t.moved=true; e.preventDefault(); }
  }
  function onTouchEnd(e){
    const t=touchRef.current;
    if(!t.moved) return;
    const touch=e.changedTouches[0];
    const dx=touch.clientX-t.startX, dy=touch.clientY-t.startY;
    const absDx=Math.abs(dx), absDy=Math.abs(dy);
    const THRESH=32;
    if(absDx<THRESH&&absDy<THRESH) return;
    if(absDx>absDy){
      if(t.startRow>=0&&t.startRow<ROWS) handleShift("row",t.startRow,dx>0?"right":"left");
    } else {
      if(t.startCol>=0&&t.startCol<COLS) handleShift("col",t.startCol,dy>0?"down":"up");
    }
  }

  function retry(){
    lastChanceRef.current=false;
    sessionStatsRef.current={batteries:0,pulses:0,maxCascade:0,corruptCleared:0,consecutiveWins:sessionStatsRef.current.consecutiveWins||0};
    moveHistoryRef.current=[];
    /* Reset story beats so they replay on retry */
    storyShownRef.current={};
    setStoryBeat(null); setAriaTx(null);
    setComboPower(0); prevRankRef.current=COMBO_RANKS[0].name;
    setNearWinData(null);
    setGrid(buildInitGrid()); setMoves(levelDef.moves);
    setBldgs(function(b){ return b.map(function(x){ return Object.assign({},x,{ch:0,on:false}); }); });
    setScore(0); setHi(new Set()); setPhase("idle"); setMoveCount(0); setSlideAnim(null);
    /* Reset ability active states but not inventory */
    setSurgeActive(false); setFreezeActive(0); setWildfireActive(false);
    setHintTile(null); setUsedAbilities(new Set());
    setAbilityAnim(null); setMovesBump(false); setCleansingTiles(new Set());
    /* Reset Phase 2 objective state */
    if(objectiveType==="timed") setTimeLeft(getTimerSeconds(levelDef));
    setComboPower(0); prevRankRef.current=COMBO_RANKS[0].name;
    setCollectDone(0); setContainBreach(false);
    if(objectiveType==="collect"){
      var rng=mkSeededRng((levelDef.id||0)*999+collectTarget*77);
      var newTargets=new Set(); var tries=0;
      while(newTargets.size<collectTarget&&tries<50){ tries++; newTargets.add(Math.floor(rng()*ROWS)+","+(Math.floor(rng()*COLS))); }
      setCollectTiles(newTargets);
    }
    /* Reload latest ability counts from storage */
    setAbilities(loadAbilities());
  }

  /* ── GRID MEMORY ── */
  function saveRun(){
    var key="sg_ghost_"+levelDef.id;
    var run={moves:moveHistoryRef.current.slice(),score:0};
    try{ localStorage.setItem(key,JSON.stringify(run)); }catch{}
  }
  function loadGhostRun(){
    var key="sg_ghost_"+levelDef.id;
    try{ var s=localStorage.getItem(key); return s?JSON.parse(s):null; }catch{ return null; }
  }
  var ghostRun = React.useMemo(function(){ return loadGhostRun(); },[levelDef.id]);

  function continueWithMoves(n){
    lastChanceRef.current=true;
    setNearWinData(null);
    setMoves(n);
    setPhase("idle");
  }

  /* ── USE ABILITY — OVERHAULED ── */
  /* Cinematic metadata per ability */
  var ABILITY_ANIM_DEFS = {
    surge:     { icon:"⚡", name:"POWER SURGE",  color:"#ffaa00", bg:"rgba(255,170,0,0.14)", glow:"rgba(255,170,0,0.35)", border:"#ffaa00",
                 effect:"Next match charges ALL buildings — no matter the color" },
    cleanse:   { icon:"🧹", name:"CLEANSE",      color:"#00ff88", bg:"rgba(0,255,136,0.1)",  glow:"rgba(0,255,136,0.3)",  border:"#00ff88",
                 effect:"All corruption tiles are being destroyed" },
    shift_plus:{ icon:"🔁", name:"+3 MOVES",     color:"#00e5ff", bg:"rgba(0,229,255,0.1)",  glow:"rgba(0,229,255,0.3)",  border:"#00e5ff",
                 effect:"3 extra moves added to your current total" },
    freeze:    { icon:"🧊", name:"FREEZE",        color:"#a5f3fc", bg:"rgba(165,243,252,0.1)",glow:"rgba(165,243,252,0.3)",border:"#a5f3fc",
                 effect:"Corruption cannot spread for the next 5 moves" },
    wildfire:  { icon:"🔥", name:"WILDFIRE",     color:"#ff7700", bg:"rgba(255,119,0,0.12)", glow:"rgba(255,119,0,0.35)", border:"#ff7700",
                 effect:"Your NEXT shift clears every tile in that row or column" },
    detector:  { icon:"🔍", name:"HINT",          color:"#c084fc", bg:"rgba(192,132,252,0.1)",glow:"rgba(192,132,252,0.3)",border:"#c084fc",
                 effect:"The best available shift is highlighted on the board" },
  };

  function useAbility(id){
    if(phase!=="idle") return;
    var count=abilities[id]||0;
    if(count<=0) return;

    /* Consume */
    var newAbils=Object.assign({},abilities,{[id]:count-1});
    setAbilities(newAbils); saveAbilities(newAbils);
    setUsedAbilities(function(s){ var n=new Set(s); n.add(id); return n; });

    /* Trigger cinematic */
    var adef = ABILITY_ANIM_DEFS[id];
    if(adef){
      setAbilityAnim(adef);
      setTimeout(function(){ setAbilityAnim(null); }, 2000);
    }

    Haptics.heavy();

    /* Per-ability effect */
    if(id==="surge"){
      setSurgeActive(true);
      Audio.abilitySurge();
    }
    else if(id==="cleanse"){
      /* Animate tiles out first, then replace */
      var corruptKeys=new Set();
      for(var r=0;r<ROWS;r++) for(var c=0;c<COLS;c++){
        if(grid[r]&&grid[r][c]&&grid[r][c].corrupted) corruptKeys.add(r+","+c);
      }
      setCleansingTiles(corruptKeys);
      Audio.abilityCleanse();
      /* Staggered removal — 420ms for animation, then swap tiles */
      later(function(){
        setCleansingTiles(new Set());
        setGrid(function(g){
          return g.map(function(row){ return row.map(function(t){
            return t&&t.corrupted&&!t.blocker ? makeTile(rndColor()) : t;
          }); });
        });
      }, 420);
    }
    else if(id==="shift_plus"){
      setMoves(function(m){ return m+3; });
      setMovesBump(true);
      setTimeout(function(){ setMovesBump(false); }, 500);
      Audio.abilityMoves();
    }
    else if(id==="freeze"){
      setFreezeActive(5);
      Audio.abilityFreeze();
    }
    else if(id==="wildfire"){
      setWildfireActive(true);
      Audio.abilityFire();
    }
    else if(id==="detector"){
      var bestScore=-1, bestHint=null;
      for(var ri=0;ri<ROWS;ri++){
        ["left","right"].forEach(function(dir){
          var tg=doShift(grid,"row",ri,dir);
          var mm=findMatches(tg);
          if(mm.size>bestScore){ bestScore=mm.size; bestHint={type:"row",idx:ri,dir:dir}; }
        });
      }
      for(var ci=0;ci<COLS;ci++){
        ["up","down"].forEach(function(dir){
          var tg=doShift(grid,"col",ci,dir);
          var mm=findMatches(tg);
          if(mm.size>bestScore){ bestScore=mm.size; bestHint={type:"col",idx:ci,dir:dir}; }
        });
      }
      setHintTile(bestHint);
      setTimeout(function(){ setHintTile(null); }, 3500);
      Audio.win();
    }
  }

  function ShiftBtn(p){
    var isHinted = hintTile && hintTile.type===p.type && hintTile.idx===p.idx && hintTile.dir===p.dir;
    var isWildfire = wildfireActive;
    return (
      <button className={"sg-shift-btn"+(p.col?" col-btn":"")+(isHinted?" flash":"")}
        style={{
          width:(p.col?SZ:30)+"px", height:(p.col?30:SZ)+"px",
          boxShadow: isHinted?"0 0 12px #c084fc" : isWildfire?"0 0 8px rgba(255,119,0,0.5)":"none",
          borderColor: isHinted?"#c084fc" : isWildfire?"rgba(255,119,0,0.7)":"",
          background: isWildfire?"rgba(255,119,0,0.12)":"",
          animation: isHinted?"ability-ready 0.8s ease infinite alternate" : isWildfire?"ability-armed 0.8s ease infinite alternate":"",
          "--acolor": "#ff7700",
          color: isWildfire?"#ff7700":isHinted?"#c084fc":"",
          transition:"all 0.15s",
        }}
        onClick={function(){ if(isHinted)setHintTile(null); handleShift(p.type,p.idx,p.dir); }}
        disabled={phase!=="idle"}>
        {isWildfire?"🔥":p.label}
      </button>
    );
  }

  const corr=countCorruption(grid);
  const spreadWarn=(levelDef.hazards||0)>0&&((moveCount+1)%spreadEvery===0);
  const winCoins=Math.floor(score/10)+25, winParts=Math.floor(score/60)+3;
  const movesUsed=levelDef.moves-moves;
  const stars=calcStars(movesUsed,levelDef.moves);
  const isLastMove=moves===1&&phase==="idle"&&!bldgs.every(function(b){ return b.on; });
  const isNearWinState=phase==="nearwin";
  /* Nudge class on grid area */
  var nudgeClass = shiftNudge ? ("sg-nudge-"+shiftNudge) : "";

  /* ─── FIX 3: safe level name for campaign levels ────────────────── */
  const displayName = levelDef.name || (levelDef.dist ? levelDef.dist + " · LVL " + ((levelDef.id||0)+1) : "CUSTOM LEVEL");

  return (
    <div className={"sg-play"+(isNearWinState?" near-win-state":"")}>
