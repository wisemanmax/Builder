function calcIdle(meta){
  const lvl=meta.upgrades&&meta.upgrades.idleBoost?meta.upgrades.idleBoost:0;
  if(!lvl) return 0;
  const hrs=Math.min(8,(Date.now()-(meta.lastCollect||Date.now()))/3600000);
