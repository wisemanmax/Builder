/* ─── SESSION GOALS STRIP ───────────────────────────────────────── */
function SessionGoalsStrip(props) {
  var sessionGoals = props.sessionGoals;
  var setSessionGoals = props.setSessionGoals;
  var setMeta = props.setMeta;

  if (!sessionGoals) return null;
  var defs = getSessionGoalDefs(sessionGoals.pickedIds);

  function claimGoal(i) {
    var def = defs[i];
    var prog = sessionGoals.goals[i];
    if (!prog || prog.claimed || prog.progress < def.goal) return;
    var newGoals = sessionGoals.goals.map(function(g, gi) {
      return gi === i ? Object.assign({}, g, {claimed: true}) : g;
    });
    var updated = Object.assign({}, sessionGoals, {goals: newGoals});
    saveSessionGoals(updated);
    setSessionGoals(updated);
    setMeta(function(m) {
      var n = Object.assign({}, m, {coins: m.coins + def.reward});
      saveMeta(n); return n;
    });
    Audio.win();
  }

  return (
    <div className="sg-goals-strip">
      <div className="sg-label" style={{marginTop:8,marginBottom:6}}>SESSION GOALS</div>
      <div className="sg-goals-row">
        {defs.map(function(def, i) {
          var prog = sessionGoals.goals[i];
          if (!prog || !def) return null;
          var pct = Math.min(100, (prog.progress / def.goal) * 100);
          var done = prog.progress >= def.goal;
          var claimed = prog.claimed;
          var cls = "sg-goal-card" + (claimed ? " complete" : done ? " claimable" : "");
          return (
            <div key={def.id} className={cls}>
              <div className="sg-goal-icon">{def.icon}</div>
              <div className="sg-goal-name">{def.name}</div>
              <div className="sg-goal-prog">{prog.progress + " / " + def.goal + " · +" + def.reward + " coins"}</div>
              <div className="sg-goal-bar-track">
                <div className="sg-goal-bar-fill" style={{
                  width: pct + "%",
                  background: claimed ? "#00ff88" : done ? "linear-gradient(90deg,#ffaa00,#ff7700)" : "linear-gradient(90deg,#00e5ff,#a855f7)"
                }}/>
              </div>
              {claimed && <div className="sg-goal-done-badge">✓ CLAIMED</div>}
              {done && !claimed && (
                <button className="sg-goal-claim" onClick={function(){ claimGoal(i); }}>
                  CLAIM +{def.reward} COINS
                </button>
              )}
            </div>
          );
        })}
      </div>
    </div>
  );
}

