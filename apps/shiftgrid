/* Master challenge: same level but 30% fewer moves */
function getMasterDef(levelDef){
  return Object.assign({},levelDef,{
    moves: Math.max(4,Math.floor(levelDef.moves*0.65)),
    isMaster: true,
    name: levelDef.name+" — MASTER",
    hint: "MASTER CHALLENGE: "+Math.floor(levelDef.moves*0.65)+" moves. No shortcuts. No mercy.",
  });
