          parts: m.parts + rewards.parts,
          chests: newChests,
        });
        saveMeta(n);
        return n;
      });
      /* Coin fly — safe outside setMeta */
      if(rewards.coins>0 && coinDisplayEl && window.sgCoinFly) {
        setTimeout(function(){ window.sgCoinFly(rewards.coins, coinDisplayEl); }, 100);
