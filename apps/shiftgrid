<script>
/* ── SHIFTGRID MUSIC CONTROLLER ── */
window.sgMusic = {
  el: null,
  playing: false,
  volume: 0.6,

  init: function() {
    window.sgMusic.el = document.getElementById('sg-audio');
    if (!window.sgMusic.el) { console.warn('[sgMusic] audio element not found'); return; }
    window.sgMusic.el.volume = window.sgMusic.volume;

    /* Create fixed button — lives outside React so React re-renders never wipe it */
    var btn = document.createElement('button');
    btn.id = 'sg-music-btn';
    btn.style.cssText = [
      'position:fixed',
      'bottom:80px',
      'right:14px',
      'z-index:9999',
      'width:40px',
      'height:40px',
      'border-radius:50%',
      'border:1px solid rgba(255,255,255,0.15)',
      'background:rgba(13,13,26,0.92)',
      'color:rgba(255,255,255,0.35)',
      'font-size:18px',
      'cursor:pointer',
      'display:flex',
      'align-items:center',
      'justify-content:center',
      'backdrop-filter:blur(8px)',
      '-webkit-backdrop-filter:blur(8px)',
      'transition:all 0.2s',
      'box-shadow:0 2px 12px rgba(0,0,0,0.4)'
    ].join(';');
    btn.textContent = '♪';
    btn.title = 'Music OFF — tap to play';
    btn.addEventListener('click', function() { window.sgMusic.toggle(); });
    document.body.appendChild(btn);

    /* Always queue autoplay on load — fires on first user gesture */
    window.sgMusic._queuePlay();
  },

  toggle: function() {
    var el = window.sgMusic.el;
    if (!el) return;
    if (window.sgMusic.playing) {
      el.pause();
      window.sgMusic.playing = false;
      localStorage.setItem('sg_music_on', '0');
      window.sgMusic._updateBtn();
    } else {
      var p = el.play();
      if (p !== undefined) {
        p.then(function() {
          window.sgMusic.playing = true;
          localStorage.setItem('sg_music_on', '1');
          window.sgMusic._updateBtn();
        }).catch(function(err) {
          console.warn('[sgMusic] play() blocked by browser:', err);
          window.sgMusic._queuePlay();
        });
      } else {
        window.sgMusic.playing = true;
        localStorage.setItem('sg_music_on', '1');
        window.sgMusic._updateBtn();
      }
    }
  },

  _queuePlay: function() {
    /* Defer play until next user gesture (browser autoplay policy) */
    var done = false;
    var handler = function(e) {
      if (done) return;
      if (e.target && e.target.id === 'sg-music-btn') return;
      done = true;
      document.removeEventListener('click',      handler, true);
      document.removeEventListener('touchstart', handler, true);
      document.removeEventListener('keydown',    handler, true);
      if (!window.sgMusic.playing && window.sgMusic.el) {
        window.sgMusic.el.play().then(function() {
          window.sgMusic.playing = true;
          localStorage.setItem('sg_music_on', '1');
          window.sgMusic._updateBtn();
        }).catch(function(e){ console.warn('[sgMusic] queued play failed:', e); });
      }
    };
    document.addEventListener('click',      handler, true);
    document.addEventListener('touchstart', handler, true);
    document.addEventListener('keydown',    handler, true);
  },

  setVolume: function(v) {
    window.sgMusic.volume = Math.max(0, Math.min(1, v));
    if (window.sgMusic.el) window.sgMusic.el.volume = window.sgMusic.volume;
  },

  _updateBtn: function() {
    var btn = document.getElementById('sg-music-btn');
    if (!btn) return;
    if (window.sgMusic.playing) {
      btn.textContent = '♫';
      btn.title = 'Music ON — tap to mute';
      btn.style.color = '#00e5ff';
      btn.style.borderColor = 'rgba(0,229,255,0.45)';
      btn.style.boxShadow = '0 0 14px rgba(0,229,255,0.3), 0 2px 12px rgba(0,0,0,0.4)';
    } else {
      btn.textContent = '♪';
      btn.title = 'Music OFF — tap to play';
      btn.style.color = 'rgba(255,255,255,0.35)';
      btn.style.borderColor = 'rgba(255,255,255,0.15)';
      btn.style.boxShadow = '0 2px 12px rgba(0,0,0,0.4)';
    }
  }
};

document.addEventListener('DOMContentLoaded', function() {
  window.sgMusic.init();
});

