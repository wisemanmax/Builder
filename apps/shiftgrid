    .sg-upg-card:hover { border-color: rgba(0,229,255,0.2); }
    .sg-upg-icon { font-size: 22px; margin-bottom: 5px; }
    .sg-upg-name { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.82); margin-bottom: 3px; }
    .sg-upg-desc { font-size: 9px; color: rgba(255,255,255,0.3); line-height: 1.4; margin-bottom: 8px; }
    .sg-upg-pips { display: flex; gap: 3px; justify-content: center; margin-bottom: 8px; }
