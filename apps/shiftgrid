/* ── ROOT ── */
#root { height: 100%; }
.sg-app {
  height: 100vh; height: 100dvh;
  display: flex; flex-direction: column; align-items: center;
  background: radial-gradient(ellipse 80% 50% at 50% -10%, #0e1428 0%, var(--bg) 65%);
  font-family: 'Rajdhani', sans-serif;
  color: #e4e4ff;
  overflow: hidden;
  position: relative;
}

/* Scanlines */
.sg-app::after {
  content: '';
  position: fixed; inset: 0; pointer-events: none; z-index: 1000;
  background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.04) 3px, rgba(0,0,0,0.04) 4px);
}

/* Ambient particles */
.sg-particles { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.sg-particle {
  position: absolute; width: 2px; height: 2px; border-radius: 50%;
  animation: pfloat linear infinite;
  opacity: 0;
}
@keyframes pfloat {
  0%   { opacity: 0; transform: translateY(0) scale(1); }
  10%  { opacity: 0.6; }
  90%  { opacity: 0.3; }
  100% { opacity: 0; transform: translateY(-120vh) scale(0.5); }
}

/* ── HEADER ── */
.sg-header {
  width: 100%; max-width: 460px;
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 16px 8px;
  position: relative; z-index: 10; flex-shrink: 0;
}
.sg-logo {
  font-family: 'Orbitron', monospace; font-weight: 900;
  font-size: clamp(18px, 4.5vw, 24px); letter-spacing: 0.22em;
  background: linear-gradient(135deg, var(--cyan) 0%, var(--mag) 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 0 14px rgba(0,229,255,0.35));
}
.sg-wallet {
  display: flex; gap: 12px;
}
.sg-coin {
  display: flex; align-items: center; gap: 4px;
  font-family: 'Share Tech Mono', monospace; font-size: 12px;
  color: rgba(255,255,255,0.6);
}
.sg-coin-dot {
  width: 8px; height: 8px; border-radius: 50%;
}

/* ── MUSIC BUTTON ── */
.sg-music-btn {
  background: none; border: none;
  font-size: 18px; cursor: pointer;
  color: rgba(255,255,255,0.3);
  padding: 2px 4px; border-radius: 6px;
  transition: color 0.2s, text-shadow 0.2s, background 0.2s;
  line-height: 1; flex-shrink: 0;
}
.sg-music-btn:hover { background: rgba(255,255,255,0.07); }

/* ── CONTENT AREA ── */
.sg-content {
  flex: 1; width: 100%; max-width: 460px;
  overflow-y: auto; overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  position: relative; z-index: 10;
  padding: 0 12px;
}
.sg-content::-webkit-scrollbar { display: none; }

/* ── NAV ── */
.sg-nav {
  width: 100%; max-width: 460px;
  display: flex;
  background: rgba(7,7,15,0.95);
  border-top: 1px solid var(--border);
  padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px));
  position: relative; z-index: 100;
  flex-shrink: 0;
  gap: 4px;
}
.sg-nav-btn {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
  padding: 10px 4px 6px; min-height: 52px;
  background: none; border: none; border-radius: 10px;
  color: rgba(255,255,255,0.25); cursor: pointer;
  font-family: 'Rajdhani', sans-serif; font-size: 10px; font-weight: 700;
  letter-spacing: 0.12em; transition: color 0.2s, background 0.2s;
  position: relative;
}
.sg-nav-btn .nav-icon { font-size: 18px; line-height: 1; }
.sg-nav-btn.active {
  color: var(--cyan);
  background: rgba(0,229,255,0.08);
}
.sg-nav-btn.active::before {
  content: '';
  position: absolute; top: 0; left: 50%; transform: translateX(-50%);
  width: 24px; height: 2px; border-radius: 0 0 2px 2px;
  background: var(--cyan);
  box-shadow: 0 0 8px var(--cyan);
}

/* ── SECTION LABELS ── */
.sg-label {
  font-size: 9px; letter-spacing: 0.24em; color: rgba(255,255,255,0.2);
  text-transform: uppercase; margin-bottom: 8px; margin-top: 16px;
}

/* ── PLAY SCREEN ── */
.sg-play {
  height: 100%; display: flex; flex-direction: column;
  position: relative; z-index: 10;
}
.sg-play.near-win-state::before {
  content: '';
  position: fixed; inset: 0; z-index: 999; pointer-events: none;
  border: 3px solid #ff2d95;
  animation: nw-border-pulse 0.55s ease infinite alternate;
}

.sg-play-top {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 14px 6px; flex-shrink: 0;
}
.sg-back {
  width: 34px; height: 34px; border-radius: 10px;
  background: rgba(255,255,255,0.06); border: 1px solid var(--border);
  color: rgba(255,255,255,0.5); font-size: 14px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all 0.15s; flex-shrink: 0;
}
.sg-back:hover { background: rgba(255,255,255,0.1); color: #fff; }
.sg-lvl-label { font-family: 'Share Tech Mono', monospace; font-size: 10px; letter-spacing: 0.1em; color: rgba(255,255,255,0.55); text-align: center; }
.sg-daily-badge { font-size: 8px; color: var(--amber); letter-spacing: 0.18em; margin-bottom: 2px; }
.sg-score-live {
  font-family: 'Orbitron', monospace; font-size: 15px; font-weight: 700;
  color: var(--amber); text-shadow: 0 0 12px rgba(255,170,0,0.4);
  min-width: 64px; text-align: right;
}

/* ── HUD ── */
.sg-hud {
  display: flex; gap: 6px; padding: 0 14px 6px;
  flex-shrink: 0;
}
.sg-stat {
  flex: 1; background: rgba(255,255,255,0.03);
  border: 1px solid var(--border); border-radius: 12px;
  padding: 7px 6px; text-align: center;
  transition: border-color 0.3s, background 0.3s;
}
.sg-stat-lbl { font-size: 7px; letter-spacing: 0.2em; color: rgba(255,255,255,0.22); margin-bottom: 2px; }
.sg-stat-val {
  font-family: 'Orbitron', monospace; font-size: 20px; font-weight: 700;
  transition: color 0.3s, text-shadow 0.3s;
}
.sg-stat.danger { border-color: rgba(255,45,149,0.35); background: rgba(255,45,149,0.06); }

/* ── KINGDOM RANK TITLE ── */
.sg-kingdom-rank {
  font-family: 'Share Tech Mono', monospace;
  font-size: 9px; letter-spacing: 0.14em;
  padding: 2px 7px; border-radius: 5px;
  border: 1px solid; font-weight: 700;
  transition: all 0.4s;
}

/* ── DAILY LOGIN CHEST POPUP ── */
.sg-login-overlay {
  position: fixed; inset: 0; z-index: 950;
  background: rgba(7,7,15,0.92);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  animation: overlay-in 0.3s ease;
}
.sg-login-modal {
  background: rgba(13,13,26,0.98);
  border-radius: 28px; padding: 36px 28px;
  max-width: 310px; width: 90%; text-align: center;
  animation: modal-in 0.4s cubic-bezier(0.34,1.56,0.64,1);
  position: relative; overflow: hidden;
}
.sg-login-modal::before {
  content: ''; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(ellipse 70% 40% at 50% 0%, var(--chest-glow,rgba(255,170,0,0.1)) 0%, transparent 65%);
}
.sg-chest-anim {
  font-size: 72px; display: block; margin-bottom: 4px;
  animation: chest-bounce 0.7s cubic-bezier(0.34,1.56,0.64,1);
  cursor: pointer; transition: transform 0.15s;
  line-height: 1;
}
.sg-chest-anim:hover { transform: scale(1.1) rotate(-3deg); }
.sg-chest-anim.opening {
  animation: chest-open 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards;
}
@keyframes chest-bounce {
  0%   { transform: scale(0.3) translateY(30px); opacity: 0; }
  70%  { transform: scale(1.15) translateY(-8px); opacity: 1; }
  100% { transform: scale(1) translateY(0); opacity: 1; }
}
@keyframes chest-open {
  0%   { transform: scale(1) rotate(0deg); }
  30%  { transform: scale(1.3) rotate(-8deg); }
  60%  { transform: scale(1.2) rotate(6deg); }
  100% { transform: scale(1) rotate(0deg); }
}
.sg-login-day {
  font-family: 'Orbitron', monospace; font-size: 11px; font-weight: 700;
  letter-spacing: 0.16em; margin-bottom: 4px;
}
.sg-login-title {
  font-family: 'Orbitron', monospace; font-size: 20px; font-weight: 900;
  letter-spacing: 0.08em; margin-bottom: 6px;
}
.sg-login-sub { font-size: 12px; color: rgba(255,255,255,0.38); margin-bottom: 20px; }
.sg-login-rewards {
  display: flex; gap: 8px; justify-content: center; margin-bottom: 20px;
  flex-wrap: wrap;
}
.sg-login-reward-chip {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
  border-radius: 12px; padding: 10px 14px; min-width: 64px;
}
.sg-login-reward-icon { font-size: 20px; }
.sg-login-reward-val { font-family: 'Orbitron', monospace; font-size: 14px; font-weight: 700; }
.sg-login-reward-lbl { font-size: 8px; color: rgba(255,255,255,0.35); letter-spacing: 0.1em; }
.sg-reward-burst {
  animation: burst-in 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
}
@keyframes burst-in {
  0%  { transform: scale(0) rotate(-15deg); opacity: 0; }
  100%{ transform: scale(1) rotate(0deg); opacity: 1; }
}

/* ── CHEST INVENTORY ── */
.sg-chest-inv-row {
  display: flex; gap: 8px; margin-bottom: 10px;
}
.sg-chest-inv-card {
  flex: 1; border: 1px solid; border-radius: 14px; padding: 14px 8px;
  text-align: center; cursor: pointer; transition: all 0.2s;
  position: relative; overflow: hidden;
}
.sg-chest-inv-card:active { transform: scale(0.96); }
.sg-chest-inv-card.empty { opacity: 0.25; cursor: default; }
.sg-chest-inv-card.empty:active { transform: none; }
.sg-chest-inv-icon { font-size: 34px; display: block; margin-bottom: 5px; }
.sg-chest-inv-name { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; margin-bottom: 2px; }
.sg-chest-inv-count {
  font-family: 'Orbitron', monospace; font-size: 18px; font-weight: 900;
}
.sg-chest-inv-tap { font-size: 9px; margin-top: 4px; opacity: 0.5; letter-spacing: 0.06em; }
.sg-chest-open-flash {
  position: fixed; inset: 0; z-index: 960; pointer-events: none;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  animation: flash-out 0.5s ease forwards;
}
@keyframes flash-out { from{opacity:1} to{opacity:0} }

/* ── TROPHY ROAD ── */
.sg-trophy-road {
  position: relative; padding: 8px 0 4px;
  margin-bottom: 8px;
}
.sg-trophy-track {
  position: absolute; top: 50%; left: 28px; right: 28px;
  height: 3px; background: rgba(255,255,255,0.08);
  transform: translateY(-50%); border-radius: 2px; z-index: 0;
}
.sg-trophy-track-fill {
  height: 100%; border-radius: 2px;
  background: linear-gradient(90deg, #ffaa00, #ff7700);
  transition: width 0.8s ease;
  box-shadow: 0 0 6px rgba(255,170,0,0.5);
}
.sg-trophy-nodes {
  display: flex; justify-content: space-between;
  position: relative; z-index: 1;
}
.sg-trophy-node {
  display: flex; flex-direction: column; align-items: center; gap: 5px;
  width: 52px;
}
.sg-trophy-gem {
  width: 36px; height: 36px; border-radius: 10px; border: 2px solid;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; transition: all 0.3s; position: relative;
}
.sg-trophy-gem.unlocked {
  animation: gem-glow 2s ease infinite;
}
@keyframes gem-glow {
  0%,100% { box-shadow: 0 0 6px currentColor; }
  50%      { box-shadow: 0 0 16px currentColor; }
}
.sg-trophy-gem.claimable {
  animation: gem-pulse 0.8s ease infinite alternate;
}
@keyframes gem-pulse {
  from { transform: scale(1); }
  to   { transform: scale(1.12); }
}
.sg-trophy-label {
  font-size: 8px; color: rgba(255,255,255,0.35); letter-spacing: 0.06em; text-align: center;
}
.sg-trophy-label.done { color: #ffaa00; }

/* ══════════════════════════════════════
   PHASE 1 — NEW SYSTEMS
══════════════════════════════════════ */

/* ── PRE-LEVEL SCREEN ── */
.sg-prelevel {
  position: fixed; inset: 0; z-index: 600;
  background: rgba(7,7,15,0.97);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 20px; backdrop-filter: blur(12px);
  animation: overlay-in 0.3s ease;
  overflow-y: auto;
}
.sg-prelevel-card {
  width: 100%; max-width: 360px;
  background: rgba(13,13,26,0.98);
  border-radius: 24px; padding: 24px 20px;
  border: 1px solid rgba(255,255,255,0.08);
  box-shadow: 0 24px 60px rgba(0,0,0,0.5);
}
.sg-prelevel-eyebrow { font-size: 9px; letter-spacing: 0.22em; color: rgba(255,255,255,0.3); margin-bottom: 4px; }
.sg-prelevel-name    { font-family:'Orbitron',monospace; font-size:18px; font-weight:900; letter-spacing:0.08em; margin-bottom:6px; }
.sg-prelevel-hint    { font-size:12px; color:rgba(255,255,255,0.42); line-height:1.6; margin-bottom:16px; }
.sg-prelevel-stats   { display:flex; gap:8px; margin-bottom:18px; }
.sg-prelevel-stat    { flex:1; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; padding:10px 6px; text-align:center; }
.sg-prelevel-stat-val{ font-family:'Orbitron',monospace; font-size:18px; font-weight:700; }
.sg-prelevel-stat-lbl{ font-size:8px; color:rgba(255,255,255,0.3); letter-spacing:0.1em; margin-top:2px; }

/* Booster loadout */
.sg-prelevel-loadout-lbl { font-size:9px; letter-spacing:0.14em; color:rgba(255,255,255,0.3); margin-bottom:8px; }
.sg-booster-row  { display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap; }
.sg-booster-slot {
  flex:1; min-width:70px; border-radius:14px; border:2px solid;
  padding:10px 6px; text-align:center; cursor:pointer;
  transition:all 0.15s; position:relative;
}
.sg-booster-slot.selected { transform:scale(1.04); }
.sg-booster-slot.empty-slot { border-style:dashed; opacity:0.4; cursor:default; }
.sg-booster-icon { font-size:24px; display:block; margin-bottom:4px; }
.sg-booster-name { font-size:9px; font-weight:700; letter-spacing:0.04em; }
.sg-booster-count{ position:absolute; top:4px; right:6px; font-family:'Orbitron',monospace; font-size:8px; font-weight:900; color:#fff; background:rgba(0,0,0,0.7); border-radius:4px; padding:1px 4px; }
.sg-booster-check{ position:absolute; top:-6px; left:-6px; width:18px; height:18px; border-radius:50%; background:#00ff88; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:900; color:#06060f; }

.sg-prelevel-launch {
  width:100%; border:none; border-radius:14px; padding:16px;
  font-family:'Orbitron',monospace; font-size:12px; font-weight:900;
  cursor:pointer; letter-spacing:0.12em; transition:all 0.15s;
  margin-bottom:10px;
}
.sg-prelevel-launch:hover { transform:scale(1.02); }
.sg-prelevel-skip {
  width:100%; background:none; border:none; color:rgba(255,255,255,0.25);
  font-family:'Rajdhani',sans-serif; font-size:12px; font-weight:700;
  cursor:pointer; padding:8px; letter-spacing:0.08em;
}

/* Episode narrative banner */
.sg-episode-banner {
  border-radius:14px; padding:14px 16px; margin-bottom:14px;
  border:1px solid; position:relative; overflow:hidden;
}
.sg-episode-banner::before {
  content:''; position:absolute; inset:0; pointer-events:none;
  background:linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 60%);
}
.sg-episode-tag  { font-size:8px; letter-spacing:0.2em; font-weight:700; margin-bottom:4px; }
.sg-episode-title{ font-family:'Orbitron',monospace; font-size:13px; font-weight:900; letter-spacing:0.08em; margin-bottom:6px; }
.sg-episode-body { font-size:11px; line-height:1.65; color:rgba(255,255,255,0.5); }

/* ── STAR CHAIN METER ── */
.sg-star-chain-bar {
  margin:0 14px 10px; position:relative;
}
.sg-star-chain-label {
  display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;
}
.sg-star-chain-lbl  { font-size:9px; letter-spacing:0.12em; color:rgba(255,255,255,0.3); }
.sg-star-chain-count{ font-family:'Orbitron',monospace; font-size:9px; font-weight:700; color:#ffaa00; }
.sg-star-chain-track{ height:6px; background:rgba(255,255,255,0.06); border-radius:3px; overflow:hidden; }
.sg-star-chain-fill {
  height:100%; border-radius:3px;
