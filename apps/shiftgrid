  return (
    <div>
      <div className="sg-city-scene" style={{height:180}}>
        {/* Starfield sky */}
        <div className="sg-city-sky">
          {stars.map(function(s,i){
            return <div key={i} className="sg-sky-star" style={{left:s.left,top:s.top,width:s.size,height:s.size,"--dur":s.dur,"--lo":s.lo,"--hi":s.hi}}/>;
