<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#06060f" />
  <title>SHIFTGRID</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Share+Tech+Mono&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --cyan:    #00e5ff;
      --mag:     #ff2d95;
      --amber:   #ffaa00;
      --green:   #00ff88;
      --bg:      #07070f;
      --bg2:     #0d0d1a;
      --border:  rgba(255,255,255,0.07);
      --glass:   rgba(255,255,255,0.04);
      --sz: 52px;
      --gap: 4px;
      --bw: 30px;
      --slide-dur: 140ms;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; background: var(--bg); }

    /* ── ROOT ── */
    #root { height: 100%; }
    .sg-app {
      height: 100vh; height: 100dvh;
      display: flex; flex-direction: column; align-items: center;
      background: radial-gradient(ellipse 80% 50% at 50% -10%, #0e1428 0%, var(--bg) 65%);
      font-family: 'Rajdhani', sans-serif;
      color: #e4e4ff;
      overflow: hidden;
      position: relative;
    }

    /* Scanlines */
    .sg-app::after {
      content: '';
      position: fixed; inset: 0; pointer-events: none; z-index: 1000;
      background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.04) 3px, rgba(0,0,0,0.04) 4px);
    }

    /* Ambient particles */
    .sg-particles { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .sg-particle {
      position: absolute; width: 2px; height: 2px; border-radius: 50%;
      animation: pfloat linear infinite;
      opacity: 0;
    }
    @keyframes pfloat {
      0%   { opacity: 0; transform: translateY(0) scale(1); }
      10%  { opacity: 0.6; }
      90%  { opacity: 0.3; }
      100% { opacity: 0; transform: translateY(-120vh) scale(0.5); }
    }

    /* ── HEADER ── */
    .sg-header {
      width: 100%; max-width: 460px;
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px 8px;
      position: relative; z-index: 10; flex-shrink: 0;
    }
    .sg-logo {
      font-family: 'Orbitron', monospace; font-weight: 900;
      font-size: clamp(18px, 4.5vw, 24px); letter-spacing: 0.22em;
      background: linear-gradient(135deg, var(--cyan) 0%, var(--mag) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 14px rgba(0,229,255,0.35));
    }
    .sg-wallet {
      display: flex; gap: 12px;
    }
    .sg-coin {
      display: flex; align-items: center; gap: 4px;
      font-family: 'Share Tech Mono', monospace; font-size: 12px;
      color: rgba(255,255,255,0.6);
    }
    .sg-coin-dot {
      width: 8px; height: 8px; border-radius: 50%;
    }

    /* ── CONTENT AREA ── */
    .sg-content {
      flex: 1; width: 100%; max-width: 460px;
      overflow-y: auto; overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      position: relative; z-index: 10;
      padding: 0 12px;
    }
    .sg-content::-webkit-scrollbar { display: none; }

    /* ── NAV ── */
    .sg-nav {
      width: 100%; max-width: 460px;
      display: flex;
      background: rgba(7,7,15,0.95);
      border-top: 1px solid var(--border);
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px));
      position: relative; z-index: 100;
      flex-shrink: 0;
      gap: 4px;
    }
    .sg-nav-btn {
      flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
      padding: 7px 4px 5px;
      background: none; border: none; border-radius: 10px;
      color: rgba(255,255,255,0.25); cursor: pointer;
      font-family: 'Rajdhani', sans-serif; font-size: 9px; font-weight: 700;
      letter-spacing: 0.12em; transition: color 0.2s, background 0.2s;
      position: relative;
    }
    .sg-nav-btn .nav-icon { font-size: 18px; line-height: 1; }
    .sg-nav-btn.active {
      color: var(--cyan);
      background: rgba(0,229,255,0.08);
    }
    .sg-nav-btn.active::before {
      content: '';
      position: absolute; top: 0; left: 50%; transform: translateX(-50%);
      width: 24px; height: 2px; border-radius: 0 0 2px 2px;
      background: var(--cyan);
      box-shadow: 0 0 8px var(--cyan);
    }

    /* ── SECTION LABELS ── */
    .sg-label {
      font-size: 9px; letter-spacing: 0.24em; color: rgba(255,255,255,0.2);
      text-transform: uppercase; margin-bottom: 8px; margin-top: 16px;
    }

    /* ── PLAY SCREEN ── */
    .sg-play {
      height: 100%; display: flex; flex-direction: column;
      position: relative; z-index: 10;
    }
    .sg-play.near-win-state::before {
      content: '';
      position: fixed; inset: 0; z-index: 999; pointer-events: none;
      border: 3px solid #ff2d95;
      animation: nw-border-pulse 0.55s ease infinite alternate;
    }

    .sg-play-top {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 14px 6px; flex-shrink: 0;
    }
    .sg-back {
      width: 34px; height: 34px; border-radius: 10px;
      background: rgba(255,255,255,0.06); border: 1px solid var(--border);
      color: rgba(255,255,255,0.5); font-size: 14px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all 0.15s; flex-shrink: 0;
    }
    .sg-back:hover { background: rgba(255,255,255,0.1); color: #fff; }
    .sg-lvl-label { font-family: 'Share Tech Mono', monospace; font-size: 10px; letter-spacing: 0.1em; color: rgba(255,255,255,0.55); text-align: center; }
    .sg-daily-badge { font-size: 8px; color: var(--amber); letter-spacing: 0.18em; margin-bottom: 2px; }
    .sg-score-live {
      font-family: 'Orbitron', monospace; font-size: 15px; font-weight: 700;
      color: var(--amber); text-shadow: 0 0 12px rgba(255,170,0,0.4);
      min-width: 64px; text-align: right;
    }

    /* ── HUD ── */
    .sg-hud {
      display: flex; gap: 6px; padding: 0 14px 6px;
      flex-shrink: 0;
    }
    .sg-stat {
      flex: 1; background: rgba(255,255,255,0.03);
      border: 1px solid var(--border); border-radius: 12px;
      padding: 7px 6px; text-align: center;
      transition: border-color 0.3s, background 0.3s;
    }
    .sg-stat-lbl { font-size: 7px; letter-spacing: 0.2em; color: rgba(255,255,255,0.22); margin-bottom: 2px; }
    .sg-stat-val {
      font-family: 'Orbitron', monospace; font-size: 20px; font-weight: 700;
      transition: color 0.3s, text-shadow 0.3s;
    }
    .sg-stat.danger { border-color: rgba(255,45,149,0.35); background: rgba(255,45,149,0.06); }

    /* ── NEAR-WIN TENSION ── */
    .sg-app.near-win-state::before {
      content: '';
      position: fixed; inset: 0; z-index: 999; pointer-events: none;
      border: 3px solid #ff2d95;
      border-radius: 0;
      animation: nw-border-pulse 0.55s ease infinite alternate;
    }
    @keyframes nw-border-pulse {
      from { box-shadow: inset 0 0 30px rgba(255,45,149,0.25), 0 0 30px rgba(255,45,149,0.15); border-color: rgba(255,45,149,0.6); }
      to   { box-shadow: inset 0 0 60px rgba(255,45,149,0.5), 0 0 60px rgba(255,45,149,0.35); border-color: #ff2d95; }
    }

    /* Last move banner */
    .sg-last-move-banner {
      margin: 0 14px 4px; padding: 6px 14px;
      background: linear-gradient(90deg, rgba(255,45,149,0.18), rgba(255,170,0,0.12));
      border: 1px solid rgba(255,45,149,0.5);
      border-radius: 10px; text-align: center; flex-shrink: 0;
      font-family: 'Orbitron', monospace; font-size: 11px; font-weight: 900;
      letter-spacing: 0.14em; color: #ff2d95;
      animation: last-move-flash 0.4s ease infinite alternate;
    }
    @keyframes last-move-flash {
      from { opacity: 0.75; } to { opacity: 1; }
    }

    /* Near-win modal extras */
    .sg-nw-bldg-row {
      display: flex; align-items: center; gap: 10px;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px; padding: 9px 12px; margin-bottom: 6px; text-align: left;
    }
    .sg-nw-bldg-icon { font-size: 20px; flex-shrink: 0; }
    .sg-nw-bldg-info { flex: 1; }
    .sg-nw-bldg-name { font-size: 12px; font-weight: 700; margin-bottom: 2px; }
    .sg-nw-bldg-need { font-size: 10px; color: rgba(255,255,255,0.4); }
    .sg-nw-track { height: 4px; background: rgba(255,255,255,0.08); border-radius: 2px; margin-top: 5px; overflow: hidden; }
    .sg-nw-fill  { height: 100%; border-radius: 2px; transition: width 0.4s ease; }

    /* Fail breakdown in lose modal */
    .sg-fail-reason {
      background: rgba(255,45,149,0.06); border: 1px solid rgba(255,45,149,0.18);
      border-radius: 10px; padding: 10px 14px; margin: 10px 0;
      font-size: 11px; color: rgba(255,255,255,0.5); line-height: 1.6; text-align: left;
    }
    .sg-fail-line { display: flex; align-items: center; gap: 7px; margin-bottom: 3px; }
    .sg-fail-line:last-child { margin-bottom: 0; }
    .sg-fail-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

    /* ── CORRUPTION WARN ── */
    .sg-crpt-warn {
      margin: 0 14px 4px;
      background: rgba(255,45,149,0.08);
      border: 1px solid rgba(255,45,149,0.3);
      border-radius: 8px; padding: 5px 12px;
      font-size: 10px; color: var(--mag); text-align: center;
      letter-spacing: 0.1em; flex-shrink: 0;
      animation: blink 0.7s ease infinite alternate;
    }
    @keyframes blink { from { opacity: 0.6; } to { opacity: 1; } }

    /* ── TOASTS ── */
    .sg-toasts {
      min-height: 28px; display: flex; align-items: center; justify-content: center;
      gap: 10px; flex-wrap: wrap; padding: 0 14px 2px; flex-shrink: 0;
    }
    .sg-toast {
      font-family: 'Share Tech Mono', monospace; font-size: 12px; font-weight: 700;
      letter-spacing: 0.08em;
      animation: toast-in 0.28s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes toast-in {
      from { opacity: 0; transform: scale(0.6) translateY(6px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* ── GRID AREA ── */
    .sg-grid-area {
      display: flex; flex-direction: column; align-items: center;
      gap: var(--gap); flex-shrink: 0; padding: 0 14px;
    }
    .sg-col-btns { display: flex; gap: var(--gap); padding: 0 calc(var(--bw) + var(--gap)); }
    .sg-grid-row { display: flex; gap: var(--gap); align-items: center; }

    /* Arrow shift buttons */
    .sg-shift-btn {
      width: var(--bw); height: var(--sz);
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 8px;
      color: rgba(255,255,255,0.25); font-size: 10px;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: all 0.12s; flex-shrink: 0;
      font-family: inherit;
    }
    .sg-shift-btn.col-btn { width: var(--sz); height: var(--bw); }
    .sg-shift-btn:hover:not(:disabled) {
      background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7);
      border-color: rgba(255,255,255,0.18);
    }
    .sg-shift-btn:active:not(:disabled) { transform: scale(0.82); }
    .sg-shift-btn:disabled { opacity: 0.1; cursor: default; }
    .sg-shift-btn.flash {
      background: rgba(255,255,255,0.18) !important;
      color: #fff !important; border-color: rgba(255,255,255,0.4) !important;
    }

    /* Grid row wrapper — clips sliding tiles */
    .sg-row-clip {
      overflow: hidden; border-radius: 11px;
      display: flex; gap: var(--gap);
    }
    .sg-col-clip-wrap {
      overflow: hidden; border-radius: 11px;
      display: inline-flex;
    }

    /* ── TILE ── */
    .sg-tile {
      width: var(--sz); height: var(--sz);
      border-radius: 11px; border: 2px solid;
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
      transition: box-shadow 0.12s, border-color 0.12s, background 0.08s;
      cursor: default; flex-shrink: 0;
      will-change: transform;
    }
    .sg-tile.matched {
      animation: tile-pop 0.44s cubic-bezier(0.36,0.07,0.19,0.97);
      z-index: 3;
    }
    @keyframes tile-pop {
      0%   { transform: scale(1); }
      25%  { transform: scale(1.28) rotate(5deg); }
      55%  { transform: scale(1.18) rotate(-3deg); }
      100% { transform: scale(1); }
    }
    .sg-tile.corrupt { cursor: default; }

    /* Tile inner shapes */
    .sg-node {
      width: 22px; height: 22px; border-radius: 4px;
      transform: rotate(45deg);
      position: relative; z-index: 2;
      transition: background 0.1s, box-shadow 0.1s;
    }
    .sg-node-ring {
      position: absolute; inset: -5px; border-radius: 7px;
      border: 1px solid; opacity: 0;
      transition: opacity 0.2s;
      transform: rotate(45deg);
    }
    .sg-tile.matched .sg-node-ring { opacity: 0.5; animation: ring-pulse 0.44s ease; }
    @keyframes ring-pulse { 0%{transform:rotate(45deg) scale(1)} 50%{transform:rotate(45deg) scale(1.6); opacity:0.6} 100%{transform:rotate(45deg) scale(2); opacity:0;} }

    .sg-tile-glow {
      position: absolute; inset: 0; pointer-events: none; z-index: 1;
      transition: opacity 0.12s;
    }

    /* Corrupt tile */
    .sg-corrupt-icon { font-size: 18px; z-index: 2; opacity: 0.7; filter: saturate(0.3); }
    .sg-corrupt-overlay {
      position: absolute; inset: 0;
      background: repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(150,0,220,0.08) 4px, rgba(150,0,220,0.08) 8px);
      pointer-events: none;
    }

    /* ── SLIDE ANIMATIONS ── */
    .slide-left  { animation: sl-left  var(--slide-dur) ease-out both; }
    .slide-right { animation: sl-right var(--slide-dur) ease-out both; }
    .slide-up    { animation: sl-up    var(--slide-dur) ease-out both; }
    .slide-down  { animation: sl-down  var(--slide-dur) ease-out both; }

    @keyframes sl-left  { from{transform:translateX(0)} to{transform:translateX(calc(-1*(var(--sz) + var(--gap))))} }
    @keyframes sl-right { from{transform:translateX(0)} to{transform:translateX(calc(var(--sz) + var(--gap)))} }
    @keyframes sl-up    { from{transform:translateY(0)} to{transform:translateY(calc(-1*(var(--sz) + var(--gap))))} }
    @keyframes sl-down  { from{transform:translateY(0)} to{transform:translateY(calc(var(--sz) + var(--gap)))} }

    /* ── BUILDINGS ── */
    .sg-bldg-list { padding: 0 14px 6px; flex-shrink: 0; }
    .sg-bldg-lbl { font-size: 8px; letter-spacing: 0.22em; color: rgba(255,255,255,0.18); margin-bottom: 6px; }
    .sg-bldg {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px; border-radius: 12px; border: 1px solid;
      margin-bottom: 5px; transition: all 0.45s;
      position: relative; overflow: hidden;
    }
    .sg-bldg::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.03) 100%);
    }
    .sg-bldg-icon { font-size: 20px; flex-shrink: 0; transition: filter 0.4s; }
    .sg-bldg-info { flex: 1; }
    .sg-bldg-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
    .sg-bldg-name { font-size: 13px; font-weight: 600; transition: color 0.4s; }
    .sg-bldg-count { font-family: 'Share Tech Mono', monospace; font-size: 11px; }
    .sg-bldg-track { height: 4px; background: rgba(255,255,255,0.07); border-radius: 2px; overflow: hidden; }
    .sg-bldg-fill { height: 100%; border-radius: 2px; transition: width 0.5s ease, box-shadow 0.4s; }
    .sg-bldg-sub { font-size: 9px; margin-top: 3px; color: rgba(255,255,255,0.2); letter-spacing: 0.08em; }

    .sg-bldg.online .sg-bldg-icon::after {
      content: ''; display: block; width: 6px; height: 6px; border-radius: 50%;
      background: var(--green); margin: -6px auto 0;
      box-shadow: 0 0 6px var(--green);
      animation: dot-pulse 1.2s ease infinite;
    }
    @keyframes dot-pulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }

    .sg-hint { font-size: 10px; color: rgba(255,255,255,0.15); text-align: center; padding: 6px 20px 8px; line-height: 1.5; flex-shrink: 0; }

    /* Swipe hint */
    .sg-swipe-hint {
      text-align: center; font-size: 9px; color: rgba(255,255,255,0.15);
      letter-spacing: 0.12em; padding: 2px 0 4px; flex-shrink: 0;
    }

    /* ── MODALS ── */
    .sg-overlay {
      position: fixed; inset: 0; z-index: 500;
      background: rgba(7,7,15,0.88);
      display: flex; align-items: center; justify-content: center;
      animation: overlay-in 0.25s ease;
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    }
    @keyframes overlay-in { from{opacity:0} to{opacity:1} }
    .sg-modal {
      background: rgba(13,13,26,0.98);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 24px; padding: 36px 28px;
      max-width: 320px; width: 90%; text-align: center;
      animation: modal-in 0.35s cubic-bezier(0.34,1.56,0.64,1);
      position: relative; overflow: hidden;
    }
    .sg-modal::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(0,229,255,0.06) 0%, transparent 70%);
    }
    @keyframes modal-in { from{opacity:0;transform:scale(0.85) translateY(20px)} to{opacity:1;transform:scale(1) translateY(0)} }
    .sg-modal-icon { font-size: 52px; margin-bottom: 10px; display: block; }
    .sg-modal-title { font-family: 'Orbitron', monospace; font-size: clamp(15px,4vw,20px); font-weight: 900; letter-spacing: 0.08em; margin-bottom: 4px; }
    .sg-modal-sub { font-size: 12px; color: rgba(255,255,255,0.3); margin-bottom: 16px; }
    .sg-modal-rewards { display: flex; gap: 8px; justify-content: center; margin: 12px 0 20px; }
    .sg-reward-chip {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px; padding: 8px 16px;
      font-family: 'Share Tech Mono', monospace; font-size: 13px;
    }
    .sg-modal-btn {
      border: none; border-radius: 14px; padding: 14px 28px;
      font-family: 'Orbitron', monospace; font-size: 10px; font-weight: 700;
      color: #06060f; cursor: pointer; letter-spacing: 0.1em;
      transition: transform 0.12s, opacity 0.12s; display: inline-block;
    }
    .sg-modal-btn:hover { opacity: 0.88; transform: scale(1.04); }
    .sg-modal-btn:active { transform: scale(0.96); }
    .sg-modal-ghost {
      background: rgba(255,255,255,0.07) !important; color: rgba(255,255,255,0.7) !important;
      border: 1px solid rgba(255,255,255,0.14) !important;
    }
    .sg-modal-row { display: flex; gap: 10px; justify-content: center; }

    /* ── CITY TAB ── */
    .sg-district-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .sg-district-card {
      border: 1px solid; border-radius: 14px; padding: 14px 10px;
      text-align: center; transition: all 0.3s;
    }
    .sg-district-emoji { font-size: 26px; margin-bottom: 5px; }
    .sg-district-name { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; }
    .sg-district-status { font-size: 8px; letter-spacing: 0.14em; margin-top: 4px; opacity: 0.5; }

    .sg-idle-card {
      display: flex; align-items: center; justify-content: space-between;
      background: rgba(255,170,0,0.05); border: 1px solid rgba(255,170,0,0.15);
      border-radius: 14px; padding: 14px 16px; margin-bottom: 8px;
    }
    .sg-idle-amt { font-family: 'Orbitron', monospace; font-size: 24px; color: var(--amber); font-weight: 700; margin-top: 4px; }
    .sg-idle-note { font-size: 10px; color: rgba(255,255,255,0.22); margin-top: 3px; }
    .sg-collect-btn {
      background: linear-gradient(135deg, var(--amber), #ff7700);
      border: none; border-radius: 10px; padding: 11px 16px;
      font-family: 'Orbitron', monospace; font-size: 9px; font-weight: 700;
      color: #06060f; cursor: pointer; transition: transform 0.12s, opacity 0.12s;
      white-space: nowrap;
    }
    .sg-collect-btn:hover:not(:disabled) { transform: scale(1.05); }
    .sg-collect-btn:disabled { opacity: 0.3; }

    .sg-meta-chips { display: flex; gap: 8px; margin-bottom: 4px; }
    .sg-meta-chip {
      flex: 1; background: rgba(255,255,255,0.04); border: 1px solid var(--border);
      border-radius: 12px; padding: 10px; text-align: center;
    }
    .sg-meta-chip-val { font-family: 'Orbitron', monospace; font-size: 18px; font-weight: 700; }
