          <div className="sg-daily-lb-hdr">TODAY'S LEADERBOARD — CRISIS #{seed%1000}</div>
          {lb.slice(0, 10).map(function(row, i) {
            var rankColor = i===0?"#ffaa00":i===1?"rgba(255,255,255,0.55)":i===2?"#ff7700":"rgba(255,255,255,0.28)";
            var medal = i===0?"🥇":i===1?"🥈":i===2?"🥉":("#"+(i+1));
            return (
              <div key={i} className={"sg-daily-lb-row"+(row.you?" you-row":"")}>
                <div className="sg-daily-lb-rank" style={{color:rankColor}}>{medal}</div>
                <div className="sg-daily-lb-name" style={{color:row.you?"#00e5ff":"rgba(255,255,255,0.65)"}}>
                  {row.name}{row.you?" (You)":""}
                </div>
                <div className="sg-daily-lb-score">{row.score.toLocaleString()}</div>
                {!row.you && <div className="sg-daily-lb-moves">{row.moves}mv</div>}
              </div>
            );
          })}
          {/* Always show player row if outside top 10 */}
          {rank > 10 && (
            <div className="sg-daily-lb-row you-row" style={{borderTop:"1px solid rgba(255,255,255,0.08)"}}>
              <div className="sg-daily-lb-rank" style={{color:"#00e5ff"}}>{"#"+rank}</div>
              <div className="sg-daily-lb-name" style={{color:"#00e5ff"}}>You</div>
              <div className="sg-daily-lb-score">{dailyFinalScore.toLocaleString()}</div>
            </div>
          )}
        </div>
      )}

      {/* TIER REWARDS (pre-play) */}
      {!played && (
        <>
          <div className="sg-label">RANK REWARDS</div>
          <div style={{display:"flex",gap:8,marginBottom:10}}>
            {[
              {label:"TOP 10%",  color:"#ffaa00", coins:80, parts:5},
              {label:"TOP 50%",  color:"#00e5ff", coins:40, parts:2},
              {label:"PLAYED",   color:"rgba(255,255,255,0.4)", coins:20, parts:1},
            ].map(function(t,i){
              return (
                <div key={i} style={{flex:1,background:"rgba(255,255,255,0.03)",border:"1px solid rgba(255,255,255,0.07)",borderRadius:12,padding:"10px 6px",textAlign:"center"}}>
                  <div style={{fontSize:9,fontWeight:700,color:t.color,letterSpacing:"0.1em",marginBottom:5}}>{t.label}</div>
                  <div style={{fontFamily:"'Share Tech Mono',monospace",fontSize:11,color:"#ffaa00",marginBottom:2}}>+{t.coins} coins</div>
