    .sg-edit-tile:hover { transform: scale(1.08); }
    .sg-editor-panel {
      background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: 14px; padding: 14px; display: flex; flex-direction: column; gap: 11px;
      margin-bottom: 10px;
