/* ─── SQUAD TAB ─────────────────────────────────────────────────── */
function SquadTab(props){
  var meta=props.meta, setMeta=props.setMeta, xpData=props.xpData;
  var _squad=React.useState(loadSquad); var squad=_squad[0]; var setSquad=_squad[1];
  var _name=React.useState(""); var newName=_name[0]; var setNewName=_name[1];
  var _pname=React.useState(meta.engineerName||"RYKER"); var playerName=_pname[0]; var setPlayerName=_pname[1];

  var cleared=(meta.levelsCleared||[]).length;
  var obj=getWeeklySquadObjective();

  function handleCreate(){
    if(!newName.trim()) return;
    var s=createSquad(newName, playerName);
    setSquad(s); Audio.win(); Haptics.medium();
  }
  function handleLeave(){
    if(!window.confirm("Leave squad?")) return;
    saveSquad(null); setSquad(null);
  }

  /* Player's weekly contribution */
  function getPlayerWeekly(type){
    /* Read actual tracked data if available, else estimate from cleared */
    var pw=squad&&squad.playerWeekly?squad.playerWeekly:{};
    if(type==="levels")   return pw.levels!=null?Math.min(obj.goal,pw.levels):Math.min(obj.goal, Math.floor(cleared/3));
    if(type==="cascades") return Math.min(30, cleared*2);
    if(type==="corrupt")  return Math.min(100, cleared*5);
    if(type==="stars3")   return pw.stars3!=null?Math.min(obj.goal,pw.stars3):Math.min(15, Math.floor(cleared*0.6));
    return 0;
  }

  if(!squad){
    return (
      <div style={{paddingBottom:16}}>
        <div className="sg-create-squad">
          <div style={{fontSize:36,marginBottom:10}}>⚡</div>
          <div style={{fontFamily:"'Orbitron',monospace",fontSize:14,fontWeight:900,letterSpacing:"0.1em",color:"rgba(255,255,255,0.7)",marginBottom:6}}>CREATE A SQUAD</div>
          <div style={{fontSize:11,color:"rgba(255,255,255,0.35)",marginBottom:16,lineHeight:1.6}}>Form a team of up to 5 engineers. Complete weekly objectives together. Earn exclusive squad rewards.</div>
          <input className="sg-squad-input" placeholder="SQUAD NAME" maxLength={16}
            value={newName} onChange={function(e){ setNewName(e.target.value.toUpperCase()); }}/>
          <button onClick={handleCreate}
            style={{width:"100%",background:"linear-gradient(135deg,#a855f7,#ff2d95)",border:"none",borderRadius:12,padding:"14px",color:"#fff",fontFamily:"'Orbitron',monospace",fontSize:11,fontWeight:700,cursor:"pointer",letterSpacing:"0.1em"}}>
            ⚡ CREATE SQUAD
          </button>
        </div>
      </div>
    );
  }

  var memberTotals=getSquadTotals(squad, obj.type);
  var playerContrib=getPlayerWeekly(obj.type);
  var totalProgress=Math.min(obj.goal, memberTotals+playerContrib);
  var pct=Math.min(100,(totalProgress/obj.goal)*100);
  var isComplete=totalProgress>=obj.goal;

  /* Leaderboard within squad */
  var leaderboard = squad.members.map(function(m){
    var contrib=0;
    if(obj.type==="levels")   contrib=m.weeklyLevels||0;
    if(obj.type==="cascades") contrib=m.weeklyCascades||0;
    if(obj.type==="corrupt")  contrib=m.weeklyCorrupt||0;
    if(obj.type==="stars3")   contrib=m.weeklyStars3||0;
    return Object.assign({},m,{contrib:contrib});
  }).concat([{name:squad.playerName||"YOU",avatar:"👷",level:xpData?xpData.level:1,online:true,contrib:playerContrib,isYou:true}])
    .sort(function(a,b){ return b.contrib-a.contrib; });

  return (
    <div style={{paddingBottom:16}}>
      <div className="sg-squad-card">
        <div className="sg-squad-banner" style={{background:"linear-gradient(90deg,#a855f7,#ff2d95)"}}/>
        <div style={{display:"flex",alignItems:"flex-start",justifyContent:"space-between",marginBottom:4}}>
          <div>
            <div className="sg-squad-name" style={{color:"#a855f7"}}>{squad.name}</div>
            <div className="sg-squad-tag">{squad.tag} · {squad.members.length+1} MEMBERS</div>
          </div>
          <button onClick={handleLeave}
            style={{background:"none",border:"1px solid rgba(255,255,255,0.1)",borderRadius:8,padding:"5px 10px",color:"rgba(255,255,255,0.25)",fontSize:9,cursor:"pointer",letterSpacing:"0.06em"}}>LEAVE</button>
        </div>

        {/* Member list */}
        <div className="sg-squad-members">
          {leaderboard.slice(0,4).map(function(m,i){
            return (
              <div key={i} className={"sg-squad-member"+(m.isYou?" you":"")}>
                <span className="sg-squad-avatar">{m.avatar}</span>
                <div style={{flex:1,minWidth:0}}>
                  <div className="sg-squad-member-name">{m.name}{m.isYou?" (You)":""}</div>
                  <div className="sg-squad-member-stat">Lv{m.level} · {m.contrib} this week</div>
                </div>
                {m.online&&<div className="sg-squad-member-online"/>}
              </div>
            );
          })}
        </div>

        {/* Weekly objective */}
        <div className="sg-squad-objective">
          <div className="sg-squad-obj-header">
            <div className="sg-squad-obj-title">⚡ WEEKLY SQUAD OBJECTIVE</div>
            <div className="sg-squad-obj-reward">+{obj.reward.coins}⬡ {obj.reward.chest?"+ "+CHEST_DEFS[obj.reward.chest].icon:""}</div>
          </div>
          <div className="sg-squad-obj-name">{obj.name}</div>
          <div className="sg-squad-obj-desc">{obj.desc}</div>
          <div className="sg-squad-progress-track">
            <div className="sg-squad-progress-fill" style={{width:pct+"%",background:isComplete?"linear-gradient(90deg,#00ff88,#00e5ff)":"linear-gradient(90deg,#a855f7,#ff2d95)"}}/>
          </div>
          <div className="sg-squad-progress-nums">
            <span>{totalProgress.toLocaleString()} / {obj.goal.toLocaleString()}</span>
            <span style={{color:isComplete?"#00ff88":"rgba(255,255,255,0.25)"}}>{isComplete?"✓ COMPLETE!":Math.round(pct)+"%"}</span>
          </div>
        </div>

        {isComplete&&(
          <div style={{background:"rgba(0,255,136,0.08)",border:"1px solid rgba(0,255,136,0.3)",borderRadius:10,padding:"10px 14px",textAlign:"center"}}>
            <div style={{fontSize:11,color:"#00ff88",fontWeight:700,letterSpacing:"0.08em",marginBottom:4}}>🏆 SQUAD OBJECTIVE COMPLETE!</div>
            <div style={{fontSize:10,color:"rgba(255,255,255,0.4)"}}>Rewards distributed to all members</div>
          </div>
        )}
      </div>
    </div>
  );
}

/* ─── GIFTING TAB ────────────────────────────────────────────────── */
function GiftingTab(props){
  var meta=props.meta, setMeta=props.setMeta, lives=props.lives, setLives=props.setLives;
  var _squadState=React.useState(loadSquad); var squad=_squadState[0];
  var _gifts=React.useState(loadGifts); var gifts=_gifts[0]; var setGifts=_gifts[1];
  var _sent=React.useState(null); var sentMsg=_sent[0]; var setSentMsg=_sent[1];

  /* Simulate inbox from squad members — seeded daily */
  var inboxSim = React.useMemo(function(){
    var sqd=loadSquad(); /* read fresh for memoization */
    if(!sqd||!sqd.members) return [];
    var today=todayStr();
    var rng=mkSeededRng(parseInt(today.replace(/-/g,""))%99999);
    return sqd.members.slice(0,2).map(function(m,i){
      var giftIdx=Math.floor(rng()*GIFT_DEFS.length);
      var def=GIFT_DEFS[giftIdx];
      return {id:"sim_"+today+"_"+i, from:m.name, avatar:m.avatar, gift:def, claimed:false};
    });
  },[]);

  var [inboxItems,setInboxItems]=React.useState(inboxSim);

  function sendGift(giftDef, recipient){
    var sentToday=getGiftSentToday(giftDef.id);
    if(sentToday>=giftDef.dailyLimit){ setSentMsg("Daily limit reached for "+giftDef.name); return; }
    if(giftDef.cost>0&&meta.coins<giftDef.cost){ setSentMsg("Not enough coins!"); return; }
    /* Deduct cost */
    if(giftDef.cost>0){
      setMeta(function(m){ var n=Object.assign({},m,{coins:m.coins-giftDef.cost}); saveMeta(n); return n; });
    }
    var g=loadGifts(); var today=todayStr();
    if(g.lastReset!==today){ g.sent=[]; g.lastReset=today; }
    g.sent=(g.sent||[]).concat([{id:giftDef.id,to:recipient,ts:Date.now()}]);
    saveGifts(g); setGifts(Object.assign({},g));
    setSentMsg("❤️ "+giftDef.name+" sent to "+recipient+"!");
    setTimeout(function(){ setSentMsg(null); },2500);
    Audio.win(); Haptics.light();
  }

  function claimGift(item){
    var def=item.gift;
    /* Apply reward */
    if(def.reward.lives){
      var fresh=loadLives();
      var upd={count:Math.min(MAX_LIVES,fresh.count+def.reward.lives),lastRegen:fresh.lastRegen};
      saveLives(upd); setLives(upd);
    }
    if(def.reward.coins){
      setMeta(function(m){ var n=Object.assign({},m,{coins:m.coins+(def.reward.coins||0)}); saveMeta(n); return n; });
    }
    if(def.reward.chest){
      setMeta(function(m){ var nc=Object.assign({},m.chests||{}); nc[def.reward.chest]=(nc[def.reward.chest]||0)+1; var n=Object.assign({},m,{chests:nc}); saveMeta(n); return n; });
    }
    if(def.reward.abilities){
      var ab=loadAbilities(); Object.keys(def.reward.abilities).forEach(function(k){ ab[k]=(ab[k]||0)+def.reward.abilities[k]; }); saveAbilities(ab);
    }
    setInboxItems(function(prev){ return prev.map(function(x){ return x.id===item.id?Object.assign({},x,{claimed:true}):x; }); });
    Audio.win(); Haptics.medium();
  }

  var members=squad?squad.members:[];

  return (
    <div style={{paddingBottom:16}}>
      {/* INBOX */}
      <div className="sg-label" style={{marginTop:8}}>📬 INBOX {inboxItems.filter(function(x){return !x.claimed;}).length>0?"("+inboxItems.filter(function(x){return !x.claimed;}).length+" new)":""}</div>
      {inboxItems.length===0&&(
        <div style={{textAlign:"center",padding:"20px",color:"rgba(255,255,255,0.2)",fontSize:11}}>
          {squad?"Your squadmates haven't sent anything yet today.":"Join a squad to receive gifts!"}
        </div>
      )}
      {inboxItems.map(function(item){
        return (
          <div key={item.id} className="sg-inbox-item" style={{opacity:item.claimed?0.45:1}}>
            <span className="sg-inbox-icon">{item.avatar}</span>
            <div className="sg-inbox-text">
              <strong style={{color:"rgba(255,255,255,0.85)"}}>{item.from}</strong> sent you a {item.gift.name}
              <div style={{fontSize:9,color:"rgba(255,255,255,0.3)",marginTop:2}}>Tap to claim {item.gift.icon}</div>
            </div>
            {!item.claimed?(
              <button className="sg-inbox-claim" onClick={function(){ claimGift(item); }}>CLAIM</button>
            ):(
              <div style={{fontSize:10,color:"#00ff88",fontWeight:700,flexShrink:0}}>✓ CLAIMED</div>
            )}
          </div>
        );
      })}

      {/* SEND GIFTS */}
      {squad&&members.length>0&&(
        <>
          <div className="sg-label">SEND A GIFT</div>
          {sentMsg&&<div style={{textAlign:"center",fontSize:11,color:"#00ff88",padding:"6px",marginBottom:8,fontWeight:700}}>{sentMsg}</div>}
          {/* Pick recipient */}
          <div style={{fontSize:9,color:"rgba(255,255,255,0.3)",marginBottom:8,letterSpacing:"0.1em"}}>SENDING TO: {members[0].name}</div>
          <div className="sg-gift-row">
            {GIFT_DEFS.map(function(gd){
              var sentToday=getGiftSentToday(gd.id);
              var atLimit=sentToday>=gd.dailyLimit;
              var cantAfford=gd.cost>0&&meta.coins<gd.cost;
              return (
                <div key={gd.id}
                  className="sg-gift-card"
                  style={{
                    borderColor:atLimit?"rgba(255,255,255,0.06)":gd.color+"44",
                    background:atLimit?"rgba(255,255,255,0.02)":gd.color+"0a",
                    opacity:(atLimit||cantAfford)?0.4:1,
                    cursor:(atLimit||cantAfford)?"default":"pointer",
                  }}
                  onClick={function(){ if(!atLimit&&!cantAfford) sendGift(gd,members[0].name); }}>
                  {atLimit&&<div className="sg-gift-sent-badge">✓</div>}
                  <span className="sg-gift-icon">{gd.icon}</span>
                  <div className="sg-gift-name" style={{color:gd.color}}>{gd.name}</div>
                  <div className="sg-gift-cost">{gd.cost===0?"FREE":gd.cost+"⬡"}</div>
                  <div style={{fontSize:8,color:"rgba(255,255,255,0.2)",marginTop:2}}>{sentToday}/{gd.dailyLimit}/day</div>
                </div>
              );
            })}
          </div>
          <div style={{fontSize:9,color:"rgba(255,255,255,0.2)",textAlign:"center",letterSpacing:"0.06em"}}>❤️ Sending lives is always free · All gifts reset daily</div>
        </>
      )}
      {!squad&&(
        <div style={{textAlign:"center",padding:"20px 10px",color:"rgba(255,255,255,0.25)",fontSize:11,lineHeight:1.7}}>
          Create or join a squad to send and receive gifts.
          <br/><span style={{color:"rgba(168,85,247,0.6)"}}>SQUAD tab → Create a Squad</span>
        </div>
      )}
    </div>
  );
}

/* ─── BRACKET TOURNAMENT ─────────────────────────────────────────── */
function BracketTab(props){
  var meta=props.meta, setMeta=props.setMeta, onPlay=props.onPlay;
  var week=Math.floor(Date.now()/(7*24*60*60*1000));
  var _bracket=React.useState(function(){ return loadBracket()||{round:0,wins:0,losses:0,weekSeed:week,scores:[]}; });
  var bracket=_bracket[0]; var setBracket=_bracket[1];
  var _result=React.useState(null); var result=_result[0]; var setResult=_result[1];

  /* Reset bracket weekly - via useEffect to avoid render-time setState */
  React.useEffect(function(){
    if(bracket.weekSeed!==week){
      var fresh={round:0,wins:0,losses:0,weekSeed:week,scores:[]};
      saveBracket(fresh); setBracket(fresh);
    }
  },[week]);

  var phase=getBracketPhase(bracket);
  var todaySeedVal=week*1000+bracket.round;
  var bracketBoard={id:"bracket_"+todaySeedVal,name:"TOURNAMENT MATCH",moves:12,bids:["apt","factory","lab","power"],hazards:4,rngSeed:todaySeedVal,isDaily:true,hint:"Tournament board — same for all competitors. Score determines advancement."};

  /* Build bracket tree */
  var allPlayers=[{name:"YOU",avatar:"👷",seed:meta.shiftWarsBest||500,isYou:true}].concat(BRACKET_PLAYERS);
  var r1Matches=genBracketRound(allPlayers.slice(0,8), week);

  function handleMatchComplete(r){
    var finalScore=r.score+(r.movesLeft||0)*80;
    var opponents=r1Matches.filter(function(m){ return m.p1.isYou||m.p2.isYou; });
    var myMatch=opponents[0]||r1Matches[0];
    var opp=myMatch?(myMatch.p1.isYou?myMatch.p2:myMatch.p1):BRACKET_PLAYERS[0];
    var oppScore=simulateMatchScore(opp, week, bracket.round);
    var won=finalScore>oppScore;
    var newBracket=Object.assign({},bracket,{
      round:bracket.round+1,
      wins:(bracket.wins||0)+(won?1:0),
      losses:(bracket.losses||0)+(!won?1:0),
      scores:(bracket.scores||[]).concat([{round:bracket.round,score:finalScore,oppScore:oppScore,won:won}]),
    });
    saveBracket(newBracket); setBracket(newBracket);
    /* Rewards for advancing */
    if(won){
      var coins=bracket.round===0?100:bracket.round===1?250:500;
      var chest=bracket.round>=2?"gold":bracket.round>=1?"silver":null;
      setMeta(function(m){
        var nc=Object.assign({},m.chests||{});
        if(chest) nc[chest]=(nc[chest]||0)+1;
        var n=Object.assign({},m,{coins:m.coins+coins,chests:nc});
        saveMeta(n); return n;
      });
      setResult({won:true,finalScore:finalScore,oppScore:oppScore,opp:opp,coins:coins,chest:chest,round:bracket.round});
    } else {
      setResult({won:false,finalScore:finalScore,oppScore:oppScore,opp:opp,round:bracket.round});
    }
  }

  var canPlay=bracket.round<3&&(bracket.losses||0)<1; /* single elimination */

  return (
    <div style={{paddingBottom:16}}>
      <div className="sg-bracket-hero">
        <div style={{position:"absolute",top:0,left:0,right:0,height:3,background:"linear-gradient(90deg,#ffaa00,#ff2d95,#a855f7)"}}/>
        <div style={{fontSize:32,marginBottom:6}}>🏆</div>
        <div className="sg-bracket-title">WEEKLY TOURNAMENT</div>
        <div className="sg-bracket-sub">8-player single elimination · Same board for all · Score determines who advances</div>
        <div className="sg-bracket-phase">{phase}</div>
        {/* Wins */}
        <div style={{display:"flex",gap:10,justifyContent:"center",marginBottom:14}}>
          {[0,1,2].map(function(r){
            var s=bracket.scores?bracket.scores.find(function(x){ return x.round===r; }):null;
            return (
              <div key={r} style={{background:"rgba(255,255,255,0.05)",border:"1px solid "+(s?s.won?"rgba(0,255,136,0.35)":"rgba(255,45,149,0.35)":"rgba(255,255,255,0.08)"),borderRadius:10,padding:"8px 14px",textAlign:"center",minWidth:70}}>
                <div style={{fontSize:9,color:"rgba(255,255,255,0.3)",letterSpacing:"0.1em",marginBottom:3}}>{r===0?"R1":r===1?"SEMI":"FINAL"}</div>
                {s?(
                  <div style={{fontFamily:"'Orbitron',monospace",fontSize:13,fontWeight:700,color:s.won?"#00ff88":"#ff2d95"}}>{s.won?"WIN":"LOSS"}</div>
                ):(
                  <div style={{fontSize:11,color:"rgba(255,255,255,0.15)"}}>—</div>
                )}
              </div>
            );
          })}
        </div>
        {canPlay?(
          <button onClick={function(){ onPlay(bracketBoard, handleMatchComplete); }}
            style={{background:"linear-gradient(135deg,#ffaa00,#ff2d95)",border:"none",borderRadius:14,padding:"14px 32px",color:"#06060f",fontFamily:"'Orbitron',monospace",fontSize:11,fontWeight:700,cursor:"pointer",letterSpacing:"0.1em",boxShadow:"0 0 20px rgba(255,170,0,0.3)"}}>
            ⚔️ PLAY {phase}
