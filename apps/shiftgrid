  var distStates = getCityDistrictState(levelsCleared);
  var cleared = levelsCleared.length;

  /* District configs */
  var DIST_CONFIGS = [
    { label:"D1",  x:"3%",   theme:"#00e5ff", bldgs:[{h:72,w:13,lit:distStates[0]==="glowing"||distStates[0]==="restored"}] },
    { label:"D2",  x:"13%",  theme:"#ffaa00", bldgs:[{h:88,w:12,lit:distStates[1]==="glowing"||distStates[1]==="restored"}] },
    { label:"D3",  x:"23%",  theme:"#ff2d95", bldgs:[{h:104,w:13,lit:distStates[2]==="glowing"||distStates[2]==="restored"}] },
    { label:"D4",  x:"33%",  theme:"#a855f7", bldgs:[{h:80,w:11,lit:distStates[3]==="glowing"||distStates[3]==="restored"}] },
    { label:"D5",  x:"43%",  theme:"#00ff88", bldgs:[{h:96,w:14,lit:distStates[4]==="glowing"||distStates[4]==="restored"}] },
    { label:"D6",  x:"53%",  theme:"#64a0ff", bldgs:[{h:85,w:12,lit:distStates[5]==="glowing"||distStates[5]==="restored"}] },
    { label:"D7",  x:"62%",  theme:"#ffdc00", bldgs:[{h:78,w:13,lit:distStates[6]==="glowing"||distStates[6]==="restored"}] },
    { label:"D8",  x:"71%",  theme:"#8888aa", bldgs:[{h:92,w:11,lit:distStates[7]==="glowing"||distStates[7]==="restored"}] },
    { label:"D9",  x:"80%",  theme:"#ff8c00", bldgs:[{h:100,w:13,lit:distStates[8]==="glowing"||distStates[8]==="restored"}] },
    { label:"D10", x:"89%",  theme:"#ff2d95", bldgs:[{h:116,w:14,lit:distStates[9]==="glowing"||distStates[9]==="restored"}] },
  ];

  /* Starfield */
  var stars = [];
  for(var si=0;si<20;si++){
    stars.push({
      left:((si*37+13)%95)+"%",
      top: ((si*53+7)%60)+"%",
      size: (si%3===0)?2:1,
      dur:  (2+(si%4))+"s",
      lo:   0.1+((si%4)*0.1),
