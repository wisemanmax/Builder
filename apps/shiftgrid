    .sg-action-row { display: flex; gap: 8px; }
    .sg-action-btn {
      flex: 1; padding: 11px 8px; border-radius: 11px; border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.6);
