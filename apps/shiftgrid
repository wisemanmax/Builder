.sg-star-pip { font-size:10px; opacity:0.3; transition:opacity 0.3s; }
.sg-star-pip.lit { opacity:1; filter:drop-shadow(0 0 4px #ffaa00); }

/* Star chain reward burst */
.sg-star-chain-burst {
  position:fixed; inset:0; z-index:700; pointer-events:none;
  display:flex; align-items:center; justify-content:center;
  animation:overlay-in 0.2s ease;
}
