/* ─── DAILY TAB ─────────────────────────────────────────────────── */
function DailyTab(props) {
  const meta=props.meta, setMeta=props.setMeta, onPlay=props.onPlay;
  const seed=todaySeed(), today=String(seed), played=meta.dailyDate===today;
  const _copied=React.useState(false); var copied=_copied[0]; var setCopied=_copied[1];

  const dailyDef={id:"daily",name:"DAILY POWER CRISIS",moves:16,bids:["apt","factory","lab","power"],hazards:5,rngSeed:seed,isDaily:true,hint:"Same board for everyone today — fewest moves wins!"};

  /* Scoring */
  var dailyFinalScore = meta.dailyFinalScore || 0;
  var dailyMovesLeft  = meta.dailyMovesLeft  || 0;
  var dailyStars      = meta.dailyStars      || 0;

  var lb = played ? genDailyLeaderboard(seed, dailyFinalScore) : [];
  var rank = played ? getDailyRank(lb) : 0;
  var tier = played ? getDailyTier(rank, lb.length) : null;
  var isPerfect = played && dailyStars === 3;

  function handleDailyComplete(r){
    var movesLeft = r.movesLeft || 0;
    var stars = calcStars(dailyDef.moves - movesLeft, dailyDef.moves);
    var finalScore = calcDailyScore(r.score || 0, movesLeft, dailyDef.moves, stars);
    var tierReward = getDailyTierReward(getDailyTier(getDailyRank(genDailyLeaderboard(seed, finalScore)), 20));
    setMeta(function(m){
      var n=Object.assign({},m,{
        dailyDate:today, dailyScore:r.score,
        dailyFinalScore: finalScore,
        dailyMovesLeft: movesLeft,
        dailyStars: stars,
        coins: m.coins + r.coins + tierReward.coins,
        parts: m.parts + r.parts + tierReward.parts,
      });
      saveMeta(n); return n;
    });
  }

  function shareResult() {
    var tierLabel = tier ? tier.label : "";
    var starsStr  = renderStars(dailyStars);
    var text = "🏙 SHIFTGRID Daily #" + (seed%1000) + "\n" +
               starsStr + "  " + tierLabel + "  Rank #" + rank + "\n" +
               "Score: " + dailyFinalScore.toLocaleString() + "\n" +
               "Moves left: " + dailyMovesLeft + "/" + dailyDef.moves + "\n" +
               "Play at shiftgrid.app";
    try {
      navigator.clipboard.writeText(text).then(function(){
        setCopied(true); setTimeout(function(){ setCopied(false); }, 2200);
      });
    } catch(e) { setCopied(true); setTimeout(function(){ setCopied(false); }, 2200); }
  }

  return (
    <div style={{paddingBottom:16}}>
      <div className="sg-daily-hero">
        <span className="sg-daily-city">🌆</span>
        <div className="sg-daily-num">{"CRISIS #"+(seed%1000)}</div>
        <div className="sg-daily-desc">Same broken district for everyone today. Score big and use fewer moves to rank higher.</div>
        <div className="sg-daily-specs">
          <div className="sg-spec"><div className="sg-spec-val">{dailyDef.moves}</div><div className="sg-spec-lbl" style={{color:"#00e5ff"}}>MOVES</div></div>
          <div className="sg-spec"><div className="sg-spec-val">{dailyDef.hazards}</div><div className="sg-spec-lbl" style={{color:"#ff2d95"}}>HAZARDS</div></div>
          <div className="sg-spec"><div className="sg-spec-val">{dailyDef.bids.length}</div><div className="sg-spec-lbl" style={{color:"#ffaa00"}}>BUILDINGS</div></div>
        </div>
        {played ? (
          <div className="sg-daily-done">
            <div style={{fontSize:28,marginBottom:4}}>✅</div>
            <div style={{fontSize:13,color:"#00ff88",fontWeight:700}}>Today Complete!</div>
            <div className="sg-daily-score">{dailyFinalScore.toLocaleString()}</div>
            <div style={{fontSize:10,color:"rgba(255,255,255,0.3)"}}>New board tomorrow</div>
          </div>
        ) : (
          <button className="sg-modal-btn" style={{background:"linear-gradient(135deg,#ff2d95,#ffaa00)",marginTop:4}} onClick={function(){ onPlay(dailyDef,handleDailyComplete); }}>PLAY TODAY</button>
        )}
      </div>

      {/* POST-PLAY: RANK CARD */}
      {played && tier && (
        <div className="sg-daily-rank-card" style={{background:"linear-gradient(135deg,"+tier.bg+",rgba(7,7,15,0.95))",border:"1px solid "+tier.border}}>
          <div className="sg-daily-rank-badge" style={{background:tier.bg,border:"1px solid "+tier.border,color:tier.color}}>{tier.label}</div>
          {isPerfect && <div className="sg-perfect-badge">⭐ PERFECT RUN — 3 STARS</div>}
          <div className="sg-daily-rank-pos" style={{color:tier.color}}>{"#"+rank}</div>
          <div className="sg-daily-rank-lbl">{"OUT OF " + lb.length + " PLAYERS TODAY"}</div>
          <div className="sg-daily-score-row">
            <div className="sg-daily-score-chip">
              <div className="sg-daily-score-val" style={{color:tier.color}}>{dailyFinalScore.toLocaleString()}</div>
              <div className="sg-daily-score-lbl">FINAL SCORE</div>
            </div>
            <div className="sg-daily-score-chip">
              <div className="sg-daily-score-val" style={{color:"#00e5ff"}}>{dailyMovesLeft}</div>
              <div className="sg-daily-score-lbl">MOVES LEFT</div>
            </div>
            <div className="sg-daily-score-chip">
              <div className="sg-daily-score-val" style={{color:"#ffaa00"}}>{renderStars(dailyStars)}</div>
              <div className="sg-daily-score-lbl">RATING</div>
