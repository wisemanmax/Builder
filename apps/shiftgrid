        <div style={{ fontSize: 11, color: "rgba(255,255,255,0.38)", marginBottom: 14, lineHeight: 1.5 }}>Same board for everyone today. Score big and use fewer moves to climb the board.</div>
        <div className="sg-spec-row">
          <div className="sg-spec-box"><span style={{ color: "#00e5ff", display: "block", fontSize: 8, letterSpacing: "0.14em", marginBottom: 3 }}>MOVES</span>{dailyDef.moves}</div>
          <div className="sg-spec-box"><span style={{ color: "#ff2d95", display: "block", fontSize: 8, letterSpacing: "0.14em", marginBottom: 3 }}>HAZARDS</span>{dailyDef.hazards}</div>
          <div className="sg-spec-box"><span style={{ color: "#ffaa00", display: "block", fontSize: 8, letterSpacing: "0.14em", marginBottom: 3 }}>BUILDINGS</span>{dailyDef.bids.length}</div>
        </div>
        {played
          ? (
            <div className="sg-daily-done">
              <div style={{ fontSize: 26, marginBottom: 4 }}>✅</div>
              <div style={{ fontSize: 12, color: "#00ff88", fontWeight: 600 }}>Complete!</div>
              <div style={{ fontFamily: "'Orbitron',monospace", fontSize: 20, color: "#ffaa00", margin: "6px 0 4px" }}>{(meta.dailyScore || 0).toLocaleString()}</div>
              <div style={{ fontSize: 9, color: "rgba(255,255,255,0.28)" }}>New board tomorrow</div>
            </div>
          )
          : (
            <button className="sg-modal-btn" style={{ background: "linear-gradient(90deg,#ff2d95,#ffaa00)", marginTop: 4 }} onClick={function() { onPlay(dailyDef, handleComplete); }}>
              PLAY TODAY
            </button>
          )
        }
      </div>
      <div className="sg-section-label" style={{ marginTop: 14 }}>BONUS ON COMPLETE</div>
      <div style={{ display: "flex", gap: 8 }}>
        {[{ icon: "⬡", val: "+20 coins", col: "#ffaa00" }, { icon: "◈", val: "+2 parts", col: "#00e5ff" }, { icon: "⭐", val: "District Star", col: "#00ff88" }].map(function(r, i) {
          return (
            <div key={i} style={{ flex: 1, background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.07)", borderRadius: 10, padding: "10px 6px", textAlign: "center" }}>
              <div style={{ fontSize: 18, marginBottom: 4 }}>{r.icon}</div>
              <div style={{ fontSize: 9, color: r.col }}>{r.val}</div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

/* ─── EDITOR TAB ────────────────────────────────────────────────── */
function EditorTab(props) {
  const meta = props.meta, setMeta = props.setMeta, onPlay = props.onPlay;
  const [brushColor, setBrushColor] = useState("cyan");
  const [brushMode, setBrushMode] = useState("color");
  const [board, setBoard] = useState(function() { return makeGrid(); });
  const [levelName, setLevelName] = useState("MY LEVEL");
  const [levelMoves, setLevelMoves] = useState(20);
  const [levelBids, setLevelBids] = useState(["apt", "factory"]);
  const [saved, setSaved] = useState(false);

  function paint(r, c) {
    setBoard(function(prev) {
      const g = prev.map(function(row) { return row.slice(); });
      if (brushMode === "corrupt") {
        g[r][c] = Object.assign({}, g[r][c], { corrupted: true });
      } else if (brushMode === "erase") {
        g[r][c] = Object.assign({}, g[r][c], { corrupted: false });
      } else {
        g[r][c] = Object.assign({}, g[r][c], { color: brushColor, corrupted: false });
      }
      return g;
    });
  }

  function buildTestDef() {
    return {
      id: "test", name: levelName || "MY LEVEL", moves: levelMoves, hazards: 0,
      bids: levelBids.length > 0 ? levelBids : ["apt"],
      boardData: board.map(function(row) { return row.map(function(t) { return Object.assign({}, t); }); }),
      hint: "Your custom level!",
    };
  }

  function saveLevel() {
    const lvl = Object.assign({}, buildTestDef(), { id: "custom_" + Date.now(), isCustom: true });
    setMeta(function(m) { const n = Object.assign({}, m, { customLevels: (m.customLevels || []).concat([lvl]) }); saveMeta(n); return n; });
    setSaved(true); setTimeout(function() { setSaved(false); }, 2000);
  }

  const SZ = 44;

  return (
    <div className="sg-tab-content">
      <div className="sg-tab-heading">LEVEL EDITOR</div>
      <div className="sg-section-label">PAINT BRUSH</div>
      <div style={{ display: "flex", gap: 5, flexWrap: "wrap", marginBottom: 10 }}>
        {COLORS.map(function(col) {
          const active = brushMode === "color" && brushColor === col;
          return (
            <button key={col} className="sg-brush-btn"
              style={{ background: active ? HEX[col] : HEX[col]+"25", borderColor: HEX[col], color: active ? "#06060f" : HEX[col] }}
              onClick={function() { setBrushColor(col); setBrushMode("color"); }}>
              {LABEL[col]}
            </button>
          );
        })}
        <button className="sg-brush-btn"
          style={{ background: brushMode === "corrupt" ? "rgba(160,0,240,0.3)" : "rgba(160,0,240,0.1)", borderColor: "#cc44ff", color: brushMode === "corrupt" ? "#fff" : "#cc44ff" }}
          onClick={function() { setBrushMode("corrupt"); }}>
          CORRUPT
        </button>
        <button className="sg-brush-btn"
          style={{ background: brushMode === "erase" ? "rgba(255,255,255,0.18)" : "rgba(255,255,255,0.05)", borderColor: "rgba(255,255,255,0.3)", color: "rgba(255,255,255,0.7)" }}
          onClick={function() { setBrushMode("erase"); }}>
          CLEAR
        </button>
      </div>

      <div style={{ display: "flex", flexDirection: "column", gap: 3, alignItems: "center", marginBottom: 12 }}>
        {board.map(function(row, r) {
          return (
            <div key={r} style={{ display: "flex", gap: 3 }}>
              {row.map(function(tile, c) {
                const isCr = tile && tile.corrupted;
                const hex = isCr ? null : (tile && tile.color ? HEX[tile.color] : null);
                return (
                  <div key={tile ? tile.id : (r+"-"+c)} onClick={function() { paint(r, c); }}
                    style={{ width: SZ, height: SZ, borderRadius: 8, cursor: "pointer", border: "2px solid " + (isCr ? "rgba(160,0,240,0.5)" : (hex ? hex+"77" : "rgba(255,255,255,0.1)")), background: isCr ? "rgba(38,0,55,0.9)" : (hex ? hex+"2e" : "rgba(255,255,255,0.04)"), display: "flex", alignItems: "center", justifyContent: "center", transition: "all 0.1s" }}>
                    {isCr
                      ? <span style={{ fontSize: 16 }}>☠</span>
                      : <div style={{ width: 18, height: 18, borderRadius: 3, transform: "rotate(45deg)", background: hex || "transparent" }} />
                    }
                  </div>
                );
              })}
            </div>
          );
        })}
      </div>

      <div className="sg-section-label">SETTINGS</div>
      <div className="sg-editor-panel">
        <div className="sg-setting-row">
          <label>Name</label>
          <input className="sg-input" value={levelName} onChange={function(e) { setLevelName(e.target.value); }} maxLength={24} />
        </div>
        <div className="sg-setting-row">
          <label>Moves</label>
          <div style={{ display: "flex", gap: 8, alignItems: "center" }}>
            <button className="sg-pill-btn" onClick={function() { setLevelMoves(function(m) { return Math.max(10, m - 2); }); }}>−</button>
            <span style={{ fontFamily: "'Orbitron',monospace", fontSize: 16, color: "#00e5ff", minWidth: 32, textAlign: "center" }}>{levelMoves}</span>
            <button className="sg-pill-btn" onClick={function() { setLevelMoves(function(m) { return Math.min(40, m + 2); }); }}>+</button>
          </div>
        </div>
        <div className="sg-setting-row" style={{ alignItems: "flex-start" }}>
          <label>Buildings</label>
          <div style={{ display: "flex", gap: 5, flexWrap: "wrap", flex: 1 }}>
            {BLDG_DEFS.map(function(b) {
              const on = levelBids.includes(b.id);
              return (
                <button key={b.id}
                  style={{ fontSize: 10, padding: "4px 8px", borderRadius: 6, border: "1px solid " + (on ? HEX[b.color] : "rgba(255,255,255,0.13)"), background: on ? HEX[b.color]+"22" : "rgba(255,255,255,0.04)", color: on ? HEX[b.color] : "rgba(255,255,255,0.38)", cursor: "pointer" }}
                  onClick={function() { setLevelBids(function(prev) { return on ? prev.filter(function(x) { return x !== b.id; }) : prev.concat([b.id]); }); }}>
                  {b.icon} {b.label}
                </button>
              );
            })}
          </div>
        </div>
      </div>

      <div style={{ display: "flex", gap: 8, marginTop: 12 }}>
        <button className="sg-pill-btn" style={{ flex: 1 }} onClick={function() { setBoard(makeGrid()); }}>RESET</button>
        <button className="sg-pill-btn" style={{ flex: 1, borderColor: "#ffaa00", color: "#ffaa00" }} onClick={function() { onPlay(buildTestDef(), function() {}); }}>TEST</button>
        <button className="sg-pill-btn" style={{ flex: 1, borderColor: saved ? "#00ff88" : "#00e5ff", color: saved ? "#00ff88" : "#00e5ff", background: saved ? "rgba(0,255,136,0.1)" : "rgba(0,229,255,0.08)" }} onClick={saveLevel}>{saved ? "SAVED" : "SAVE"}</button>
      </div>

      {(meta.customLevels || []).length > 0 && (
        <div style={{ marginTop: 16 }}>
          <div className="sg-section-label">SAVED LEVELS</div>
          {(meta.customLevels || []).map(function(lvl, i) {
            return (
              <div key={lvl.id} style={{ display: "flex", alignItems: "center", gap: 8, background: "rgba(255,255,255,0.03)", border: "1px solid rgba(255,255,255,0.07)", borderRadius: 10, padding: "10px 12px", marginBottom: 6 }}>
                <div style={{ flex: 1 }}>
                  <div style={{ fontSize: 12, fontWeight: 600, color: "rgba(255,255,255,0.8)" }}>{lvl.name}</div>
                  <div style={{ fontSize: 10, color: "rgba(255,255,255,0.28)" }}>{lvl.moves} moves</div>
                </div>
                <button className="sg-pill-btn" style={{ fontSize: 10 }} onClick={function() { onPlay(lvl, function() {}); }}>PLAY</button>
                <button className="sg-pill-btn" style={{ fontSize: 10, borderColor: "#ff2d95", color: "#ff2d95" }} onClick={function() { setMeta(function(m) { const n = Object.assign({}, m, { customLevels: m.customLevels.filter(function(_, j) { return j !== i; }) }); saveMeta(n); return n; }); }}>X</button>
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}

/* ─── CAMPAIGN TAB ──────────────────────────────────────────────── */
function CampaignTab(props) {
  const meta = props.meta, onPlay = props.onPlay;
  return (
    <div className="sg-tab-content">
      <div className="sg-tab-heading">CAMPAIGN</div>
      <div className="sg-section-label">{(meta.levelsCleared || []).length + "/" + CAMPAIGN_LEVELS.length + " DISTRICTS POWERED"}</div>
      {CAMPAIGN_LEVELS.map(function(lvl, i) {
        const done = (meta.levelsCleared || []).includes(lvl.id);
        const locked = i > 0 && !(meta.levelsCleared || []).includes(CAMPAIGN_LEVELS[i-1].id);
        return (
          <div key={lvl.id} className="sg-campaign-card" style={{ borderColor: done ? "#00ff8855" : (locked ? "rgba(255,255,255,0.04)" : "rgba(0,229,255,0.22)"), background: done ? "rgba(0,255,136,0.05)" : (locked ? "rgba(255,255,255,0.01)" : "rgba(0,229,255,0.03)"), opacity: locked ? 0.45 : 1 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
              <div style={{ fontSize: 28 }}>{done ? "🏙️" : (locked ? "🔒" : "🌑")}</div>
              <div style={{ flex: 1 }}>
                <div style={{ fontSize: 13, fontWeight: 700, color: done ? "#00ff88" : (locked ? "rgba(255,255,255,0.25)" : "rgba(255,255,255,0.85)"), marginBottom: 3 }}>{"0" + (i+1) + " · " + lvl.name}</div>
                <div style={{ display: "flex", gap: 10 }}>
                  <span style={{ fontSize: 10, color: "rgba(255,255,255,0.33)" }}>{lvl.moves + " moves"}</span>
                  {lvl.hazards > 0 && <span style={{ fontSize: 10, color: "#ff2d9577" }}>{"☠ " + lvl.hazards}</span>}
                </div>
              </div>
              {!locked && (
                <button className="sg-modal-btn"
                  style={{ background: done ? "rgba(0,255,136,0.18)" : "linear-gradient(90deg,#00e5ff,#00ff88)", color: done ? "#00ff88" : "#06060f", border: done ? "1px solid #00ff8844" : "none", fontSize: 10, padding: "8px 14px" }}
                  onClick={function() { onPlay(lvl, null); }}>
                  {done ? "REPLAY" : "PLAY"}
                </button>
              )}
            </div>
            {!locked && (
              <div style={{ marginTop: 8, display: "flex", gap: 4, flexWrap: "wrap" }}>
                {lvl.bids.map(function(bid) {
                  const b = BLDG_DEFS.find(function(x) { return x.id === bid; });
                  return <span key={bid} style={{ fontSize: 9, padding: "2px 7px", borderRadius: 4, background: HEX[b.color]+"20", color: HEX[b.color], border: "1px solid " + HEX[b.color]+"40" }}>{b.icon + " " + b.label}</span>;
                })}
              </div>
            )}
          </div>
        );
      })}
    </div>
  );
}

/* ─── ROOT APP ──────────────────────────────────────────────────── */
function Shiftgrid() {
  const [meta, setMeta] = useState(loadMeta);
  const [tab, setTab] = useState("campaign");
  const [playing, setPlaying] = useState(null);

  function handlePlay(levelDef, cb) { setPlaying({ levelDef: levelDef, cb: cb || function() {} }); }

  function handleComplete(rewards) {
    const lvl = playing.levelDef;
    if (playing.cb) playing.cb(rewards);
    setMeta(function(m) {
      const cleared = Array.from(new Set((m.levelsCleared || []).concat([lvl.id])));
      const n = Object.assign({}, m, { coins: m.coins + (rewards.coins || 0), parts: m.parts + (rewards.parts || 0), levelsCleared: cleared });
      saveMeta(n); return n;
    });
    setPlaying(null);
  }

  const TABS = [
    { id: "campaign", icon: "🗺", label: "PLAY" },
    { id: "city",     icon: "🌆", label: "CITY" },
    { id: "daily",    icon: "📅", label: "DAILY" },
    { id: "editor",   icon: "🛠", label: "EDITOR" },
  ];

  if (playing) {
    return (
      <div className="sg-root">
        <GameBoard levelDef={playing.levelDef} meta={meta} onComplete={handleComplete} onBack={function() { setPlaying(null); }} />
      </div>
    );
  }

  return (
    <div className="sg-root">
      <header style={{ textAlign: "center", marginBottom: 12, position: "relative", zIndex: 1, flexShrink: 0 }}>
        <h1 className="sg-title">SHIFTGRID</h1>
        <div className="sg-subtitle">NEON CITY RESTORATION ENGINE</div>
      </header>
      <div className="sg-wallet-row" style={{ marginBottom: 10, flexShrink: 0 }}>
        <div className="sg-wallet-chip"><span style={{ color: "#ffaa00" }}>Coins</span> {meta.coins}</div>
        <div className="sg-wallet-chip"><span style={{ color: "#00e5ff" }}>Parts</span> {meta.parts}</div>
        <div className="sg-wallet-chip"><span style={{ color: "#00ff88" }}>Districts</span> {(meta.levelsCleared || []).length + "/" + CAMPAIGN_LEVELS.length}</div>
      </div>
      <div style={{ flex: 1, width: "100%", maxWidth: 440, overflowY: "auto", position: "relative", zIndex: 1 }}>
        {tab === "campaign" && <CampaignTab meta={meta} onPlay={handlePlay} />}
        {tab === "city"     && <CityTab meta={meta} setMeta={setMeta} />}
        {tab === "daily"    && <DailyTab meta={meta} setMeta={setMeta} onPlay={handlePlay} />}
        {tab === "editor"   && <EditorTab meta={meta} setMeta={setMeta} onPlay={handlePlay} />}
      </div>
      <nav className="sg-nav" style={{ flexShrink: 0 }}>
        {TABS.map(function(t) {
          return (
            <button key={t.id} className={"sg-nav-btn" + (tab === t.id ? " active" : "")} onClick={function() { setTab(t.id); }}>
              <span style={{ fontSize: 16 }}>{t.icon}</span>
              <span>{t.label}</span>
            </button>
          );
        })}
      </nav>
    </div>
  );
}

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<Shiftgrid />);
  </script>

</body>
