/* ─── SOCIAL PROOF ──────────────────────────────────────────────── */
function getLevelSocialProof(levelId, meta) {
  /* Deterministic per-level stats — seeded from level ID */
  var rng = mkSeededRng(levelId * 137 + 42);
  var difficulty = levelId / 49; /* 0 = easy, 1 = hard */

  /* Clear rate: 96% → 32%, with small noise */
  var baseClear = Math.round(96 - difficulty * 64 + (rng() - 0.5) * 8);
  baseClear = Math.max(28, Math.min(97, baseClear));

  /* Avg moves: 55-80% of move cap with noise */
  var lvl = CAMPAIGN_LEVELS[levelId];
  var movePct = 0.55 + rng() * 0.25;
  var avgMoves = Math.max(2, Math.round(lvl.moves * movePct));

  /* Player best */
  var starsMap = meta.stars || {};
  var cleared = (meta.levelsCleared || []).includes(levelId);
  var bestStars = starsMap[levelId] || 0;

  return { clearRate: baseClear, avgMoves: avgMoves, cleared: cleared, bestStars: bestStars };
}

