      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12);
      border-radius: 9px; color: rgba(255,255,255,0.55); padding: 7px 13px;
      font-family: 'Rajdhani', sans-serif; font-size: 11px; font-weight: 700;
      cursor: pointer; transition: all 0.12s; letter-spacing: 0.06em;
    }
    .sg-pill:hover { background: rgba(255,255,255,0.1); color: #fff; }

    /* ── ADJACENT CORRUPTION PREVIEW ── */
    .sg-tile.adj-corrupt {
      box-shadow: 0 0 0 2px rgba(255,45,149,0.28) !important;
      animation: adj-pulse 1.5s ease infinite;
    }
    @keyframes adj-pulse {
      0%,100% { box-shadow: 0 0 0 1px rgba(255,45,149,0.15); }
      50%      { box-shadow: 0 0 0 2px rgba(255,45,149,0.5), 0 0 10px rgba(255,45,149,0.2); }
    }
    /* ── BUILDING ONLINE FLASH ── */
    @keyframes bldg-flash {
      0%   { transform:scale(1); }
      25%  { transform:scale(1.03); }
      50%  { transform:scale(0.99); }
      100% { transform:scale(1); }
    }
    .sg-bldg.online { animation: bldg-flash 0.55s ease; }
    /* ── LIVES ── */
    .sg-lives { display:flex; gap:2px; align-items:center; }
    .sg-heart { font-size:12px; transition: opacity 0.3s, filter 0.3s; line-height:1; }
    .sg-heart.empty { opacity:0.18; filter:grayscale(1) brightness(0.5); }
    /* ── BOSS BADGE ── */
    .sg-boss-badge { display:inline-block; background:linear-gradient(135deg,#ffaa00,#ff7700); color:#06060f; font-family:'Orbitron',monospace; font-size:7px; font-weight:900; letter-spacing:0.12em; padding:2px 5px; border-radius:4px; margin-left:5px; vertical-align:middle; }
    /* ── STARS ── */
    .sg-stars { font-size:10px; letter-spacing:0.05em; color:#ffaa00; }
    /* ── DISTRICT PROGRESS BAR ── */
    .dist-bar { height:3px; background:rgba(255,255,255,0.06); border-radius:2px; margin-bottom:8px; overflow:hidden; }
    .dist-bar-fill { height:100%; border-radius:2px; transition:width 0.5s ease; }

    /* ── XP BAR ── */
    .sg-xp-bar-wrap {
      width: 100%; max-width: 460px; padding: 0 16px 8px;
      flex-shrink: 0; position: relative; z-index: 10;
    }
    .sg-xp-row {
      display: flex; justify-content: space-between; align-items: center;
      margin-bottom: 4px;
    }
    .sg-xp-lbl {
      font-family: 'Share Tech Mono', monospace; font-size: 10px;
      color: rgba(255,255,255,0.4); letter-spacing: 0.1em;
    }
    .sg-xp-track {
      height: 4px; background: rgba(255,255,255,0.07);
      border-radius: 2px; overflow: hidden;
    }
    .sg-xp-fill {
      height: 100%; border-radius: 2px;
      background: linear-gradient(90deg, #a855f7, #00e5ff);
      box-shadow: 0 0 6px rgba(168,85,247,0.5);
      transition: width 0.6s ease;
    }
    .sg-xp-levelup {
      animation: xp-flash 0.5s ease;
    }
    @keyframes xp-flash {
      0%   { transform: scale(1); }
      40%  { transform: scale(1.06); box-shadow: 0 0 20px rgba(168,85,247,0.7); }
      100% { transform: scale(1); }
    }

    /* ── STREAK ── */
    .sg-streak-banner {
      background: linear-gradient(90deg, rgba(255,170,0,0.12), rgba(255,120,0,0.08));
      border: 1px solid rgba(255,170,0,0.25); border-radius: 14px;
      padding: 12px 14px; margin-bottom: 10px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .sg-streak-fire { font-size: 28px; }
    .sg-streak-val {
      font-family: 'Orbitron', monospace; font-size: 26px; font-weight: 900;
      color: #ffaa00; text-shadow: 0 0 14px rgba(255,170,0,0.5);
    }
    .sg-streak-lbl { font-size: 9px; color: rgba(255,255,255,0.3); letter-spacing: 0.12em; margin-top: 1px; }
    .sg-streak-days { display: flex; gap: 4px; }
    .sg-streak-day {
      width: 28px; height: 28px; border-radius: 8px; border: 1px solid;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; transition: all 0.3s;
    }
    .sg-streak-day.done {
      background: rgba(255,170,0,0.2); border-color: #ffaa00;
      box-shadow: 0 0 8px rgba(255,170,0,0.3);
    }
    .sg-streak-day.today {
      background: rgba(255,170,0,0.35); border-color: #ffaa00;
      animation: today-pulse 1.2s ease infinite;
    }
    .sg-streak-day.pending {
      background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08);
    }
    @keyframes today-pulse {
      0%,100% { box-shadow: 0 0 6px rgba(255,170,0,0.3); }
      50%      { box-shadow: 0 0 14px rgba(255,170,0,0.6); }
    }

    /* ── REWARD CALENDAR ── */
    .sg-calendar {
      display: grid; grid-template-columns: repeat(7,1fr); gap: 5px;
      margin-bottom: 8px;
    }
    .sg-cal-day {
      border: 1px solid; border-radius: 10px; padding: 8px 4px;
      text-align: center; transition: all 0.3s;
    }
    .sg-cal-day.claimed  { background: rgba(0,255,136,0.1);  border-color: rgba(0,255,136,0.4); }
    .sg-cal-day.today    { background: rgba(255,170,0,0.12); border-color: rgba(255,170,0,0.5); animation: today-pulse 1.2s ease infinite; }
    .sg-cal-day.future   { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.06); }
    .sg-cal-day .day-num { font-size: 8px; color: rgba(255,255,255,0.3); margin-bottom: 4px; }
    .sg-cal-day .day-ico { font-size: 16px; }
    .sg-cal-day .day-val { font-size: 8px; color: rgba(255,255,255,0.4); margin-top: 2px; }
    .sg-cal-day.milestone { border-color: rgba(255,170,0,0.5); background: rgba(255,170,0,0.06); }
    .sg-cal-day.milestone .day-ico { filter: drop-shadow(0 0 4px #ffaa00); }

    /* ── DAILY CHALLENGES ── */
    .sg-challenge-card {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 13px; padding: 11px 13px; margin-bottom: 7px;
      display: flex; align-items: center; gap: 11px;
      transition: all 0.3s;
    }
    .sg-challenge-card.complete {
      border-color: rgba(0,255,136,0.35); background: rgba(0,255,136,0.05);
    }
    .sg-challenge-icon { font-size: 22px; flex-shrink: 0; }
    .sg-challenge-info { flex: 1; }
    .sg-challenge-name { font-size: 13px; font-weight: 700; color: rgba(255,255,255,0.85); margin-bottom: 3px; }
    .sg-challenge-prog { font-size: 10px; color: rgba(255,255,255,0.35); margin-bottom: 5px; }
    .sg-challenge-bar-track { height: 4px; background: rgba(255,255,255,0.07); border-radius: 2px; overflow: hidden; }
    .sg-challenge-bar-fill  { height: 100%; border-radius: 2px; transition: width 0.5s ease; }
    .sg-challenge-check { font-size: 20px; flex-shrink: 0; }
    .sg-chest-card {
      background: linear-gradient(135deg, rgba(255,170,0,0.12), rgba(255,100,0,0.06));
      border: 1px solid rgba(255,170,0,0.3); border-radius: 16px;
      padding: 18px; text-align: center; margin-bottom: 10px;
      position: relative; overflow: hidden;
    }
    .sg-chest-card.unlocked {
      border-color: rgba(0,255,136,0.5); background: linear-gradient(135deg, rgba(0,255,136,0.1), rgba(0,229,255,0.06));
      animation: chest-glow 1.5s ease infinite;
    }
    @keyframes chest-glow {
      0%,100% { box-shadow: 0 0 12px rgba(0,255,136,0.2); }
      50%      { box-shadow: 0 0 24px rgba(0,255,136,0.4); }
    }
    .sg-chest-icon { font-size: 44px; margin-bottom: 6px; display: block; }
    .sg-chest-title { font-family: 'Orbitron', monospace; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; margin-bottom: 4px; }
    .sg-chest-sub { font-size: 11px; color: rgba(255,255,255,0.35); }

    /* ── CITY OVERVIEW ── */
    .sg-city-overview {
      border-radius: 16px; overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
      margin-bottom: 12px; position: relative;
      background: rgba(13,13,26,0.9);
      min-height: 180px;
    }
    .sg-city-skyline {
      display: flex; align-items: flex-end; justify-content: center;
      gap: 6px; padding: 16px 12px 0; height: 140px;
    }
    .sg-city-building {
      border-radius: 4px 4px 0 0; transition: all 0.6s ease;
      position: relative; overflow: hidden;
      display: flex; flex-direction: column; justify-content: flex-start;
      align-items: center; padding-top: 6px;
    }
    .sg-city-building::after {
      content: ''; position: absolute; inset: 0;
      background: repeating-linear-gradient(0deg, transparent, transparent 8px, rgba(255,255,255,0.04) 8px, rgba(255,255,255,0.04) 9px);
    }
    .sg-city-building.lit .window {
      animation: window-flicker 3s ease infinite;
    }
    @keyframes window-flicker {
      0%,95%,100% { opacity: 1; }
      96%          { opacity: 0.3; }
    }
    .sg-building-windows {
      display: grid; gap: 2px; position: relative; z-index: 2;
    }
    .sg-window {
      width: 6px; height: 4px; border-radius: 1px;
      transition: background 0.8s ease, box-shadow 0.8s;
    }
    .sg-city-label {
      text-align: center; padding: 8px 0 10px;
      font-size: 9px; letter-spacing: 0.14em;
      color: rgba(255,255,255,0.3);
    }
    .sg-city-stats {
      display: flex; gap: 8px; padding: 0 12px 12px;
    }
    .sg-city-stat {
      flex: 1; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px; padding: 8px; text-align: center;
    }
    .sg-city-stat-val { font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 700; }
    .sg-city-stat-lbl { font-size: 8px; color: rgba(255,255,255,0.28); letter-spacing: 0.1em; margin-top: 2px; }

    /* ── WEEKLY EVENT ── */
    .sg-event-hero {
      border-radius: 18px; padding: 0; margin-bottom: 12px;
      overflow: hidden; position: relative; border: 1px solid;
    }
    .sg-event-banner {
      padding: 20px 18px 16px; text-align: center; position: relative; z-index: 2;
    }
    .sg-event-icon { font-size: 48px; display: block; margin-bottom: 8px; }
    .sg-event-title { font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 900; letter-spacing: 0.1em; margin-bottom: 4px; }
    .sg-event-timer-label { font-size: 9px; color: rgba(255,255,255,0.35); letter-spacing: 0.14em; margin-bottom: 6px; }
    .sg-event-timer { font-family: 'Share Tech Mono', monospace; font-size: 22px; font-weight: 700; }
    .sg-event-desc { font-size: 11px; color: rgba(255,255,255,0.45); line-height: 1.55; margin: 10px 0; }
    .sg-event-modifiers {
      display: flex; gap: 7px; justify-content: center; flex-wrap: wrap; margin-bottom: 14px;
    }
    .sg-event-mod {
      background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px; padding: 5px 10px; font-size: 10px; font-weight: 600;
    }
    .sg-leaderboard {
      background: rgba(7,7,15,0.7); border-top: 1px solid rgba(255,255,255,0.07);
      padding: 12px 14px;
    }
    .sg-lb-row {
      display: flex; align-items: center; gap: 10px;
      padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,0.04);
    }
    .sg-lb-row:last-child { border-bottom: none; }
    .sg-lb-rank { font-family: 'Orbitron', monospace; font-size: 11px; font-weight: 700; min-width: 22px; }
    .sg-lb-name { flex: 1; font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.7); }
    .sg-lb-score { font-family: 'Share Tech Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.55); }
    .sg-lb-row.you .sg-lb-name { color: #00e5ff; }
    .sg-lb-row.you .sg-lb-score { color: #00e5ff; }

    /* ── NEAR-WIN STATE — pulsing danger border on the play screen ── */
    .sg-play.near-win-state::before {
      content: '';
      position: fixed; inset: 0; pointer-events: none; z-index: 200;
      border: 3px solid rgba(255,45,149,0.0);
      box-shadow: inset 0 0 0 3px rgba(255,45,149,0.55);
      animation: nw-border-pulse 0.65s ease infinite alternate;
      border-radius: 0;
    }
    @keyframes nw-border-pulse {
      from { box-shadow: inset 0 0 0 2px rgba(255,45,149,0.3), inset 0 0 40px rgba(255,45,149,0.05); }
      to   { box-shadow: inset 0 0 0 3px rgba(255,45,149,0.85), inset 0 0 60px rgba(255,45,149,0.18); }
    }

    /* ── LAST MOVE BANNER ── */
    .sg-last-move-banner {
      margin: 0 14px 4px;
      background: linear-gradient(90deg, rgba(255,45,149,0.18), rgba(255,100,0,0.12));
      border: 1px solid rgba(255,45,149,0.55);
      border-radius: 10px; padding: 7px 14px;
      font-family: 'Orbitron', monospace; font-size: 10px; font-weight: 900;
      color: #ff2d95; text-align: center; letter-spacing: 0.14em;
      flex-shrink: 0;
      text-shadow: 0 0 10px rgba(255,45,149,0.6);
      animation: last-move-flash 0.5s ease infinite alternate;
    }
    @keyframes last-move-flash {
      from { opacity: 0.75; transform: scaleX(0.99); }
      to   { opacity: 1;    transform: scaleX(1); }
    }

    /* ── BUILDINGS "ALMOST DONE" HIGHLIGHT ── */
    .sg-bldg.almost-done {
      border-color: rgba(255,170,0,0.55) !important;
      background: rgba(255,170,0,0.07) !important;
      animation: almost-pulse 0.9s ease infinite alternate;
    }
    @keyframes almost-pulse {
      from { box-shadow: 0 0 8px rgba(255,170,0,0.2);  border-color: rgba(255,170,0,0.4) !important; }
      to   { box-shadow: 0 0 18px rgba(255,170,0,0.45); border-color: rgba(255,170,0,0.8) !important; }
    }

    /* ── NEAR-WIN MODAL — building breakdown rows ── */
    .sg-nw-bldg-row {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 10px; border-radius: 10px;
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
      margin-bottom: 6px;
    }
    .sg-nw-bldg-icon { font-size: 20px; flex-shrink: 0; }
    .sg-nw-bldg-info { flex: 1; }
    .sg-nw-bldg-name { font-size: 12px; font-weight: 700; margin-bottom: 2px; }
    .sg-nw-bldg-need { font-size: 10px; color: rgba(255,255,255,0.35); margin-bottom: 5px; }
    .sg-nw-track {
      height: 5px; background: rgba(255,255,255,0.07);
      border-radius: 3px; overflow: hidden;
    }
    .sg-nw-fill { height: 100%; border-radius: 3px; transition: width 0.4s ease; }

    /* ── LOSE MODAL — failure breakdown ── */
    .sg-fail-reason {
      background: rgba(255,45,149,0.05); border: 1px solid rgba(255,45,149,0.18);
      border-radius: 12px; padding: 10px 12px;
      margin-bottom: 12px; text-align: left;
    }
    .sg-fail-line {
      display: flex; align-items: flex-start; gap: 8px;
      font-size: 11px; color: rgba(255,255,255,0.55);
      line-height: 1.45; padding: 3px 0;
    }
    .sg-fail-line + .sg-fail-line { border-top: 1px solid rgba(255,255,255,0.05); }
    .sg-fail-dot {
      width: 8px; height: 8px; border-radius: 50%;
      flex-shrink: 0; margin-top: 3px;
      box-shadow: 0 0 6px currentColor;
    }
  </style>
</head>
