function seededShuffle(arr, seed) {
  var rng = mkSeededRng(seed);
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(rng() * (i + 1));
    var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
  }
  return a;
}

function loadSessionGoals() {
  try {
    var s = sessionStorage.getItem(SESSION_GOALS_KEY);
    if (s) return JSON.parse(s);
  } catch {}
  /* Fresh session — pick 3 from pool using time-based seed */
  var seed = Math.floor(Date.now() / 3600000); /* changes every hour */
  var picked = seededShuffle(SESSION_GOAL_POOL, seed).slice(0, 3);
  var goals = picked.map(function(g) {
    return { id: g.id, progress: 0, claimed: false };
  });
  var d = { goals: goals, pickedIds: picked.map(function(g){ return g.id; }) };
