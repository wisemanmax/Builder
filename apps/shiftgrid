/* ─── STREAK CALENDAR ────────────────────────────────────────────── */
function StreakCalendar(props) {
  var streak = props.streak, setMeta = props.setMeta, meta = props.meta;
  var onStreakUpdate = props.onStreakUpdate;
  var today = todayStr();
  var todayClaimed = streak.claimed && streak.claimed.includes(today);
  var isProtected = isStreakProtected(streak);

  /* Check if streak is at risk — last played day was not yesterday or today */
  var d = new Date(), prev = new Date(d); prev.setDate(prev.getDate()-1);
  var prevStr = prev.getFullYear() + "-" + String(prev.getMonth()+1).padStart(2,"0") + "-" + String(prev.getDate()).padStart(2,"0");
  var atRisk = streak.count >= 2 && streak.lastDay !== today && streak.lastDay !== prevStr && !isProtected;
  var canAffordProtect = meta.coins >= PROTECT_COST;

  function claimToday() {
    if (todayClaimed) return;
    var day = streak.count;
    var reward = getStreakReward(day);
    var newClaimed = (streak.claimed || []).concat([today]);
    var newStreak = Object.assign({}, streak, {claimed: newClaimed});
    saveStreak(newStreak);
    onStreakUpdate(newStreak);
    if (reward.coins > 0) {
      setMeta(function(m) { var n = Object.assign({}, m, {coins: m.coins + reward.coins}); saveMeta(n); return n; });
    }
    Audio.win();
  }

  function protectWithAd() {
    var updated = applyStreakProtection(streak);
    onStreakUpdate(updated);
    Audio.tap();
  }

  function protectWithCoins() {
    if (!canAffordProtect) return;
    var updated = applyStreakProtection(streak);
    onStreakUpdate(updated);
    setMeta(function(m) { var n = Object.assign({}, m, {coins: m.coins - PROTECT_COST}); saveMeta(n); return n; });
    Audio.tap();
  }

  var days = [];
  for (var i = 1; i <= 7; i++) {
    var daysClaimed = streak.count >= i;
    var isToday = streak.count === i || (streak.count === 0 && i === 1);
    var r = getStreakReward(i);
    var cls = daysClaimed ? "done" : (isToday ? "today" : "pending");
    if (i === 7) cls += " milestone";
    days.push({i: i, cls: cls, reward: r});
  }

  return (
    <div>
      {/* STREAK BANNER */}
      <div className="sg-streak-banner">
        <div>
          <div style={{fontSize:10,color:"rgba(255,255,255,0.3)",letterSpacing:"0.14em",marginBottom:4}}>DAILY STREAK</div>
          <div style={{display:"flex",alignItems:"baseline",gap:6}}>
            <div className="sg-streak-val">{streak.count}</div>
            <div className="sg-streak-lbl">DAYS{isProtected && <span className="sg-streak-shield">🛡</span>}</div>
          </div>
          {isProtected && <div className="sg-streak-protected-badge">PROTECTED TODAY</div>}
        </div>
        <div className="sg-streak-fire">🔥</div>
        {!todayClaimed && streak.count > 0 && !atRisk && (
          <button onClick={claimToday} style={{background:"linear-gradient(135deg,#ffaa00,#ff7700)",border:"none",borderRadius:10,padding:"10px 14px",color:"#06060f",fontFamily:"'Orbitron',monospace",fontSize:9,fontWeight:700,cursor:"pointer",letterSpacing:"0.08em"}}>
            CLAIM
          </button>
        )}
      </div>

      {/* STREAK AT RISK — PROTECTION OFFER */}
      {atRisk && (
        <div className="sg-streak-protect">
          <div className="sg-protect-icon">🛡</div>
          <div className="sg-protect-info">
            <div className="sg-protect-title">Streak at Risk!</div>
            <div className="sg-protect-sub">You missed a day — protect your {streak.count}-day streak before it resets.</div>
          </div>
          <div className="sg-protect-btns">
            <button className="sg-protect-ad" onClick={protectWithAd}>WATCH AD</button>
            <button className="sg-protect-coins" onClick={protectWithCoins} disabled={!canAffordProtect}>{PROTECT_COST} coins</button>
          </div>
        </div>
      )}

      {/* 7-DAY CALENDAR */}
      <div className="sg-calendar">
        {days.map(function(d) {
          return (
            <div key={d.i} className={"sg-cal-day " + d.cls}>
              <div className="day-num">{"D"+d.i}</div>
              <div className="day-ico">{d.reward.icon}</div>
              <div className="day-val">{d.reward.coins > 0 ? "+"+d.reward.coins : d.reward.label.substring(0,4)}</div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

