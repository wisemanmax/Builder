                  <div key={bi}
                    className={"sg-city-building "+(state==="ruins"?"ruins":state==="repairing"?"repairing":state==="glowing"?"glowing":"restored")}
                    style={{
                      height:b.h+"px", width:b.w+"px",
                      "--bcolor": dc.theme,
                      background: state==="ruins"?"rgba(255,255,255,0.03)": state==="repairing"?"rgba(255,255,255,0.06)": dc.theme+"22",
                      borderTop:"2px solid "+(state==="ruins"?"rgba(255,255,255,0.05)":dc.theme+(b.lit?"":"55")),
                      borderLeft:"1px solid "+(state==="ruins"?"rgba(255,255,255,0.03)":dc.theme+(b.lit?"44":"22")),
                      borderRight:"1px solid "+(state==="ruins"?"rgba(255,255,255,0.03)":dc.theme+(b.lit?"44":"22")),
