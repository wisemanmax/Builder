  <!-- React 18 + Babel CDN — no build step needed -->

  <script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.2/babel.min.js"></script>

  <script type="text/babel">
    const { useState, useEffect, useRef, useCallback } = React;


/* ─── CONSTANTS ─────────────────────────────────────────────────── */
const ROWS = 5, COLS = 5;
const COLORS = ["cyan", "magenta", "amber", "green"];
const HEX = { cyan: "#00e5ff", magenta: "#ff2d95", amber: "#ffaa00", green: "#00ff88" };
const LABEL = { cyan: "CYAN", magenta: "MAG", amber: "AMB", green: "GRN" };

const BLDG_DEFS = [
  { id: "apt",     label: "Apartments", color: "cyan",    cap: 12, icon: "🏢" },
  { id: "factory", label: "Factory",    color: "amber",   cap: 12, icon: "🏭" },
  { id: "lab",     label: "Neon Lab",   color: "green",   cap: 10, icon: "🔬" },
  { id: "power",   label: "Power Core", color: "magenta", cap: 14, icon: "⚡" },
];

const UPGRADE_DEFS = [
  { id: "comboBoost",  label: "Combo Amp",     icon: "⚡", desc: "+30% chain bonus",         cost: [80, 200, 500] },
  { id: "hazardSlow",  label: "Hazard Shield", icon: "🛡", desc: "Corruption spreads slower", cost: [100, 250, 600] },
  { id: "extraMoves",  label: "Move Extender", icon: "🎯", desc: "15% free move chance",      cost: [120, 300, 700] },
  { id: "idleBoost",   label: "Idle Generator",icon: "⏰", desc: "Coins/hr while away",        cost: [60, 150, 400] },
  { id: "capReduce",   label: "Power Saver",   icon: "🔋", desc: "-2 charge per building",    cost: [150, 350, 800] },
  { id: "specialRate", label: "Node Enhancer", icon: "🌀", desc: "More shape combos",          cost: [90, 220, 550] },
];

const CAMPAIGN_LEVELS = [
  { id: 0, name: "BLACKOUT BLOCK",   moves: 25, bids: ["apt","factory"],               hazards: 0, hint: "Slide rows & columns — board wraps! Line up 3+ same-color nodes to score." },
  { id: 1, name: "INDUSTRIAL ROW",   moves: 22, bids: ["apt","factory","lab"],          hazards: 2, hint: "Corrupted tiles block matches. Adjacent combos clear the rot!" },
  { id: 2, name: "SKYLINE SECTOR",   moves: 20, bids: ["apt","factory","lab","power"],  hazards: 3, hint: "Shape combos: 2x2=Battery  Plus=Pulse Blast  Line-5=Wild Core" },
  { id: 3, name: "UNDERGROUND GRID", moves: 18, bids: ["apt","lab","power"],            hazards: 5, hint: "Heavy corruption. Contain it fast or lose the board." },
];

const IDLE_RATES = [0, 5, 12, 25];
const STORE_KEY = "sg_v2_meta";
const DEF_META = {
  coins: 0, parts: 0,
  upgrades: { comboBoost: 0, hazardSlow: 0, extraMoves: 0, idleBoost: 0, capReduce: 0, specialRate: 0 },
  levelsCleared: [], lastCollect: Date.now(), dailyDate: "", dailyScore: 0, customLevels: [],
};

/* ─── META ──────────────────────────────────────────────────────── */
function loadMeta() {
  try { const s = localStorage.getItem(STORE_KEY); return s ? { ...DEF_META, ...JSON.parse(s) } : { ...DEF_META }; }
  catch { return { ...DEF_META }; }
}
function saveMeta(m) { try { localStorage.setItem(STORE_KEY, JSON.stringify(m)); } catch {} }
function calcIdle(meta) {
  const lvl = meta.upgrades && meta.upgrades.idleBoost ? meta.upgrades.idleBoost : 0;
  if (!lvl) return 0;
  const hrs = Math.min(8, (Date.now() - (meta.lastCollect || Date.now())) / 3600000);
  return Math.floor(hrs * IDLE_RATES[lvl]);
}

/* ─── GRID UTILS ────────────────────────────────────────────────── */
let _uid = 0;
function nextId() { return ++_uid; }
function rndColor() { return COLORS[Math.floor(Math.random() * COLORS.length)]; }
function makeTile(color, corrupted) {
  return { id: nextId(), color: color || rndColor(), corrupted: corrupted === true };
}

function mkSeededRng(seed) {
  let s = ((seed ^ 0x9e3779b9) >>> 0) || 1;
  return function() {
    s = ((s ^ (s << 13)) >>> 0);
    s = ((s ^ (s >> 17)) >>> 0);
    s = ((s ^ (s << 5)) >>> 0);
    return s / 4294967296;
  };
}
function todaySeed() {
  const d = new Date();
  return d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate();
}

function makeGrid(rng) {
  const fn = rng || Math.random;
  const rc = function() { return COLORS[Math.floor(fn() * COLORS.length)]; };
  const g = [];
  for (let r = 0; r < ROWS; r++) {
    const row = [];
    for (let c = 0; c < COLS; c++) {
      let col, tries = 0;
      do {
        col = rc(); tries++;
      } while (
        tries < 10 &&
        ((c >= 2 && row[c-1] && row[c-1].color === col && row[c-2] && row[c-2].color === col) ||
         (r >= 2 && g[r-1] && g[r-1][c] && g[r-1][c].color === col && g[r-2] && g[r-2][c] && g[r-2][c].color === col))
      );
      row.push(makeTile(col));
    }
    g.push(row);
  }
  return g;
}

function addCorruption(grid, count, rng) {
  const fn = rng || Math.random;
  const g = grid.map(function(row) { return row.map(function(t) { return Object.assign({}, t); }); });
  let n = 0, tries = 0;
  while (n < count && tries < 100) {
    tries++;
    const r = Math.floor(fn() * ROWS), c = Math.floor(fn() * COLS);
    if (!g[r][c].corrupted) { g[r][c].corrupted = true; n++; }
  }
  return g;
}

function doShift(grid, type, idx, dir) {
  const g = grid.map(function(row) { return row.slice(); });
  if (type === "row") {
    if (dir === "left") {
      g[idx] = grid[idx].slice(1).concat([grid[idx][0]]);
    } else {
      g[idx] = [grid[idx][COLS - 1]].concat(grid[idx].slice(0, -1));
    }
  } else {
    const col = grid.map(function(row) { return row[idx]; });
    const s = dir === "up" ? col.slice(1).concat([col[0]]) : [col[ROWS - 1]].concat(col.slice(0, -1));
    s.forEach(function(t, r) { g[r][idx] = t; });
  }
  return g;
}

function findMatches(grid) {
  const m = new Set();
  for (let r = 0; r < ROWS; r++) {
    let s = 0;
    for (let c = 1; c <= COLS; c++) {
      const ok = c < COLS && !grid[r][c].corrupted && !grid[r][c-1].corrupted && grid[r][c].color === grid[r][c-1].color;
      if (!ok) { if (c - s >= 3) { for (let i = s; i < c; i++) m.add(r + "," + i); } s = c; }
    }
  }
  for (let c = 0; c < COLS; c++) {
    let s = 0;
    for (let r = 1; r <= ROWS; r++) {
      const ok = r < ROWS && !grid[r][c].corrupted && !grid[r-1][c].corrupted && grid[r][c].color === grid[r-1][c].color;
      if (!ok) { if (r - s >= 3) { for (let i = s; i < r; i++) m.add(i + "," + c); } s = r; }
    }
  }
  return m;
}

function detectShapes(grid, matched) {
  const shapes = [];
  for (let r = 0; r < ROWS - 1; r++) {
    for (let c = 0; c < COLS - 1; c++) {
      const cells = [r+","+c, r+","+(c+1), (r+1)+","+c, (r+1)+","+(c+1)];
      if (cells.every(function(k) { return matched.has(k); })) {
        const col = grid[r][c].color;
        const allSame = cells.every(function(k) {
          const p = k.split(","); return grid[+p[0]][+p[1]].color === col && !grid[+p[0]][+p[1]].corrupted;
        });
        if (allSame) shapes.push({ type: "battery", label: "BATTERY ACTIVATED", bonus: 2 });
      }
    }
  }
  for (let r = 1; r < ROWS - 1; r++) {
    for (let c = 1; c < COLS - 1; c++) {
      const cells = [r+","+c, (r-1)+","+c, (r+1)+","+c, r+","+(c-1), r+","+(c+1)];
      if (cells.every(function(k) { return matched.has(k); })) {
        const col = grid[r][c].color;
        const allSame = cells.every(function(k) {
          const p = k.split(","); return grid[+p[0]][+p[1]].color === col && !grid[+p[0]][+p[1]].corrupted;
        });
        if (allSame) shapes.push({ type: "pulse", pos: [r, c], label: "PULSE BLAST" });
      }
    }
  }
  let wildAdded = false;
  for (let r = 0; r < ROWS && !wildAdded; r++) {
    let allIn = true;
    for (let c = 0; c < COLS; c++) { if (!matched.has(r+","+c) || grid[r][c].corrupted) { allIn = false; break; } }
    if (allIn) { shapes.push({ type: "wild", label: "WILD CORE" }); wildAdded = true; }
  }
  for (let c = 0; c < COLS && !wildAdded; c++) {
    let allIn = true;
    for (let r = 0; r < ROWS; r++) { if (!matched.has(r+","+c) || grid[r][c].corrupted) { allIn = false; break; } }
    if (allIn) { shapes.push({ type: "wild", label: "WILD CORE" }); wildAdded = true; }
  }
  return shapes;
}

function expandPulse(matched, pos) {
  const m = new Set(matched);
  const pr = pos[0], pc = pos[1];
  for (let r = Math.max(0, pr-1); r <= Math.min(ROWS-1, pr+1); r++)
    for (let c = Math.max(0, pc-1); c <= Math.min(COLS-1, pc+1); c++)
      m.add(r + "," + c);
  return m;
}

function clearNearCorruption(grid, matched) {
  const x = new Set();
  matched.forEach(function(k) {
    const p = k.split(","); const r = +p[0], c = +p[1];
    const dirs = [[-1,0],[1,0],[0,-1],[0,1]];
    dirs.forEach(function(d) {
      const nr = r + d[0], nc = c + d[1];
      if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS && grid[nr][nc] && grid[nr][nc].corrupted) x.add(nr+","+nc);
    });
  });
  return x;
}

function applyGravity(grid, matched) {
  const g = grid.map(function(row) { return row.slice(); });
  const cleared = {};
  matched.forEach(function(k) {
    const p = k.split(","); const r = +p[0], c = +p[1];
    const t = g[r][c];
    if (t && !t.corrupted) cleared[t.color] = (cleared[t.color] || 0) + 1;
    g[r][c] = null;
  });
  for (let c = 0; c < COLS; c++) {
    const col = [];
    for (let r = 0; r < ROWS; r++) { if (g[r][c]) col.push(g[r][c]); }
    while (col.length < ROWS) col.unshift(makeTile());
    for (let r = 0; r < ROWS; r++) g[r][c] = col[r];
  }
  return { g: g, cleared: cleared };
}

function spreadCorruption(grid, slow) {
  if (slow && Math.random() < slow * 0.25) return grid;
  const g = grid.map(function(row) { return row.map(function(t) { return Object.assign({}, t); }); });
  const sources = [];
  for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) if (g[r][c] && g[r][c].corrupted) sources.push([r, c]);
  if (!sources.length) return g;
  const src = sources[Math.floor(Math.random() * sources.length)];
  const sr = src[0], sc = src[1];
  const dirs = [[-1,0],[1,0],[0,-1],[0,1]];
  const nbrs = dirs.map(function(d) { return [sr+d[0], sc+d[1]]; }).filter(function(pos) {
    return pos[0] >= 0 && pos[0] < ROWS && pos[1] >= 0 && pos[1] < COLS && g[pos[0]][pos[1]] && !g[pos[0]][pos[1]].corrupted;
  });
  if (nbrs.length) {
    const pick = nbrs[Math.floor(Math.random() * nbrs.length)];
    g[pick[0]][pick[1]] = Object.assign({}, g[pick[0]][pick[1]], { corrupted: true });
  }
  return g;
}

function countCorruption(grid) {
  let n = 0;
  for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) if (grid[r][c] && grid[r][c].corrupted) n++;
  return n;
}

/* ─── TILE ──────────────────────────────────────────────────────── */
function Tile(props) {
  const tile = props.tile, isHi = props.isHi, size = props.size;
  const isCr = tile && tile.corrupted;
  const color = (!isCr && tile && tile.color) ? tile.color : null;
  const hex = color ? HEX[color] : null;

  const borderColor = isCr ? "rgba(160,0,240,0.45)" : (hex ? (isHi ? hex : hex + "66") : "rgba(255,255,255,0.07)");
  const bg = isCr ? "rgba(38,0,55,0.92)" : (hex ? (isHi ? hex + "55" : hex + "1c") : "rgba(255,255,255,0.03)");
  const shadow = (isHi && hex) ? ("0 0 16px " + hex + ",0 0 32px " + hex + "55") : (isCr ? "inset 0 0 18px rgba(150,0,220,0.3)" : (hex ? ("0 0 5px " + hex + "22") : "none"));

  const cls = "sg-tile" + (isHi ? " hi" : "") + (isCr ? " sg-corrupt" : "");

  return (
    <div className={cls} style={{ width: size, height: size, background: bg, borderColor: borderColor, boxShadow: shadow }}>
      {isCr && <span style={{ fontSize: 17, filter: "saturate(0.5) brightness(0.7)" }}>☠</span>}
      {!isCr && hex && <div className="sg-diamond" style={{ background: isHi ? hex : (hex + "99"), boxShadow: isHi ? ("0 0 10px " + hex) : "none" }} />}
      {!isCr && hex && isHi && <div className="sg-glow" style={{ background: "radial-gradient(circle," + hex + "44 0%,transparent 70%)" }} />}
    </div>
  );
}

/* ─── GAME BOARD ────────────────────────────────────────────────── */
function GameBoard(props) {
  const levelDef = props.levelDef, meta = props.meta, onComplete = props.onComplete, onBack = props.onBack;
  const upg = (meta && meta.upgrades) ? meta.upgrades : DEF_META.upgrades;
  const capBonus = (upg.capReduce || 0) * 2;
  const hazardSlow = upg.hazardSlow || 0;
  const comboAmp = 1 + (upg.comboBoost || 0) * 0.3;
  const freeChance = (upg.extraMoves || 0) * 0.15;
  const spreadEvery = 3 + hazardSlow;

  const buildInitGrid = useCallback(function() {
    if (levelDef.boardData) {
      return levelDef.boardData.map(function(row) { return row.map(function(t) { return Object.assign({}, t, { id: nextId() }); }); });
    }
    const rng = levelDef.rngSeed ? mkSeededRng(levelDef.rngSeed) : null;
    const g = makeGrid(rng);
    return (levelDef.hazards || 0) > 0 ? addCorruption(g, levelDef.hazards, rng) : g;
  }, [levelDef]);

  const [grid, setGrid] = useState(buildInitGrid);
  const [moves, setMoves] = useState(levelDef.moves);
  const [bldgs, setBldgs] = useState(function() {
    return BLDG_DEFS.filter(function(b) { return levelDef.bids.includes(b.id); }).map(function(b) {
      return Object.assign({}, b, { max: Math.max(4, b.cap - capBonus), ch: 0, on: false });
    });
  });
  const [score, setScore] = useState(0);
  const [hi, setHi] = useState(new Set());
  const [phase, setPhase] = useState("idle");
  const [toasts, setToasts] = useState([]);
  const [btnFlash, setBtnFlash] = useState(null);
  const [moveCount, setMoveCount] = useState(0);
  const timers = useRef([]);

  useEffect(function() { return function() { timers.current.forEach(clearTimeout); }; }, []);

  function later(fn, ms) { const t = setTimeout(fn, ms); timers.current.push(t); }
  function addToast(text, color) {
    const id = nextId();
    setToasts(function(prev) { return prev.filter(function(x) { return x.text !== text; }).concat([{ id: id, text: text, color: color || "#ffaa00" }]); });
    setTimeout(function() { setToasts(function(prev) { return prev.filter(function(x) { return x.id !== id; }); }); }, 2200);
  }

  const handleShift = useCallback(function(type, idx, dir) {
    if (phase !== "idle") return;
    timers.current.forEach(clearTimeout); timers.current = [];
    setBtnFlash({ type: type, idx: idx, dir: dir });
    setTimeout(function() { setBtnFlash(null); }, 280);

    let g = doShift(grid, type, idx, dir);
    const frames = [], totCleared = {};
    let pts = 0, cascades = 0, chargeBoost = 1;
    const toastQueue = [];

    while (true) {
      let m = findMatches(g);
      if (!m.size) break;
      const shapes = detectShapes(g, m);
      shapes.forEach(function(sh) {
        if (!toastQueue.find(function(x) { return x.text === sh.label; })) toastQueue.push({ text: sh.label, color: "#ffaa00" });
        if (sh.type === "battery") chargeBoost = 2;
        if (sh.type === "pulse" && sh.pos) m = expandPulse(m, sh.pos);
      });
      clearNearCorruption(g, m).forEach(function(k) { m.add(k); });
      frames.push({ g: g, m: new Set(m) });
      const res = applyGravity(g, m);
      Object.keys(res.cleared).forEach(function(col) { totCleared[col] = (totCleared[col] || 0) + res.cleared[col]; });
      pts += m.size * 10 * (1 + cascades * 0.5) * comboAmp;
      cascades++;
      frames.push({ g: res.g, m: new Set() });
      g = res.g;
    }

    const newMC = moveCount + 1;
    let finalG = g;
    if ((levelDef.hazards || 0) > 0 && newMC % spreadEvery === 0) finalG = spreadCorruption(g, hazardSlow);

    const free = Math.random() < freeChance;
    const newMoves = free ? moves : moves - 1;
    if (free) addToast("FREE MOVE!", "#00ff88");

    const newBldgs = bldgs.map(function(b) {
      const add = (totCleared[b.color] || 0) * chargeBoost;
      const ch = Math.min(b.max, b.ch + add);
      return Object.assign({}, b, { ch: ch, on: ch >= b.max });
    });

    setMoveCount(newMC); setMoves(newMoves); setPhase("busy");

    function finish() {
      setGrid(finalG); setHi(new Set()); setBldgs(newBldgs); setScore(function(s) { return s + Math.round(pts); });
      toastQueue.forEach(function(t, i) { setTimeout(function() { addToast(t.text, t.color); }, i * 340); });
      if (cascades > 1) setTimeout(function() { addToast("CHAIN x" + cascades, "#ffaa00"); }, toastQueue.length * 340);
      if (newBldgs.every(function(b) { return b.on; })) { setPhase("win"); return; }
      if (newMoves <= 0) { setPhase("lose"); return; }
      setPhase("idle");
    }

    if (!frames.length) { setGrid(finalG); if (newMoves <= 0) setPhase("lose"); else setPhase("idle"); return; }
    let fi = 0;
    function step() {
      if (fi >= frames.length) { finish(); return; }
      const fr = frames[fi++]; setGrid(fr.g); setHi(fr.m);
      later(step, fr.m.size > 0 ? 420 : 180);
    }
    setGrid(frames[0].g); setHi(frames[0].m); fi = 1; later(step, 420);
  }, [grid, phase, moves, bldgs, moveCount, hazardSlow, comboAmp, freeChance, spreadEvery, levelDef]);

  const SZ = 52, BW = 32;
  const corr = countCorruption(grid);
  const spreadWarn = (levelDef.hazards || 0) > 0 && ((moveCount + 1) % spreadEvery === 0);
  const winCoins = Math.floor(score / 10) + 25;
  const winParts = Math.floor(score / 60) + 3;

  function retry() {
    setGrid(buildInitGrid()); setMoves(levelDef.moves);
    setBldgs(function(b) { return b.map(function(x) { return Object.assign({}, x, { ch: 0, on: false }); }); });
    setScore(0); setHi(new Set()); setPhase("idle"); setMoveCount(0);
  }

  function ShiftBtn(p) {
    const fl = btnFlash && btnFlash.type === p.type && btnFlash.idx === p.idx && btnFlash.dir === p.dir;
    return (
      <button className={"sg-btn" + (fl ? " flashed" : "")} style={{ width: p.type === "row" ? BW : SZ, height: p.type === "row" ? SZ : BW }}
        onClick={function() { handleShift(p.type, p.idx, p.dir); }} disabled={phase !== "idle"}>
        {p.label}
      </button>
    );
  }

  return (
    <div className="sg-screen">
      <div className="sg-play-header">
        <button className="sg-pill-btn" onClick={onBack}>Back</button>
        <div style={{ textAlign: "center" }}>
          {levelDef.isDaily && <div style={{ fontSize: 8, color: "#ffaa00", letterSpacing: "0.2em", marginBottom: 2 }}>DAILY</div>}
          <div className="sg-level-name">{levelDef.name}</div>
        </div>
        <div className="sg-score-disp">{score.toLocaleString()}</div>
      </div>

      <div className="sg-hud">
        <div className="sg-hud-box">
          <div className="sg-hud-label">MOVES</div>
          <div className="sg-hud-val" style={{ color: moves <= 5 ? "#ff2d95" : "#00e5ff", textShadow: moves <= 5 ? "0 0 14px #ff2d95" : "none" }}>{moves}</div>
        </div>
        <div className="sg-hud-box">
          <div className="sg-hud-label">POWERED</div>
          <div className="sg-hud-val" style={{ color: "#00ff88" }}>
            {bldgs.filter(function(b) { return b.on; }).length}
            <span style={{ fontSize: 14, opacity: 0.4 }}>/{bldgs.length}</span>
          </div>
        </div>
        {(levelDef.hazards || 0) > 0 && (
          <div className="sg-hud-box" style={{ borderColor: corr > 0 ? "rgba(255,45,149,0.35)" : "rgba(255,255,255,0.08)" }}>
            <div className="sg-hud-label">CORRUPT</div>
            <div className="sg-hud-val" style={{ color: corr > 4 ? "#ff2d95" : corr > 0 ? "#ffaa00" : "rgba(255,255,255,0.2)", fontSize: 20 }}>{corr}</div>
          </div>
        )}
      </div>

      {spreadWarn && (levelDef.hazards || 0) > 0 && (
        <div className="sg-warn-banner">CORRUPTION SPREADS THIS MOVE</div>
      )}

      <div style={{ minHeight: 30, display: "flex", gap: 8, alignItems: "center", justifyContent: "center", flexWrap: "wrap", margin: "2px 0" }}>
        {toasts.map(function(t) {
          return <div key={t.id} className="sg-toast" style={{ color: t.color, textShadow: "0 0 12px " + t.color }}>{t.text}</div>;
        })}
      </div>

      <div className="sg-grid-wrap">
        <div className="sg-col-btns">
          {[0,1,2,3,4].map(function(c) { return <ShiftBtn key={c} type="col" idx={c} dir="up" label="▲" />; })}
        </div>
        {grid.map(function(row, r) {
          return (
            <div key={r} className="sg-row">
              <ShiftBtn type="row" idx={r} dir="left" label="◀" />
              {row.map(function(tile, c) {
                return <Tile key={tile ? tile.id : (r+"-"+c)} tile={tile} isHi={hi.has(r+","+c)} size={SZ} />;
              })}
              <ShiftBtn type="row" idx={r} dir="right" label="▶" />
            </div>
          );
        })}
        <div className="sg-col-btns">
          {[0,1,2,3,4].map(function(c) { return <ShiftBtn key={c} type="col" idx={c} dir="down" label="▼" />; })}
        </div>
      </div>

      <div className="sg-bldg-list">
        <div className="sg-section-label">BUILDINGS</div>
        {bldgs.map(function(b) {
          const hex = HEX[b.color];
          return (
            <div key={b.id} className="sg-bldg" style={{ borderColor: b.on ? hex : "rgba(255,255,255,0.07)", background: b.on ? hex + "10" : "rgba(255,255,255,0.025)", boxShadow: b.on ? "0 0 18px " + hex + "33" : "none" }}>
              <div style={{ fontSize: 18, filter: b.on ? "none" : "grayscale(0.6) brightness(0.55)" }}>{b.icon}</div>
              <div style={{ flex: 1 }}>
                <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 4 }}>
                  <span style={{ fontSize: 13, fontWeight: 600, color: b.on ? hex : "rgba(255,255,255,0.55)" }}>{b.label}</span>
                  <span style={{ fontFamily: "'Orbitron',monospace", fontSize: 10, color: hex }}>{b.on ? "ONLINE" : (b.ch + "/" + b.max)}</span>
                </div>
                <div className="sg-bar-track">
                  <div className="sg-bar-fill" style={{ width: Math.min(100, (b.ch / b.max) * 100) + "%", background: b.on ? ("linear-gradient(90deg," + hex + ",#fff)") : ("linear-gradient(90deg," + hex + "66," + hex + ")"), boxShadow: b.on ? ("0 0 8px " + hex) : "none" }} />
                </div>
                <div style={{ fontSize: 9, marginTop: 3, color: "rgba(255,255,255,0.22)", letterSpacing: "0.08em" }}>{"MATCH " + LABEL[b.color]}</div>
              </div>
            </div>
          );
        })}
      </div>

      <div className="sg-hint-text">{levelDef.hint}</div>

      {phase === "win" && (
        <div className="sg-overlay">
          <div className="sg-modal">
            <div style={{ fontSize: 50 }}>⚡</div>
            <div className="sg-modal-title" style={{ background: "linear-gradient(90deg,#ffaa00,#00ff88)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent" }}>DISTRICT POWERED!</div>
            <div className="sg-modal-sub">{levelDef.name}</div>
            <div className="sg-modal-rewards">
              <div className="sg-reward-chip">{"+" + winCoins} <span style={{ color: "#ffaa00" }}>coins</span></div>
              <div className="sg-reward-chip">{"+" + winParts} <span style={{ color: "#00e5ff" }}>parts</span></div>
            </div>
            <button className="sg-modal-btn" style={{ background: "linear-gradient(90deg,#00e5ff,#00ff88)" }} onClick={function() { onComplete({ score: score, coins: winCoins, parts: winParts }); }}>COLLECT</button>
          </div>
        </div>
      )}

      {phase === "lose" && (
        <div className="sg-overlay">
          <div className="sg-modal">
            <div style={{ fontSize: 50 }}>💀</div>
            <div className="sg-modal-title" style={{ color: "#ff2d95", textShadow: "0 0 20px #ff2d9555" }}>BLACKOUT</div>
            <div className="sg-modal-sub">Out of moves</div>
            <div style={{ display: "flex", gap: 10, marginTop: 18, justifyContent: "center" }}>
              <button className="sg-modal-btn sg-modal-outline" onClick={onBack}>EXIT</button>
              <button className="sg-modal-btn" style={{ background: "linear-gradient(90deg,#ff2d95,#ffaa00)" }} onClick={retry}>RETRY</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

/* ─── CITY TAB ──────────────────────────────────────────────────── */
function CityTab(props) {
  const meta = props.meta, setMeta = props.setMeta;
  const idle = calcIdle(meta);

  function collect() {
    setMeta(function(m) { const n = Object.assign({}, m, { coins: m.coins + calcIdle(m), lastCollect: Date.now() }); saveMeta(n); return n; });
  }

  function buyUpgrade(id, curLvl, cost) {
    if (meta.coins < cost) return;
    setMeta(function(m) {
      const newUpg = Object.assign({}, m.upgrades, { [id]: curLvl + 1 });
      const n = Object.assign({}, m, { coins: m.coins - cost, upgrades: newUpg });
      saveMeta(n); return n;
    });
  }

  return (
    <div className="sg-tab-content">
      <div className="sg-tab-heading">CITY COMMAND</div>
      <div className="sg-section-label">DISTRICT MAP</div>
      <div className="sg-district-grid">
        {CAMPAIGN_LEVELS.map(function(lvl, i) {
          const done = (meta.levelsCleared || []).includes(lvl.id);
          const locked = i > 0 && !(meta.levelsCleared || []).includes(CAMPAIGN_LEVELS[i-1].id);
          return (
            <div key={lvl.id} className="sg-district-node" style={{ borderColor: done ? "#00ff88" : (locked ? "rgba(255,255,255,0.05)" : "rgba(0,229,255,0.25)"), background: done ? "rgba(0,255,136,0.07)" : (locked ? "rgba(255,255,255,0.01)" : "rgba(0,229,255,0.04)"), opacity: locked ? 0.5 : 1 }}>
              <div style={{ fontSize: 24, marginBottom: 4 }}>{done ? "🏙️" : (locked ? "🔒" : "🌑")}</div>
              <div style={{ fontSize: 10, fontWeight: 600, color: done ? "#00ff88" : (locked ? "rgba(255,255,255,0.25)" : "rgba(255,255,255,0.7)") }}>{lvl.name}</div>
              {done && <div style={{ fontSize: 8, color: "#00ff8866", marginTop: 3 }}>POWERED</div>}
            </div>
          );
        })}
      </div>

      <div className="sg-section-label" style={{ marginTop: 16 }}>IDLE INCOME</div>
      <div className="sg-idle-card">
        <div>
          <div style={{ fontSize: 13, fontWeight: 600, color: "rgba(255,255,255,0.65)" }}>Accumulated</div>
          <div style={{ fontFamily: "'Orbitron',monospace", fontSize: 22, color: "#ffaa00", marginTop: 4 }}>{idle}<span style={{ fontSize: 12, color: "rgba(255,255,255,0.28)", marginLeft: 6 }}>coins</span></div>
          <div style={{ fontSize: 10, color: "rgba(255,255,255,0.22)", marginTop: 3 }}>{(meta.upgrades && meta.upgrades.idleBoost) ? "Collecting since last visit" : "Upgrade Idle Generator to earn"}</div>
        </div>
        <button className="sg-collect-btn" onClick={collect} disabled={idle === 0} style={{ opacity: idle === 0 ? 0.35 : 1 }}>COLLECT</button>
      </div>

      <div className="sg-wallet-row" style={{ margin: "8px 0" }}>
        <div className="sg-wallet-chip"><span style={{ color: "#ffaa00" }}>Coins</span> {meta.coins}</div>
        <div className="sg-wallet-chip"><span style={{ color: "#00e5ff" }}>Parts</span> {meta.parts}</div>
      </div>

      <div className="sg-section-label" style={{ marginTop: 14 }}>UPGRADES</div>
      <div className="sg-upg-grid">
        {UPGRADE_DEFS.map(function(upg) {
          const cur = (meta.upgrades && meta.upgrades[upg.id]) ? meta.upgrades[upg.id] : 0;
          const maxed = cur >= upg.cost.length;
          const cost = maxed ? 0 : upg.cost[cur];
          const can = !maxed && meta.coins >= cost;
          return (
            <div key={upg.id} className="sg-upg-card">
              <div style={{ fontSize: 20, marginBottom: 5 }}>{upg.icon}</div>
              <div style={{ fontSize: 11, fontWeight: 700, color: "rgba(255,255,255,0.85)", marginBottom: 3 }}>{upg.label}</div>
              <div style={{ fontSize: 9, color: "rgba(255,255,255,0.32)", marginBottom: 8, lineHeight: 1.4 }}>{upg.desc}</div>
              <div className="sg-pips">
                {upg.cost.map(function(_, i) { return <div key={i} className="sg-pip" style={{ background: i < cur ? "#00e5ff" : "rgba(255,255,255,0.1)" }} />; })}
              </div>
              {maxed
                ? <div style={{ fontSize: 8, color: "#00ff88", letterSpacing: "0.12em", marginTop: 6 }}>MAX</div>
                : <button className="sg-upg-btn" disabled={!can} style={{ opacity: can ? 1 : 0.35 }} onClick={function() { buyUpgrade(upg.id, cur, cost); }}>{cost} coins</button>
              }
            </div>
          );
        })}
      </div>
    </div>
  );
}

