/* ─── NEW BLOCKERS ─────────────────────────────────────────────────
   4 types, each with distinct mechanic:
   "anchor"     — blocks adjacent row/col shifts until cleared by match
   "overcharge" — explodes on clear, blasting 3×3 area  
   "fog"        — hides tile color until a neighbor is matched
   "chain"      — linked in pairs; both must clear same shift or neither does
 ─────────────────────────────────────────────────────────────────── */

const BLOCKER_DEFS = {
  anchor: {
    icon: "🔒", label: "ANCHOR",
    color: "#64a0ff", bg: "rgba(30,60,120,0.92)",
    desc: "Blocks adjacent row/col shifts. Clear with a neighboring match.",
  },
  overcharge: {
    icon: "⚡", label: "OVERCHARGE",
    color: "#ffdc00", bg: "rgba(60,45,0,0.93)",
    desc: "Match it to trigger a 3×3 area blast — destroys all tiles around it.",
  },
  fog: {
    icon: "🌫", label: "FOG",
    color: "rgba(180,180,200,0.6)", bg: "rgba(20,20,30,0.97)",
    desc: "Color hidden until a neighbor clears. Match blind.",
  },
  chain: {
    icon: "🔗", label: "CHAIN",
    color: "#ff8c00", bg: "rgba(50,25,0,0.93)",
    desc: "Linked to a partner tile. Both must match in the same shift or neither clears.",
  },
};

/* Add a blocker to a tile */
function makeBlockerTile(color, blockerType, chainId) {
  return Object.assign(makeTile(color), {
    blocker: blockerType,
    chainId: chainId || null,
    fogRevealed: false,
  });
}

/* Inject blockers into a grid based on level */
function injectBlockers(grid, levelId, count, rng) {
  if (!count || count <= 0) return grid;
  var g = grid.map(function(row){ return row.map(function(t){ return Object.assign({},t); }); });
  var fn = rng || Math.random;
  /* Determine which blocker types to use based on district */
  var dist = Math.min(10, Math.floor(levelId / 10));
  /* D6: anchor only; D7: overcharge+anchor; D8: fog+anchor; D9: chain+fog; D10: all 4 */
  var available = dist >= 15 ? ["anchor","overcharge","fog","chain"] :
                  dist >= 13 ? ["chain","fog","anchor"] :
                  dist >= 12 ? ["fog","anchor","overcharge"] :
                  dist >= 11 ? ["overcharge","anchor"] :
                               ["anchor"];
  var placed = 0, tries = 0;
  var chainId = 1;
  while (placed < count && tries < 80) {
    tries++;
    var r = Math.floor(fn() * ROWS), c = Math.floor(fn() * COLS);
    var t = g[r][c];
    if (t.corrupted || t.blocker || t.nodeType) continue;
    var btype = available[Math.floor(fn() * available.length)];
    /* Chain blockers come in pairs */
    if (btype === "chain" && placed + 1 < count) {
      g[r][c] = makeBlockerTile(t.color, "chain", chainId);
      /* Find a partner nearby */
      var dirs = [[0,1],[1,0],[0,-1],[-1,0]];
      var placed2 = false;
      for (var di = 0; di < dirs.length; di++) {
        var nr = r + dirs[di][0], nc = c + dirs[di][1];
        if (nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&!g[nr][nc].corrupted&&!g[nr][nc].blocker&&!g[nr][nc].nodeType) {
          g[nr][nc] = makeBlockerTile(g[nr][nc].color, "chain", chainId);
          placed2 = true; placed++; break;
        }
      }
      if (placed2) { chainId++; placed++; }
      else { g[r][c] = t; } /* undo if no partner */
    } else {
      g[r][c] = makeBlockerTile(t.color, btype, null);
      placed++;
    }
  }
  return g;
}

/* Check if a shift is blocked by an anchor */
function isShiftBlocked(grid, type, idx) {
  if (type === "row") {
    for (var c = 0; c < COLS; c++) {
      if (grid[idx] && grid[idx][c] && grid[idx][c].blocker === "anchor") return true;
    }
  } else {
    for (var r = 0; r < ROWS; r++) {
      if (grid[r] && grid[r][idx] && grid[r][idx].blocker === "anchor") return true;
    }
  }
  return false;
}

/* Clear blockers adjacent to a match set, return cleared blocker keys */
function clearAdjacentBlockers(grid, matched) {
  var cleared = new Set();
  matched.forEach(function(k) {
    var p = k.split(","); var r = +p[0], c = +p[1];
    [[-1,0],[1,0],[0,-1],[0,1]].forEach(function(d) {
      var nr = r+d[0], nc = c+d[1];
      if (nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&grid[nr]&&grid[nr][nc]) {
        var t = grid[nr][nc];
        /* Anchor: adjacent match clears it */
        if (t.blocker === "anchor") cleared.add(nr+","+nc);
        /* Fog: adjacent match reveals it (not clears) */
        if (t.blocker === "fog") cleared.add("fog:"+nr+","+nc);
      }
    });
  });
  return cleared;
}

/* Process overcharge explosions — returns set of additional keys to clear */
function processOvercharge(grid, matched) {
  var extra = new Set();
  matched.forEach(function(k) {
    var p = k.split(","); var r = +p[0], c = +p[1];
    if (grid[r]&&grid[r][c]&&grid[r][c].blocker==="overcharge") {
      /* Blast 3×3 */
      for (var dr=-1;dr<=1;dr++) for (var dc=-1;dc<=1;dc++) {
        var nr=r+dr, nc=c+dc;
        if (nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&!(dr===0&&dc===0)) extra.add(nr+","+nc);
      }
    }
  });
  return extra;
}

/* Validate chain pairs — unlinked chains don't clear */
function filterChainMatches(grid, matched) {
  /* Group by chainId */
  var byChain = {};
  matched.forEach(function(k) {
    var p=k.split(","); var t=grid[+p[0]]&&grid[+p[0]][+p[1]];
    if (t&&t.blocker==="chain"&&t.chainId) {
      if (!byChain[t.chainId]) byChain[t.chainId]=[];
      byChain[t.chainId].push(k);
    }
  });
  /* Remove chains where only one partner matched */
  var blocked = new Set();
  Object.keys(byChain).forEach(function(cid) {
    /* Count total tiles in grid with this chainId */
    var total = 0;
    for (var r=0;r<ROWS;r++) for (var c=0;c<COLS;c++) {
      if (grid[r]&&grid[r][c]&&grid[r][c].chainId===+cid) total++;
    }
    if (byChain[cid].length < total) byChain[cid].forEach(function(k){ blocked.add(k); });
  });
  return blocked; /* keys that cannot clear */
}

