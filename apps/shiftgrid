<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="screen-orientation" content="portrait"/>
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#06060f" />
  <title>SHIFTGRID</title>
  <meta name="application-name" content="SHIFTGRID"/>
  <meta name="apple-mobile-web-app-title" content="SHIFTGRID"/>
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
  <link rel="manifest" href="data:application/json,{&quot;name&quot;:&quot;SHIFTGRID&quot;,&quot;short_name&quot;:&quot;SHIFTGRID&quot;,&quot;display&quot;:&quot;standalone&quot;,&quot;background_color&quot;:&quot;%2307070f&quot;,&quot;theme_color&quot;:&quot;%2307070f&quot;,&quot;orientation&quot;:&quot;portrait&quot;,&quot;start_url&quot;:&quot;.&quot;,&quot;icons&quot;:[{&quot;src&quot;:&quot;data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 192 192'%3E%3Crect width='192' height='192' fill='%2307070f'/%3E%3Ctext x='96' y='130' font-size='100' text-anchor='middle'%3E%E2%9A%A1%3C/text%3E%3C/svg%3E&quot;,&quot;sizes&quot;:&quot;192x192&quot;,&quot;type&quot;:&quot;image/svg+xml&quot;}]}"/>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Share+Tech+Mono&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --cyan:    #00e5ff;
      --mag:     #ff2d95;
      --amber:   #ffaa00;
      --green:   #00ff88;
      --bg:      #07070f;
      --bg2:     #0d0d1a;
      --border:  rgba(255,255,255,0.07);
      --glass:   rgba(255,255,255,0.04);
      --sz: 52px;
      --gap: 4px;
      --bw: 30px;
      --slide-dur: 140ms;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; background: var(--bg); }

    /* ── ROOT ── */
    #root { height: 100%; }
    .sg-app {
      height: 100vh; height: 100dvh;
      display: flex; flex-direction: column; align-items: center;
      background: radial-gradient(ellipse 80% 50% at 50% -10%, #0e1428 0%, var(--bg) 65%);
      font-family: 'Rajdhani', sans-serif;
      color: #e4e4ff;
      overflow: hidden;
      position: relative;
    }

    /* Scanlines */
    .sg-app::after {
      content: '';
      position: fixed; inset: 0; pointer-events: none; z-index: 1000;
      background: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.04) 3px, rgba(0,0,0,0.04) 4px);
    }

    /* Ambient particles */
    .sg-particles { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .sg-particle {
      position: absolute; width: 2px; height: 2px; border-radius: 50%;
      animation: pfloat linear infinite;
      opacity: 0;
    }
    @keyframes pfloat {
      0%   { opacity: 0; transform: translateY(0) scale(1); }
      10%  { opacity: 0.6; }
      90%  { opacity: 0.3; }
      100% { opacity: 0; transform: translateY(-120vh) scale(0.5); }
    }

    /* ── HEADER ── */
    .sg-header {
      width: 100%; max-width: 460px;
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 16px 8px;
      position: relative; z-index: 10; flex-shrink: 0;
    }
    .sg-logo {
      font-family: 'Orbitron', monospace; font-weight: 900;
      font-size: clamp(18px, 4.5vw, 24px); letter-spacing: 0.22em;
      background: linear-gradient(135deg, var(--cyan) 0%, var(--mag) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 14px rgba(0,229,255,0.35));
    }
    .sg-wallet {
      display: flex; gap: 12px;
    }
    .sg-coin {
      display: flex; align-items: center; gap: 4px;
      font-family: 'Share Tech Mono', monospace; font-size: 12px;
      color: rgba(255,255,255,0.6);
    }
    .sg-coin-dot {
      width: 8px; height: 8px; border-radius: 50%;
    }

    /* ── MUSIC BUTTON ── */
    .sg-music-btn {
      background: none; border: none;
      font-size: 18px; cursor: pointer;
      color: rgba(255,255,255,0.3);
      padding: 2px 4px; border-radius: 6px;
      transition: color 0.2s, text-shadow 0.2s, background 0.2s;
      line-height: 1; flex-shrink: 0;
    }
    .sg-music-btn:hover { background: rgba(255,255,255,0.07); }

    /* ── CONTENT AREA ── */
    .sg-content {
      flex: 1; width: 100%; max-width: 460px;
      overflow-y: auto; overflow-x: hidden;
      -webkit-overflow-scrolling: touch;
      position: relative; z-index: 10;
      padding: 0 12px;
    }
    .sg-content::-webkit-scrollbar { display: none; }

    /* ── NAV ── */
    .sg-nav {
      width: 100%; max-width: 460px;
      display: flex;
      background: rgba(7,7,15,0.95);
      border-top: 1px solid var(--border);
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom, 0px));
      position: relative; z-index: 100;
      flex-shrink: 0;
      gap: 4px;
    }
    .sg-nav-btn {
      flex: 1; display: flex; flex-direction: column; align-items: center; gap: 3px;
      padding: 10px 4px 6px; min-height: 52px;
      background: none; border: none; border-radius: 10px;
      color: rgba(255,255,255,0.25); cursor: pointer;
      font-family: 'Rajdhani', sans-serif; font-size: 10px; font-weight: 700;
      letter-spacing: 0.12em; transition: color 0.2s, background 0.2s;
      position: relative;
    }
    .sg-nav-btn .nav-icon { font-size: 18px; line-height: 1; }
    .sg-nav-btn.active {
      color: var(--cyan);
      background: rgba(0,229,255,0.08);
    }
    .sg-nav-btn.active::before {
      content: '';
      position: absolute; top: 0; left: 50%; transform: translateX(-50%);
      width: 24px; height: 2px; border-radius: 0 0 2px 2px;
      background: var(--cyan);
      box-shadow: 0 0 8px var(--cyan);
    }

    /* ── SECTION LABELS ── */
    .sg-label {
      font-size: 9px; letter-spacing: 0.24em; color: rgba(255,255,255,0.2);
      text-transform: uppercase; margin-bottom: 8px; margin-top: 16px;
    }

    /* ── PLAY SCREEN ── */
    .sg-play {
      height: 100%; display: flex; flex-direction: column;
      position: relative; z-index: 10; overflow: hidden;
    }
    .sg-play.near-win-state::before {
      content: '';
      position: fixed; inset: 0; z-index: 999; pointer-events: none;
      border: 3px solid #ff2d95;
      animation: nw-border-pulse 0.55s ease infinite alternate;
    }

    .sg-play-top {
      display: flex; align-items: center; justify-content: space-between;
      padding: 4px 12px 2px; flex-shrink: 0; min-height: 0;
    }
    .sg-back {
      width: 30px; height: 30px; border-radius: 8px;
      background: rgba(255,255,255,0.06); border: 1px solid var(--border);
      color: rgba(255,255,255,0.5); font-size: 14px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; transition: all 0.15s; flex-shrink: 0;
    }
    .sg-back:hover { background: rgba(255,255,255,0.1); color: #fff; }
    .sg-lvl-label { font-family: 'Share Tech Mono', monospace; font-size: 10px; letter-spacing: 0.1em; color: rgba(255,255,255,0.55); text-align: center; }
    .sg-daily-badge { font-size: 8px; color: var(--amber); letter-spacing: 0.18em; margin-bottom: 2px; }
    .sg-score-live {
      font-family: 'Orbitron', monospace; font-size: 13px; font-weight: 700;
      color: var(--amber); text-shadow: 0 0 12px rgba(255,170,0,0.4);
      min-width: 64px; text-align: right;
    }

    /* ── HUD ── */
    .sg-hud {
      display: flex; gap: 4px; padding: 0 10px 4px;
      flex-shrink: 0;
    }
    .sg-stat {
      flex: 1; background: rgba(255,255,255,0.03);
      border: 1px solid var(--border); border-radius: 8px;
      padding: 4px 4px; text-align: center;
      transition: border-color 0.3s, background 0.3s;
    }
    .sg-stat-lbl { font-size: 6px; letter-spacing: 0.14em; color: rgba(255,255,255,0.22); margin-bottom: 2px; }
    .sg-stat-val {
      font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 700;
      transition: color 0.3s, text-shadow 0.3s;
    }
    .sg-stat.danger { border-color: rgba(255,45,149,0.35); background: rgba(255,45,149,0.06); }

    /* ── KINGDOM RANK TITLE ── */
    .sg-kingdom-rank {
      font-family: 'Share Tech Mono', monospace;
      font-size: 9px; letter-spacing: 0.14em;
      padding: 2px 7px; border-radius: 5px;
      border: 1px solid; font-weight: 700;
      transition: all 0.4s;
    }

    /* ── DAILY LOGIN CHEST POPUP ── */
    .sg-login-overlay {
      position: fixed; inset: 0; z-index: 950;
      background: rgba(7,7,15,0.92);
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      animation: overlay-in 0.3s ease;
    }
    .sg-login-modal {
      background: rgba(13,13,26,0.98);
      border-radius: 28px; padding: 36px 28px;
      max-width: 310px; width: 90%; text-align: center;
      animation: modal-in 0.4s cubic-bezier(0.34,1.56,0.64,1);
      position: relative; overflow: hidden;
    }
    .sg-login-modal::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(ellipse 70% 40% at 50% 0%, var(--chest-glow,rgba(255,170,0,0.1)) 0%, transparent 65%);
    }
    .sg-chest-anim {
      font-size: 72px; display: block; margin-bottom: 4px;
      animation: chest-bounce 0.7s cubic-bezier(0.34,1.56,0.64,1);
      cursor: pointer; transition: transform 0.15s;
      line-height: 1;
    }
    .sg-chest-anim:hover { transform: scale(1.1) rotate(-3deg); }
    .sg-chest-anim.opening {
      animation: chest-open 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards;
    }
    @keyframes chest-bounce {
      0%   { transform: scale(0.3) translateY(30px); opacity: 0; }
      70%  { transform: scale(1.15) translateY(-8px); opacity: 1; }
      100% { transform: scale(1) translateY(0); opacity: 1; }
    }
    @keyframes chest-open {
      0%   { transform: scale(1) rotate(0deg); }
      30%  { transform: scale(1.3) rotate(-8deg); }
      60%  { transform: scale(1.2) rotate(6deg); }
      100% { transform: scale(1) rotate(0deg); }
    }
    .sg-login-day {
      font-family: 'Orbitron', monospace; font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; margin-bottom: 4px;
    }
    .sg-login-title {
      font-family: 'Orbitron', monospace; font-size: 20px; font-weight: 900;
      letter-spacing: 0.08em; margin-bottom: 6px;
    }
    .sg-login-sub { font-size: 12px; color: rgba(255,255,255,0.38); margin-bottom: 20px; }
    .sg-login-rewards {
      display: flex; gap: 8px; justify-content: center; margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .sg-login-reward-chip {
      display: flex; flex-direction: column; align-items: center; gap: 4px;
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 12px; padding: 10px 14px; min-width: 64px;
    }
    .sg-login-reward-icon { font-size: 20px; }
    .sg-login-reward-val { font-family: 'Orbitron', monospace; font-size: 14px; font-weight: 700; }
    .sg-login-reward-lbl { font-size: 8px; color: rgba(255,255,255,0.35); letter-spacing: 0.1em; }
    .sg-reward-burst {
      animation: burst-in 0.5s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    @keyframes burst-in {
      0%  { transform: scale(0) rotate(-15deg); opacity: 0; }
      100%{ transform: scale(1) rotate(0deg); opacity: 1; }
    }

    /* ── CHEST INVENTORY ── */
    .sg-chest-inv-row {
      display: flex; gap: 8px; margin-bottom: 10px;
    }
    .sg-chest-inv-card {
      flex: 1; border: 1px solid; border-radius: 14px; padding: 14px 8px;
      text-align: center; cursor: pointer; transition: all 0.2s;
      position: relative; overflow: hidden;
    }
    .sg-chest-inv-card:active { transform: scale(0.96); }
    .sg-chest-inv-card.empty { opacity: 0.25; cursor: default; }
    .sg-chest-inv-card.empty:active { transform: none; }
    .sg-chest-inv-icon { font-size: 34px; display: block; margin-bottom: 5px; }
    .sg-chest-inv-name { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; margin-bottom: 2px; }
    .sg-chest-inv-count {
      font-family: 'Orbitron', monospace; font-size: 18px; font-weight: 900;
    }
    .sg-chest-inv-tap { font-size: 9px; margin-top: 4px; opacity: 0.5; letter-spacing: 0.06em; }
    .sg-chest-open-flash {
      position: fixed; inset: 0; z-index: 960; pointer-events: none;
      background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
      animation: flash-out 0.5s ease forwards;
    }
    @keyframes flash-out { from{opacity:1} to{opacity:0} }

    /* ── TROPHY ROAD ── */
    .sg-trophy-road {
      position: relative; padding: 8px 0 4px;
      margin-bottom: 8px;
    }
    .sg-trophy-track {
      position: absolute; top: 50%; left: 28px; right: 28px;
      height: 3px; background: rgba(255,255,255,0.08);
      transform: translateY(-50%); border-radius: 2px; z-index: 0;
    }
    .sg-trophy-track-fill {
      height: 100%; border-radius: 2px;
      background: linear-gradient(90deg, #ffaa00, #ff7700);
      transition: width 0.8s ease;
      box-shadow: 0 0 6px rgba(255,170,0,0.5);
    }
    .sg-trophy-nodes {
      display: flex; justify-content: space-between;
      position: relative; z-index: 1;
    }
    .sg-trophy-node {
      display: flex; flex-direction: column; align-items: center; gap: 5px;
      width: 52px;
    }
    .sg-trophy-gem {
      width: 36px; height: 36px; border-radius: 10px; border: 2px solid;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; transition: all 0.3s; position: relative;
    }
    .sg-trophy-gem.unlocked {
      animation: gem-glow 2s ease infinite;
    }
    @keyframes gem-glow {
      0%,100% { box-shadow: 0 0 6px currentColor; }
      50%      { box-shadow: 0 0 16px currentColor; }
    }
    .sg-trophy-gem.claimable {
      animation: gem-pulse 0.8s ease infinite alternate;
    }
    @keyframes gem-pulse {
      from { transform: scale(1); }
      to   { transform: scale(1.12); }
    }
    .sg-trophy-label {
      font-size: 8px; color: rgba(255,255,255,0.35); letter-spacing: 0.06em; text-align: center;
    }
    .sg-trophy-label.done { color: #ffaa00; }

    /* ══════════════════════════════════════
       PHASE 1 — NEW SYSTEMS
    ══════════════════════════════════════ */

    /* ── PRE-LEVEL SCREEN ── */
    .sg-prelevel {
      position: fixed; inset: 0; z-index: 600;
      background: rgba(7,7,15,0.97);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      padding: 20px; backdrop-filter: blur(12px);
      animation: overlay-in 0.3s ease;
      overflow-y: auto;
    }
    .sg-prelevel-card {
      width: 100%; max-width: 360px;
      background: rgba(13,13,26,0.98);
      border-radius: 24px; padding: 24px 20px;
      border: 1px solid rgba(255,255,255,0.08);
      box-shadow: 0 24px 60px rgba(0,0,0,0.5);
    }
    .sg-prelevel-eyebrow { font-size: 9px; letter-spacing: 0.22em; color: rgba(255,255,255,0.3); margin-bottom: 4px; }
    .sg-prelevel-name    { font-family:'Orbitron',monospace; font-size:18px; font-weight:900; letter-spacing:0.08em; margin-bottom:6px; }
    .sg-prelevel-hint    { font-size:12px; color:rgba(255,255,255,0.42); line-height:1.6; margin-bottom:16px; }
    .sg-prelevel-stats   { display:flex; gap:8px; margin-bottom:18px; }
    .sg-prelevel-stat    { flex:1; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.07); border-radius:10px; padding:10px 6px; text-align:center; }
    .sg-prelevel-stat-val{ font-family:'Orbitron',monospace; font-size:18px; font-weight:700; }
    .sg-prelevel-stat-lbl{ font-size:8px; color:rgba(255,255,255,0.3); letter-spacing:0.1em; margin-top:2px; }

    /* Booster loadout */
    .sg-prelevel-loadout-lbl { font-size:9px; letter-spacing:0.14em; color:rgba(255,255,255,0.3); margin-bottom:8px; }
    .sg-booster-row  { display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap; }
    .sg-booster-slot {
      flex:1; min-width:70px; border-radius:14px; border:2px solid;
      padding:10px 6px; text-align:center; cursor:pointer;
      transition:all 0.15s; position:relative;
    }
    .sg-booster-slot.selected { transform:scale(1.04); }
    .sg-booster-slot.empty-slot { border-style:dashed; opacity:0.4; cursor:default; }
    .sg-booster-icon { font-size:24px; display:block; margin-bottom:4px; }
    .sg-booster-name { font-size:9px; font-weight:700; letter-spacing:0.04em; }
    .sg-booster-count{ position:absolute; top:4px; right:6px; font-family:'Orbitron',monospace; font-size:8px; font-weight:900; color:#fff; background:rgba(0,0,0,0.7); border-radius:4px; padding:1px 4px; }
    .sg-booster-check{ position:absolute; top:-6px; left:-6px; width:18px; height:18px; border-radius:50%; background:#00ff88; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:900; color:#06060f; }

    .sg-prelevel-launch {
      width:100%; border:none; border-radius:14px; padding:16px;
      font-family:'Orbitron',monospace; font-size:12px; font-weight:900;
      cursor:pointer; letter-spacing:0.12em; transition:all 0.15s;
      margin-bottom:10px;
    }
    .sg-prelevel-launch:hover { transform:scale(1.02); }
    .sg-prelevel-skip {
      width:100%; background:none; border:none; color:rgba(255,255,255,0.25);
      font-family:'Rajdhani',sans-serif; font-size:12px; font-weight:700;
      cursor:pointer; padding:8px; letter-spacing:0.08em;
    }

    /* Episode narrative banner */
    .sg-episode-banner {
      border-radius:14px; padding:14px 16px; margin-bottom:14px;
      border:1px solid; position:relative; overflow:hidden;
    }
    .sg-episode-banner::before {
      content:''; position:absolute; inset:0; pointer-events:none;
      background:linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 60%);
    }
    .sg-episode-tag  { font-size:8px; letter-spacing:0.2em; font-weight:700; margin-bottom:4px; }
    .sg-episode-title{ font-family:'Orbitron',monospace; font-size:13px; font-weight:900; letter-spacing:0.08em; margin-bottom:6px; }
    .sg-episode-body { font-size:11px; line-height:1.65; color:rgba(255,255,255,0.5); }

    /* ── STAR CHAIN METER ── */
    .sg-star-chain-bar {
      margin:0 14px 10px; position:relative;
    }
    .sg-star-chain-label {
      display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;
    }
    .sg-star-chain-lbl  { font-size:9px; letter-spacing:0.12em; color:rgba(255,255,255,0.3); }
    .sg-star-chain-count{ font-family:'Orbitron',monospace; font-size:9px; font-weight:700; color:#ffaa00; }
    .sg-star-chain-track{ height:6px; background:rgba(255,255,255,0.06); border-radius:3px; overflow:hidden; }
    .sg-star-chain-fill {
      height:100%; border-radius:3px;
      background:linear-gradient(90deg,#ffaa00,#ff7700);
      transition:width 0.6s ease;
      box-shadow:0 0 6px rgba(255,170,0,0.5);
    }
    .sg-star-chain-pips { display:flex; justify-content:space-between; margin-top:4px; }
    .sg-star-pip { font-size:10px; opacity:0.3; transition:opacity 0.3s; }
    .sg-star-pip.lit { opacity:1; filter:drop-shadow(0 0 4px #ffaa00); }

    /* Star chain reward burst */
    .sg-star-chain-burst {
      position:fixed; inset:0; z-index:700; pointer-events:none;
      display:flex; align-items:center; justify-content:center;
      animation:overlay-in 0.2s ease;
    }
    .sg-scb-inner {
      text-align:center;
      animation:modal-in 0.4s cubic-bezier(0.34,1.56,0.64,1);
    }
    .sg-scb-icon  { font-size:72px; display:block; margin-bottom:8px; animation:du-bounce 0.5s cubic-bezier(0.34,1.56,0.64,1); }
    .sg-scb-title { font-family:'Orbitron',monospace; font-size:20px; font-weight:900; color:#ffaa00; text-shadow:0 0 20px rgba(255,170,0,0.6); margin-bottom:6px; }
    .sg-scb-sub   { font-size:12px; color:rgba(255,255,255,0.5); }

    /* ── MASTER CHALLENGE badge on level node ── */
    .sg-master-badge {
      position:absolute; top:-5px; right:-5px;
      width:18px; height:18px; border-radius:50%;
      background:linear-gradient(135deg,#a855f7,#ff2d95);
      display:flex; align-items:center; justify-content:center;
      font-size:9px; font-weight:900; color:#fff;
      box-shadow:0 0 8px rgba(168,85,247,0.5);
    }

    /* ── COMEBACK INDICATOR (subtle, just for UX) ── */
    .sg-comeback-hint {
      font-size:9px; color:rgba(0,255,136,0.5); letter-spacing:0.08em;
      text-align:center; padding:3px 0; flex-shrink:0;
    }

    /* ── COMBO POWER METER ── */
    .sg-combo-meter {
      position:absolute; right:0; top:0; bottom:0; width:8px;
      border-radius:0 0 4px 4px; overflow:hidden;
      background:rgba(255,255,255,0.05);
      display:flex; flex-direction:column-reverse;
    }
    .sg-combo-fill {
      width:100%; border-radius:0 0 4px 4px;
      transition:height 0.4s cubic-bezier(0.34,1.56,0.64,1);
    }
    .sg-combo-meter-wrap {
      position:relative; display:flex; align-items:center; justify-content:center;
    }

    /* ══════════════════════════════════════
       PHASE 2 — OBJECTIVE TYPES + COMBO METER
    ══════════════════════════════════════ */

    /* ── OBJECTIVE TYPE HUD BADGE ── */
    .sg-objective-badge {
      display: flex; align-items: center; gap: 6px;
      margin: 0 10px 2px; padding: 4px 10px;
      border-radius: 8px; border: 1.5px solid; flex-shrink: 0;
      animation: banner-in 0.3s ease;
    }
    .sg-obj-icon { font-size: 16px; flex-shrink: 0; }
    .sg-obj-label { font-size: 8px; font-weight: 700; letter-spacing: 0.12em; }
    .sg-obj-desc  { font-size: 9px; color: rgba(255,255,255,0.45); }

    /* ── RACE THE CLOCK ── */
    .sg-timer-display {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      min-width: 60px;
    }
    .sg-timer-val {
      font-family: 'Orbitron', monospace; font-size: 20px; font-weight: 900;
      transition: color 0.3s;
      line-height: 1;
    }
    .sg-timer-val.urgent { color: #ff2d95 !important; animation: timer-pulse 0.5s ease infinite alternate; }
    @keyframes timer-pulse { from{text-shadow:none} to{text-shadow:0 0 14px #ff2d95} }
    .sg-timer-arc {
      width: 48px; height: 48px; transform: rotate(-90deg);
    }

    /* ── CONTAINMENT ZONE ── */
    .sg-contain-line {
      position: absolute; left: 0; right: 0;
      height: 2px; z-index: 20; pointer-events: none;
      transition: top 0.2s;
    }
    .sg-contain-line::before {
      content: 'HOLD THIS LINE'; position: absolute;
      right: 0; top: -12px;
      font-size: 7px; font-weight: 700; letter-spacing: 0.12em;
      color: rgba(255,45,149,0.7);
    }
    .sg-contain-breach {
      position: fixed; inset: 0; z-index: 998; pointer-events: none;
      background: rgba(255,45,149,0.12);
      animation: ability-flash 0.4s ease forwards;
    }

    /* ── COMBO POWER METER ── */
    .sg-combo-power-wrap {
      padding: 2px 12px 3px; flex-shrink: 0;
    }
    .sg-combo-power-track { height: 5px; }
    .sg-combo-power-header {
      display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px;
    }
    .sg-combo-power-lbl { font-size: 7px; letter-spacing: 0.1em; color: rgba(255,255,255,0.25); }
    .sg-combo-power-rank {
      font-family: 'Orbitron', monospace; font-size: 8px; font-weight: 900;
      letter-spacing: 0.08em; transition: all 0.3s;
    }
    .sg-combo-power-track {
      height: 8px; background: rgba(255,255,255,0.05);
      border-radius: 4px; overflow: hidden; position: relative;
    }
    .sg-combo-power-fill {
      height: 100%; border-radius: 4px;
      transition: width 0.5s cubic-bezier(0.34,1.56,0.64,1);
      position: relative;
    }
    .sg-combo-power-fill::after {
      content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 4px;
      background: rgba(255,255,255,0.6); border-radius: 0 4px 4px 0;
      filter: blur(1px);
    }
    .sg-combo-power-rankup {
      position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%);
      z-index: 900; pointer-events: none;
      font-family: 'Orbitron', monospace; font-size: 18px; font-weight: 900;
      letter-spacing: 0.14em; white-space: nowrap;
      animation: rank-up 1.2s cubic-bezier(0.34,1.56,0.64,1) forwards;
    }
    @keyframes rank-up {
      0%   { opacity:0; transform:translate(-50%,-50%) scale(0.6); }
      20%  { opacity:1; transform:translate(-50%,-50%) scale(1.1); }
      70%  { opacity:1; transform:translate(-50%,-50%) scale(1); }
      100% { opacity:0; transform:translate(-50%,-50%) scale(0.9); }
    }

    /* ── COLLECT TILES ── */
    .sg-tile.collect-target {
      animation: collect-target-pulse 1s ease infinite alternate !important;
    }
    @keyframes collect-target-pulse {
      from { box-shadow: 0 0 8px rgba(255,255,255,0.4); }
      to   { box-shadow: 0 0 20px rgba(255,255,255,0.7), inset 0 0 8px rgba(255,255,255,0.2); }
    }
    .sg-tile.collect-target::after {
      content: '◎'; position: absolute;
      font-size: 14px; color: rgba(255,255,255,0.8);
      top: 50%; left: 50%; transform: translate(-50%,-50%);
      pointer-events: none; z-index: 5;
    }

    /* Collect counter badge */
    .sg-collect-counter {
      font-family: 'Orbitron', monospace; font-size: 20px; font-weight: 900;
    }

    /* ── DIFFICULTY SPIKE (every 5th level) ── */
    .sg-level-node.spike-level .sg-level-node-icon::after {
      content: '🔥'; font-size: 8px; position: absolute; top: -2px; right: -2px;
    }
    /* ══════════════════════════════════════
       PHASE 3 — CITY EVOLUTION + CHARACTER + SEASON PASS
    ══════════════════════════════════════ */

    /* ── EVOLVED CITY SKYLINE ── */
    .sg-city-scene {
      position: relative; width: 100%; overflow: hidden;
      border-radius: 14px; margin-bottom: 12px;
      background: linear-gradient(180deg, #07070f 0%, #0d0d20 60%, #111128 100%);
      border: 1px solid rgba(255,255,255,0.06);
    }
    /* Sky layers — stars, aurora glow */
    .sg-city-sky {
      position: absolute; inset: 0; pointer-events: none;
    }
    .sg-sky-star {
      position: absolute; border-radius: 50%;
      background: #fff; animation: star-twinkle var(--dur,3s) ease infinite alternate;
    }
    @keyframes star-twinkle {
      from { opacity: var(--lo, 0.2); }
      to   { opacity: var(--hi, 0.8); }
    }
    /* Ground and road */
    .sg-city-ground {
      position: absolute; bottom: 0; left: 0; right: 0; height: 18px;
      background: linear-gradient(180deg, #0a0a18, #0d0d1e);
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .sg-city-road {
      position: absolute; bottom: 0; left: 0; right: 0; height: 8px;
      background: #0d0d1e;
    }
    .sg-road-stripe {
      position: absolute; bottom: 3px; height: 2px; width: 24px;
      background: rgba(255,255,255,0.12); border-radius: 1px;
      animation: road-scroll 3s linear infinite;
    }
    @keyframes road-scroll { from{right:-30px} to{right:110%} }
    /* District labels on ground */
    .sg-dist-label {
      position: absolute; bottom: 20px;
      font-size: 6px; letter-spacing: 0.16em; font-weight: 700;
      transform: translateX(-50%);
      opacity: 0.4; transition: opacity 0.5s;
    }
    .sg-dist-label.active { opacity: 0.9; }
    /* Animated construction crane on locked districts */
    .sg-crane {
      position: absolute; bottom: 18px;
      font-size: 20px; pointer-events: none;
      animation: crane-sway 4s ease infinite alternate;
      transform-origin: bottom center;
    }
    @keyframes crane-sway { from{transform:rotate(-3deg)} to{transform:rotate(3deg)} }
    /* Victory fireworks on complete district */
    .sg-firework {
      position: absolute; pointer-events: none;
      animation: firework-burst 1s ease forwards;
    }
    @keyframes firework-burst {
      0%  { transform: scale(0); opacity: 1; }
      60% { transform: scale(1.5); opacity: 1; }
      100%{ transform: scale(2); opacity: 0; }
    }
    /* Building evolution states */
    .sg-city-building.ruins {
      filter: brightness(0.3) saturate(0);
    }
    .sg-city-building.repairing {
      animation: repair-flicker 0.8s ease infinite alternate;
    }
    @keyframes repair-flicker {
      from { filter: brightness(0.4) saturate(0.3); }
      to   { filter: brightness(0.7) saturate(0.7); }
    }
    .sg-city-building.restored {
      filter: none;
    }
    .sg-city-building.glowing {
      filter: drop-shadow(0 0 8px var(--bcolor,#00e5ff));
    }
    /* City stats bar */
    .sg-city-stats-bar {
      display: flex; gap: 10px; margin-bottom: 10px;
    }
    .sg-city-stat-pill {
      flex: 1; background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 10px; padding: 8px 10px; text-align: center;
    }
    .sg-city-stat-pill-val { font-family:'Orbitron',monospace; font-size:16px; font-weight:700; }
    .sg-city-stat-pill-lbl { font-size:8px; color:rgba(255,255,255,0.3); letter-spacing:0.1em; margin-top:2px; }

    /* ── POWER ENGINEER CHARACTER ── */
    .sg-engineer-card {
      border-radius: 16px; padding: 14px 16px; margin-bottom: 12px;
      display: flex; align-items: center; gap: 14px;
      border: 1px solid; position: relative; overflow: hidden;
    }
    .sg-engineer-card::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, transparent 60%);
    }
    .sg-engineer-avatar {
      width: 56px; height: 56px; border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 32px; flex-shrink: 0; position: relative;
      background: rgba(255,255,255,0.06);
    }
    .sg-engineer-rank-badge {
      position: absolute; bottom: -5px; right: -5px;
      background: var(--rank-color,#00e5ff); border-radius: 6px;
      font-size: 8px; font-weight: 900; color: #06060f;
      padding: 2px 5px; font-family: 'Orbitron',monospace;
    }
    .sg-engineer-name { font-family:'Orbitron',monospace; font-size:13px; font-weight:900; letter-spacing:0.08em; margin-bottom:3px; }
    .sg-engineer-title { font-size:10px; color:rgba(255,255,255,0.4); margin-bottom:6px; }
    .sg-engineer-xp-wrap { }
    .sg-engineer-xp-bar { height:5px; background:rgba(255,255,255,0.08); border-radius:3px; overflow:hidden; margin-top:4px; }
    .sg-engineer-xp-fill { height:100%; border-radius:3px; transition:width 0.8s ease; }
    .sg-engineer-dialogue {
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px; padding: 9px 12px; margin-top: 10px;
      font-size: 11px; color: rgba(255,255,255,0.55); line-height: 1.55;
      position: relative;
    }
    .sg-engineer-dialogue::before {
      content: '"'; font-size: 24px; color: rgba(255,255,255,0.1);
      position: absolute; top: 2px; left: 8px; line-height: 1;
    }

    /* ── SEASON PASS ── */
    .sg-season-header {
      border-radius: 18px; overflow: hidden; margin-bottom: 12px;
      position: relative;
    }
    .sg-season-header-bg {
      padding: 20px 18px 14px;
      background: linear-gradient(135deg, rgba(168,85,247,0.15), rgba(255,45,149,0.08));
      border: 1px solid rgba(168,85,247,0.3);
      border-radius: 18px;
    }
    .sg-season-name { font-family:'Orbitron',monospace; font-size:14px; font-weight:900; letter-spacing:0.12em; margin-bottom:3px; }
    .sg-season-subtitle { font-size:10px; color:rgba(255,255,255,0.35); margin-bottom:12px; }
    .sg-season-xp-bar { height:8px; background:rgba(255,255,255,0.08); border-radius:4px; overflow:hidden; }
    .sg-season-xp-fill { height:100%; border-radius:4px; background:linear-gradient(90deg,#a855f7,#ff2d95); transition:width 0.8s ease; box-shadow:0 0 8px rgba(168,85,247,0.4); }
    .sg-season-tier-lbl { display:flex; justify-content:space-between; margin-top:4px; font-size:8px; color:rgba(255,255,255,0.25); letter-spacing:0.1em; }

    /* Season pass tier track */
    .sg-pass-track { position:relative; padding:4px 0 8px; }
    .sg-pass-rail {
      position:absolute; top:28px; left:24px; right:24px; height:3px;
      background:rgba(255,255,255,0.07); border-radius:2px;
    }
    .sg-pass-rail-fill { height:100%; border-radius:2px; background:linear-gradient(90deg,#a855f7,#ff2d95); transition:width 0.8s ease; }
    .sg-pass-nodes { display:flex; justify-content:space-between; align-items:flex-start; position:relative; }
    .sg-pass-node { display:flex; flex-direction:column; align-items:center; gap:4px; width:46px; cursor:pointer; }
    .sg-pass-gem {
      width:34px; height:34px; border-radius:10px; border:2px solid;
      display:flex; align-items:center; justify-content:center;
      font-size:15px; transition:all 0.25s; position:relative; flex-shrink:0;
    }
    .sg-pass-gem.earned  { animation:gem-glow 2s ease infinite; }
    .sg-pass-gem.current { animation:gem-pulse 0.7s ease infinite alternate; border-color:#a855f7; }
    .sg-pass-gem.locked  { opacity:0.3; filter:grayscale(0.8); }
    .sg-pass-lbl { font-size:7px; color:rgba(255,255,255,0.3); letter-spacing:0.06em; text-align:center; }
    .sg-pass-premium {
      position:absolute; top:-6px; right:-6px; background:linear-gradient(135deg,#ffaa00,#ff7700);
      border-radius:4px; font-size:6px; font-weight:900; color:#06060f; padding:1px 4px;
    }
    .sg-pass-claim-btn {
      width:100%; border:none; border-radius:10px; padding:10px;
      font-family:'Orbitron',monospace; font-size:10px; font-weight:700;
      cursor:pointer; letter-spacing:0.1em; margin-top:10px;
      background:linear-gradient(135deg,#a855f7,#ff2d95);
      color:#fff; box-shadow:0 0 16px rgba(168,85,247,0.3);
    }
    .sg-pass-claim-btn:disabled { opacity:0.3; cursor:default; box-shadow:none; background:rgba(255,255,255,0.08); }
    /* ══════════════════════════════════════
       PHASE 4 — SQUAD + GIFTING + BRACKET
    ══════════════════════════════════════ */

    /* ── SQUAD CARD ── */
    .sg-squad-card {
      border-radius: 18px; padding: 18px 16px; margin-bottom: 12px;
      background: rgba(13,13,26,0.98);
      border: 1px solid rgba(255,255,255,0.08);
      position: relative; overflow: hidden;
    }
    .sg-squad-banner {
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
    }
    .sg-squad-name {
      font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 900;
      letter-spacing: 0.1em; margin-bottom: 3px;
    }
    .sg-squad-tag   { font-size: 9px; color: rgba(255,255,255,0.3); letter-spacing: 0.14em; margin-bottom: 12px; }
    .sg-squad-members { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 14px; }
    .sg-squad-member {
      display: flex; align-items: center; gap: 7px;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px; padding: 8px 12px; flex: 1; min-width: 130px;
    }
    .sg-squad-member.you { border-color: rgba(0,229,255,0.3); background: rgba(0,229,255,0.06); }
    .sg-squad-avatar { font-size: 22px; flex-shrink: 0; }
    .sg-squad-member-name { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.8); }
    .sg-squad-member-stat { font-size: 9px; color: rgba(255,255,255,0.35); margin-top:1px; }
    .sg-squad-member-online { width: 7px; height: 7px; border-radius: 50%; background: #00ff88; flex-shrink: 0; box-shadow: 0 0 4px #00ff88; }

    /* Squad objective */
    .sg-squad-objective {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);
      border-radius: 12px; padding: 12px 14px; margin-bottom: 12px;
    }
    .sg-squad-obj-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .sg-squad-obj-title  { font-size: 9px; font-weight: 700; letter-spacing: 0.14em; color: rgba(255,255,255,0.5); }
    .sg-squad-obj-reward { font-size: 9px; color: #ffaa00; font-weight: 700; }
    .sg-squad-obj-name   { font-family: 'Orbitron', monospace; font-size: 13px; font-weight: 900; margin-bottom: 4px; }
    .sg-squad-obj-desc   { font-size: 10px; color: rgba(255,255,255,0.38); margin-bottom: 10px; line-height: 1.5; }
    .sg-squad-progress-track { height: 8px; background: rgba(255,255,255,0.07); border-radius: 4px; overflow: hidden; }
    .sg-squad-progress-fill  {
      height: 100%; border-radius: 4px; transition: width 0.6s ease;
      background: linear-gradient(90deg, #a855f7, #ff2d95);
      box-shadow: 0 0 8px rgba(168,85,247,0.4);
    }
    .sg-squad-progress-nums { display: flex; justify-content: space-between; font-size: 8px; color: rgba(255,255,255,0.25); margin-top: 4px; letter-spacing: 0.08em; }

    /* Create squad */
    .sg-create-squad {
      border-radius: 18px; padding: 28px 20px; text-align: center;
      border: 2px dashed rgba(255,255,255,0.1); background: rgba(255,255,255,0.02);
      margin-bottom: 12px;
    }
    .sg-squad-input {
      width: 100%; background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12); border-radius: 10px;
      padding: 12px 14px; color: #fff; font-family: 'Orbitron', monospace;
      font-size: 12px; font-weight: 700; letter-spacing: 0.08em;
      outline: none; text-align: center; margin: 12px 0;
    }
    .sg-squad-input::placeholder { color: rgba(255,255,255,0.2); }

    /* ── GIFTING ── */
    .sg-gift-row { display: flex; gap: 8px; margin-bottom: 10px; }
    .sg-gift-card {
      flex: 1; border-radius: 14px; padding: 14px 10px; text-align: center;
      border: 1px solid; cursor: pointer; transition: all 0.15s; position: relative;
    }
    .sg-gift-card:hover { transform: scale(1.04); }
    .sg-gift-card:active { transform: scale(0.96); }
    .sg-gift-icon { font-size: 28px; margin-bottom: 6px; display: block; }
    .sg-gift-name { font-size: 11px; font-weight: 700; margin-bottom: 3px; }
    .sg-gift-cost { font-size: 9px; color: rgba(255,255,255,0.35); }
    .sg-gift-sent-badge {
      position: absolute; top: -5px; right: -5px; background: #00ff88;
      border-radius: 50%; width: 18px; height: 18px;
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; color: #06060f; font-weight: 900;
    }
    .sg-inbox-item {
      display: flex; align-items: center; gap: 10px;
      background: rgba(0,255,136,0.06); border: 1px solid rgba(0,255,136,0.2);
      border-radius: 12px; padding: 11px 14px; margin-bottom: 7px;
    }
    .sg-inbox-icon { font-size: 22px; flex-shrink: 0; }
    .sg-inbox-text { flex: 1; font-size: 11px; color: rgba(255,255,255,0.7); line-height: 1.5; }
    .sg-inbox-claim {
      border: none; border-radius: 8px; padding: 7px 14px;
      font-family: 'Orbitron', monospace; font-size: 8px; font-weight: 700;
      cursor: pointer; letter-spacing: 0.08em; flex-shrink: 0;
      background: #00ff88; color: #06060f; transition: all 0.15s;
    }
    .sg-inbox-claim:hover { transform: scale(1.05); }

    /* ── BRACKET TOURNAMENT ── */
    .sg-bracket-hero {
      border-radius: 18px; padding: 20px 16px; margin-bottom: 12px;
      position: relative; overflow: hidden; text-align: center;
      background: linear-gradient(135deg, rgba(255,170,0,0.12), rgba(255,45,149,0.08));
      border: 1px solid rgba(255,170,0,0.35);
    }
    .sg-bracket-title {
      font-family: 'Orbitron', monospace; font-size: 18px; font-weight: 900;
      letter-spacing: 0.12em; margin-bottom: 4px; color: #ffaa00;
      text-shadow: 0 0 16px rgba(255,170,0,0.4);
    }
    .sg-bracket-sub { font-size: 10px; color: rgba(255,255,255,0.4); margin-bottom: 14px; }
    .sg-bracket-phase {
      display: inline-block; background: rgba(255,170,0,0.15);
      border: 1px solid rgba(255,170,0,0.4); border-radius: 8px;
      padding: 4px 12px; font-size: 9px; font-weight: 700;
      color: #ffaa00; letter-spacing: 0.1em; margin-bottom: 14px;
    }

    /* Bracket tree */
    .sg-bracket-tree { position: relative; margin-bottom: 14px; }
    .sg-bracket-round { display: flex; flex-direction: column; gap: 6px; }
    .sg-bracket-match {
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px; overflow: hidden;
    }
    .sg-bracket-player {
      display: flex; align-items: center; gap: 8px; padding: 8px 12px;
      transition: background 0.2s;
    }
    .sg-bracket-player.winner { background: rgba(255,170,0,0.1); border-left: 3px solid #ffaa00; }
    .sg-bracket-player.loser  { opacity: 0.45; }
    .sg-bracket-player.you    { font-weight: 700; }
    .sg-bracket-player-name   { flex: 1; font-size: 11px; color: rgba(255,255,255,0.8); }
    .sg-bracket-player-score  { font-family: 'Orbitron', monospace; font-size: 11px; font-weight: 700; }
    .sg-bracket-divider { height: 1px; background: rgba(255,255,255,0.05); }
    .sg-bracket-round-label {
      font-size: 8px; letter-spacing: 0.18em; color: rgba(255,255,255,0.25);
      text-align: center; margin-bottom: 6px; margin-top: 10px;
    }

    /* Prize pool */
    .sg-prize-row { display: flex; gap: 8px; margin-bottom: 12px; }
    .sg-prize-card {
      flex: 1; border-radius: 12px; padding: 10px 8px; text-align: center;
      border: 1px solid; background: rgba(255,255,255,0.03);
    }
    .sg-prize-place { font-size: 16px; margin-bottom: 4px; }
    .sg-prize-amount { font-family: 'Orbitron', monospace; font-size: 13px; font-weight: 700; }
    .sg-prize-label { font-size: 8px; color: rgba(255,255,255,0.3); letter-spacing: 0.1em; margin-top: 2px; }

    /* ══════════════════════════════════════
       NEW BLOCKERS — 4 types
    ══════════════════════════════════════ */

    /* ANCHOR: steel blue, lock icon, row/col shift disabled */
    .sg-tile.blocker-anchor {
      border-color: rgba(100,160,255,0.7) !important;
      background: rgba(30,60,120,0.92) !important;
      box-shadow: inset 0 0 14px rgba(100,160,255,0.25) !important;
    }
    .sg-tile.blocker-anchor .sg-blocker-icon { color: #64a0ff; text-shadow: 0 0 8px rgba(100,160,255,0.6); }

    /* OVERCHARGE: electric gold, explodes on clear */
    .sg-tile.blocker-overcharge {
      border-color: rgba(255,220,0,0.8) !important;
      background: rgba(60,45,0,0.93) !important;
      animation: overcharge-pulse 0.8s ease infinite alternate;
    }
    @keyframes overcharge-pulse {
      from { box-shadow: inset 0 0 10px rgba(255,220,0,0.2), 0 0 8px rgba(255,220,0,0.3); }
      to   { box-shadow: inset 0 0 18px rgba(255,220,0,0.4), 0 0 20px rgba(255,220,0,0.5); }
    }
    .sg-tile.blocker-overcharge .sg-blocker-icon { color: #ffdc00; text-shadow: 0 0 10px rgba(255,220,0,0.8); }

    /* FOG: dark grey, hides gem color */
    .sg-tile.blocker-fog {
      border-color: rgba(140,140,160,0.5) !important;
      background: rgba(20,20,30,0.97) !important;
      box-shadow: inset 0 0 20px rgba(100,100,120,0.3) !important;
    }
    .sg-tile.blocker-fog .sg-node { opacity: 0 !important; }
    .sg-tile.blocker-fog.fog-revealed .sg-node { opacity: 1 !important; transition: opacity 0.4s; }
    .sg-tile.blocker-fog .sg-blocker-icon { color: rgba(180,180,200,0.6); }

    /* CHAIN: linked pairs glow same color */
    .sg-tile.blocker-chain {
      border-color: rgba(255,140,0,0.7) !important;
      background: rgba(50,25,0,0.93) !important;
    }
    .sg-tile.blocker-chain .sg-blocker-icon { color: #ff8c00; text-shadow: 0 0 8px rgba(255,140,0,0.6); }
    .sg-tile.blocker-chain.chain-matched { animation: chain-break 0.4s ease forwards; }
    @keyframes chain-break {
      0%  { transform: scale(1.2); filter: brightness(3); }
      100%{ transform: scale(0); opacity: 0; }
    }

    /* Anchor locked-row highlight */
    .sg-shift-btn.anchor-locked {
      opacity: 0.15 !important; cursor: not-allowed !important; pointer-events: none;
    }

    /* Overcharge explosion flash */
    .sg-overcharge-burst {
      position: fixed; inset: 0; z-index: 900; pointer-events: none;
      background: radial-gradient(circle at var(--bx) var(--by), rgba(255,220,0,0.45) 0%, transparent 60%);
      animation: ability-flash 0.4s ease forwards;
    }

    /* Fog reveal ripple */
    .sg-fog-reveal { animation: fog-reveal 0.3s ease forwards; }
    @keyframes fog-reveal {
      from { filter: blur(4px); opacity: 0.3; }
      to   { filter: none; opacity: 1; }
    }

    /* ══════════════════════════════════════
       STORY DIALOGUE SYSTEM
    ══════════════════════════════════════ */
    .sg-story-dialogue {
      position: fixed; bottom: 240px; left: 50%; transform: translateX(-50%);
      width: min(340px, 92vw); border-radius: 12px; padding: 10px 14px;
      border: 1px solid; z-index: 601;
      background: rgba(7,7,15,0.97); backdrop-filter: blur(12px);
      box-shadow: 0 -4px 24px rgba(0,0,0,0.6);
      animation: slide-up-in 0.4s cubic-bezier(0.34,1.56,0.64,1);
    }
    .sg-story-dialogue::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 60%);
    }
    .sg-story-char {
      display: flex; align-items: center; gap: 6px; margin-bottom: 5px;
    }
    .sg-story-char-icon { font-size: 12px; flex-shrink: 0; }
    .sg-story-char-name {
      font-family: 'Orbitron', monospace; font-size: 8px; font-weight: 900;
      letter-spacing: 0.16em;
    }
    .sg-story-char-role { font-size: 7px; color: rgba(255,255,255,0.3); letter-spacing: 0.1em; }
    .sg-story-line {
      font-size: 12px; line-height: 1.55; color: rgba(255,255,255,0.88);
      margin-top: 6px; font-style: italic;
    }
    .sg-story-line::before {
      content: '"'; position: absolute; left: 0; top: -2px;
      font-size: 18px; color: rgba(255,255,255,0.1); font-style: normal; line-height: 1;
    }
    .sg-story-dismiss {
      display: flex; justify-content: flex-end; margin-top: 6px;
    }
    .sg-story-dismiss-btn {
      background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2);
      border-radius: 6px; padding: 4px 12px; cursor: pointer;
      font-family: 'Orbitron', monospace; font-size: 9px; font-weight: 700;
      color: rgba(255,255,255,0.6); letter-spacing: 0.12em;
    }
    .sg-story-dismiss-btn:hover { color: rgba(255,255,255,0.4); }

    /* ARIA transmission — different look, monospace, scanline feel */
    .sg-aria-transmission {
      position: fixed; bottom: 260px; left: 50%; transform: translateX(-50%);
      width: min(340px, 92vw); padding: 8px 12px; z-index: 600;
      pointer-events: none;
      background: rgba(7,7,15,0.95); border: 1px solid rgba(255,45,149,0.5);
      border-radius: 10px; font-family: 'Share Tech Mono', monospace;
      font-size: 10px; color: rgba(255,45,149,0.9); letter-spacing: 0.1em;
      line-height: 1.4; backdrop-filter: blur(8px);
      animation: slide-up-in 0.35s cubic-bezier(0.34,1.56,0.64,1);
      box-shadow: 0 0 20px rgba(255,45,149,0.2);
    }
    .sg-aria-transmission::before {
      content: '◈  ARIA BROADCAST  ◈';
      display: block; font-size: 6px; color: rgba(255,45,149,0.4);
      letter-spacing: 0.2em; margin-bottom: 3px;
    }

    /* Pre-level story card */
    .sg-prelevel-story {
      border-radius: 12px; padding: 12px 14px; margin-bottom: 12px;
      border: 1px solid; position: relative; overflow: hidden;
    }
    .sg-prelevel-story::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.04) 0%, transparent 60%);
      pointer-events: none;
    }
    .sg-pls-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .sg-pls-icon   { font-size: 14px; flex-shrink: 0; }
    .sg-pls-name   { font-family:'Orbitron',monospace; font-size:9px; font-weight:900; letter-spacing:0.12em; }
    .sg-pls-role   { font-size:7px; color:rgba(255,255,255,0.3); letter-spacing:0.1em; margin-top:1px; }
    .sg-pls-line   { font-size:11px; color:rgba(255,255,255,0.7); line-height:1.65; font-style:italic; }

    /* Win screen story */
    .sg-win-story {
      border-radius: 10px; padding: 10px 12px; margin-bottom: 10px;
      border: 1px solid; position: relative;
    }
    .sg-win-story-char { font-family:'Orbitron',monospace; font-size:8px; font-weight:900; letter-spacing:0.14em; margin-bottom:5px; }
    .sg-win-story-line { font-size:11px; color:rgba(255,255,255,0.7); line-height:1.6; font-style:italic; }

    /* District story panel in campaign */
    .sg-episode-title { font-family:'Orbitron',monospace; font-size:13px; font-weight:900; letter-spacing:0.08em; margin-bottom:6px; }

    /* ── BOSS LEVEL ENVIRONMENT CARD ── */
    .sg-boss-env-card {
      width: 100%; border-radius: 16px; overflow: hidden;
      margin-bottom: 14px; position: relative;
      aspect-ratio: 16/9; flex-shrink: 0;
    }
    .sg-boss-env-img {
      width: 100%; height: 100%; object-fit: cover;
      object-position: center;
    }
    .sg-boss-env-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, transparent 30%, rgba(7,7,15,0.85) 100%);
    }
    .sg-boss-env-label {
      position: absolute; bottom: 10px; left: 14px; right: 14px;
    }
    .sg-boss-env-tag {
      font-size: 8px; letter-spacing: 0.22em; font-weight: 700;
      margin-bottom: 3px;
    }
    .sg-boss-env-title {
      font-family: 'Orbitron', monospace; font-size: 15px; font-weight: 900;
      letter-spacing: 0.1em;
    }
    /* ── PORTRAIT LOCK ── */
    #sg-landscape-block {
      display: none;
      position: fixed; inset: 0; z-index: 99999;
      background: #07070f;
      flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 32px;
    }
    @media (orientation: landscape) and (max-height: 500px) {
      #sg-landscape-block { display: flex; }
    }
    .sg-rotate-icon {
      font-size: 52px; margin-bottom: 16px;
      animation: rotate-hint 2s ease infinite;
    }
    @keyframes rotate-hint {
      0%,100% { transform: rotate(0deg); }
      40%      { transform: rotate(-90deg); }
      60%      { transform: rotate(-90deg); }
    }

    /* ── SPLASH ── */
    #sg-splash {
      position: fixed; inset: 0; z-index: 10000;
      background: #07070f;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      animation: splash-out 0.5s ease 1.6s forwards;
      pointer-events: none;
    }
    @keyframes splash-out { to { opacity:0; visibility:hidden; } }
    .sg-splash-logo {
      width: 200px; height: 200px; object-fit: contain;
      animation: splash-logo 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.2s both;
      filter: drop-shadow(0 0 24px rgba(0,229,255,0.5));
    }
    @keyframes splash-logo {
      from { opacity:0; transform:scale(0.6) translateY(20px); }
      to   { opacity:1; transform:scale(1) translateY(0); }
    }
    .sg-splash-sub {
      font-family: 'Share Tech Mono', monospace; font-size: 10px;
      letter-spacing: 0.3em; color: rgba(255,255,255,0.3);
      margin-top: 12px;
      animation: splash-logo 0.5s ease 0.7s both;
    }
    .sg-splash-bar {
      width: 120px; height: 2px; background: rgba(255,255,255,0.08);
      border-radius: 2px; margin-top: 24px; overflow: hidden;
      animation: splash-logo 0.5s ease 0.8s both;
    }
    .sg-splash-bar-fill {
      height: 100%; background: linear-gradient(90deg,#00e5ff,#ff2d95);
      border-radius: 2px;
      animation: splash-fill 1s ease 0.9s both;
    }
    @keyframes splash-fill { from{width:0} to{width:100%} }

    /* ── SCREEN NUDGE ── */
    .sg-nudge-left  { animation: nudge-left  0.16s ease-out both; }
    .sg-nudge-right { animation: nudge-right 0.16s ease-out both; }
    .sg-nudge-up    { animation: nudge-up    0.16s ease-out both; }
    .sg-nudge-down  { animation: nudge-down  0.16s ease-out both; }
    @keyframes nudge-left  { 0%{transform:translateX(0)} 40%{transform:translateX(-4px)} 100%{transform:translateX(0)} }
    @keyframes nudge-right { 0%{transform:translateX(0)} 40%{transform:translateX(4px)}  100%{transform:translateX(0)} }
    @keyframes nudge-up    { 0%{transform:translateY(0)} 40%{transform:translateY(-4px)} 100%{transform:translateY(0)} }
    @keyframes nudge-down  { 0%{transform:translateY(0)} 40%{transform:translateY(4px)}  100%{transform:translateY(0)} }

    /* ── CASCADE FLASH ── */
    .sg-cascade-flash {
      position: fixed; inset: 0; z-index: 998; pointer-events: none;
      background: radial-gradient(circle at 50% 50%, rgba(255,170,0,0.12) 0%, transparent 70%);
      animation: c-flash 0.4s ease forwards;
    }
    @keyframes c-flash { 0%{opacity:1} 100%{opacity:0} }

    /* ── WRAP CHAIN GLOW ── */
    .sg-wrap-chain-glow {
      position: fixed; inset: 0; z-index: 997; pointer-events: none;
      border: 2px solid rgba(168,85,247,0.5);
      box-shadow: inset 0 0 40px rgba(168,85,247,0.2);
      animation: wrap-fade 1.2s ease forwards;
    }
    @keyframes wrap-fade { 0%{opacity:1} 100%{opacity:0} }

    /* ── PERFECT CLEAR BANNER ── */
    .sg-perfect-clear {
      position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%);
      z-index: 999; pointer-events: none; text-align: center;
      animation: pc-in 0.5s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes pc-in {
      0%  { opacity:0; transform: translate(-50%,-50%) scale(0.5); }
      100%{ opacity:1; transform: translate(-50%,-50%) scale(1); }
    }
    .sg-pc-text {
      font-family: 'Orbitron', monospace; font-size: 22px; font-weight: 900;
      letter-spacing: 0.14em;
      background: linear-gradient(135deg,#ffaa00,#00ff88,#00e5ff);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 16px rgba(255,170,0,0.7));
      white-space: nowrap;
    }

    /* ── PATROL CORRUPTION ── */
    .sg-tile.patrol-corrupt {
      animation: patrol-pulse 0.6s ease infinite alternate !important;
    }
    @keyframes patrol-pulse {
      from { box-shadow: 0 0 8px rgba(255,45,149,0.4); border-color: rgba(255,45,149,0.5); }
      to   { box-shadow: 0 0 18px rgba(255,45,149,0.8); border-color: rgba(255,45,149,0.9); }
    }

    /* ── SPECIAL NODE CHARGED PULSE ── */
    .sg-tile:has(.sg-node)[style*="charged"] {
      animation: charged-pulse 1s ease infinite alternate;
    }
    @keyframes charged-pulse {
      from { box-shadow: 0 0 6px rgba(255,170,0,0.3); }
      to   { box-shadow: 0 0 16px rgba(255,170,0,0.7); }
    }

    /* ── GRID MEMORY REPLAY INDICATOR ── */
    .sg-ghost-indicator {
      position: fixed; bottom: 130px; right: 14px; z-index: 9998;
      background: rgba(13,13,26,0.92); border: 1px solid rgba(168,85,247,0.4);
      border-radius: 10px; padding: 6px 10px;
      font-family: 'Share Tech Mono', monospace; font-size: 9px;
      color: #a855f7; letter-spacing: 0.1em;
      backdrop-filter: blur(8px);
    }

    /* ── SKIN PICKER ── */
    .sg-skin-row { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .sg-skin-btn {
      flex: 1; min-width: 54px; border-radius: 10px; border: 1.5px solid;
      padding: 10px 6px; text-align: center; cursor: pointer;
      transition: all 0.18s; font-size: 10px; font-weight: 700;
      font-family: 'Rajdhani', sans-serif; letter-spacing: 0.06em;
    }
    .sg-skin-btn.active { transform: scale(1.06); }
    .sg-skin-btn.locked { opacity: 0.35; cursor: default; }
    .sg-skin-swatch {
      width: 22px; height: 22px; border-radius: 6px; margin: 0 auto 5px;
      transform: rotate(45deg);
    }

    /* ── SETTINGS SHEET ── */
    .sg-settings-overlay {
      position: fixed; inset: 0; z-index: 800;
      background: rgba(7,7,15,0.85);
      display: flex; align-items: flex-end; justify-content: center;
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      animation: overlay-in 0.2s ease;
    }
    .sg-settings-sheet {
      width: 100%; max-width: 460px;
      background: rgba(13,13,26,0.99);
      border-top: 1px solid rgba(255,255,255,0.1);
      border-radius: 24px 24px 0 0;
      padding: 20px 20px calc(20px + env(safe-area-inset-bottom,0px));
      animation: sheet-up 0.3s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes sheet-up { from{transform:translateY(100%)} to{transform:translateY(0)} }
    .sg-settings-handle {
      width: 36px; height: 4px; background: rgba(255,255,255,0.15);
      border-radius: 2px; margin: 0 auto 20px;
    }
    .sg-settings-row {
      display: flex; align-items: center; justify-content: space-between;
      padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .sg-settings-row:last-child { border-bottom: none; }
    .sg-settings-label { font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.75); }
    .sg-settings-sub   { font-size: 10px; color: rgba(255,255,255,0.28); margin-top:2px; letter-spacing:0.04em; }
    .sg-toggle {
      width: 48px; height: 26px; border-radius: 13px; border: none; cursor: pointer;
      position: relative; transition: background 0.25s;
      flex-shrink: 0;
    }
    .sg-toggle::after {
      content: ''; position: absolute; top: 3px; left: 3px;
      width: 20px; height: 20px; border-radius: 50%;
      background: #fff; transition: transform 0.25s;
    }
    .sg-toggle.on { background: #00e5ff; }
    .sg-toggle.off{ background: rgba(255,255,255,0.15); }
    .sg-toggle.on::after { transform: translateX(22px); }
    .sg-vol-slider {
      width: 120px; accent-color: #00e5ff;
      cursor: pointer; height: 4px;
    }
    .sg-settings-danger {
      background: rgba(255,45,149,0.08); border: 1px solid rgba(255,45,149,0.25);
      border-radius: 10px; padding: 10px 14px; cursor: pointer;
      font-size: 12px; font-weight: 700; color: #ff2d95; letter-spacing: 0.06em;
      transition: background 0.15s; width: 100%; text-align: center; margin-top: 8px;
    }
    .sg-settings-danger:hover { background: rgba(255,45,149,0.15); }
    .sg-iap-row {
      display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px;
    }
    .sg-iap-btn {
      flex: 1; min-width: 80px; background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.1); border-radius: 11px;
      padding: 10px 8px; text-align: center; cursor: pointer;
      transition: all 0.15s;
    }
    .sg-iap-btn:hover { background: rgba(255,255,255,0.09); border-color: rgba(255,255,255,0.2); }
    .sg-iap-icon  { font-size: 20px; margin-bottom: 4px; }
    .sg-iap-name  { font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.75); margin-bottom: 2px; }
    .sg-iap-price { font-size: 10px; color: rgba(255,255,255,0.35); }

    /* ── STATS PAGE ── */
    .sg-stats-grid {
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px;
    }
    .sg-stat-card {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07);
      border-radius: 13px; padding: 12px 10px; text-align: center;
    }
    .sg-stat-card-val {
      font-family: 'Orbitron', monospace; font-size: 22px; font-weight: 700;
      margin-bottom: 4px;
    }
    .sg-stat-card-lbl { font-size: 9px; color: rgba(255,255,255,0.3); letter-spacing: 0.1em; }

    /* ── WIN SCREEN UPGRADE ── */
    .sg-win-stars { display: flex; justify-content: center; gap: 10px; margin: 10px 0; }
    .sg-win-star  {
      font-size: 32px; transition: transform 0.3s, filter 0.3s;
      filter: grayscale(1) brightness(0.3);
    }
    .sg-win-star.lit {
      filter: none; animation: star-pop 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    @keyframes star-pop {
      0%  { transform: scale(0); }
      60% { transform: scale(1.3); }
      100%{ transform: scale(1); }
    }
    .sg-win-eff-bar {
      height: 5px; background: rgba(255,255,255,0.08); border-radius: 3px;
      margin: 8px 0 4px; overflow: hidden;
    }
    .sg-win-eff-fill {
      height: 100%; border-radius: 3px;
      background: linear-gradient(90deg,#00e5ff,#00ff88);
      animation: eff-grow 0.8s ease 0.5s both;
    }
    @keyframes eff-grow { from{width:0} }
    .sg-best-badge {
      display: inline-block; background: linear-gradient(135deg,rgba(255,170,0,0.2),rgba(255,100,0,0.1));
      border: 1px solid rgba(255,170,0,0.4); border-radius: 8px;
      padding: 4px 10px; font-size: 9px; font-weight: 700;
      color: #ffaa00; letter-spacing: 0.12em; margin-bottom: 8px;
    }

    /* ── DISTRICT UNLOCK CEREMONY ── */
    .sg-district-unlock {
      position: fixed; inset: 0; z-index: 750;
      background: rgba(7,7,15,0.9);
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      animation: overlay-in 0.3s ease;
    }
    .sg-du-modal {
      text-align: center; padding: 32px 28px;
      animation: modal-in 0.5s cubic-bezier(0.34,1.56,0.64,1);
    }
    .sg-du-icon  { font-size: 72px; display: block; margin-bottom: 12px;
      animation: du-bounce 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.2s both; }
    @keyframes du-bounce {
      0%{transform:scale(0) rotate(-20deg)} 70%{transform:scale(1.2) rotate(5deg)} 100%{transform:scale(1) rotate(0)}
    }
    .sg-du-eyebrow { font-size: 10px; letter-spacing: 0.24em; color:rgba(255,255,255,0.35); margin-bottom:6px; }
    .sg-du-title   { font-family:'Orbitron',monospace; font-size:22px; font-weight:900; letter-spacing:0.1em; margin-bottom:6px; }
    .sg-du-sub     { font-size:12px; color:rgba(255,255,255,0.38); margin-bottom:22px; line-height:1.6; }

    /* ── END GAME ── */
    .sg-endgame {
      position: fixed; inset: 0; z-index: 760;
      background: rgba(7,7,15,0.96);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
      overflow-y: auto; padding: 24px 20px;
    }
    .sg-endgame-logo {
      font-family:'Orbitron',monospace; font-weight:900; font-size:28px;
      letter-spacing:0.2em;
      background:linear-gradient(135deg,#ffaa00 0%,#ff2d95 50%,#00e5ff 100%);
      -webkit-background-clip:text; -webkit-text-fill-color:transparent;
      filter:drop-shadow(0 0 20px rgba(255,170,0,0.5));
      margin-bottom:8px;
    }
    .sg-endgame-crown { font-size:64px; margin-bottom:12px; animation:du-bounce 0.8s cubic-bezier(0.34,1.56,0.64,1) 0.3s both; }

    /* ── NEAR-WIN TENSION ── */
    .sg-app.near-win-state::before {
      content: '';
      position: fixed; inset: 0; z-index: 999; pointer-events: none;
      border: 3px solid #ff2d95;
      border-radius: 0;
      animation: nw-border-pulse 0.55s ease infinite alternate;
    }
    @keyframes nw-border-pulse {
      from { box-shadow: inset 0 0 30px rgba(255,45,149,0.25), 0 0 30px rgba(255,45,149,0.15); border-color: rgba(255,45,149,0.6); }
      to   { box-shadow: inset 0 0 60px rgba(255,45,149,0.5), 0 0 60px rgba(255,45,149,0.35); border-color: #ff2d95; }
    }

    /* Last move banner */
    .sg-last-move-banner {
      position: fixed; bottom: 255px; left: 50%; transform: translateX(-50%);
      white-space: nowrap; padding: 5px 16px; z-index: 599; pointer-events: none;
      background: linear-gradient(90deg, rgba(255,45,149,0.25), rgba(255,170,0,0.18));
      border: 1px solid rgba(255,45,149,0.6);
      border-radius: 10px; text-align: center; flex-shrink: 0;
      font-family: 'Orbitron', monospace; font-size: 11px; font-weight: 900;
      letter-spacing: 0.14em; color: #ff2d95;
      animation: last-move-flash 0.4s ease infinite alternate;
    }
    @keyframes last-move-flash {
      from { opacity: 0.75; } to { opacity: 1; }
    }

    /* Near-win modal extras */
    .sg-nw-bldg-row {
      display: flex; align-items: center; gap: 10px;
      background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px; padding: 9px 12px; margin-bottom: 6px; text-align: left;
    }
    .sg-nw-bldg-icon { font-size: 20px; flex-shrink: 0; }
    .sg-nw-bldg-info { flex: 1; }
    .sg-nw-bldg-name { font-size: 12px; font-weight: 700; margin-bottom: 2px; }
    .sg-nw-bldg-need { font-size: 10px; color: rgba(255,255,255,0.4); }
    .sg-nw-track { height: 4px; background: rgba(255,255,255,0.08); border-radius: 2px; margin-top: 5px; overflow: hidden; }
    .sg-nw-fill  { height: 100%; border-radius: 2px; transition: width 0.4s ease; }

    /* Fail breakdown in lose modal */
    .sg-fail-reason {
      background: rgba(255,45,149,0.06); border: 1px solid rgba(255,45,149,0.18);
      border-radius: 10px; padding: 10px 14px; margin: 10px 0;
      font-size: 11px; color: rgba(255,255,255,0.5); line-height: 1.6; text-align: left;
    }
    .sg-fail-line { display: flex; align-items: center; gap: 7px; margin-bottom: 3px; }
    .sg-fail-line:last-child { margin-bottom: 0; }
    .sg-fail-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }

    /* ══════════════════════════════════════════
       ABILITIES — COMPLETE OVERHAUL
    ══════════════════════════════════════════ */

    /* ── ABILITY BAR ── */
    .sg-abilities-bar {
      display: flex; gap: 4px; padding: 2px 10px 1px;
      flex-shrink: 0; align-items: flex-end;
    }
    .sg-abilities-label {
      font-size: 7px; letter-spacing: 0.14em; color: rgba(255,255,255,0.2);
      writing-mode: horizontal-tb; padding-bottom: 4px; flex-shrink: 0;
    }

    /* ── ABILITY BUTTON ── */
    .sg-ability-btn {
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      width: 46px; height: 50px; border-radius: 11px; border: 2px solid;
      background: rgba(10,10,20,0.9); cursor: pointer;
      transition: transform 0.12s, box-shadow 0.2s, border-color 0.2s, background 0.2s;
      position: relative; flex-shrink: 0; padding: 7px 4px 4px;
      overflow: hidden;
    }
    .sg-ability-btn::before {
      content: ''; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(255,255,255,0.07) 0%, transparent 60%);
      pointer-events: none;
    }
    .sg-ability-btn:hover:not(:disabled) { transform: scale(1.08) translateY(-2px); }
    .sg-ability-btn:active:not(:disabled) { transform: scale(0.93); }
    .sg-ability-btn:disabled { opacity: 0.22; cursor: default; filter: grayscale(0.6); }

    /* ARMED state — ability has been activated, waiting for use */
    .sg-ability-btn.armed {
      border-width: 2px;
      animation: ability-armed 0.7s ease infinite alternate;
    }
    @keyframes ability-armed {
      from { box-shadow: 0 0 8px var(--acolor,#ffaa00), 0 0 0px var(--acolor,#ffaa00) inset; transform: scale(1); }
      to   { box-shadow: 0 0 22px var(--acolor,#ffaa00), 0 0 8px var(--acolor,#ffaa00) inset; transform: scale(1.05) translateY(-2px); }
    }
    .sg-ability-btn.armed::after {
      content: 'ARMED'; position: absolute; bottom: 2px; left: 0; right: 0;
      text-align: center; font-size: 6px; font-weight: 900; letter-spacing: 0.12em;
      color: var(--acolor,#ffaa00); font-family: 'Orbitron', monospace;
    }

    .sg-ability-icon { font-size: 18px; line-height: 1; }
    .sg-ability-count {
      position: absolute; top: 4px; right: 5px;
      font-family: 'Orbitron', monospace; font-size: 9px; font-weight: 900;
      color: #fff; background: rgba(0,0,0,0.75); border-radius: 5px;
      padding: 1px 4px; line-height: 1.3;
    }
    .sg-ability-name { font-size: 6px; letter-spacing: 0.03em; font-weight: 700; margin-top: 0px; }

    /* ── ACTIVATION CINEMATIC ── */
    .sg-ability-cinematic {
      position: fixed; inset: 0; z-index: 1500; pointer-events: none;
      display: flex; align-items: center; justify-content: center;
      animation: cinematic-in-out 2s cubic-bezier(0.22,1,0.36,1) forwards;
    }
    @keyframes cinematic-in-out {
      0%   { opacity: 0; }
      8%   { opacity: 1; }
      75%  { opacity: 1; }
      100% { opacity: 0; }
    }
    .sg-ability-cinematic-bg {
      position: absolute; inset: 0;
      background: var(--cbg, rgba(255,170,0,0.15));
    }
    .sg-ability-cinematic-card {
      position: relative; text-align: center;
      padding: 28px 32px 24px;
      background: rgba(8,8,16,0.97);
      border: 2px solid var(--cborder, #ffaa00);
      border-radius: 24px;
      box-shadow: 0 0 40px var(--cglow, rgba(255,170,0,0.3)), inset 0 0 20px var(--cglow, rgba(255,170,0,0.05));
      animation: cinematic-card 2s cubic-bezier(0.34,1.56,0.64,1) forwards;
      max-width: 280px; width: 88%;
    }
    @keyframes cinematic-card {
      0%   { transform: scale(0.7) translateY(20px); }
      18%  { transform: scale(1.04) translateY(-4px); }
      28%  { transform: scale(1) translateY(0); }
      100% { transform: scale(1) translateY(0); }
    }
    .sg-cin-stripe {
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, transparent, var(--cborder,#ffaa00), transparent);
    }
    .sg-cin-icon  { font-size: 56px; display: block; margin-bottom: 8px;
      animation: cin-icon-pop 0.5s cubic-bezier(0.34,1.56,0.64,1) 0.1s both; }
    @keyframes cin-icon-pop {
      from { transform: scale(0) rotate(-15deg); opacity: 0; }
      to   { transform: scale(1) rotate(0deg); opacity: 1; }
    }
    .sg-cin-name {
      font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 900;
      letter-spacing: 0.12em; margin-bottom: 6px;
      color: var(--cborder, #ffaa00);
      text-shadow: 0 0 16px var(--cglow, rgba(255,170,0,0.5));
    }
    .sg-cin-effect {
      font-size: 12px; color: rgba(255,255,255,0.65);
      line-height: 1.55; font-weight: 500;
    }
    .sg-cin-particle {
      position: absolute; pointer-events: none;
      animation: cin-particle 1.2s ease-out both;
    }
    @keyframes cin-particle {
      0%   { opacity: 1; transform: translate(0,0) scale(1); }
      100% { opacity: 0; transform: translate(var(--px), var(--py)) scale(0.3); }
    }

    /* ── ACTIVE ABILITY HUD BANNER ── */
    .sg-active-ability-banner {
      margin: 0 10px 2px; border-radius: 8px; padding: 4px 10px;
      display: flex; align-items: center; gap: 6px; flex-shrink: 0;
      border: 1.5px solid var(--ab-border, rgba(255,170,0,0.4));
      background: var(--ab-bg, rgba(255,170,0,0.08));
      animation: banner-in 0.3s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes banner-in {
      from { transform: translateY(-8px); opacity: 0; }
      to   { transform: translateY(0); opacity: 1; }
    }
    .sg-ab-icon   { font-size: 18px; flex-shrink: 0; }
    .sg-ab-text   { flex: 1; }
    .sg-ab-name   { font-family: 'Orbitron', monospace; font-size: 9px; font-weight: 900; letter-spacing: 0.1em; }
    .sg-ab-desc   { font-size: 9px; color: rgba(255,255,255,0.4); margin-top: 1px; }
    .sg-ab-badge  {
      font-family: 'Orbitron', monospace; font-size: 10px; font-weight: 900;
      padding: 3px 7px; border-radius: 6px;
      background: var(--ab-border, rgba(255,170,0,0.3));
      color: var(--ab-color, #ffaa00); flex-shrink: 0;
    }

    /* ── GRID OVERLAYS WHILE ACTIVE ── */
    /* SURGE: golden shimmer across the whole grid area */
    .sg-grid-surge-overlay {
      position: absolute; inset: 0; pointer-events: none; z-index: 10; border-radius: 8px;
      background: radial-gradient(ellipse at 50% 50%, rgba(255,170,0,0.12) 0%, transparent 70%);
      animation: surge-shimmer 1.2s ease infinite alternate;
    }
    @keyframes surge-shimmer {
      from { opacity: 0.5; }
      to   { opacity: 1; }
    }
    /* FREEZE: blue frost overlay on corrupt tiles handled via tile class */
    .sg-tile.frozen-corrupt {
      animation: freeze-pulse 1.5s ease infinite alternate !important;
    }
    @keyframes freeze-pulse {
      from { box-shadow: inset 0 0 10px rgba(165,243,252,0.4), 0 0 6px rgba(165,243,252,0.3); border-color: #a5f3fc !important; }
      to   { box-shadow: inset 0 0 18px rgba(165,243,252,0.7), 0 0 14px rgba(165,243,252,0.5); border-color: #a5f3fc !important; }
    }
    /* WILDFIRE: full row/col line highlight on hover */
    .sg-grid-wildfire-row { outline: 2px solid rgba(255,119,0,0.6); outline-offset: 2px; border-radius: 4px; background: rgba(255,119,0,0.08) !important; }
    .sg-grid-wildfire-col-tile { box-shadow: inset 0 0 12px rgba(255,119,0,0.3) !important; border-color: rgba(255,119,0,0.5) !important; }

    /* +3 MOVES bounce on counter */
    .sg-moves-bump {
      animation: moves-bump 0.5s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes moves-bump {
      0%   { transform: scale(1); }
      40%  { transform: scale(1.5); color: #00e5ff; text-shadow: 0 0 16px #00e5ff; }
      100% { transform: scale(1); }
    }

    /* CLEANSE: tile shatter animation */
    .sg-tile.cleansing {
      animation: tile-shatter 0.4s ease forwards !important;
    }
    @keyframes tile-shatter {
      0%   { transform: scale(1) rotate(0deg); opacity: 1; }
      40%  { transform: scale(1.3) rotate(8deg); opacity: 0.8; filter: brightness(2) saturate(0); }
      100% { transform: scale(0) rotate(-20deg); opacity: 0; }
    }

    /* ── ABILITY FLASH (still used as subtle BG tint) ── */
    .sg-ability-use-flash {
      position: fixed; inset: 0; z-index: 997; pointer-events: none;
      animation: ability-flash 0.5s ease forwards;
    }
    @keyframes ability-flash { 0%{opacity:0.25} 40%{opacity:0.25} 100%{opacity:0} }

    /* Ability shop in CityTab */
    .sg-ability-shop-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
    .sg-ability-shop-card {
      border: 1px solid; border-radius: 14px; padding: 14px 12px;
      background: rgba(255,255,255,0.03); transition: all 0.2s;
    }
    .sg-ability-shop-card:hover { background: rgba(255,255,255,0.06); }
    .sg-abilshop-icon { font-size: 28px; margin-bottom: 6px; display: block; }
    .sg-abilshop-name { font-size: 13px; font-weight: 700; margin-bottom: 3px; }
    .sg-abilshop-desc { font-size: 10px; color: rgba(255,255,255,0.38); line-height: 1.45; margin-bottom: 10px; }
    .sg-abilshop-footer { display: flex; align-items: center; justify-content: space-between; }
    .sg-abilshop-owned { font-family: 'Orbitron', monospace; font-size: 12px; font-weight: 700; }
    .sg-abilshop-buy {
      border: none; border-radius: 8px; padding: 6px 12px;
      font-family: 'Orbitron', monospace; font-size: 8px; font-weight: 700;
      cursor: pointer; letter-spacing: 0.08em; transition: all 0.15s;
    }
    .sg-abilshop-buy:hover:not(:disabled) { transform: scale(1.05); }
    .sg-abilshop-buy:disabled { opacity: 0.3; cursor: default; }

    /* ── SPREAD TENSION BAR ── */
    .sg-spread-bar-wrap {
      margin: 0 12px 1px; flex-shrink: 0;
    }
    .sg-spread-bar-label {
      display: flex; justify-content: space-between; align-items: center;
      font-size: 9px; letter-spacing: 0.12em; margin-bottom: 3px;
    }
    .sg-spread-bar-lbl-text { color: rgba(255,45,149,0.8); font-weight: 700; }
    .sg-spread-bar-lbl-moves { color: rgba(255,255,255,0.35); }
    .sg-spread-bar-track {
      height: 5px; background: rgba(255,45,149,0.1);
      border-radius: 3px; overflow: hidden;
      border: 1px solid rgba(255,45,149,0.2);
    }
    .sg-spread-bar-fill {
      height: 100%; border-radius: 3px;
      transition: width 0.3s ease, background 0.3s;
    }
    .sg-spread-bar-wrap.imminent .sg-spread-bar-fill {
      animation: spread-pulse 0.4s ease infinite alternate;
    }
    @keyframes spread-pulse {
      from { box-shadow: none; }
      to   { box-shadow: 0 0 8px rgba(255,45,149,0.8); }
    }

    /* ── CORRUPTION WARN ── */
    .sg-crpt-warn {
      margin: 0 14px 4px;
      background: rgba(255,45,149,0.08);
      border: 1px solid rgba(255,45,149,0.3);
      border-radius: 8px; padding: 5px 12px;
      font-size: 10px; color: var(--mag); text-align: center;
      letter-spacing: 0.1em; flex-shrink: 0;
      animation: blink 0.7s ease infinite alternate;
    }
    @keyframes blink { from { opacity: 0.6; } to { opacity: 1; } }

    /* ── TOASTS ── */
    .sg-toasts {
      position: fixed; top: 38%; left: 50%; transform: translateX(-50%);
      display: flex; flex-direction: column; align-items: center;
      gap: 5px; pointer-events: none; z-index: 550; min-height: 0;
    }
    .sg-toast {
      font-family: 'Share Tech Mono', monospace; font-size: 12px; font-weight: 700;
      letter-spacing: 0.08em;
      animation: toast-in 0.28s cubic-bezier(0.34,1.56,0.64,1);
    }
    @keyframes toast-in {
      from { opacity: 0; transform: scale(0.6) translateY(6px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* ── GRID AREA ── */
    .sg-grid-area {
      display: flex; flex-direction: column; align-items: center;
      gap: var(--gap); flex-shrink: 0;
    }
    .sg-col-btns { display: flex; gap: var(--gap); padding: 0; }
    .sg-grid-row { display: flex; gap: var(--gap); align-items: center; }

    /* Arrow shift buttons */
    .sg-shift-btn {
      width: 32px; height: var(--sz);
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 8px;
      color: rgba(255,255,255,0.25); font-size: 10px;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: all 0.12s; flex-shrink: 0;
      font-family: inherit;
    }
    .sg-shift-btn.col-btn { width: var(--sz); height: 26px; }
    .sg-shift-btn:hover:not(:disabled) {
      background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7);
      border-color: rgba(255,255,255,0.18);
    }
    .sg-shift-btn:active:not(:disabled) { transform: scale(0.82); }
    .sg-shift-btn:disabled { opacity: 0.1; cursor: default; }
    .sg-shift-btn.flash {
      background: rgba(255,255,255,0.18) !important;
      color: #fff !important; border-color: rgba(255,255,255,0.4) !important;
    }

    /* Grid row wrapper — clips sliding tiles */
    .sg-row-clip {
      overflow: hidden; border-radius: 11px;
      display: flex; gap: var(--gap);
    }
    .sg-col-clip-wrap {
      overflow: hidden; border-radius: 11px;
      display: inline-flex;
    }

    /* ── TILE ── */
    .sg-tile {
      width: var(--sz); height: var(--sz);
      border-radius: 11px; border: 2px solid;
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden;
      transition: box-shadow 0.12s, border-color 0.12s, background 0.08s;
      cursor: default; flex-shrink: 0;
      will-change: transform;
    }
    .sg-tile.matched {
      animation: tile-pop 0.44s cubic-bezier(0.36,0.07,0.19,0.97);
      z-index: 3;
    }
    @keyframes tile-pop {
      0%   { transform: scale(1); }
      25%  { transform: scale(1.28) rotate(5deg); }
      55%  { transform: scale(1.18) rotate(-3deg); }
      100% { transform: scale(1); }
    }
    .sg-tile.corrupt { cursor: default; }

    /* Tile inner shapes */
    .sg-node {
      width: 22px; height: 22px; border-radius: 4px;
      transform: rotate(45deg);
      position: relative; z-index: 2;
      transition: background 0.1s, box-shadow 0.1s;
    }
    .sg-node-ring {
      position: absolute; inset: -5px; border-radius: 7px;
      border: 1px solid; opacity: 0;
      transition: opacity 0.2s;
      transform: rotate(45deg);
    }
    .sg-tile.matched .sg-node-ring { opacity: 0.5; animation: ring-pulse 0.44s ease; }
    @keyframes ring-pulse { 0%{transform:rotate(45deg) scale(1)} 50%{transform:rotate(45deg) scale(1.6); opacity:0.6} 100%{transform:rotate(45deg) scale(2); opacity:0;} }

    .sg-tile-glow {
      position: absolute; inset: 0; pointer-events: none; z-index: 1;
      transition: opacity 0.12s;
    }

    /* Corrupt tile */
    .sg-corrupt-icon { font-size: 18px; z-index: 2; opacity: 0.7; filter: saturate(0.3); }
    .sg-corrupt-overlay {
      position: absolute; inset: 0;
      background: repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(150,0,220,0.08) 4px, rgba(150,0,220,0.08) 8px);
      pointer-events: none;
    }

    /* ── SLIDE ANIMATIONS ── */
    .slide-left  { animation: sl-left  var(--slide-dur) ease-out both; }
    .slide-right { animation: sl-right var(--slide-dur) ease-out both; }
    .slide-up    { animation: sl-up    var(--slide-dur) ease-out both; }
    .slide-down  { animation: sl-down  var(--slide-dur) ease-out both; }

    @keyframes sl-left  { from{transform:translateX(0)} to{transform:translateX(calc(-1*(var(--sz) + var(--gap))))} }
    @keyframes slide-right { from{background-position:0 0} to{background-position:200% 0} }
    @keyframes sl-right { from{transform:translateX(0)} to{transform:translateX(calc(var(--sz) + var(--gap)))} }
    @keyframes sl-up    { from{transform:translateY(0)} to{transform:translateY(calc(-1*(var(--sz) + var(--gap))))} }
    @keyframes sl-down  { from{transform:translateY(0)} to{transform:translateY(calc(var(--sz) + var(--gap)))} }

    /* ── BUILDINGS ── */
    .sg-bldg-list { padding: 0 10px 4px; flex-shrink: 1; overflow-y: auto; max-height: 160px; min-height: 0; }
    .sg-bldg-lbl { font-size: 7px; letter-spacing: 0.18em; color: rgba(255,255,255,0.18); margin-bottom: 4px; }
    .sg-bldg {
      display: flex; align-items: center; gap: 7px;
      padding: 5px 9px; border-radius: 9px; border: 1px solid;
      margin-bottom: 3px; transition: all 0.45s;
      position: relative; overflow: hidden;
    }
    .sg-bldg::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.03) 100%);
    }
    .sg-bldg-icon { font-size: 16px; flex-shrink: 0; transition: filter 0.4s; }
    .sg-bldg-info { flex: 1; }
    .sg-bldg-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2px; }
    .sg-bldg-name { font-size: 10px; font-weight: 600; transition: color 0.4s; }
    .sg-bldg-count { font-family: 'Share Tech Mono', monospace; font-size: 10px; }
    .sg-bldg-track { height: 3px; background: rgba(255,255,255,0.07); border-radius: 2px; overflow: hidden; }
    .sg-bldg-fill { height: 100%; border-radius: 2px; transition: width 0.5s ease, box-shadow 0.4s; }
    .sg-bldg-sub { font-size: 8px; margin-top: 2px; color: rgba(255,255,255,0.2); letter-spacing: 0.06em; }

    .sg-bldg.online .sg-bldg-icon::after {
      content: ''; display: block; width: 6px; height: 6px; border-radius: 50%;
      background: var(--green); margin: -6px auto 0;
      box-shadow: 0 0 6px var(--green);
      animation: dot-pulse 1.2s ease infinite;
    }
    @keyframes dot-pulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }
