/* ─── LIVES ─────────────────────────────────────────────────────── */
function loadLives(){
  try{
    const s=localStorage.getItem(LIVES_KEY);
    if(!s) return {count:MAX_LIVES,lastRegen:Date.now()};
    const d=JSON.parse(s);
    const elapsed=Date.now()-d.lastRegen;
    const regenCount=Math.floor(elapsed/LIFE_REGEN_MS);
    if(regenCount>0){
      d.count=Math.min(MAX_LIVES,d.count+regenCount);
      d.lastRegen=d.lastRegen+regenCount*LIFE_REGEN_MS;
    }
    return d;
  }catch{ return {count:MAX_LIVES,lastRegen:Date.now()}; }
}
function saveLives(l){ try{ localStorage.setItem(LIVES_KEY,JSON.stringify(l)); }catch{} }
function msToNextLife(l){
  if(l.count>=MAX_LIVES) return 0;
  return Math.max(0,LIFE_REGEN_MS-(Date.now()-l.lastRegen));
}
function fmtTime(ms){
  const m=Math.floor(ms/60000), s=Math.floor((ms%60000)/1000);
  return m+":"+String(s).padStart(2,"0");
}

/* ─── AUDIO ENGINE ──────────────────────────────────────────────── */
const Audio = (function(){
  var ctx=null;
  function getCtx(){ if(!ctx){ try{ ctx=new(window.AudioContext||window.webkitAudioContext)(); }catch(e){} } return ctx; }
  function tone(freq,type,dur,gain,delay){
    var c=getCtx(); if(!c) return;
    try{
      var osc=c.createOscillator(), g=c.createGain();
      osc.connect(g); g.connect(c.destination);
      osc.frequency.value=freq; osc.type=type||"sine";
      var t=c.currentTime+(delay||0);
      g.gain.setValueAtTime(0,t);
      g.gain.linearRampToValueAtTime(gain||0.25,t+0.01);
      g.gain.exponentialRampToValueAtTime(0.001,t+dur);
      osc.start(t); osc.stop(t+dur+0.05);
    }catch(e){}
  }
  return {
    shift:   function(){ tone(160,"sine",0.07,0.15); },
    match:   function(){ tone(520,"sine",0.1,0.2); tone(660,"sine",0.15,0.15,0.05); },
    cascade: function(n){ tone(100*(1+n*0.8),"sawtooth",0.22,0.25); tone(200*(1+n*0.5),"sine",0.18,0.16,0.04); },
    powerOn: function(){ [262,330,392,523].forEach(function(f,i){ tone(f,"sine",0.4,0.28,i*0.06); }); },
    chain:   function(n){ for(var i=0;i<Math.min(n,5);i++){ (function(j){ tone(280+j*110,"sine",0.1,0.18,j*0.055); })(i); } },
    win:     function(){ [523,659,784,1047,1319].forEach(function(f,i){ tone(f,"sine",0.5,0.3,i*0.08); }); },
    bossWin: function(){ [262,330,392,523,659,784,1047].forEach(function(f,i){ tone(f,"sine",0.55,0.32,i*0.075); }); },
    lose:     function(){ tone(200,"sawtooth",0.25,0.28); tone(150,"sawtooth",0.35,0.22,0.12); tone(100,"sawtooth",0.28,0.18,0.28); },
    tap:      function(){ tone(800,"sine",0.04,0.08); },
    lastMove: function(){ tone(320,"sawtooth",0.12,0.22); tone(240,"sawtooth",0.18,0.18,0.1); },
