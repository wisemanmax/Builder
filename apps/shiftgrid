  function buyUpgrade(id,cur,cost,currency){
    var curr = currency||"parts";
    if(curr==="parts" && meta.parts<cost) return;
    if(curr==="coins" && meta.coins<cost) return;
    setMeta(function(m){
      var newUpg=Object.assign({},m.upgrades,{[id]:cur+1});
      var updates={upgrades:newUpg};
      if(curr==="parts") updates.parts=m.parts-cost;
      else updates.coins=m.coins-cost;
