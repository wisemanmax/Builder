/* Assign objectives to levels based on position within district */
/* Positions 3,7 get special objectives; boss always standard */
function getLevelObjective(levelDef) {
  if(levelDef.boss||levelDef.isMaster||!levelDef.id||typeof levelDef.id!=="number") return "standard";
  var pos = levelDef.id % 10; /* 0-9 within district */
  if(pos===3) return "timed";
  if(pos===6) return "collect";
  if(pos===7) return "containment";
  /* Every 5th non-boss level is minmoves spike */
  if(pos===4||pos===8) return "minmoves";
  return "standard";
}
/* Timer seconds per district (harder as you go) */
function getTimerSeconds(levelDef){
  var dist=Math.floor((levelDef.id||0)/10);
  return [90,75,60,50,40][dist]||60;
}
/* Collect target count */
function getCollectTarget(levelDef){
  var dist=Math.floor((levelDef.id||0)/10);
  return [6,8,10,10,12][dist]||8;
}
/* MinMoves par — tighter than normal 3-star threshold */
function getMinMovesPar(levelDef){
  return Math.max(3,Math.floor(levelDef.moves*0.45));
}

