    timers.current.forEach(clearTimeout); timers.current=[];

    setSlideAnim({type:type,idx:idx,dir:dir});
    setPhase("busy");
    Audio.shift();

    later(function(){
      setSlideAnim(null);

      let g=doShift(grid,type,idx,dir);
      const frames=[],totCleared={};
      let pts=0,cascades=0,chargeBoost=1;
      const toastQueue=[];

      while(true){
        let m=findMatches(g);
        if(!m.size) break;
        const shapes=detectShapes(g,m);
        shapes.forEach(function(sh){
          if(!toastQueue.find(function(x){ return x.text===sh.label; })) toastQueue.push({text:sh.label,color:"#ffaa00"});
          if(sh.type==="battery"){ chargeBoost=2; sessionStatsRef.current.batteries++; }
          if(sh.type==="pulse"&&sh.pos){ m=expandPulse(m,sh.pos); sessionStatsRef.current.pulses++; }
        });
        var nearCorrupt=clearNearCorruption(g,m);
        nearCorrupt.forEach(function(k){ m.add(k); });
        sessionStatsRef.current.corruptCleared+=nearCorrupt.size;
        frames.push({g:g,m:new Set(m)});
        const res=applyGravity(g,m);
        Object.keys(res.cleared).forEach(function(col){ totCleared[col]=(totCleared[col]||0)+res.cleared[col]; });
        pts+=m.size*10*(1+cascades*0.5)*comboAmp;
        cascades++;
        if(cascades>sessionStatsRef.current.maxCascade) sessionStatsRef.current.maxCascade=cascades;
        frames.push({g:res.g,m:new Set()});
        g=res.g;
      }

      const newMC=moveCount+1;
      let finalG=g;
      if((levelDef.hazards||0)>0&&newMC%spreadEvery===0) finalG=spreadCorruption(g,hazardSlow);
      const free=Math.random()<freeChance;
      const newMoves=free?moves:moves-1;
      if(free) addToast("FREE MOVE!","#00ff88");

      const newBldgs=bldgs.map(function(b){
        const add=(totCleared[b.color]||0)*chargeBoost;
        const ch=Math.min(b.max,b.ch+add);
        return Object.assign({},b,{ch:ch,on:ch>=b.max});
      });

      setMoveCount(newMC); setMoves(newMoves);

      /* ── LAST MOVE WARNING ── */
      if(newMoves===1 && !newBldgs.every(function(b){ return b.on; })){
        addToast("⚠ LAST MOVE","#ff2d95");
        Audio.lastMove();
      }

      function finish(){
        setGrid(finalG); setHi(new Set()); setBldgs(newBldgs); setScore(function(s){ return s+Math.round(pts); });
        toastQueue.forEach(function(t,i){ setTimeout(function(){ addToast(t.text,t.color); },i*320); });
        if(cascades>1){ setTimeout(function(){ addToast("CHAIN x"+cascades,"#ffaa00"); },toastQueue.length*320); Audio.chain(cascades); }
        if(cascades>=1) Audio.cascade(cascades-1);
        if(newBldgs.every(function(b){ return b.on; })){ setPhase("win"); setTimeout(function(){ if(levelDef.boss) Audio.bossWin(); else Audio.win(); },100); return; }

        if(newMoves<=0){
          /* ── NEAR-WIN CHECK ── */
          var offlineBldgs=newBldgs.filter(function(b){ return !b.on; });
          var anyClose=offlineBldgs.some(function(b){ return b.ch/b.max>=0.4; });
          if(!lastChanceRef.current && anyClose){
            /* Build the breakdown for the modal */
            var breakdown=offlineBldgs.map(function(b){
              var need=b.max-b.ch;
              return {label:b.label,icon:b.icon,color:b.color,ch:b.ch,max:b.max,need:Math.ceil(need)};
            });
            setNearWinData(breakdown);
            setPhase("nearwin");
            Audio.nearWin();
            setTimeout(onLose,300);
            return;
          }
          /* Normal lose */
          var failBreakdown=offlineBldgs.map(function(b){
            return {label:b.label,icon:b.icon,color:b.color,ch:b.ch,max:b.max,need:Math.ceil(b.max-b.ch)};
          });
          setNearWinData(failBreakdown);
          setPhase("lose"); setTimeout(Audio.lose.bind(Audio),100); setTimeout(onLose,300); return;
        }
        setPhase("idle");
      }

      if(!frames.length){ setGrid(finalG); if(newMoves<=0) setPhase("lose"); else setPhase("idle"); return; }
      let fi=0;
      function step(){
        if(fi>=frames.length){ finish(); return; }
        const fr=frames[fi++]; setGrid(fr.g); setHi(fr.m);
        later(step,fr.m.size>0?400:170);
      }
      setGrid(frames[0].g); setHi(frames[0].m); fi=1; later(step,400);

    }, SLIDE_MS);

  },[grid,phase,moves,bldgs,moveCount,hazardSlow,comboAmp,freeChance,spreadEvery,levelDef]);

  /* ── SWIPE HANDLING ── */
  function onTouchStart(e){
    if(phase!=="idle") return;
    const touch=e.touches[0];
    const rect=gridRef.current.getBoundingClientRect();
    const relX=touch.clientX-rect.left-(SZ+GAP);
    const relY=touch.clientY-rect.top-(SZ+GAP);
    touchRef.current={
      startX:touch.clientX, startY:touch.clientY,
      startRow:Math.floor(relY/(SZ+GAP)),
      startCol:Math.floor(relX/(SZ+GAP)),
      moved:false
    };
  }
  function onTouchMove(e){
    const t=touchRef.current;
    const dx=Math.abs(e.touches[0].clientX-t.startX);
    const dy=Math.abs(e.touches[0].clientY-t.startY);
    if(dx>8||dy>8){ t.moved=true; e.preventDefault(); }
  }
  function onTouchEnd(e){
    const t=touchRef.current;
    if(!t.moved) return;
    const touch=e.changedTouches[0];
    const dx=touch.clientX-t.startX, dy=touch.clientY-t.startY;
    const absDx=Math.abs(dx), absDy=Math.abs(dy);
    const THRESH=32;
    if(absDx<THRESH&&absDy<THRESH) return;
    if(absDx>absDy){
      if(t.startRow>=0&&t.startRow<ROWS) handleShift("row",t.startRow,dx>0?"right":"left");
    } else {
      if(t.startCol>=0&&t.startCol<COLS) handleShift("col",t.startCol,dy>0?"down":"up");
    }
  }

  function retry(){
    lastChanceRef.current=false;
    sessionStatsRef.current={batteries:0,pulses:0,maxCascade:0,corruptCleared:0};
    setNearWinData(null);
    setGrid(buildInitGrid()); setMoves(levelDef.moves);
    setBldgs(function(b){ return b.map(function(x){ return Object.assign({},x,{ch:0,on:false}); }); });
    setScore(0); setHi(new Set()); setPhase("idle"); setMoveCount(0); setSlideAnim(null);
  }

  function continueWithMoves(n){
    lastChanceRef.current=true;
    setNearWinData(null);
    setMoves(n);
    setPhase("idle");
  }

  function ShiftBtn(p){
    return (
      <button className={"sg-shift-btn"+(p.col?" col-btn":"")} style={{width:(p.col?SZ:30)+"px",height:(p.col?30:SZ)+"px"}}
        onClick={function(){ handleShift(p.type,p.idx,p.dir); }} disabled={phase!=="idle"}>
        {p.label}
      </button>
    );
  }

  const corr=countCorruption(grid);
  const spreadWarn=(levelDef.hazards||0)>0&&((moveCount+1)%spreadEvery===0);
  const winCoins=Math.floor(score/10)+25, winParts=Math.floor(score/60)+3;
  const movesUsed=levelDef.moves-moves;
  const stars=calcStars(movesUsed,levelDef.moves);
  const isLastMove=moves===1&&phase==="idle"&&!bldgs.every(function(b){ return b.on; });
  const isNearWinState=phase==="nearwin";

  /* ─── FIX 3: safe level name for campaign levels ────────────────── */
  const displayName = levelDef.name || (levelDef.dist ? levelDef.dist + " · LVL " + ((levelDef.id||0)+1) : "CUSTOM LEVEL");

  return (
    <div className={"sg-play"+(isNearWinState?" near-win-state":"")}>
      <div className="sg-play-top">
        <button className="sg-back" onClick={onBack}>←</button>
        <div style={{textAlign:"center"}}>
          {levelDef.isDaily&&<div className="sg-daily-badge">DAILY CHALLENGE</div>}
          <div className="sg-lvl-label">{displayName}</div>
        </div>
        <div className="sg-score-live">{score.toLocaleString()}</div>
      </div>

      <div className="sg-hud">
        <div className={"sg-stat"+(moves<=5?" danger":"")}>
          <div className="sg-stat-lbl">MOVES</div>
          <div className="sg-stat-val" style={{color:moves<=5?"#ff2d95":"#00e5ff",textShadow:moves<=5?"0 0 14px #ff2d95":"none"}}>{moves}</div>
        </div>
        <div className="sg-stat">
          <div className="sg-stat-lbl">POWERED</div>
          <div className="sg-stat-val" style={{color:"#00ff88"}}>
            {bldgs.filter(function(b){ return b.on; }).length}
            <span style={{fontSize:13,opacity:0.35}}>/{bldgs.length}</span>
          </div>
        </div>
        {(levelDef.hazards||0)>0&&(
          <div className={"sg-stat"+(corr>0?" danger":"")}>
            <div className="sg-stat-lbl">CORRUPT</div>
            <div className="sg-stat-val" style={{color:corr>4?"#ff2d95":corr>0?"#ffaa00":"rgba(255,255,255,0.2)",fontSize:20}}>{corr}</div>
          </div>
        )}
      </div>

      {isLastMove&&<div className="sg-last-move-banner">⚡ LAST MOVE — MAKE IT COUNT</div>}

      {spreadWarn&&(levelDef.hazards||0)>0&&<div className="sg-crpt-warn">⚠ CORRUPTION SPREADS THIS MOVE</div>}

      <div className="sg-toasts">
        {toasts.map(function(t){ return <span key={t.id} className="sg-toast" style={{color:t.color,textShadow:"0 0 10px "+t.color}}>{t.text}</span>; })}
      </div>

      {/* ── GRID ── */}
      <div className="sg-grid-area"
        ref={gridRef}
        onTouchStart={onTouchStart}
        onTouchMove={onTouchMove}
        onTouchEnd={onTouchEnd}
        style={{touchAction:"none"}}
      >
        {/* Col UP buttons */}
        <div className="sg-col-btns">
          {[0,1,2,3,4].map(function(c){ return <ShiftBtn key={c} type="col" idx={c} dir="up" label="▲" col={true}/>; })}
        </div>

        {/* Rows */}
        {grid.map(function(row,r){
          const rowSlide = slideAnim&&slideAnim.type==="row"&&slideAnim.idx===r ? ("slide-"+(slideAnim.dir==="left"?"left":"right")) : "";
          return (
            <div key={r} className="sg-grid-row">
              <ShiftBtn type="row" idx={r} dir="left" label="◀"/>
              <div className="sg-row-clip" style={{gap:GAP+"px"}}>
                {row.map(function(tile,c){
                  const colSlide = slideAnim&&slideAnim.type==="col"&&slideAnim.idx===c ? ("slide-"+(slideAnim.dir==="up"?"up":"down")) : "";
                  const slideClass = rowSlide || colSlide;
                  var isAdjacentCorrupt=false;
                  if(tile&&!tile.corrupted){ [[-1,0],[1,0],[0,-1],[0,1]].forEach(function(d){ var nr=r+d[0],nc=c+d[1]; if(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&grid[nr][nc]&&grid[nr][nc].corrupted) isAdjacentCorrupt=true; }); }
                  return <Tile key={tile?tile.id:(r+"-"+c)} tile={tile} isHi={hi.has(r+","+c)} size={SZ} slideClass={slideClass} adjacentCorrupt={isAdjacentCorrupt}/>;
                })}
              </div>
              <ShiftBtn type="row" idx={r} dir="right" label="▶"/>
            </div>
          );
        })}

        {/* Col DOWN buttons */}
        <div className="sg-col-btns">
          {[0,1,2,3,4].map(function(c){ return <ShiftBtn key={c} type="col" idx={c} dir="down" label="▼" col={true}/>; })}
        </div>
      </div>

      <div className="sg-swipe-hint">SWIPE TILES TO SHIFT • WRAPS AROUND</div>

      {/* Buildings */}
      <div className="sg-bldg-list">
        <div className="sg-bldg-lbl">BUILDINGS — RESTORATION STATUS</div>
        {bldgs.map(function(b){
          const hex=HEX[b.color];
          const almostDone=!b.on&&(b.ch/b.max)>=0.65&&isLastMove;
          return (
            <div key={b.id} className={"sg-bldg"+(b.on?" online":"")+(almostDone?" almost-done":"")} style={{borderColor:b.on?hex:"rgba(255,255,255,0.07)",background:b.on?hex+"0e":"rgba(255,255,255,0.025)",boxShadow:b.on?"0 0 20px "+hex+"28":"none"}}>
              <div className="sg-bldg-icon" style={{filter:b.on?"none":"grayscale(0.7) brightness(0.5)"}}>{b.icon}</div>
              <div className="sg-bldg-info">
                <div className="sg-bldg-row">
                  <span className="sg-bldg-name" style={{color:b.on?hex:"rgba(255,255,255,0.6)"}}>{b.label}</span>
                  <span className="sg-bldg-count" style={{color:hex}}>{b.on?"ONLINE":b.ch+"/"+b.max}</span>
                </div>
                <div className="sg-bldg-track">
                  <div className="sg-bldg-fill" style={{width:Math.min(100,(b.ch/b.max)*100)+"%",background:b.on?"linear-gradient(90deg,"+hex+",#fff)":"linear-gradient(90deg,"+hex+"55,"+hex+")",boxShadow:b.on?"0 0 8px "+hex:"none"}}/>
                </div>
                <div className="sg-bldg-sub">{"MATCH "+LABEL[b.color]+" TILES"}</div>
              </div>
            </div>
          );
        })}
      </div>

      <div className="sg-hint">{levelDef.hint}</div>

      {/* WIN */}
      {phase==="win"&&(
        <div className="sg-overlay">
          <div className="sg-modal">
            <span className="sg-modal-icon">⚡</span>
            <div className="sg-modal-title" style={{background:"linear-gradient(135deg,#ffaa00,#00ff88)",WebkitBackgroundClip:"text",WebkitTextFillColor:"transparent"}}>DISTRICT POWERED!</div>
            <div className="sg-modal-sub">{displayName}</div>
            <div style={{fontSize:22,color:"#ffaa00",letterSpacing:"0.12em",margin:"6px 0"}}>{renderStars(stars)}</div>
            <div style={{fontSize:11,color:"rgba(255,255,255,0.35)",marginBottom:12}}>
              {movesUsed + " of " + levelDef.moves + " moves used · " + (levelDef.moves-movesUsed) + " remaining"}
            </div>
            <div className="sg-modal-rewards">
              <div className="sg-reward-chip">{"+" + winCoins} <span style={{color:"#ffaa00"}}>coins</span></div>
              <div className="sg-reward-chip">{"+" + winParts} <span style={{color:"#00e5ff"}}>parts</span></div>
            </div>
            <button className="sg-modal-btn" style={{background:"linear-gradient(135deg,#00e5ff,#00ff88)"}} onClick={function(){ onComplete({score:score,coins:winCoins,parts:winParts,movesLeft:moves,batteries:sessionStatsRef.current.batteries,pulses:sessionStatsRef.current.pulses,maxCascade:sessionStatsRef.current.maxCascade,corruptCleared:sessionStatsRef.current.corruptCleared,wasNearWin:lastChanceRef.current}); }}>COLLECT</button>
          </div>
        </div>
      )}

      {/* NEAR-WIN — SO CLOSE interception */}
      {phase==="nearwin"&&(
        <div className="sg-overlay" style={{background:"rgba(7,7,15,0.92)"}}>
          <div className="sg-modal" style={{border:"1px solid rgba(255,45,149,0.4)",boxShadow:"0 0 40px rgba(255,45,149,0.2)"}}>
            <span className="sg-modal-icon" style={{animation:"tile-pop 0.5s ease"}}>😤</span>
            <div className="sg-modal-title" style={{color:"#ff2d95",textShadow:"0 0 20px rgba(255,45,149,0.5)"}}>SO CLOSE!</div>
            <div className="sg-modal-sub" style={{marginBottom:14}}>Out of moves — but your city isn't done yet</div>

            {/* Building breakdown */}
            <div style={{width:"100%",marginBottom:16}}>
              {(nearWinData||[]).map(function(b,i){
                var hex=HEX[b.color];
                var pct=Math.min(100,(b.ch/b.max)*100);
                return (
                  <div key={i} className="sg-nw-bldg-row">
                    <div className="sg-nw-bldg-icon">{b.icon}</div>
                    <div className="sg-nw-bldg-info">
                      <div className="sg-nw-bldg-name" style={{color:hex}}>{b.label}</div>
                      <div className="sg-nw-bldg-need">Needs {b.need} more {LABEL[b.color]} match{b.need!==1?"es":""}</div>
                      <div className="sg-nw-track">
                        <div className="sg-nw-fill" style={{width:pct+"%",background:"linear-gradient(90deg,"+hex+"88,"+hex+")"}}/>
                      </div>
                    </div>
                    <div style={{fontFamily:"'Share Tech Mono',monospace",fontSize:10,color:hex}}>{b.ch+"/"+b.max}</div>
                  </div>
                );
              })}
            </div>

            <button onClick={function(){ continueWithMoves(2); }}
              style={{display:"block",width:"100%",background:"linear-gradient(135deg,#ff2d95,#ffaa00)",border:"none",borderRadius:13,padding:"14px",color:"#06060f",fontFamily:"'Orbitron',monospace",fontSize:10,fontWeight:700,cursor:"pointer",letterSpacing:"0.1em",marginBottom:10,boxShadow:"0 0 20px rgba(255,45,149,0.35)"}}>
              WATCH AD · GET +2 MOVES FREE
            </button>
            <div className="sg-modal-row">
              <button className="sg-modal-btn sg-modal-ghost" onClick={function(){ setPhase("lose"); }}>GIVE UP</button>
              <button className="sg-modal-btn" style={{background:"linear-gradient(135deg,#ff2d95,#ffaa00)"}} onClick={retry}>RETRY</button>
            </div>
          </div>
        </div>
      )}

      {/* LOSE */}
      {phase==="lose"&&(
        <div className="sg-overlay">
          <div className="sg-modal">
            <span className="sg-modal-icon">💀</span>
            <div className="sg-modal-title" style={{color:"#ff2d95",textShadow:"0 0 20px #ff2d9566"}}>BLACKOUT</div>
            <div className="sg-modal-sub">District stays dark — here's what went wrong</div>

            {/* Failure breakdown */}
            {nearWinData&&nearWinData.length>0&&(
              <div className="sg-fail-reason">
                {nearWinData.map(function(b,i){
                  var hex=HEX[b.color];
                  return (
                    <div key={i} className="sg-fail-line">
                      <div className="sg-fail-dot" style={{background:hex}}/>
                      <span>{b.icon} {b.label} — needed <strong style={{color:hex}}>{b.need} more {LABEL[b.color]}</strong> match{b.need!==1?"es":""}</span>
                    </div>
                  );
                })}
              </div>
            )}

            <div className="sg-modal-row" style={{marginTop:12}}>
              <button className="sg-modal-btn sg-modal-ghost" onClick={onBack}>EXIT</button>
              <button className="sg-modal-btn" style={{background:"linear-gradient(135deg,#ff2d95,#ffaa00)"}} onClick={retry}>RETRY</button>
            </div>
            <div style={{fontSize:9,color:"rgba(255,255,255,0.2)",marginTop:12,textAlign:"center",letterSpacing:"0.06em",lineHeight:1.5}}>
              {(function(){
                if(!nearWinData||!nearWinData.length) return "Tip: match longer chains to charge multiple buildings at once";
                var worst=nearWinData.slice().sort(function(a,b){return b.need-a.need;})[0];
                var corruptHigh=corr>4;
                if(corruptHigh) return "Tip: clear corruption tiles early — they blocked your "+worst.label+" chain";
                if(worst.need<=2) return "Tip: "+worst.label+" was almost there — one more "+LABEL[worst.color]+" chain would have done it";
                if(nearWinData.length>=3) return "Tip: with 4 buildings, commit to 2 colors first before switching";
                return "Tip: "+worst.label+" needed "+worst.need+" more "+LABEL[worst.color]+" matches — chain longer";
              })()}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}


/* ─── XP BAR COMPONENT ──────────────────────────────────────────── */
function XPBar(props) {
  var xpData = props.xpData;
  var pct = (xpData.xp / XP_PER_LEVEL) * 100;
  return (
    <div className="sg-xp-bar-wrap">
      <div className="sg-xp-row">
        <span className="sg-xp-lbl">{"LVL " + xpData.level}</span>
        <span className="sg-xp-lbl">{xpData.xp + " / " + XP_PER_LEVEL + " XP"}</span>
      </div>
      <div className="sg-xp-track">
        <div className="sg-xp-fill" style={{width: pct + "%"}} />
      </div>
    </div>
  );
}

/* ─── CITY OVERVIEW ─────────────────────────────────────────────── */
function CityOverview(props) {
  var levelsCleared = props.levelsCleared || [];
  var totalLevels = 50;
  var totalStars = Object.values(props.stars || {}).reduce(function(a,b){return a+b;},0);

  var buildings = [
    {color:"#00e5ff",  h:90, w:18, windows:[3,3,3,3]},
    {color:"#a855f7",  h:120,w:14, windows:[2,2,2,2,2,2]},
    {color:"#ffaa00",  h:75, w:22, windows:[4,4,3,3]},
    {color:"#ff2d95",  h:100,w:16, windows:[3,3,3,3,3]},
    {color:"#00ff88",  h:55, w:20, windows:[3,3,2]},
    {color:"#00e5ff",  h:80, w:12, windows:[2,2,2,2]},
    {color:"#a855f7",  h:110,w:18, windows:[3,3,3,3,3]},
    {color:"#ffaa00",  h:65, w:14, windows:[2,2,2,2]},
  ];

  var pctCleared = levelsCleared.length / totalLevels;
  var litCount = Math.floor(pctCleared * buildings.length);

  return (
    <div className="sg-city-overview">
      <div className="sg-city-skyline">
        {buildings.map(function(b, i) {
          var lit = i < litCount;
          return (
            <div key={i} className={"sg-city-building" + (lit ? " lit" : "")}
              style={{height: b.h + "px", width: b.w + "px",
                background: lit ? b.color + "22" : "rgba(255,255,255,0.04)",
                borderTop: "2px solid " + (lit ? b.color : "rgba(255,255,255,0.1)"),
                borderLeft: "1px solid " + (lit ? b.color + "55" : "rgba(255,255,255,0.06)"),
                borderRight: "1px solid " + (lit ? b.color + "55" : "rgba(255,255,255,0.06)"),
                boxShadow: lit ? ("0 0 20px " + b.color + "33, 0 -4px 12px " + b.color + "44") : "none",
              }}>
              <div className="sg-building-windows" style={{gridTemplateColumns: "repeat(" + b.windows[0] + ", 1fr)", gap: "2px", padding: "4px 3px"}}>
                {b.windows.map(function(rowCount, ri) {
                  return Array.from({length: rowCount}).map(function(_, ci) {
                    return (
                      <div key={ri+"-"+ci} className="sg-window" style={{
                        background: lit ? b.color + "cc" : "rgba(255,255,255,0.06)",
                        boxShadow: lit ? ("0 0 4px " + b.color) : "none",
                      }}/>
                    );
                  });
                })}
              </div>
            </div>
          );
        })}
      </div>
      <div className="sg-city-label">
        {levelsCleared.length === 0 ? "CITY IN DARKNESS — RESTORE POWER TO LIGHT IT UP" :
         levelsCleared.length < 25 ? "PARTIAL RESTORATION — KEEP GOING" :
         levelsCleared.length < 50 ? "CITY AWAKENING — ALMOST THERE" : "CITY FULLY RESTORED — LEGEND"}
      </div>
      <div className="sg-city-stats">
        <div className="sg-city-stat">
          <div className="sg-city-stat-val" style={{color:"#00e5ff"}}>{levelsCleared.length}</div>
