        <div>
          <div style={{fontSize:12,color:"rgba(255,255,255,0.5)"}}>Accumulated</div>
          <div className="sg-idle-amt">{idle}<span style={{fontSize:12,color:"rgba(255,255,255,0.28)",marginLeft:6}}>coins</span></div>
          <div className="sg-idle-note">{(meta.upgrades&&meta.upgrades.idleBoost)?"Earning while you play":"Upgrade Idle Generator to earn"}</div>
        </div>
        <button className="sg-collect-btn" onClick={collect} disabled={idle===0} style={{opacity:idle===0?0.3:1}}>COLLECT</button>
      </div>

      <div className="sg-meta-chips">
        <div className="sg-meta-chip"><div className="sg-meta-chip-val" style={{color:"#ffaa00"}}>{meta.coins}</div><div className="sg-meta-chip-lbl">COINS</div></div>
        <div className="sg-meta-chip"><div className="sg-meta-chip-val" style={{color:"#00e5ff"}}>{meta.parts}</div><div className="sg-meta-chip-lbl">PARTS</div></div>
