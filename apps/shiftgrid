      {wrapChain    && <div className="sg-wrap-chain-glow"/>}
      {perfectClear && (
        <div className="sg-perfect-clear">
          <div className="sg-pc-text">⚡ PERFECT CLEAR ⚡</div>
        </div>
      )}
      <div className="sg-play-top">
        <button className="sg-back" onClick={onBack}>←</button>
        <div style={{textAlign:"center"}}>
          {levelDef.isDaily&&<div className="sg-daily-badge">DAILY CHALLENGE</div>}
          <div className="sg-lvl-label">{displayName}</div>
        </div>
        <div className="sg-score-live">{score.toLocaleString()}</div>
      </div>

      {/* ── ARIA TRANSMISSION ── */}
      {ariaTransmission&&(
        <div className="sg-aria-transmission" style={{display:"flex",alignItems:"flex-start",gap:8}}>
          <img src={ARIA_IMG} alt="ARIA" style={{width:28,height:28,borderRadius:6,objectFit:"cover",objectPosition:"center top",flexShrink:0,marginTop:2}}/>
          <span>{ariaTransmission}</span>
        </div>
      )}
      {/* ── MID-LEVEL STORY BEAT ── */}
      {storyBeat&&(
        <div className="sg-story-dialogue"
          style={{borderColor:storyBeat.color+"44",background:storyBeat.color+"08"}}>
          <div className="sg-story-char">
            <span className="sg-story-char-icon">{storyBeat.icon}</span>
            <div>
              <div className="sg-story-char-name" style={{color:storyBeat.color}}>{storyBeat.name}</div>
              <div className="sg-story-char-role">{storyBeat.role}</div>
            </div>
          </div>
          <div className="sg-story-line">{storyBeat.line}</div>
          <div className="sg-story-dismiss">
            <button className="sg-story-dismiss-btn" onClick={function(){ setStoryBeat(null); }}>DISMISS ✕</button>
          </div>
        </div>
      )}
      {/* ── OBJECTIVE BADGE ── */}
      {objectiveType!=="standard"&&(function(){
        var om=OBJECTIVE_META[objectiveType];
        return (
          <div className="sg-objective-badge"
            style={{borderColor:om.color+"55",background:om.color+"0a",color:om.color}}>
            <span className="sg-obj-icon">{om.icon}</span>
            <div style={{flex:1}}>
              <div className="sg-obj-label" style={{color:om.color}}>{om.label}</div>
              <div className="sg-obj-desc">
                {objectiveType==="timed"&&"Power all buildings before time runs out"}
                {objectiveType==="collect"&&("Clear "+collectTarget+" marked tiles ◎ from the board")}
                {objectiveType==="containment"&&"Don't let corruption cross the midpoint line"}
                {objectiveType==="minmoves"&&("Par: "+minMovesPar+" moves — beat it for 3 stars")}
              </div>
            </div>
          </div>
        );
      })()}

      {/* ── COMBO POWER METER ── */}
      {(function(){
        var rank=getComboRank(comboPower);
        var pct=Math.min(100,(comboPower/COMBO_MAX)*100);
        if(comboPower<=0) return null;
        return (
          <div className="sg-combo-power-wrap">
            <div className="sg-combo-power-header">
              <span className="sg-combo-power-lbl">COMBO POWER</span>
              <span className="sg-combo-power-rank" style={{color:rank.color}}>{rank.name}</span>
            </div>
            <div className="sg-combo-power-track">
              <div className="sg-combo-power-fill" style={{width:pct+"%",background:"linear-gradient(90deg,"+rank.gradient+")"}}/>
            </div>
          </div>
        );
      })()}
      {rankUpText&&(
        <div className="sg-combo-power-rankup" style={{color:getComboRank(comboPower).color,textShadow:"0 0 20px "+getComboRank(comboPower).color}}>
          {rankUpText} ↑
        </div>
      )}

      <div className="sg-hud">
        <div className={"sg-stat"+(moves<=5?" danger":"")}>
          <div className="sg-stat-lbl">MOVES</div>
          <div className={"sg-stat-val"+(movesBump?" sg-moves-bump":"")} style={{color:moves<=5?"#ff2d95":"#00e5ff",textShadow:moves<=5?"0 0 14px #ff2d95":"none"}}>{moves}</div>
        </div>
        {objectiveType==="timed"&&(
          <div className="sg-stat">
            <div className="sg-stat-lbl">TIME</div>
            <div className={"sg-timer-val"+(timeLeft<=10?" urgent":"")} style={{color:timeLeft<=10?"#ff2d95":timeLeft<=20?"#ff7700":"#ffaa00",fontSize:18,fontFamily:"'Orbitron',monospace",fontWeight:900}}>
              {Math.floor(timeLeft/60)+":"+(String(timeLeft%60).padStart(2,"0"))}
            </div>
          </div>
        )}
        {objectiveType==="collect"&&(
          <div className="sg-stat">
            <div className="sg-stat-lbl">COLLECT</div>
            <div className="sg-collect-counter" style={{color:collectTiles.size===0?"#00ff88":"#a855f7"}}>
              {collectTarget-collectTiles.size}/{collectTarget}
            </div>
          </div>
        )}
        <div className="sg-stat">
          <div className="sg-stat-lbl">POWERED</div>
          <div className="sg-stat-val" style={{color:"#00ff88"}}>
            {bldgs.filter(function(b){ return b.on; }).length}
            <span style={{fontSize:13,opacity:0.35}}>/{bldgs.length}</span>
          </div>
        </div>
        {(levelDef.hazards||0)>0&&(
          <div className={"sg-stat"+(corr>0?" danger":"")}>
            <div className="sg-stat-lbl">CORRUPT</div>
            <div className="sg-stat-val" style={{color:corr>4?"#ff2d95":corr>0?"#ffaa00":"rgba(255,255,255,0.2)",fontSize:20}}>{corr}</div>
          </div>
        )}
      </div>

      {/* ── ABILITY CINEMATIC ── */}
      <AbilityCinematic anim={abilityAnim}/>

      {/* ── ACTIVE ABILITY BANNERS ── */}
      {surgeActive&&(
        <div className="sg-active-ability-banner"
          style={{"--ab-border":"rgba(255,170,0,0.5)","--ab-bg":"rgba(255,170,0,0.1)","--ab-color":"#ffaa00"}}>
          <span className="sg-ab-icon">⚡</span>
          <div className="sg-ab-text">
            <div className="sg-ab-name" style={{color:"#ffaa00"}}>POWER SURGE ARMED</div>
            <div className="sg-ab-desc">Next match charges ALL buildings — any color</div>
          </div>
          <div className="sg-ab-badge">READY</div>
        </div>
      )}
      {wildfireActive&&(
        <div className="sg-active-ability-banner"
          style={{"--ab-border":"rgba(255,119,0,0.5)","--ab-bg":"rgba(255,119,0,0.1)","--ab-color":"#ff7700"}}>
          <span className="sg-ab-icon">🔥</span>
          <div className="sg-ab-text">
            <div className="sg-ab-name" style={{color:"#ff7700"}}>WILDFIRE ARMED</div>
            <div className="sg-ab-desc">Next shift clears the ENTIRE row or column</div>
          </div>
          <div className="sg-ab-badge">SWIPE NOW</div>
        </div>
      )}
      {freezeActive>0&&(
        <div className="sg-active-ability-banner"
          style={{"--ab-border":"rgba(165,243,252,0.4)","--ab-bg":"rgba(165,243,252,0.08)","--ab-color":"#a5f3fc"}}>
          <span className="sg-ab-icon">🧊</span>
          <div className="sg-ab-text">
            <div className="sg-ab-name" style={{color:"#a5f3fc"}}>CORRUPTION FROZEN</div>
            <div className="sg-ab-desc">Spread is blocked</div>
          </div>
          <div className="sg-ab-badge">{freezeActive+" MOVES"}</div>
        </div>
      )}

      {/* ── ABILITIES BUTTON BAR ── */}
      {(function(){
        var ownedAbils=ABILITY_DEFS.filter(function(a){ return (abilities[a.id]||0)>0; });
        if(ownedAbils.length===0) return null;
        return (
          <div className="sg-abilities-bar">
            <div className="sg-abilities-label">ABILITIES</div>
            {ownedAbils.map(function(ab){
              var isArmed = (ab.id==="surge"&&surgeActive)||(ab.id==="freeze"&&freezeActive>0)||(ab.id==="wildfire"&&wildfireActive);
              var cnt  = abilities[ab.id]||0;
              return (
                <button key={ab.id}
                  className={"sg-ability-btn"+(isArmed?" armed":"")}
                  style={{
                    "--acolor": ab.color,
                    borderColor: isArmed ? ab.color : ab.color+"44",
                    background: isArmed ? ab.color+"22" : "rgba(10,10,20,0.9)",
                    color: ab.color,
                  }}
                  onClick={function(){ useAbility(ab.id); }}
                  disabled={phase!=="idle"||cnt<=0}
                  title={ab.name+": "+ab.desc}>
                  <div className="sg-ability-count" style={{background:cnt>1?ab.color+"dd":"rgba(0,0,0,0.7)",color:cnt>1?"#06060f":"#fff"}}>{cnt}</div>
                  <div className="sg-ability-icon">{ab.icon}</div>
                  <div className="sg-ability-name" style={{color:isArmed?ab.color:ab.color+"aa"}}>{ab.name.split(" ")[0]}</div>
                </button>
              );
            })}
          </div>
        );
      })()}

      {isLastMove&&<div className="sg-last-move-banner">⚡ LAST MOVE — MAKE IT COUNT</div>}
      {/* Node type introduction banner for first time seeing a node type */}
      {(levelDef.id||0)===10&&<div style={{margin:"0 14px 4px",background:"rgba(0,229,255,0.08)",border:"1px solid rgba(0,229,255,0.25)",borderRadius:8,padding:"5px 12px",fontSize:10,color:"#00e5ff",textAlign:"center",letterSpacing:"0.08em",flexShrink:0}}>🔒 NEW: LOCKED NODES appear — match adjacent tiles to free them</div>}
      {(levelDef.id||0)===20&&<div style={{margin:"0 14px 4px",background:"rgba(255,170,0,0.08)",border:"1px solid rgba(255,170,0,0.25)",borderRadius:8,padding:"5px 12px",fontSize:10,color:"#ffaa00",textAlign:"center",letterSpacing:"0.08em",flexShrink:0}}>⚡ NEW: CHARGED NODES give double charge when matched</div>}
      {(levelDef.id||0)===30&&<div style={{margin:"0 14px 4px",background:"rgba(0,229,255,0.08)",border:"1px solid rgba(0,229,255,0.25)",borderRadius:8,padding:"5px 12px",fontSize:10,color:"#00e5ff",textAlign:"center",letterSpacing:"0.08em",flexShrink:0}}>🪞 NEW: MIRROR NODES also charge the opposite color building</div>}
      {(levelDef.id||0)===40&&<div style={{margin:"0 14px 4px",background:"rgba(168,85,247,0.08)",border:"1px solid rgba(168,85,247,0.3)",borderRadius:8,padding:"5px 12px",fontSize:10,color:"#a855f7",textAlign:"center",letterSpacing:"0.08em",flexShrink:0}}>🌑 NEW: VOID NODES — clear them fast or they corrupt neighbors</div>}
      {(levelDef.id||0)>=30&&<div style={{margin:"0 14px 2px",background:"rgba(255,45,149,0.06)",border:"1px solid rgba(255,45,149,0.2)",borderRadius:8,padding:"4px 12px",fontSize:9,color:"#ff2d95",textAlign:"center",letterSpacing:"0.08em",flexShrink:0}}>👾 PATROL active — corrupted tiles move every 2 shifts</div>}

      {/* ── SPREAD TENSION BAR — only when corruption tiles exist ── */}
      {(levelDef.hazards||0)>0&&corr>0&&moveCount>0&&(function(){
        var movesToSpread = spreadEvery - (moveCount % spreadEvery);
        var pct = Math.round(((spreadEvery - movesToSpread) / spreadEvery) * 100);
        var imminent = movesToSpread === 1;
        var barColor = imminent
          ? "#ff2d95"
          : pct > 60 ? "#ff7700" : "#ffaa00";
        return (
          <div className={"sg-spread-bar-wrap"+(imminent?" imminent":"")}>
            <div className="sg-spread-bar-label">
              <span className="sg-spread-bar-lbl-text">
                {imminent ? "⚠ SPREADING NOW" : "☠ CORRUPTION PRESSURE"}
              </span>
              <span className="sg-spread-bar-lbl-moves">
                {imminent ? "!" : movesToSpread+" move"+(movesToSpread!==1?"s":"")}
              </span>
            </div>
            <div className="sg-spread-bar-track">
              <div className="sg-spread-bar-fill" style={{
                width: pct+"%",
                background: "linear-gradient(90deg,"+barColor+"88,"+barColor+")",
              }}/>
            </div>
          </div>
        );
      })()}

      <div className="sg-toasts">
        {toasts.map(function(t){ return <span key={t.id} className="sg-toast" style={{color:t.color,textShadow:"0 0 10px "+t.color}}>{t.text}</span>; })}
      </div>

      {/* ── GRID ── */}
      <div className={"sg-grid-area"+(nudgeClass?" "+nudgeClass:"")} style={{position:"relative"}}
        ref={gridRef}
        onTouchStart={onTouchStart}
        onTouchMove={onTouchMove}
        onTouchEnd={onTouchEnd}
        style={{touchAction:"none"}}
      >
        {/* SURGE glow overlay */}
        {surgeActive&&<div className="sg-grid-surge-overlay"/>}
        {/* CONTAINMENT line — drawn at grid midpoint */}
        {objectiveType==="containment"&&(
          <div className="sg-contain-line" style={{
            top:(2*(SZ+GAP)+SZ/2)+"px",
            background:"linear-gradient(90deg,transparent,#ff2d95,transparent)",
            boxShadow:"0 0 8px rgba(255,45,149,0.5)",
          }}/>
        )}
        {containBreach&&<div className="sg-contain-breach"/>}
        {/* Col UP buttons */}
        <div className="sg-col-btns">
          {[0,1,2,3,4].map(function(c){ return <ShiftBtn key={c} type="col" idx={c} dir="up" label="▲" col={true}/>; })}
        </div>

        {/* Rows */}
        {grid.map(function(row,r){
          const rowSlide = slideAnim&&slideAnim.type==="row"&&slideAnim.idx===r ? ("slide-"+(slideAnim.dir==="left"?"left":"right")) : "";
          return (
            <div key={r} className="sg-grid-row">
