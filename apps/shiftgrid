  function isBlocked(t){ return !t||t.corrupted||(t.blocker==="fog"&&!t.fogRevealed)||(t.blocker==="anchor"); }
  for(let r=0;r<ROWS;r++){ let s=0; for(let c=1;c<=COLS;c++){ const ok=c<COLS&&!isBlocked(grid[r][c])&&!isBlocked(grid[r][c-1])&&grid[r][c].color===grid[r][c-1].color; if(!ok){ if(c-s>=3){ for(let i=s;i<c;i++) if(!isBlocked(grid[r][i])) m.add(r+","+i); } s=c; } } }
  for(let c=0;c<COLS;c++){ let s=0; for(let r=1;r<=ROWS;r++){ const ok=r<ROWS&&!isBlocked(grid[r][c])&&!isBlocked(grid[r-1][c])&&grid[r][c].color===grid[r-1][c].color; if(!ok){ if(r-s>=3){ for(let i=s;i<r;i++) if(!isBlocked(grid[i][c])) m.add(i+","+c); } s=r; } } }
  return m;
}
function detectShapes(grid,matched){
  const shapes=[];
  for(let r=0;r<ROWS-1;r++) for(let c=0;c<COLS-1;c++){
    const cells=[r+","+c,r+","+(c+1),(r+1)+","+c,(r+1)+","+(c+1)];
    if(cells.every(function(k){ return matched.has(k); })){ const col=grid[r][c].color; const allSame=cells.every(function(k){ const p=k.split(","); return grid[+p[0]][+p[1]].color===col&&!grid[+p[0]][+p[1]].corrupted; }); if(allSame) shapes.push({type:"battery",label:"BATTERY",bonus:2}); }
  }
  for(let r=1;r<ROWS-1;r++) for(let c=1;c<COLS-1;c++){
    const cells=[r+","+c,(r-1)+","+c,(r+1)+","+c,r+","+(c-1),r+","+(c+1)];
    if(cells.every(function(k){ return matched.has(k); })){ const col=grid[r][c].color; const allSame=cells.every(function(k){ const p=k.split(","); return grid[+p[0]][+p[1]].color===col&&!grid[+p[0]][+p[1]].corrupted; }); if(allSame) shapes.push({type:"pulse",pos:[r,c],label:"PULSE BLAST"}); }
  }
  let wa=false;
  for(let r=0;r<ROWS&&!wa;r++){ let ok=true; for(let c=0;c<COLS;c++){ if(!matched.has(r+","+c)||grid[r][c].corrupted){ok=false;break;} } if(ok){shapes.push({type:"wild",label:"WILD CORE"});wa=true;} }
  for(let c=0;c<COLS&&!wa;c++){ let ok=true; for(let r=0;r<ROWS;r++){ if(!matched.has(r+","+c)||grid[r][c].corrupted){ok=false;break;} } if(ok){shapes.push({type:"wild",label:"WILD CORE"});wa=true;} }
  return shapes;
}
function expandPulse(matched,pos){
  const m=new Set(matched); const pr=pos[0],pc=pos[1];
  for(let r=Math.max(0,pr-1);r<=Math.min(ROWS-1,pr+1);r++) for(let c=Math.max(0,pc-1);c<=Math.min(COLS-1,pc+1);c++) m.add(r+","+c);
  return m;
}
function clearNearCorruption(grid,matched){
  const x=new Set();
  matched.forEach(function(k){ const p=k.split(","); const r=+p[0],c=+p[1]; [[-1,0],[1,0],[0,-1],[0,1]].forEach(function(d){ const nr=r+d[0],nc=c+d[1]; if(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&grid[nr][nc]&&grid[nr][nc].corrupted) x.add(nr+","+nc); }); });
  return x;
}
function applyGravity(grid,matched){
  const g=grid.map(function(row){ return row.slice(); }), cleared={};
  matched.forEach(function(k){ const p=k.split(","); const r=+p[0],c=+p[1]; const t=g[r][c]; if(t&&!t.corrupted) cleared[t.color]=(cleared[t.color]||0)+1; g[r][c]=null; });
  for(let c=0;c<COLS;c++){
    /* Blockers stay fixed in their row — only non-blocker tiles fall */
    var fixed={}; /* row→tile for blockers */
    for(let r=0;r<ROWS;r++){ if(g[r][c]&&g[r][c].blocker) fixed[r]=g[r][c]; }
    const col=[];
    for(let r=0;r<ROWS;r++){ if(g[r][c]&&!g[r][c].blocker) col.push(g[r][c]); }
    while(col.length<ROWS) col.unshift(makeTile());
    for(let r=0;r<ROWS;r++) g[r][c]= fixed[r]||col.shift()||makeTile();
  }
  return {g:g,cleared:cleared};
}
/* ─── PATROLLING CORRUPTION ────────────────────────────────────── */
function movePatrollers(grid){
  /* Find tiles marked as patrollers and move them one step */
  const g=grid.map(function(row){ return row.map(function(t){ return Object.assign({},t); }); });
  for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++){
    if(g[r][c]&&g[r][c].patrol&&g[r][c].corrupted){
      var dir=g[r][c].patrolDir||0;
      var dirs=[[0,1],[1,0],[0,-1],[-1,0]];
      var tried=0;
      while(tried<4){
        var nr=r+dirs[dir][0], nc=c+dirs[dir][1];
        if(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&g[nr][nc]&&!g[nr][nc].corrupted&&!g[nr][nc].patrol){
          /* Move patroller */
          g[nr][nc]=Object.assign({},g[nr][nc],{corrupted:true,patrol:true,patrolDir:dir});
          g[r][c]=Object.assign({},g[r][c],{corrupted:false,patrol:false,patrolDir:undefined});
          break;
        }
        dir=(dir+1)%4; tried++;
      }
      if(tried>=4) g[r][c]=Object.assign({},g[r][c],{patrolDir:(dir+1)%4});
    }
  }
  return g;
}

function spreadCorruption(grid,slow){
  if(slow&&Math.random()<slow*0.25) return grid;
  const g=grid.map(function(row){ return row.map(function(t){ return Object.assign({},t); }); });
  const sources=[]; for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) if(g[r][c]&&g[r][c].corrupted) sources.push([r,c]);
  if(!sources.length) return g;
  const src=sources[Math.floor(Math.random()*sources.length)]; const sr=src[0],sc=src[1];
  const nbrs=[[-1,0],[1,0],[0,-1],[0,1]].map(function(d){ return [sr+d[0],sc+d[1]]; }).filter(function(pos){ return pos[0]>=0&&pos[0]<ROWS&&pos[1]>=0&&pos[1]<COLS&&g[pos[0]][pos[1]]&&!g[pos[0]][pos[1]].corrupted&&!g[pos[0]][pos[1]].blocker; });
  if(nbrs.length){ const pick=nbrs[Math.floor(Math.random()*nbrs.length)]; g[pick[0]][pick[1]]=Object.assign({},g[pick[0]][pick[1]],{corrupted:true}); }
  return g;
}
function countCorruption(grid){ let n=0; for(let r=0;r<ROWS;r++) for(let c=0;c<COLS;c++) if(grid[r][c]&&grid[r][c].corrupted) n++; return n; }


/* ─── TILE COMPONENT ────────────────────────────────────────────── */
/* Node type icons */
var NODE_TYPE_ICONS = { locked:"🔒", charged:"⚡", mirror:"🪞", void:"🌑" };
var NODE_TYPE_TIPS  = { locked:"LOCKED — match adjacent to free", charged:"CHARGED — 2× charge on match", mirror:"MIRROR — charges opposite color too", void:"VOID — corrupts neighbors in 5 moves" };

function Tile(props) {
  const tile = props.tile, isHi = props.isHi, size = props.size;
  const slideClass = props.slideClass || "", adjacentCorrupt = props.adjacentCorrupt;
  const skinColors = props.skinColors || HEX;
  const colorblind = props.colorblind || false;
  const isCleansing = props.isCleansing || false;
  const isFrozenCorrupt = props.isFrozenCorrupt || false;
  const isCollectTarget = props.isCollectTarget || false;
  const isCr = tile && tile.corrupted;
  const isPatrol = isCr && tile && tile.patrol;
  const nodeType = tile && tile.nodeType;
  const blocker  = tile && tile.blocker;   /* "anchor"|"overcharge"|"fog"|"chain"|null */
  const fogRevealed = tile && tile.fogRevealed;
  const isFog    = blocker === "fog";
  const isAnchor = blocker === "anchor";
  const isOvercharge = blocker === "overcharge";
  const isChain  = blocker === "chain";
  /* Fog hides color until revealed */
  const color = (!isCr && tile && tile.color && (!isFog || fogRevealed)) ? tile.color : null;
  const hex = color ? (skinColors[color]||HEX[color]) : null;
  const isLocked   = nodeType==="locked";
  const isCharged  = nodeType==="charged";
  const isMirror   = nodeType==="mirror";
  const isVoidNode = nodeType==="void";

  /* Locked tile looks dim/grey, charged pulses amber, mirror has cyan shimmer, void has purple tinge */
  var effectBorder = isLocked ? "rgba(150,150,150,0.6)" :
                     isCharged? "#ffaa00" :
                     isMirror ? "#00e5ff" :
                     isVoidNode? "#a855f7" : null;

  const borderColor = isCr ? (isPatrol?"rgba(255,45,149,0.7)":"rgba(170,0,255,0.4)") :
                      effectBorder ? effectBorder :
                      hex ? (isHi ? hex : hex+"55") : "rgba(255,255,255,0.06)";
  const bg = isCr ? (isPatrol?"rgba(50,0,20,0.97)":"rgba(30,0,50,0.95)") :
             isLocked ? "rgba(100,100,110,0.15)" :
             isCharged? "rgba(255,170,0,0.18)" :
             isMirror ? "rgba(0,229,255,0.12)" :
             isVoidNode? "rgba(168,85,247,0.15)" :
             hex ? (isHi ? hex+"44" : hex+"15") : "rgba(255,255,255,0.025)";
  const outerShadow = isHi && hex ? ("0 0 20px "+hex+",0 0 40px "+hex+"44") :
                      isCr ? "inset 0 0 20px rgba(170,0,255,0.2)" :
                      isCharged? "0 0 12px rgba(255,170,0,0.4)" :
                      isMirror ? "0 0 10px rgba(0,229,255,0.3)" :
                      isVoidNode? "0 0 14px rgba(168,85,247,0.4)" :
                      hex ? "0 0 6px "+hex+"22" : "none";

  const cls = "sg-tile" +
    (isHi ? " matched" : "") +
    (isCr ? " corrupt" : "") +
    (adjacentCorrupt&&!isCr ? " adj-corrupt" : "") +
    (isPatrol ? " patrol-corrupt" : "") +
    (isCleansing ? " cleansing" : "") +
    (isFrozenCorrupt ? " frozen-corrupt" : "") +
    (isCollectTarget&&!isCr&&!blocker ? " collect-target" : "") +
    (isAnchor ? " blocker-anchor" : "") +
    (isOvercharge ? " blocker-overcharge" : "") +
    (isFog&&!fogRevealed ? " blocker-fog" : "") +
    (isFog&&fogRevealed ? " blocker-fog fog-revealed" : "") +
    (isChain ? " blocker-chain" : "") +
    (slideClass ? " "+slideClass : "");

  return (
    <div className={cls} style={{width: size+"px", height: size+"px", background: bg, borderColor: borderColor, boxShadow: outerShadow}}>
      {isCr && !isPatrol && <span className="sg-corrupt-icon">☠</span>}
      {!isCr && blocker && (
        <div className="sg-blocker-icon" style={{
          position:"absolute", inset:0, display:"flex", alignItems:"center",
          justifyContent:"center", fontSize:20, zIndex:4, flexDirection:"column",
        }}>
          <span>{BLOCKER_DEFS[blocker].icon}</span>
          {isChain&&tile.chainId&&<span style={{fontSize:7,opacity:0.5,marginTop:1}}>#{tile.chainId}</span>}
        </div>
      )}
      {isPatrol && <span className="sg-corrupt-icon" style={{filter:"none",opacity:0.9}}>👾</span>}
      {isCr && <div className="sg-corrupt-overlay"/>}
      {/* Special node type indicator */}
      {!isCr && nodeType && (
        <div style={{position:"absolute",top:2,right:3,fontSize:9,opacity:0.8,zIndex:5}}>{NODE_TYPE_ICONS[nodeType]}</div>
      )}
      {!isCr && hex && !nodeType && (
        <div className="sg-node" style={{background: isHi ? hex : hex+"88", boxShadow: isHi ? "0 0 12px "+hex+",0 0 24px "+hex+"55" : "none"}}>
          {isHi && <div className="sg-node-ring" style={{borderColor: hex}}/>}
          {colorblind && color && (
            <div style={{position:"absolute",inset:0,display:"flex",alignItems:"center",justifyContent:"center",
              fontSize:13,fontWeight:900,color:"#06060f",transform:"rotate(-45deg)",lineHeight:1,zIndex:3}}>
              {CB_SHAPE[color]}
            </div>
          )}
        </div>
      )}
      {!isCr && hex && nodeType && (
        <div style={{fontSize:14,fontWeight:900,color:hex,textShadow:"0 0 8px "+hex,zIndex:2}}>{NODENAME[color]}</div>
      )}
      {!isCr && hex && isHi && <div className="sg-tile-glow" style={{background: "radial-gradient(circle, "+hex+"33 0%, transparent 65%)"}}/>}
    </div>
  );
}

/* ─── FIX 2: single Particles definition (duplicate removed) ─────── */
function Particles() {
  var particles = [];
  var cols = ["#00e5ff","#ff2d95","#ffaa00","#00ff88","#a855f7"];
  for (var i = 0; i < 18; i++) {
    var col = cols[i % cols.length];
    var left = (i * 17 + 3) % 97;
    var dur = 8 + (i * 3.7) % 14;
    var delay = -(i * 2.1) % dur;
    var size = 1.5 + (i % 3);
    particles.push(
      <div key={i} className="sg-particle" style={{left: left+"%", bottom: "-4px", width: size+"px", height: size+"px", background: col, boxShadow: "0 0 6px "+col, animationDuration: dur+"s", animationDelay: delay+"s"}}/>
    );
  }
  return <div className="sg-particles">{particles}</div>;
}

