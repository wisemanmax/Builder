    .sg-upg-cost-btn {
      border: 1px solid rgba(0,229,255,0.3); background: rgba(0,229,255,0.07);
      color: var(--cyan); border-radius: 7px; padding: 5px 8px;
      font-family: 'Share Tech Mono', monospace; font-size: 9px;
      cursor: pointer; width: 100%; transition: all 0.12s;
    }
    .sg-upg-cost-btn:hover:not(:disabled) { background: rgba(0,229,255,0.16); }
    .sg-upg-cost-btn:disabled { opacity: 0.3; }
    .sg-upg-max { font-size: 9px; color: var(--green); letter-spacing: 0.12em; margin-top: 4px; }

    /* ── DAILY CHALLENGE SCORING ── */
    .sg-daily-rank-card {
      border-radius: 16px; padding: 18px 16px; margin-bottom: 10px;
      text-align: center; position: relative; overflow: hidden;
    }
    .sg-daily-rank-badge {
      display: inline-block; font-family: 'Orbitron', monospace;
      font-size: 9px; font-weight: 900; letter-spacing: 0.14em;
      padding: 4px 10px; border-radius: 6px; margin-bottom: 8px;
    }
    .sg-daily-rank-pos {
      font-family: 'Orbitron', monospace; font-size: 32px; font-weight: 900;
      margin-bottom: 2px;
    }
    .sg-daily-rank-lbl { font-size: 10px; color: rgba(255,255,255,0.35); letter-spacing: 0.12em; margin-bottom: 12px; }
    .sg-daily-score-row { display: flex; gap: 8px; justify-content: center; margin-bottom: 12px; }
    .sg-daily-score-chip {
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 9px; padding: 8px 12px; text-align: center;
    }
    .sg-daily-score-val { font-family: 'Orbitron', monospace; font-size: 16px; font-weight: 700; }
    .sg-daily-score-lbl { font-size: 8px; color: rgba(255,255,255,0.3); letter-spacing: 0.1em; margin-top: 2px; }
    .sg-perfect-badge {
      display: inline-flex; align-items: center; gap: 5px;
      background: linear-gradient(135deg,rgba(255,170,0,0.2),rgba(255,120,0,0.1));
      border: 1px solid rgba(255,170,0,0.4); border-radius: 8px;
      padding: 5px 12px; font-size: 10px; font-weight: 700; color: #ffaa00;
      letter-spacing: 0.1em; margin-bottom: 10px;
    }
    .sg-share-btn {
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14);
      border-radius: 10px; padding: 10px 20px;
      font-family: 'Rajdhani', sans-serif; font-size: 12px; font-weight: 700;
      color: rgba(255,255,255,0.6); cursor: pointer; letter-spacing: 0.08em;
      transition: all 0.15s; display: inline-flex; align-items: center; gap: 6px;
