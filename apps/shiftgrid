    .sg-daily-score { font-family: 'Orbitron', monospace; font-size: 22px; color: var(--amber); font-weight: 700; margin: 6px 0; }

    .sg-bonus-row { display: flex; gap: 8px; }
    .sg-bonus-card {
      flex: 1; background: rgba(255,255,255,0.03); border: 1px solid var(--border);
      border-radius: 12px; padding: 12px 6px; text-align: center;
    }
    .sg-bonus-icon { font-size: 20px; margin-bottom: 4px; }
    .sg-bonus-val { font-size: 10px; font-weight: 600; }

    /* ── EDITOR TAB ── */
    .sg-brush-row { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 10px; }
    .sg-brush {
      padding: 5px 12px; border-radius: 8px; border: 1px solid;
      font-size: 10px; font-weight: 700; cursor: pointer;
      font-family: 'Rajdhani', sans-serif; transition: all 0.12s; letter-spacing: 0.06em;
    }
    .sg-edit-grid { display: flex; flex-direction: column; gap: 3px; align-items: center; margin-bottom: 12px; }
    .sg-edit-row { display: flex; gap: 3px; }
    .sg-edit-tile {
      width: 46px; height: 46px; border-radius: 9px; border: 2px solid;
      display: flex; align-items: center; justify-content: center; cursor: pointer;
      transition: all 0.1s;
