function calcXP(score, stars, isBoss) {
  return Math.floor(score / 5) + stars * 15 + (isBoss ? 50 : 0);
}
const MAX_LEVEL = 99;
function addXP(d, amount) {
  if (d.level >= MAX_LEVEL) return { xp: XP_PER_LEVEL-1, level: MAX_LEVEL };
  var newXP = d.xp + amount;
  var newLevel = d.level;
  while (newXP >= XP_PER_LEVEL && newLevel < MAX_LEVEL) { newXP -= XP_PER_LEVEL; newLevel++; }
  if (newLevel >= MAX_LEVEL) newXP = XP_PER_LEVEL - 1;
  return { xp: newXP, level: newLevel };
}
